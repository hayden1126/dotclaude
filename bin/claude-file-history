#!/usr/bin/env python3
"""List and restore Claude Code's own backups of a file.

Before each Write or Edit tool call, Claude Code copies the file it is about to change to
<config>/file-history/<session_id>/<hash>@v<n> and records it in the session's transcript, as a
`file-history-delta` line (trackingPath, backup) or in a `file-history-snapshot` line's
trackedFileBackups. That covers files outside the working directory too, and lasts as long as
the session's transcript (about 30 days by default). Bash writes are not covered.

  claude-file-history PATH              list every backup of PATH, oldest first
  claude-file-history PATH --show N     print backup N
  claude-file-history PATH --restore N  copy the current file to PATH.before-restore-<time>,
                                        then put backup N in its place

A path inside the session's working directory is recorded relative to it ("docs/finances.md"),
so each recorded path is resolved against the cwd of the entries around it (and the session's
first cwd), then compared by realpath. The transcripts (gigabytes) are pre-filtered with grep -F
for the file's name: the name in PATH and, through a symlink, the real one. A backup recorded
under some other link's name is found by passing that link as PATH.
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time

CWD = re.compile(rb'"cwd":\s*("(?:[^"\\]|\\.)*")')


def config_dir():
    return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")


def session_of(transcript, projects):
    """The session whose file-history dir holds a transcript's backups: <project>/<sid>.jsonl,
    or for a subagent <project>/<sid>/subagents/agent-<id>.jsonl."""
    parts = os.path.relpath(transcript, projects).split(os.sep)
    return parts[1][:-len(".jsonl")] if len(parts) == 2 else parts[1]


def cwd_in(line):
    m = CWD.search(line)
    try:
        return json.loads(m.group(1)) if m else None
    except ValueError:
        return None


def backups(target, given):
    cfg = config_dir()
    projects = os.path.join(cfg, "projects")
    needles = sorted({json.dumps(os.path.basename(p), ensure_ascii=False)[1:-1]
                      for p in (target, given)})
    try:
        out = subprocess.run(["grep", "-rlF", "--include=*.jsonl",
                              *[a for n in needles for a in ("-e", n)], projects],
                             capture_output=True, text=True).stdout
    except OSError as e:
        sys.exit(f"claude-file-history: grep failed: {e}")
    found = {}
    for transcript in out.splitlines():
        sid = session_of(transcript, projects)
        with open(transcript, "rb") as f:
            data = f.read()
        first = cwd_in(data)
        cwd = first
        for line in data.split(b"\n"):
            cwd = cwd_in(line) or cwd
            if b"file-history" not in line or not any(n.encode() in line for n in needles):
                continue
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            found_in(entry, target, {c for c in (first, cwd) if c}, cfg, sid, found)
    return sorted(found.values(), key=lambda b: (b["time"], b["file"]))


def found_in(entry, target, cwds, cfg, sid, found):
    if entry.get("type") == "file-history-delta":
        pairs = [(entry.get("trackingPath"), entry.get("backup"))]
    elif entry.get("type") == "file-history-snapshot":
        pairs = ((entry.get("snapshot") or {}).get("trackedFileBackups") or {}).items()
    else:
        return
    for path, backup in pairs:
        if not isinstance(path, str) or not isinstance(backup, dict) \
                or not backup.get("backupFileName"):
            continue
        bases = cwds if not os.path.isabs(path) else {"/"}
        if not any(os.path.realpath(os.path.join(c, path)) == target for c in bases):
            continue
        file = os.path.join(cfg, "file-history", sid, backup["backupFileName"])
        if file not in found and os.path.isfile(file):
            found[file] = {"file": file, "time": str(backup.get("backupTime") or ""),
                           "session": sid, "size": os.path.getsize(file)}


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("path")
    act = ap.add_mutually_exclusive_group()
    act.add_argument("--show", type=int, metavar="N")
    act.add_argument("--restore", type=int, metavar="N")
    args = ap.parse_args()
    target = os.path.realpath(os.path.abspath(args.path))
    found = backups(target, os.path.abspath(args.path))
    if not found:
        sys.exit(f"claude-file-history: no backups of {target} (only tool writes are backed up, "
                 "for as long as the session's transcript is kept)")
    n = args.show if args.show is not None else args.restore
    if n is None:
        now = os.path.getsize(target) if os.path.isfile(target) else None
        print(f"{target}  (now: {'missing' if now is None else f'{now} bytes'})")
        print("each backup is the file as it was just before a tool changed it at that time")
        for i, b in enumerate(found, 1):
            print(f"{i:3}  {b['time']}  {b['size']:>8} bytes  session {b['session'][:8]}  {b['file']}")
        return
    if not 1 <= n <= len(found):
        sys.exit(f"claude-file-history: N must be 1 to {len(found)}")
    src = found[n - 1]["file"]
    if args.show is not None:
        with open(src, "rb") as f:
            sys.stdout.buffer.write(f.read())
        return
    if os.path.exists(target):
        keep = f"{target}.before-restore-{time.strftime('%Y%m%dT%H%M%S')}"
        shutil.copy2(target, keep)
        print(f"kept the current file as {keep}")
    shutil.copyfile(src, target)
    print(f"restored {target} from backup {n} ({found[n - 1]['time']})")


if __name__ == "__main__":
    main()
