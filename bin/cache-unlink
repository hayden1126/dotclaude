#!/usr/bin/env python3
"""Find, and on request un-link, project files that are hardlinks into a shared package cache.

uv and pnpm (and bun) install a project's packages as hardlinks into their shared cache, so the
project's file and the cache's file are one file. A sandboxed session can write the project, so
an in-place edit there would reach the cache and every later install of that package (sandbox
gap N3). setup.sh puts uv and pnpm in copy mode, which covers new installs only; this finds the
installs made before it and, with --apply, gives each shared file a copy of its own: the same
bytes and mode, in a new file renamed over the old one, so nothing needs reinstalling.

Run it from a terminal, outside the sandbox: it reads the caches and rewrites the projects.

    cache-unlink ~/code              # report, per project under ~/code; exit 1 if any is shared
    cache-unlink --apply ~/code      # un-link them; exit 0 once none is left

The caches: uv's ($UV_CACHE_DIR, else $XDG_CACHE_HOME/uv or ~/.cache/uv), pnpm's store
($PNPM_STORE_DIR, else $XDG_DATA_HOME/pnpm/store or ~/.local/share/pnpm/store, and
~/Library/pnpm/store on macOS) and bun's ($BUN_INSTALL_CACHE_DIR, else ~/.bun/install/cache),
plus any --cache DIR. Only files with more than one link are looked at, and only a project file
that is the same file as one in a cache counts; links inside a cache (uv links its own entries
to each other) never do. The caches themselves are skipped when a DIR holds them.
tests/setup/test_cache_unlink.py holds the cases.
"""
import argparse
import os
import stat
import sys


def default_caches():
    home = os.path.expanduser("~")
    env = os.environ.get
    xdg_cache = env("XDG_CACHE_HOME") or os.path.join(home, ".cache")
    xdg_data = env("XDG_DATA_HOME") or os.path.join(home, ".local", "share")
    caches = {
        "uv": [env("UV_CACHE_DIR") or os.path.join(xdg_cache, "uv")],
        "pnpm": [env("PNPM_STORE_DIR") or os.path.join(xdg_data, "pnpm", "store"),
                 os.path.join(home, "Library", "pnpm", "store")],
        "bun": [env("BUN_INSTALL_CACHE_DIR") or os.path.join(home, ".bun", "install", "cache")],
    }
    return {name: [os.path.realpath(d) for d in dirs if os.path.isdir(d)]
            for name, dirs in caches.items()}


def linked_files(root, skip):
    """(path, lstat) for each regular file under root with more than one link; never follows
    a symlink, and skips the dirs in skip (real paths)."""
    for dirpath, dirnames, filenames in os.walk(root, onerror=lambda e: None):
        dirnames[:] = [d for d in dirnames
                       if os.path.realpath(os.path.join(dirpath, d)) not in skip]
        for name in filenames:
            path = os.path.join(dirpath, name)
            try:
                st = os.lstat(path)
            except OSError:
                continue
            if stat.S_ISREG(st.st_mode) and st.st_nlink > 1:
                yield path, st


def project_of(path, roots):
    """The DIR argument the file is under, or its top-level entry when that is a dir: the
    report groups by project when DIR holds several."""
    for root in roots:
        rel = os.path.relpath(path, root)
        if not rel.startswith(os.pardir + os.sep):
            first = rel.split(os.sep, 1)
            return os.path.join(root, first[0]) if len(first) > 1 else root
    return path


def unlink_in_place(path, st):
    """Copy path to a new file beside it and rename that over it, keeping its mode and times.
    The source opens without following a link, so a file swapped for a symlink since the walk
    is refused rather than copied from wherever it points."""
    tmp = os.path.join(os.path.dirname(path), f".{os.path.basename(path)}.cache-unlink.{os.getpid()}")
    src = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    try:
        if os.fstat(src).st_ino != st.st_ino:
            raise OSError(f"{path} changed since the walk")
        dst = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, stat.S_IMODE(st.st_mode))
        try:
            while chunk := os.read(src, 1 << 20):
                os.write(dst, chunk)
            os.fchmod(dst, stat.S_IMODE(st.st_mode))
        finally:
            os.close(dst)
        os.utime(tmp, ns=(st.st_atime_ns, st.st_mtime_ns))
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    finally:
        os.close(src)


def main(argv=None):
    ap = argparse.ArgumentParser(prog="cache-unlink", description=__doc__.split("\n\n")[0])
    ap.add_argument("dirs", nargs="+", metavar="DIR", help="dirs to search (your projects)")
    ap.add_argument("--apply", action="store_true", help="un-link what the report finds")
    ap.add_argument("--cache", action="append", default=[], metavar="DIR",
                    help="another cache dir to count (a store on another disk)")
    args = ap.parse_args(argv)

    caches = default_caches()
    if args.cache:
        caches["other"] = [os.path.realpath(d) for d in args.cache if os.path.isdir(d)]
    cache_dirs = {d for dirs in caches.values() for d in dirs}
    roots = [os.path.realpath(d) for d in args.dirs]
    for d, real in zip(args.dirs, roots):
        if not os.path.isdir(real):
            ap.error(f"not a dir: {d}")

    # Project side first: usually far fewer linked files than the caches hold.
    wanted = {}
    for root in roots:
        for path, st in linked_files(root, cache_dirs):
            wanted.setdefault((st.st_dev, st.st_ino), []).append((path, st))
    shared = {}  # (project, cache name) -> [(path, st)]
    for name, dirs in caches.items():
        for d in dirs:
            if not wanted:
                break
            for _, st in linked_files(d, set()):
                for path, pst in wanted.pop((st.st_dev, st.st_ino), ()):
                    shared.setdefault((project_of(path, roots), name), []).append((path, pst))

    if not shared:
        print("cache-unlink: no file under " + ", ".join(args.dirs) + " is shared with a cache")
        return 0
    home = os.path.expanduser("~")
    for (project, name), files in sorted(shared.items()):
        shown = "~" + project[len(home):] if project.startswith(home + os.sep) else project
        print(f"{name:<6}{len(files):>8} files  {shown}")
    if not args.apply:
        print("cache-unlink: rerun with --apply to give each its own copy")
        return 1
    failed = 0
    for files in shared.values():
        for path, st in files:
            try:
                unlink_in_place(path, st)
            except OSError as e:
                failed += 1
                print(f"cache-unlink: {path}: {e.strerror or e}", file=sys.stderr)
    done = sum(len(f) for f in shared.values()) - failed
    print(f"cache-unlink: un-linked {done} files" + (f", {failed} failed" if failed else ""))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
