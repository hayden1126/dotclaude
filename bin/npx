#!/usr/bin/env bash
# npx shim, linked into ~/.local/bin ahead of the real npx by setup.sh (sandbox gap N2). Claude
# Code starts stdio MCP servers in the project dir, which sandboxed Bash and the file tools can
# write, and npx prefers a matching package in that dir's node_modules, and reads its .npmrc,
# over its own cache. So a launch by Claude Code, or any exact-version spec such as a plugin
# server's `npx chrome-devtools-mcp@1.11.0`, gets --prefix=/ first: npm then takes / as the
# project, where only root can create either. The flag must come before the spec, or npx hands
# it to the package. It also makes / npm's global prefix for that run (globals under
# /lib/node_modules, global config /etc/npmrc, npm_config_prefix=/ in the package's env).
# A launch by Claude Code also starts at / (sandbox gap SW1), so the server's cwd is / too, and a
# dot path, which would then name / or a dir under it with no error, is refused. Anything else,
# such as Hayden's own `npx tsc` or `npx tool@1.2.3 ./x` in a project, keeps its cwd, and without
# an exact version reaches the real npx untouched.
# tests/setup/test_npx_shim.py holds the cases.
# dotclaude-npx-shim: setup.sh and the tests know this shim, or a copy of it, by this line.
set -uo pipefail

# The real npx: the first on PATH that isn't a copy of this shim (any checkout's link, or a
# git-bash copy: two would exec each other forever). A relative or empty PATH entry is the cwd,
# the dir an MCP server starts in, so it is never taken.
# Builtins only: with no grep on PATH, a failed check would take the shim for the real npx.
is_a_shim() {
  local line n=0
  [[ $1 -ef ${BASH_SOURCE[0]} ]] && return 0
  while ((n++ < 30)) && IFS= read -r line; do
    [[ $line == *dotclaude-npx-shim* ]] && return 0
  done <"$1"
  return 1
} 2>/dev/null
real=""
IFS=: read -ra dirs <<<"$PATH"
for d in "${dirs[@]}"; do
  [[ $d == /* && -f $d/npx && -x $d/npx ]] || continue
  is_a_shim "$d/npx" && continue
  real="$d/npx"
  break
done
[[ -n $real ]] || { echo "npx shim: no npx on PATH besides this shim" >&2; exit 127; }
abs=""
for d in "${dirs[@]}"; do
  [[ $d == /* ]] && abs+=":$d"
done

# Claude Code is the native binary (comm `claude`; a session the daemon runs is exec'd by its
# versioned path, so its comm is the version and its executable sits in claude/versions/) or,
# installed with npm, node running its cli.js through a `claude` link on PATH (`node
# /usr/local/bin/claude`). So with comm `node`, the script is node's first argument that isn't
# an option: named `claude`, or resolving into the package. /proc where there is one, ps
# elsewhere (macOS: its comm is the executable's path, its args come space-joined).
parent_is_claude() {
  local comm exe a script="" words
  { read -r comm <"/proc/$PPID/comm"; } 2>/dev/null || comm="$(ps -o comm= -p "$PPID" 2>/dev/null)"
  exe="$(readlink "/proc/$PPID/exe" 2>/dev/null)" || exe="$comm"
  [[ $exe == */claude/versions/* ]] && return 0
  comm="${comm##*/}"
  [[ $comm == claude ]] && return 0
  [[ $comm == node ]] || return 1
  if [[ -r /proc/$PPID/cmdline ]]; then
    words=()
    while IFS= read -r -d '' a; do words+=("$a"); done <"/proc/$PPID/cmdline"
  else
    read -ra words <<<"$(ps -o args= -p "$PPID" 2>/dev/null)"
  fi
  ((${#words[@]} > 1)) || return 1  # bash 3.2 (macOS) calls an empty slice unbound
  for a in "${words[@]:1}"; do
    [[ $a == -* ]] || { script="$a"; break; }
  done
  [[ -n $script ]] || return 1
  [[ ${script##*/} == claude ]] && return 0
  script="$(readlink -f -- "$script" 2>/dev/null)"
  [[ $script == */@anthropic-ai/claude-code/* ]]
}

# The package spec: a -p/--package value, else the first operand. The value of an option on the
# list, npx's own and the common npm ones, is skipped, so it is never taken for the spec.
spec=""
for ((i = 1; i <= $#; i++)); do
  a="${!i}"
  case "$a" in
    --) ((i++)); spec="${!i-}"; break ;;
    -p|--package) ((i++)); spec="${!i-}"; break ;;
    --package=*) spec="${a#--package=}"; break ;;
    -p=*) spec="${a#-p=}"; break ;;
    -c|--call|--registry|--cache|--prefix|--userconfig|--globalconfig|--loglevel|-w|--workspace|\
    --node-options|--script-shell|--before|--tag|--omit|--include|--location|--shell|--npm|\
    --node-arg|-n)
      ((i++)) ;;
    -*) ;;
    *) spec="$a"; break ;;
  esac
done
exact='^(@[^/@]+/)?[^/@]+@v?[0-9]+\.[0-9]+\.[0-9]+([-+][0-9A-Za-z.+-]*)?$'

# The check runs commands from the cwd it hasn't left yet, so never by a relative PATH entry.
# Exit 1, not 2: a hook's exit 2 is Claude Code's code for blocking.
if (PATH="${abs#:}"; parent_is_claude); then
  for a in "$@"; do
    case "$a" in
      .|..|./*|../*|*=.|*=..|*=./*|*=../*)
        echo "npx shim: a launch by Claude Code starts at /, so use an absolute path, not: $a" >&2
        exit 1 ;;
    esac
  done
  cd / || exit 1
  exec "$real" --prefix=/ "$@"
fi
[[ $spec =~ $exact ]] && exec "$real" --prefix=/ "$@"
exec "$real" "$@"
