import fcntl  # noqa: E402
import glob  # noqa: E402
import hashlib  # noqa: E402
import json  # noqa: E402
import re  # noqa: E402
import stat  # noqa: E402
import subprocess  # noqa: E402
import tempfile  # noqa: E402
import time  # noqa: E402
import traceback  # noqa: E402
import unicodedata  # noqa: E402

MAX_ROWS = 5            # tmux's own limit for `status`
DEFAULT_SLOT = 32       # a tab's width while its row has room; a fuller row splits evenly
MIN_SLOT = 18           # desktop: index, glyphs and a few title cells
MIN_SLOT_PHONE = 9      # " 999 ★ ◐ ": the label shrinks to fit (entry)
PHONE_WIDTH = 100       # a client narrower than this gets the phone layout
PHONE_LEFT = 6          # row 0's cells for the delegation token on the phone
NAME_CELLS = 12         # tab and header names are cut to this many cells
PHONE_HEAD_CHARS = 3    # the phone's header shows this much of the repo name
GITFILE_MAX = 4096
RECORD_MAX = 64 * 1024  # a lane.json is untrusted: read no more than this
ERR_MAX = 16 * 1024     # the error log keeps the end of the traceback
PASSES = 5              # passes per lock hold while hooks burst (2 holds: 2 x PASSES at most)
PALETTE = (75, 179, 141, 114, 174, 110)   # header colours, by group order
CUSTOM_COLOUR = 252     # every custom row's header, outside PALETTE
ROW_NAME_CELLS = 16     # a custom row's name is cut to this many cells
PLACE_MAX = 2048        # an @tab_place value, in bytes
LOCK_WAIT = 2.0         # seconds a move waits for the layout lock, a record write for its own
RECORDS_LOCK = ".records.lock"   # in open-sessions, shared with hooks/session-registry.sh
POS_MAX = 999
CUSTOM_MAX = 9999       # custom row ids run 1..CUSTOM_MAX
PHONE_STATUS_LEFT = "#(~/.local/bin/tmux-claude-status)"

SID = re.compile(r"\$\d+\Z")
WID = re.compile(r"@\d+\Z")
CLIENT = re.compile(r"[A-Za-z0-9_./][A-Za-z0-9_./-]{0,255}\Z")   # a tty path, client-<pid>
NAV_ROW = re.compile(r"\d{1,2};@\d{1,9}:\d{1,6}:\d{1,6}(?:,@\d{1,9}:\d{1,6}:\d{1,6})*\Z")
NAV_MAX = 16 * 1024
DIRECTIONS = ("left", "right", "up", "down")
ROW_KEY = re.compile(r"(?:p:/.*|s|c:[1-9]\d{0,3})\Z", re.S)   # a project, the shared or a custom row
PLAIN_WORD = re.compile(r"[A-Za-z0-9_@-][A-Za-z0-9_@\[\]-]*")   # needs no quotes in tmux's config

FILL = "#[fill=colour236]"
NORM = "#[bg=colour236]#[fg=colour250]#[nobold]#[nodim]"
CUR = "#[bg=colour24]#[fg=colour231]#[bold]"
# Between two tabs, after the left tab's #[norange]. tmux 3.7c ends a range at cx + 1
# (format-draw.c:949), so a range also claims the cell after it: a click on the divider acts
# on the tab to its left.
SEP = "#[fg=colour240]│#[fg=colour250]"
GLYPH_ON = "#{?#{==:#{@claude_state},busy},1,#{?#{==:#{@claude_state},wait},1,0}}"
# The label: the pane title (else the running command) with two substitutions, applied in order
# after the lookup (tmux 3.7c format.c format_replace1):
# - s/[#]/♯/ first: a # left in would start a style (`#[...]`) when the row is drawn, and a q/h
#   `##` is counted as one cell by `=` but two by `p`, which shrinks the tab. `[#]` because a
#   modifier's argument is format-expanded twice (format_build_modifiers, then format_sub's
#   caller), where `##` would collapse to `#` and then to nothing; `#]` passes through as is.
# - then the prefix Claude's titles carry: `✳ ` idle, a braille spinner frame (U+2800-28FF)
#   busy, then the repo: `repo · ` (hooks/session-title.sh), or `[repo] ` from before it, which
#   a session keeps until its next prompt (an idle or restored tab, indefinitely). The server's
#   locale decides whether regcomp sees bytes or characters, so the sets are ASCII: 1 to 3
#   non-space, non-[ characters cover a 3-byte glyph either way, and the `·` is a literal, which
#   matches as its bytes or as one character (a title with no glyph whose first word is that
#   short, then a [bracket] or a word and ` · `, loses both). The bound is repeated `?`, not
#   `{1,3}`: a bare } ends the enclosing #{...} early. The match runs to the end and keeps \3,
#   so tmux's global replace can't strip a second prefix. \3 must be non-empty: tmux draws an
#   empty group's reference as a literal "3", so a bare prefix (`repo · `) is left whole.
# Both run on the text cut to LABEL_CAP characters first: s/// is quadratic in its input (regsub
# runs regexec once per match, each from the strlen of the rest), and a pane can set a title of
# any length with OSC 2, so a 160k-cell title took 98 ms a row to draw, against tmux's 100 ms
# limit for a whole row. The cut is itself a substitution, one anchored match that keeps the
# first LABEL_CAP characters (bytes, under a C locale), not #{=/N:...}: `=` skips a `#[...]`
# style and counts `##` as one cell, so a title of "#[" + "##" * 80000 + "]" passed it whole
# and took 88 ms. The bound's brace is escaped (`#}`): a bare } ends the format. 128 bytes
# still hold 42 three-byte glyphs, more than the widest slot; cut, the label takes 3 ms.
LABEL_CAP = 128
CUT = "#{s/^(.{" + str(LABEL_CAP) + "#}).+$/\\1/:%s}"
BODY = ("#{?@tab_name,#{@tab_name} ,}"
        "#{?pane_title,#{s/[#]/♯/;s/^([^ [][^ []?[^ []? )?(\\[[^]]*\\]|[^ []+ ·) (.+)$/\\3/:"
        + CUT % "pane_title" + "},"
        "#{s/[#]/♯/:" + CUT % "pane_current_command" + "}}")

SESSION_FMT = ("#{session_id}\t#{status}\t#{status-left-length}\t#{status-right-length}"
               "\t#{@tab_bar_sig}")
CLIENT_FMT = "#{session_id}\t#{client_width}"
# A client's session and current window, and that session's @tab_bar_nav (a list-clients format
# has the client's session, its current window and pane, so the option resolves there).
NAV_FMT = "#{client_name}\t#{session_id}\t#{window_id}\t#{@tab_bar_nav}"
# The same for a move, plus the server a restore record names (its start time, pid and socket,
# as hooks/session-registry.sh writes them; the socket last, since a path may hold a tab).
MOVE_FMT = ("#{client_name}\t#{session_id}\t#{window_id}\t#{start_time}\t#{pid}"
            "\t#{@tab_bar_nav}\t#{socket_path}")
# The placement last: one holding a tab is invalid anyway. A tab in a name (never ours: clean
# drops it) pushes its tail into the placement for one run, which then rewrites the name.
WINDOW_FMT = ("#{session_id}\t#{window_id}\t#{window_index}\t#{window_active}\t#{@tab_group}"
              "\t#{@tab_row_custom}\t#{@tab_name}\t#{@tab_place}")
PANE_FMT = "#{window_id}\t#{pane_active}\t#{pane_id}\t#{pane_current_path}"
NAME_IN_FMT = "#{window_id}\t#{@tab_row_name_in}"


# --- names --------------------------------------------------------------------------------------

def cell_width(ch: str) -> int:
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def text_width(s: str) -> int:
    return sum(cell_width(c) for c in s)


def clean(s: str, cells: int = NAME_CELLS) -> str:
    """s without control, format or surrogate characters or '#', cut to `cells` with '…'."""
    s = "".join(c for c in s if c != "#" and unicodedata.category(c) not in ("Cc", "Cf", "Cs"))
    if text_width(s) <= cells:
        return s
    out, used = [], 0
    for c in s:
        if used + cell_width(c) > cells - 1:
            break
        out.append(c)
        used += cell_width(c)
    return "".join(out) + "…"


def clean_row_name(s: str) -> str:
    """A custom row's name as typed: each '#' drawn as '♯' (a '#' would start a style when the
    header is drawn), control and format characters dropped, cut to ROW_NAME_CELLS."""
    return clean(s.replace("#", "♯"), ROW_NAME_CELLS).strip()


def short(name: str, phone: bool) -> str:
    """A group header's name: whole on the desktop, its first few characters on the phone."""
    return name[:PHONE_HEAD_CHARS] if phone else name


# --- classify -----------------------------------------------------------------------------------

@dataclasses.dataclass(frozen=True)
class Tab:
    kind: str       # lead | lane | other (a laned repo's worktrees) | shared
    repo: str       # a laned repo's common dir; "" when shared
    repo_name: str  # cleaned: the group header (laned), or the shared tab's name
    name: str       # cleaned: the tab's @tab_name

    @property
    def rank(self) -> int:
        return ("lead", "lane", "other").index(self.kind) if self.kind != "shared" else 3


def read_small(path: str, limit: int) -> bytes | None:
    """At most `limit` bytes of a regular file (not a symlink or FIFO), or None when it is
    missing, unreadable, not regular or longer."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
    except (OSError, ValueError):
        return None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        data = b""
        while len(data) <= limit:
            chunk = os.read(fd, limit + 1 - len(data))
            if not chunk:
                break
            data += chunk
        return data if len(data) <= limit else None
    except OSError:
        return None
    finally:
        os.close(fd)


def common_dir(top: str, dotgit: str) -> str | None:
    """The git common dir of the checkout at `top`: its .git dir, or for a linked worktree
    (.git file reading `gitdir: <common>/worktrees/<name>`) that <common>."""
    if os.path.isdir(dotgit):
        return os.path.realpath(dotgit)
    data = read_small(dotgit, GITFILE_MAX)
    if data is None:
        return None
    try:
        text = data.decode().rstrip()   # as git reads it: the whole file, trailing space cut
    except UnicodeDecodeError:
        return None
    if not text.startswith("gitdir:") or not text[7:].strip() or "\0" in text:
        return None
    gitdir = os.path.realpath(os.path.join(top, text[7:].strip()))
    parent = os.path.dirname(gitdir)
    return os.path.dirname(parent) if os.path.basename(parent) == "worktrees" else gitdir


def lane_paths(common: str) -> set[str] | None:
    """The realpaths that the repo's lane records name, or None when it has no lanes: no
    <common>/lanes/<id>/lane.json for an id not starting with '_' (`_closed` holds the
    archive), or a symlinked lanes dir. A record is untrusted: only its `path` is used, and only
    when it is an absolute str."""
    lanes = os.path.join(common, "lanes")
    if os.path.islink(lanes):
        return None
    found, paths = False, set()
    for rec in glob.glob(os.path.join(glob.escape(lanes), "*", "lane.json")):
        if os.path.basename(os.path.dirname(rec)).startswith("_"):
            continue
        found = True
        data = read_small(rec, RECORD_MAX)
        try:
            path = json.loads(data).get("path") if data is not None else None
        except (ValueError, RecursionError, AttributeError):
            continue
        if isinstance(path, str) and os.path.isabs(path) and "\0" not in path:
            paths.add(os.path.realpath(path))
    return paths if found else None


def classify(cwd: str) -> Tab:
    """What a window is, from its active pane's cwd: a laned repo's lead, lane or other
    worktree, or a shared tab named by its checkout's (or cwd's) directory.

    Looser than lanelib's Repo.identity (skills/lanes/scripts/lanelib.py), on purpose: a repo
    counts as laned when it has a lane record, without lanelib's check for `lane init`'s config,
    and a record whose path another record also claims still names its lane (lanelib rejects
    both). That is fine for a display: the worst a planted record does is draw a tab under the
    wrong header, and nothing here acts on a lane."""
    if not cwd or "\0" in cwd or not os.path.isabs(cwd):
        return Tab("shared", "", "", "")
    cwd = os.path.realpath(cwd)
    top = cwd
    while not os.path.lexists(os.path.join(top, ".git")):
        parent = os.path.dirname(top)
        if parent == top:
            name = clean(os.path.basename(cwd), NAME_CELLS - 1)
            return Tab("shared", "", name, f"{name}:" if name else "")
        top = parent
    name = clean(os.path.basename(top), NAME_CELLS - 1)
    shared = Tab("shared", "", name, f"{name}:" if name else "")
    common = common_dir(top, os.path.join(top, ".git"))
    if common is None:
        return shared
    lanes = lane_paths(common)
    if lanes is None:
        return shared
    lead = os.path.dirname(common)
    repo_name = clean(os.path.basename(lead))
    if top == lead:
        return Tab("lead", common, repo_name, "lead")
    kind = "lane" if top in lanes else "other"
    return Tab(kind, common, repo_name, clean(os.path.basename(top)))


# --- placements ---------------------------------------------------------------------------------

@dataclasses.dataclass(frozen=True)
class Place:
    """A window's @tab_place: its row ("p:<common dir>", "s" or "c:<n>") and position there; a
    custom row's members also carry the row it was made below (`after`) and its cleaned name."""
    row: str
    pos: int
    after: str = ""
    name: str = ""


def plain(s: object) -> bool:
    """s is a str with no control character or lone surrogate."""
    return isinstance(s, str) and not any(unicodedata.category(c) in ("Cc", "Cs") for c in s)


def parse_place(text: str) -> Place | None:
    """An @tab_place value read strictly, or None: exactly the four keys, a row key, an int
    position 0..POS_MAX, an `after` that is "" or a row key, and an already cleaned name; at most
    PLACE_MAX bytes and no control characters, raw or decoded. It comes from a window option a
    restore record can set, so it is untrusted, and it never reaches a format."""
    if not text or not plain(text) or len(text.encode()) > PLACE_MAX:
        return None
    try:
        d = json.loads(text)
    except (ValueError, RecursionError):
        return None
    if not isinstance(d, dict) or set(d) != {"row", "pos", "after", "name"}:
        return None
    row, pos, after, name = d["row"], d["pos"], d["after"], d["name"]
    if not plain(row) or not ROW_KEY.match(row) or type(pos) is not int \
            or not 0 <= pos <= POS_MAX or not plain(after) or (after and not ROW_KEY.match(after)) \
            or not plain(name) or name != clean_row_name(name):
        return None
    return Place(row, pos, after, name)


def place_text(place: Place) -> str | None:
    """The @tab_place value for `place`, or None when it wouldn't read back (a common dir too
    long or holding a control character): such a tab stays where layout puts it."""
    text = json.dumps(dataclasses.asdict(place), ensure_ascii=False, separators=(",", ":"))
    return text if parse_place(text) == place else None


# --- lay out ------------------------------------------------------------------------------------

@dataclasses.dataclass
class Group:
    name: str                   # the cleaned repo name, or a custom row's cleaned name
    tabs: list                  # [(window id, window index)], in tab order
    colour: int = PALETTE[0]    # the header's colour
    key: str = ""               # the row: "p:<common dir>" or "c:<n>"
    after: str = ""             # a custom row: the row it was made below


@dataclasses.dataclass
class Layout:
    phone: bool
    heads: list                 # per group: the header name shown (an option value, not format)
    head_w: list                # per group: name + "▸" + a space, in cells (also its ┃ divider's)
    rows: list                  # per row: items ("head", g, dim) ("div", g) ("tab", wid, index)
                                # ("more", hidden, cells); a "head" is drawn in the gutter
    slots: list                 # per row: the slot width of its tabs
    hidden: int
    left: int                   # L: row 0's cells for status-left (blank on the other rows)
    head: int                   # H: the widest shown header's cells, 0 with no laned row
    right: int                  # row 0's cells for status-right (desktop)
    colours: list               # per group: its header's colour

    @property
    def gutter(self) -> int:
        """G = L + H: every row's first tab starts at column G + 1."""
        return self.left + self.head


def group_windows(wins: list, tab_of: dict, place_of: dict | None = None) -> tuple:
    """Split a session's windows ([(index, wid)]; tab_of: wid -> Tab; place_of: wid -> Place)
    into its groups and the shared tabs, plus each window's (@tab_name, @tab_group,
    @tab_row_custom).
    A window sits in its placement's row when that row is the shared row, a custom row or a
    project row some window here classifies into; else in its auto row (its project's, or the
    shared row). A row with a placed member is manual: placed members by position, then the
    others in auto order (lead, lanes, other worktrees, each by index; shared tabs by index).
    Project rows go by their auto members' lowest index, which also picks their colour, so a
    move never recolours a project. A custom row follows the row it was made below (several:
    by id), else goes last among the groups; its `after` and name are its lowest window id's."""
    place_of = place_of or {}
    projects: dict = {}                 # project row key -> its first window's Tab
    auto = {}
    for _, wid in sorted(wins):
        tab = tab_of[wid]
        auto[wid] = "s" if tab.kind == "shared" else "p:" + tab.repo
        if auto[wid] != "s":
            projects.setdefault(auto[wid], tab)
    colour = {key: k % len(PALETTE) for k, key in enumerate(projects)}
    members: dict = {}                  # row key -> [(order, wid, index)]
    for index, wid in sorted(wins):
        tab, place = tab_of[wid], place_of.get(wid)
        if place is not None and (place.row in projects or not place.row.startswith("p:")):
            row, order = place.row, (0, place.pos, tab.rank, index)
        else:
            row, order = auto[wid], (1, 0, tab.rank, index)
        members.setdefault(row, []).append((order, wid, index))

    custom = sorted((k for k in members if k.startswith("c:")), key=lambda k: int(k[2:]))
    meta = {key: place_of[min((m[1] for m in members[key]), key=lambda w: int(w[1:]))]
            for key in custom}
    laned = [k for k in projects if k in members]
    children: dict = {}                 # anchor -> the custom rows made below it; "" = last
    for key in custom:
        anchor = meta[key].after
        shown = anchor != key and (anchor in laned or anchor in meta)
        children.setdefault(anchor if shown else "", []).append(key)
    order, seen = [], set()
    # Each row, then the rows made below it, depth first. Custom rows go once more at the end:
    # rows anchored in a cycle (only a hand-made placement does that) are reached from nowhere.
    for start in laned + children.get("", []) + custom:
        stack = [start]
        while stack:
            key = stack.pop()
            if key not in seen:
                seen.add(key)
                order.append(key)
                stack.extend(reversed(children.get(key, [])))

    groups, names = [], {}
    for key in order:
        tabs = [(wid, index) for _, wid, index in sorted(members[key])]
        if key.startswith("p:"):
            groups.append(Group(projects[key].repo_name, tabs, PALETTE[colour[key]], key))
        else:
            groups.append(Group(meta[key].name, tabs, CUSTOM_COLOUR, key, meta[key].after))
    for key, mem in members.items():
        for _, wid, _ in mem:
            tab, in_custom = tab_of[wid], "1" if key.startswith("c:") else ""
            if tab.kind == "shared":
                names[wid] = (tab.name, "", in_custom)
            else:
                name = tab.name if key == auto[wid] else f"{tab.repo_name}·{tab.name}"
                names[wid] = (name, str(colour[auto[wid]]), in_custom)
    shared = [(wid, index) for _, wid, index in sorted(members.get("s", []))]
    return groups, shared, names


def rows_of(groups: list, shared: list) -> dict:
    """The logical rows: row key -> [wid] in bar order (the shared row is "s")."""
    rows = {g.key: [wid for wid, _ in g.tabs] for g in groups}
    if shared:
        rows["s"] = [wid for wid, _ in shared]
    return rows


def separators(row: list) -> int:
    """The 1-cell separators a row draws: one between each two adjacent tabs (none after a
    header or divider, none after the last tab)."""
    return sum(a[0] == "tab" and b[0] == "tab" for a, b in zip(row, row[1:]))


def marker_w(head_w: list, item: tuple) -> int:
    """A divider's cells: `┃name▸` for a packed group, a lone `┃` (group None) before a shared
    tab that the current window put on a laned row."""
    return 1 if item[1] is None else head_w[item[1]]


def owner(row: list, k: int) -> int | None:
    """The group whose tab row[k] is drawn as: the last header or divider before it, or None
    (a shared tab) when there is none."""
    g = None
    for item in row[:k]:
        if item[0] in ("head", "div"):
            g = item[1]
    return g


def prune(row: list) -> None:
    """Drop each header or divider that no tab follows before the next one."""
    keep = []
    for k, item in enumerate(row):
        if item[0] in ("head", "div"):
            after = next((i for i in row[k + 1:] if i[0] != "more"), None)
            if after is None or after[0] != "tab":
                continue
        keep.append(item)
    row[:] = keep


def spread(n: int, caps: list) -> list:
    """n tabs over rows holding at most caps[i] each, as evenly as the caps allow (4 over two
    rows is 2+2, not 3+1); a leftover tab goes to an earlier row. sum(caps) >= n."""
    level = 0
    while sum(min(c, level) for c in caps) < n:
        level += 1
    sizes = [min(c, level) for c in caps]
    extra = sum(sizes) - n
    for i in reversed(range(len(sizes))):
        if extra and sizes[i] == level:
            sizes[i] -= 1
            extra -= 1
    return sizes


def lay_out(groups: list, shared: list, width: int, current: str | None = None,
            left_len: int = 0, right_len: int = 0) -> Layout:
    """Rows of tabs for one session (pure). groups: [Group] in order; shared: [(wid, index)];
    width: the session's narrowest client; current: its current window id; left_len and
    right_len: status-left-length and status-right-length (desktop).

    Every row starts with the same gutter of G = L + H cells, so every row's first tab starts
    at the same column: L is status-left's reserve (PHONE_LEFT on the phone), shown on row 0 and
    blank below; H is the widest header shown (`name▸ `), drawn on a laned group's rows and
    blank on the shared ones. Tabs get the width after the gutter (and status-right on row 0)."""
    phone = width < PHONE_WIDTH
    min_slot = MIN_SLOT_PHONE if phone else MIN_SLOT
    left, right = (PHONE_LEFT, 0) if phone else (max(0, left_len), max(0, right_len))
    heads = [short(g.name, phone) for g in groups]
    head_w = [text_width(h) + 2 for h in heads]

    def avail(r: int, head: int) -> int:
        return max(0, width - left - head - (right if r == 0 else 0))

    def run_w(k: int) -> int:                # k tabs take k * min_slot + (k - 1) separators
        return k * min_slot + k - 1

    def build(packed: set) -> tuple:
        """(rows, H) with the groups in `packed` moved onto the shared rows."""
        head = max((head_w[g] for g in range(len(groups)) if g not in packed), default=0)

        def kind_rows(first: int, tabs: list, fixed: int) -> list:
            """A kind's tabs over as few rows as hold them from row `first`, spread evenly."""
            caps = []
            while sum(caps) < len(tabs):
                r = first + len(caps)
                caps.append(max(1, (avail(r, head) - fixed + 1) // (min_slot + 1)))
            out, k = [], 0
            for size in spread(len(tabs), caps):
                out.append(tabs[k:k + size])
                k += size
            return out

        rows = []
        for g, group in enumerate(groups):
            if g not in packed:
                for i, part in enumerate(kind_rows(len(rows), group.tabs, 0)):
                    rows.append([("head", g, i > 0)] + [("tab", *t) for t in part])
        base = len(rows)
        bins = [[[("tab", *t) for t in part], run_w(len(part))]   # [items, cells used]
                for part in kind_rows(base, shared, 0)] if shared else []
        for g in sorted(packed):        # first fit, each group whole behind its divider
            need = head_w[g] + run_w(len(groups[g].tabs))
            for b, (items, used) in enumerate(bins):
                if used + need <= avail(base + b, head):
                    items += [("div", g)] + [("tab", *t) for t in groups[g].tabs]
                    bins[b][1] += need
                    break
            else:                       # no room: its own row(s), each behind the divider
                for part in kind_rows(base + len(bins), groups[g].tabs, head_w[g]):
                    bins.append([[("div", g)] + [("tab", *t) for t in part],
                                 head_w[g] + run_w(len(part))])
        return rows + [items for items, _ in bins], head

    # Pack the smallest groups one more at a time until the rows fit; if none fits, keep the
    # packing with the fewest rows (none on a tie), so a pack that saves nothing never happens.
    rows, head = build(set())
    packed: set = set()
    for g in sorted(range(len(groups)), key=lambda g: (len(groups[g].tabs), g)):
        if len(rows) <= MAX_ROWS:
            break
        packed.add(g)
        trial = build(packed)
        if len(trial[0]) < len(rows):
            rows, head = trial

    def fixed(row: list) -> int:        # cells a row's tabs can't use: dividers and +N
        return sum(marker_w(head_w, i) if i[0] == "div" else i[2]
                   for i in row if i[0] in ("div", "more"))

    def tab_count(row: list) -> int:
        return sum(i[0] == "tab" for i in row)

    hidden = []
    if len(rows) > MAX_ROWS:
        total = sum(len(g.tabs) for g in groups) + len(shared)
        more_w = len(f" +{total} ")
        for row in rows[MAX_ROWS:]:
            hidden += [i[1:] for i in row if i[0] == "tab"]
        rows = rows[:MAX_ROWS]
        last, r = rows[-1], MAX_ROWS - 1
        # The current window is always shown, and under its own header: it takes the last
        # shown slot of its own kind (a tab of its group, or a shared tab for a shared one),
        # else the last row's last slot behind its own divider (a lone ┃ for a shared tab).
        # Taking any other slot would draw it under another repo's name.
        cur = next((t for t in hidden if t[0] == current), None)
        if cur is not None:
            g = next((g for g, grp in enumerate(groups) if cur in grp.tabs), None)
            hidden.remove(cur)
            spots = [(i, k) for i, row in enumerate(rows) for k, item in enumerate(row)
                     if item[0] == "tab" and owner(row, k) == g]
            if spots:
                i, k = spots[-1]
                hidden.append(rows[i][k][1:])
                rows[i][k] = ("tab", *cur)
            else:
                k = max(k for k, item in enumerate(last) if item[0] == "tab")
                hidden.append(last.pop(k)[1:])
                last += [("div", g), ("tab", *cur)]
                prune(last)
        # Room for `+N`: drop the last row's last tabs (never the current one) and any
        # header or divider left with no tab.
        while tab_count(last) > 1 and fixed(last) + more_w + tab_count(last) * min_slot \
                + separators(last) > avail(r, head):
            k = max(k for k, item in enumerate(last) if item[0] == "tab" and item[1] != current)
            hidden.insert(0, last.pop(k)[1:])
            prune(last)
        last.append(("more", len(hidden), more_w))

    slots = []
    for r, row in enumerate(rows):
        n = sum(i[0] == "tab" for i in row)
        slots.append(min(DEFAULT_SLOT,
                         max(1, (avail(r, head) - fixed(row) - separators(row)) // n))
                     if n else 0)
    return Layout(phone, heads, head_w, rows, slots, len(hidden), left, head, right,
                  [g.colour for g in groups])


# --- render -------------------------------------------------------------------------------------

def fit(width: int) -> str:
    """BODY padded to `width` cells, cut to width-1 plus '…' when longer (literal widths only:
    a computed width garbles)."""
    width = max(2, width)
    return f"#{{p{width}:#{{=/{width - 1}/…:{BODY}}}}}"


def entry(wid: str, index: int, slot: int) -> str:
    """One slot: a W loop that draws only window `wid`, normal or (as tmux's current window)
    highlighted, as ` #I ★ ◐ name label` padded to `slot` cells. The star and the glyph come and
    go at render time, so the text is a 4-way conditional over literal widths. A slot too narrow
    for the index, a star and a glyph draws only the index, cut to the slot."""
    if not WID.match(wid) or not isinstance(index, int) or index < 0:
        raise ValueError(f"bad window {wid!r} {index!r}")
    base = slot - (len(str(index)) + 2)

    def label(cells: int) -> str:
        """The label in exactly `cells`: fitted, a lone '…', or nothing. fit() needs 2 (a name
        cell and the '…'), so a 3-digit index with a star and a glyph (9 cells) in a phone's
        9-cell slot would draw 2 past it and push every later tab right."""
        return fit(cells) if cells >= 2 else "…" if cells == 1 else ""

    def one(style: str, fg: str) -> str:
        if base < 4:                    # no room for a star and a glyph (a client a few cells
            text = f" {index} "[:slot]  # wide, a 4-digit index): the index, cut to the slot
            return ("#[range=window|#{window_index}]" + style + text.ljust(slot) + "#[norange]"
                    + NORM)
        glyph = ("#{?#{==:#{@claude_state},busy},◐ ,#{?#{==:#{@claude_state},wait},"
                 f"#[fg=colour46]✳ #[fg={fg}],}}}}")
        rest = (f"#{{?@claude_star,#{{?{GLYPH_ON},{label(base - 4)},{label(base - 2)}}},"
                f"#{{?{GLYPH_ON},{label(base - 2)},{label(base)}}}}}")
        return ("#[range=window|#{window_index}]" + style + " #I #{?@claude_star,★ ,}" + glyph
                + rest + "#[norange]" + NORM)

    match = f"#{{==:#{{window_id}},{wid}}}"
    return (f"#{{W:#{{?{match},{one(NORM, 'colour250')},}},"
            f"#{{?{match},{one(CUR, 'colour231')},}}}}")


def name_part(g: int, cells: int) -> str:
    """Group g's name (the session option @tab_bar_g<g>, read plainly) in exactly `cells`."""
    if cells <= 0:
        return ""
    return f"#{{p{cells}:#{{={cells}:#{{@tab_bar_g{g}}}}}}}"


def header(g: int, cells: int, dim: bool, width: int, colour: int) -> str:
    """Group g's `name▸` in the gutter, padded with spaces to `width` (H) cells; `cells` is the
    name's own width, known at layout time, so the padding is fixed text."""
    return (f"#[fg=colour{int(colour)}]" + ("#[dim]" if dim else "#[bold]")
            + name_part(g, cells) + "▸" + NORM + " " * max(0, width - cells - 1))


def divider(g: int | None, cells: int, colour: int) -> str:
    if g is None:                       # before a shared tab on a laned row: no name
        return "#[fg=colour250]#[bold]┃" + NORM
    return f"#[fg=colour{int(colour)}]#[bold]┃" + name_part(g, cells) + "▸" + NORM


def left_part(cells: int) -> str:
    """status-left (which runs tmux-claude-status, the glyph backstop), padded to `cells`."""
    return f"#{{p{cells}:#{{T;=/{cells}:status-left}}}}" if cells > 0 else ""


def right_part(cells: int) -> str:
    return f"#[align=right]#{{T;=/{cells}:status-right}}" if cells > 0 else ""


def render(lay: Layout) -> list:
    """The status-format rows for a layout. Only window ids, integers and fixed text go in."""
    out = []
    for r, (items, slot) in enumerate(zip(lay.rows, lay.slots)):
        # The gutter: status-left (row 0) or blanks, then the header (a laned row) or blanks.
        parts = [FILL, NORM, left_part(lay.left) if r == 0 else " " * lay.left]
        if not (items and items[0][0] == "head"):
            parts.append(" " * lay.head)
        for k, item in enumerate(items):
            if item[0] == "tab" and k and items[k - 1][0] == "tab":
                parts.append(SEP)
            if item[0] == "head":
                parts.append(header(item[1], lay.head_w[item[1]] - 2, item[2], lay.head,
                                    lay.colours[item[1]]))
            elif item[0] == "div":
                parts.append(divider(item[1], marker_w(lay.head_w, item) - 2,
                                     250 if item[1] is None else lay.colours[item[1]]))
            elif item[0] == "tab":
                parts.append(entry(item[1], item[2], slot))
            else:
                text = f" +{int(item[1])} ".ljust(int(item[2]))
                parts.append("#[range=user|more]#[fg=colour250]#[bold]" + text
                             + "#[norange]" + NORM)
        if r == 0 and not lay.phone:
            parts.append(right_part(lay.right))
        row = "".join(parts)
        if any(bad in row for bad in ("%", "#(", "'", "\n")):
            raise ValueError(f"row {r} breaks the template rules")
        out.append(row)
    return out


def nav_value(lay: Layout) -> str:
    """The session's @tab_bar_nav: each row's tabs in bar order as `row;@id:x:w,...`, the rows
    joined by `|`, where x is the 0-based cell the tab starts at (the gutter, then its row's
    dividers, slots and separators, as render draws them) and w its slot. Ids and integers
    only, so nothing untrusted. A row with no tab is left out."""
    out = []
    for r, (row, slot) in enumerate(zip(lay.rows, lay.slots)):
        col, tabs = lay.gutter, []
        for k, item in enumerate(row):
            if item[0] == "tab":
                if not WID.match(item[1]):
                    raise ValueError(f"bad window {item[1]!r}")
                col += 1 if k and row[k - 1][0] == "tab" else 0     # the separator
                tabs.append(f"{item[1]}:{col}:{slot}")
                col += slot
            elif item[0] == "div":
                col += marker_w(lay.head_w, item)
        if tabs:
            out.append(f"{r};" + ",".join(tabs))
    return "|".join(out)


def session_ops(lay: Layout, rows: list) -> list:
    """The option writes that give a session this layout, in order: (name, value), with None
    for an unset. The row count (`status`) goes in after the rows (write_line)."""
    ops = [(f"@tab_bar_g{g}", head) for g, head in enumerate(lay.heads)]
    ops += [(f"status-format[{i}]", row) for i, row in enumerate(rows)]
    ops.append(("@tab_bar_nav", nav_value(lay)))
    if lay.phone:
        ops += [("status-position", "bottom"), ("status-left", PHONE_STATUS_LEFT),
                ("status-right", "")]
    else:                               # back to the global (desktop) values
        ops += [("status-position", None), ("status-left", None), ("status-right", None)]
    return ops


def status_value(rows: int) -> str:
    return "on" if rows == 1 else str(rows)


def signature(ops: list, status: str, state: str) -> str:
    """What a session's @tab_bar_sig holds after a write. state: "off" (the bar was turned off:
    rows are kept current, `status` is left alone), "ok" (`status` is right) or "fix" (it isn't,
    so this sig never matches a stored one and the next run writes it)."""
    return hashlib.sha256(json.dumps([ops, status, state]).encode()).hexdigest()[:16]


# --- the write: one `tmux source-file -` ---------------------------------------------------------

def quote(s: str) -> str:
    """s as one word of tmux's config language, byte for byte: single quotes keep everything
    literal ($, ~, \\, ;, {}, #) but a ', which goes in double quotes on its own ("'"). tmux's
    lexer joins a line ending in \\ to the next even inside quotes, so a newline never goes in."""
    if "\n" in s or "\r" in s or "\0" in s:
        raise ValueError("a newline or NUL in a tmux word")
    if PLAIN_WORD.fullmatch(s):
        return s                        # set-option, -t, @tab_name, status-format[0]
    return "'" + s.replace("'", "'\"'\"'") + "'"


def command(*words: str) -> str:
    return " ".join(quote(w) for w in words)


def write_line(sid: str, ops: list, status: str | None, sig: str) -> str:
    """One session's writes as one ;-joined line: the headers and every row, then `status`
    (None: leave it), then position, left and right, and the sig last. tmux drops the rest of a
    line after an error, so a session that vanished records no sig."""
    tail = ("status-position", "status-left", "status-right")
    cmds = [command("set-option", "-t", sid, name, value)
            for name, value in ops if name not in tail]
    if status is not None:
        cmds.append(command("set-option", "-t", sid, "status", status))
    cmds += [command("set-option", "-u", "-t", sid, name) if value is None
             else command("set-option", "-t", sid, name, value)
             for name, value in ops if name in tail]
    cmds.append(command("set-option", "-t", sid, "@tab_bar_sig", sig))
    return " ; ".join(cmds)


# --- tmux I/O -----------------------------------------------------------------------------------

def tmux(*args: str, stdin: str | None = None) -> subprocess.CompletedProcess:
    """One tmux command on the server $TMUX names. -u: a client that doesn't think its locale
    is UTF-8 prints every tab and non-ASCII byte of a list as _ (server_client_print's
    utf8_sanitize), which would break the tab-separated fields and every non-ASCII path."""
    return subprocess.run(["tmux", "-u", *args], input=stdin, capture_output=True, text=True,
                          encoding="utf-8", timeout=5, errors="surrogateescape")


def read(fields: int, command: str, fmt: str, *flags: str) -> list:
    """A tmux list command's records, each split into `fields` tab-separated fields (the last
    may hold tabs); a record with fewer is dropped. tmux prints values raw, so a path or name
    holding a newline would split its line and could forge another (a directory named
    `x\n@5\t1\t/a/laned/repo`): each record starts with a nonce no value can guess, and the
    output splits only where a newline is followed by it, which keeps such a value whole."""
    head = os.urandom(8).hex() + "\t"
    p = tmux(command, *flags, "-F", head + fmt)
    if p.returncode != 0:
        raise RuntimeError(f"tmux {command} failed: {p.stderr.strip()}")
    if not p.stdout.startswith(head):
        return []
    out = p.stdout[len(head):]
    out = out[:-1] if out.endswith("\n") else out
    rows = [record.split("\t", fields - 1) for record in out.split("\n" + head)]
    return [f for f in rows if len(f) == fields]


def to_int(s: str, default: int) -> int:
    return int(s) if s.isdigit() else default


@dataclasses.dataclass
class State:
    sessions: dict              # sid -> {"status", "left", "right", "sig"}
    widths: dict                # sid -> its narrowest client's width
    windows: dict               # sid -> [(index, wid, active)]
    options: dict               # wid -> {"name", "group", "custom", "place"}, as read
    cwds: dict                  # wid -> its active pane's cwd
    panes: dict                 # wid -> [pane id]


def snapshot() -> State:
    """Every session, client, window and pane, read once."""
    sessions = {}
    for f in read(5, "list-sessions", SESSION_FMT):
        if SID.match(f[0]):
            sessions[f[0]] = {"status": f[1], "left": to_int(f[2], 0),
                              "right": to_int(f[3], 0), "sig": f[4]}
    widths = {}
    for f in read(2, "list-clients", CLIENT_FMT):
        if f[0] in sessions and f[1].isdigit() and int(f[1]) > 0:
            widths[f[0]] = min(widths.get(f[0], int(f[1])), int(f[1]))
    windows, options = {}, {}
    for f in read(8, "list-windows", WINDOW_FMT, "-a"):
        if f[0] in sessions and WID.match(f[1]) and f[2].isdigit():
            windows.setdefault(f[0], []).append((int(f[2]), f[1], f[3] == "1"))
            options[f[1]] = {"group": f[4], "custom": f[5], "name": f[6], "place": f[7]}
    cwds, panes = {}, {}
    for f in read(4, "list-panes", PANE_FMT, "-a"):
        panes.setdefault(f[0], []).append(f[2])
        if f[1] == "1":
            cwds[f[0]] = f[3]
    return State(sessions, widths, windows, options, cwds, panes)


def arrange(state: State, sid: str, tabs: dict) -> tuple:
    """group_windows for session sid; tabs: cwd -> Tab, classified once per run."""
    wins = sorted(state.windows.get(sid, []))
    tab_of, place_of = {}, {}
    for _, wid, _ in wins:
        cwd = state.cwds.get(wid, "")
        if cwd not in tabs:
            tabs[cwd] = classify(cwd)
        tab_of[wid] = tabs[cwd]
        place = parse_place(state.options[wid]["place"])
        if place is not None:
            place_of[wid] = place
    return group_windows([(i, wid) for i, wid, _ in wins], tab_of, place_of)


def layout(err_log: str) -> None:
    """Read every session, window, pane and client once; write what changed in one
    source-file."""
    state = snapshot()
    tabs: dict = {}                     # cwd -> Tab, classified once per run
    writes: dict = {}                   # wid -> (@tab_name, @tab_group, @tab_row_custom) wanted
    lines = []
    for sid, sess in state.sessions.items():
        if sid not in state.widths or not state.windows.get(sid):
            continue                    # nobody sees it
        groups, shared, names = arrange(state, sid, tabs)
        for wid, value in names.items():
            writes.setdefault(wid, value)
        current = next((wid for _, wid, active in state.windows[sid] if active), None)
        lay = lay_out(groups, shared, state.widths[sid], current, sess["left"], sess["right"])
        rows = render(lay)
        ops = session_ops(lay, rows)
        status, old = status_value(len(rows)), sess["status"]
        now = "off" if old == "off" else "ok" if old == status else "fix"
        if signature(ops, status, now) == sess["sig"]:
            continue
        after = "off" if old == "off" else "ok"
        lines.append(write_line(sid, ops, status if now == "fix" else None,
                                signature(ops, status, after)))

    # The window options go first (the rows read them), each on its own line.
    head = []
    for wid, wanted in writes.items():
        have = state.options[wid]
        for opt, key, value in zip(("@tab_name", "@tab_group", "@tab_row_custom"),
                                   ("name", "group", "custom"), wanted):
            if have[key] != value:      # @tab_row_custom is 1 or unset, for the tap menu
                head.append(command("set-option", "-w", "-t", wid, opt, value)
                            if value or opt != "@tab_row_custom"
                            else command("set-option", "-u", "-w", "-t", wid, opt))
    script = head + lines
    if script:
        p = tmux("source-file", "-", stdin="\n".join(script) + "\n")
        if p.returncode != 0:           # e.g. a window closed mid-run; the next run retries
            log_error(err_log, f"source-file: {p.stderr.strip()}\n")


# --- nav: Shift+arrows ---------------------------------------------------------------------------

def parse_nav_rows(text: str) -> list | None:
    """@tab_bar_nav read back as [(status line, [(wid, x, w), ...]) per row, top to bottom], or
    None when it is missing or not exactly what nav_value writes: every id and integer is
    checked, and row numbers must rise."""
    if not text or len(text) > NAV_MAX:
        return None
    rows, last = [], -1
    for part in text.split("|"):
        if not NAV_ROW.match(part):
            return None
        r, tabs = part.split(";")
        if int(r) <= last:
            return None
        last = int(r)
        rows.append((last, [(wid, int(x), int(w)) for wid, x, w in
                            (tab.split(":") for tab in tabs.split(","))]))
    return rows


def parse_nav(text: str) -> list | None:
    """@tab_bar_nav as [[(wid, x, w), ...] per row, top to bottom], or None (parse_nav_rows)."""
    rows = parse_nav_rows(text)
    return None if rows is None else [tabs for _, tabs in rows]


def column_pick(row: list, x: int) -> str:
    """The tab of a drawn row whose span covers cell x, else the nearest (the left on a tie)."""
    def distance(tab: tuple) -> int:
        return max(tab[1] - x, x - (tab[1] + tab[2] - 1), 0)

    return min(row, key=distance)[0]


def nav_step(rows: list | None, current: str, direction: str) -> tuple | None:
    """Where a Shift+arrow goes from `current` (pure): ("select", wid), (command,) for tmux's
    previous-window or next-window when the bar has no place for the current window (no
    @tab_bar_nav, or the window is hidden in +N; left and right only), or None to stay (up
    and down there).
    Left and right step in reading order, past a row's end to the next row's first tab and from
    the last tab to the first. Up and down go to the next row up or down (wrapping between the
    top and bottom rows), to the tab whose span covers the current tab's first cell, else the
    nearest by column (the left one on a tie)."""
    where = next(((r, k) for r, row in enumerate(rows or []) for k, tab in enumerate(row)
                  if tab[0] == current), None)
    if where is None:
        fallback = {"left": "previous-window", "right": "next-window"}.get(direction)
        return (fallback,) if fallback else None
    r, k = where
    if direction in ("left", "right"):
        flat = [tab[0] for row in rows for tab in row]
        step = 1 if direction == "right" else -1
        target = flat[(flat.index(current) + step) % len(flat)]
    else:
        step = 1 if direction == "down" else -1
        target = column_pick(rows[(r + step) % len(rows)], rows[r][k][1])
    return None if target == current else ("select", target)


def nav(direction: str, client: str) -> None:
    """Select the window a Shift+arrow on `client` goes to: one tmux read, then at most one
    select-window (or previous-window/next-window) on that client's session."""
    if direction not in DIRECTIONS or not CLIENT.match(client):
        return
    found = [f for f in read(4, "list-clients", NAV_FMT) if f[0] == client]
    if len(found) != 1:
        return
    _, sid, wid, text = found[0]
    if not SID.match(sid) or not WID.match(wid):
        return
    step = nav_step(parse_nav(text), wid, direction)
    if step is None:
        return
    if step[0] == "select":
        tmux("select-window", "-t", f"{sid}:{step[1]}")
    else:
        tmux(step[0], "-t", sid)


# --- arrange: keys, drags and the Move menu -------------------------------------------------------

MOVES = DIRECTIONS + ("newrow", "auto")
NUM = re.compile(r"[0-9]{1,6}\Z")            # a mouse x or status line
DIGITS = re.compile(r"[0-9]{1,20}\Z")
SELF = '"$HOME/.local/bin/tmux-tab-bar"'     # as claude.conf runs it
# display-menu -y for a menu or popup: row 0 under a top bar, where tmux 3.7c can't draw a busy
# pane over its first rows (tmux/claude.conf explains), else centred.
OVERLAY_Y_CENTRE = "#{?#{==:#{status-position},top},0,#{popup_centre_y}}"
MENU = (("◀ Left", "h", "left"), ("▶ Right", "l", "right"), ("▲ Up", "k", "up"),
        ("▼ Down", "j", "down"), None, ("New row", "n", "newrow"),
        ("#{?@tab_row_custom,,-}Name row…", "N", "name-row"), ("Auto place", "a", "auto"))


def put(groups: list, shared: list, src: str, dst: str, after: bool) -> dict:
    """The one primitive (pure): src goes before dst (after: after it) in dst's row, and every
    member of that row gets a placement there, 0..n-1 ({wid: Place}). src's old row is left as
    it is (a gap is fine). Joining a custom row copies its `after` and name."""
    rows = rows_of(groups, shared)
    key = next((k for k, wids in rows.items() if dst in wids), None)
    if key is None or src == dst:
        return {}
    wids = [w for w in rows[key] if w != src]
    wids.insert(wids.index(dst) + after, src)
    group = next((g for g in groups if g.key == key), None)
    anchor, name = (group.after, group.name) if key.startswith("c:") else ("", "")
    return {w: Place(key, min(k, POS_MAX), anchor, name) for k, w in enumerate(wids)}


def row_key_of(groups: list, shared: list, wid: str) -> str | None:
    return next((k for k, wids in rows_of(groups, shared).items() if wid in wids), None)


def on_line(groups: list, shared: list, nav: list, src: str, dst: str, after: bool) -> bool:
    """put()'s `after` for a move aimed at dst's drawn line (nav: as parse_nav_rows gives it).
    put() closes src's gap, so when src is already in dst's logical row the tabs after src shift
    back one slot, and before dst (or after it) can land on the line above (or below) dst's. A
    reorder within a row keeps each drawn line's slot count, so the new order is mapped onto the
    row's drawn slots in reading order, and before and after flip when src would land off dst's
    line. Unchanged when src is in another row or some member isn't drawn (+N)."""
    row = rows_of(groups, shared).get(row_key_of(groups, shared, dst), [])
    slots = [(line, wid) for line, tabs in nav for wid, _, _ in tabs if wid in row]
    if src not in row or sorted(w for _, w in slots) != sorted(row):
        return after
    order = [w for w in row if w != src]
    order.insert(order.index(dst) + after, src)
    line_of = {wid: line for line, wid in slots}
    return after if slots[order.index(src)][0] == line_of[dst] else not after


def side_step(groups: list, shared: list, src: str, direction: str) -> dict:
    """Left or right: src before or after its neighbour in its own row (the logical row, across
    its overflow rows); nothing at either end."""
    row = rows_of(groups, shared).get(row_key_of(groups, shared, src), [])
    k = row.index(src) + (1 if direction == "right" else -1) if src in row else -1
    return put(groups, shared, src, row[k], direction == "right") if 0 <= k < len(row) else {}


def climb(rows: list, src: str, direction: str) -> str | None:
    """Up or down: the tab nav_step would pick in the drawn row above or below src's (rows: as
    parse_nav gives them), without wrapping: None at the top or bottom, or when src isn't drawn."""
    where = next(((r, k) for r, row in enumerate(rows) for k, tab in enumerate(row)
                  if tab[0] == src), None)
    if where is None:
        return None
    r, k = where
    r2 = r + (1 if direction == "down" else -1)
    return column_pick(rows[r2], rows[r][k][1]) if 0 <= r2 < len(rows) else None


def new_row(groups: list, shared: list, src: str, places: list) -> dict:
    """src alone in a new custom row below its own: `c:` 1 + the highest id any placement names
    (places: every window's). A tab already alone in its row (of any kind) stays. Made from a
    shared tab, the row sits just above the shared rows (group_windows: a custom row whose anchor
    is no group goes last among the groups)."""
    rows = rows_of(groups, shared)
    key = row_key_of(groups, shared, src)
    if key is None or rows[key] == [src]:
        return {}
    n = 1 + max((int(k[2:]) for p in places for k in (p.row, p.after) if k.startswith("c:")),
                default=0)
    return {src: Place(f"c:{n}", 0, key, "")} if n <= CUSTOM_MAX else {}


def rename_row(groups: list, src: str, name: str) -> dict:
    """Every member of src's custom row with the row's name set to `name` (cleaned); nothing
    when src isn't in a custom row."""
    group = next((g for g in groups if g.key.startswith("c:")
                  and src in (w for w, _ in g.tabs)), None)
    if group is None:
        return {}
    return {w: Place(group.key, min(k, POS_MAX), group.after, name)
            for k, (w, _) in enumerate(group.tabs)}


def drop_side(rows: list, dst: str, x: int, line: int) -> bool | None:
    """A drop on dst (rows: as parse_nav_rows gives them): after it (True) when x is in the right
    half of its slot, else before; None when the bar doesn't draw it."""
    for _, tabs in sorted(rows, key=lambda row: row[0] != line):    # the release's row first
        for wid, start, w in tabs:
            if wid == dst:
                return 2 * (x - start) >= w
    return None


def row_end(rows: list, x: int, line: int) -> tuple | None:
    """A drop on a row's gutter or empty tail: (its first tab, before) when x is left of that
    tab, else (its last tab, after); None for a line with no tabs."""
    tabs = next((tabs for r, tabs in rows if r == line), None)
    if not tabs:
        return None
    return (tabs[0][0], False) if x < tabs[0][1] else (tabs[-1][0], True)


@dataclasses.dataclass
class Context:
    state: State
    sid: str
    wid: str                    # the tab the command acts on
    nav: list                   # the session's drawn rows, as parse_nav_rows gives them
    server: tuple | None        # (socket, start time, pid), as the restore records name it


def context(client: str, wid: str | None) -> Context | None:
    """What a command from `client` about window `wid` (default: the client's current one)
    needs, or None when a word isn't valid or the window isn't in the client's session."""
    if not CLIENT.match(client) or (wid is not None and not WID.match(wid)):
        return None
    found = [f for f in read(7, "list-clients", MOVE_FMT) if f[0] == client]
    if len(found) != 1:
        return None
    _, sid, current, start, pid, nav, socket = found[0]
    wid = wid or current
    if not SID.match(sid) or not WID.match(wid):
        return None
    state = snapshot()
    if wid not in [w for _, w, _ in state.windows.get(sid, [])]:
        return None
    server = (socket, int(start), int(pid)) if DIGITS.match(start) and DIGITS.match(pid) else None
    return Context(state, sid, wid, parse_nav_rows(nav) or [], server)


def registry_dir() -> str:
    """hooks/session-registry.sh's record dir: $XDG_STATE_HOME/dotclaude/open-sessions."""
    home = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"),
                                                              ".local", "state")
    return os.path.join(home, "dotclaude", "open-sessions")


def update_record(path: str, server: tuple, places: dict) -> None:
    """Set or drop `place` in one restore record when it names this server and one of the
    panes in `places` (pane id -> @tab_place, None: unset). A read-modify-write through an
    fsynced temp file and os.replace, skipped when the file changed meanwhile (the registry
    rewrites or deletes it), so a record is never created or brought back. The compare and the
    replace hold the records' lock (RECORDS_LOCK, which hooks/session-registry.sh takes for its
    writes and deletes), so the registry can't delete or rewrite the file between them; a lock
    not had within LOCK_WAIT is gone without (fail-open)."""
    before = os.lstat(path)
    data = read_small(path, RECORD_MAX)
    if data is None:
        return
    try:
        entry = json.loads(data)
    except (ValueError, RecursionError):
        return
    if not isinstance(entry, dict) \
            or (entry.get("socket"), entry.get("server_start"), entry.get("server_pid")) != server:
        return
    pane = entry.get("pane")
    if not isinstance(pane, str) or pane not in places or entry.get("place") == places[pane]:
        return
    if places[pane] is None:
        del entry["place"]
    else:
        entry["place"] = places[pane]
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(entry, f)
            f.flush()
            os.fsync(f.fileno())
        lock = lock_within(os.path.join(os.path.dirname(path), RECORDS_LOCK), LOCK_WAIT)
        try:
            try:
                now = os.lstat(path)
            except FileNotFoundError:
                return                  # deleted meanwhile: never brought back
            if (now.st_ino, now.st_mtime_ns, now.st_size) \
                    == (before.st_ino, before.st_mtime_ns, before.st_size):
                os.replace(tmp, path)
        finally:
            if lock is not None:
                os.close(lock)
    finally:
        if os.path.lexists(tmp):
            os.unlink(tmp)


def update_records(server: tuple, places: dict) -> None:
    """update_record for every restore record; one it can't read or write is skipped."""
    for path in glob.glob(os.path.join(glob.escape(registry_dir()), "*.json")):
        try:
            update_record(path, server, places)
        except (OSError, ValueError):
            continue


def apply(ctx: Context, changes: dict, base: str) -> None:
    """Write each @tab_place that changes ({wid: Place, or None to unset}), lay out at once
    (under layout's lock, waiting up to LOCK_WAIT for a hook's run in flight, so the next
    queued move reads the bar this one drew), then copy the changes into the restore records of
    each changed window's panes."""
    lines, changed = [], {}
    for wid, place in changes.items():
        text = place_text(place) if place is not None else None
        if (place is not None and text is None) or (text or "") == ctx.state.options[wid]["place"]:
            continue
        lines.append(command("set-option", "-w", "-t", wid, "@tab_place", text) if text
                     else command("set-option", "-u", "-w", "-t", wid, "@tab_place"))
        changed[wid] = text
    if not lines:
        return
    tmux("source-file", "-", stdin="\n".join(lines) + "\n")
    try:
        run_locked(base, wait=LOCK_WAIT)
    finally:
        if ctx.server is not None:
            update_records(ctx.server, {pane: text for wid, text in changed.items()
                                        for pane in ctx.state.panes.get(wid, [])})


def show_menu(client: str, wid: str) -> None:
    """The Move menu on `client`, centred, without -O (a touch tap has no hover). Each item
    moves `wid` and opens the menu again, so the phone takes several steps without retapping;
    a tap outside closes it. Only a validated client name and window id go in its commands.
    display-menu holds its tmux client until the menu closes, so it runs detached: a run-shell
    waiting on it would hold the client's queue, and a timeout would kill it under the menu."""
    args = ["tmux", "-u", "display-menu", "-c", client, "-t", wid, "-x", "C",
            "-y", OVERLAY_Y_CENTRE,
            "-T", "#[align=centre]Move #{window_index}"]
    for item in MENU:
        if item is None:
            args.append("")
            continue
        label, key, how = item
        if how == "name-row":           # the tap menu's prompt, aimed at wid; no reopening
            shell = f"{SELF} name-row {client} {wid} >/dev/null 2>&1; true".replace('"', '\\"')
            args += [label, key, f'command-prompt -p "row name:" "set -w -t {wid} '
                                 f'@tab_row_name_in \\"%%%\\" ; run-shell \'{shell}\'"']
            continue
        shell = f"{SELF} move {how} {client} {wid} --menu >/dev/null 2>&1; true"
        args += [label, key, command("run-shell", shell)]
    subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def arrange_command(words: list, base: str) -> None:
    """One of move, drop, drop-row, name-row, menu and reset; a word count or a word that isn't
    what it should be does nothing. Moves run one at a time (a lock beside layout's), so two
    clients moving at once can't both rewrite a row from the same read."""
    cmd, args = words[0], words[1:]
    menu = cmd == "move" and args[-1:] == ["--menu"]
    args = args[:-1] if menu else args
    try:
        fd = os.open(base + ".move", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX)
    except OSError:
        fd = None                       # no lock to be had: still move
    try:
        if cmd == "move" and len(args) in (2, 3) and args[0] in MOVES:
            move(args[0], args[1], args[2] if len(args) == 3 else None, menu, base)
        elif cmd == "drop" and len(args) == 6:
            drop(*args, base=base)
        elif cmd == "drop-row" and len(args) == 4:
            drop_row(*args, base=base)
        elif cmd == "name-row" and len(args) in (1, 2):
            name_row(args[0], args[1] if len(args) == 2 else None, base)
        elif cmd == "menu" and len(args) in (1, 2):
            ctx = context(args[0], args[1] if len(args) == 2 else None)
            if ctx is not None:
                show_menu(args[0], ctx.wid)
        elif cmd == "reset" and len(args) == 1:
            ctx = context(args[0], None)
            if ctx is not None:
                apply(ctx, {w: None for _, w, _ in ctx.state.windows[ctx.sid]}, base)
    finally:
        if fd is not None:
            os.close(fd)


def move(how: str, client: str, wid: str | None, menu: bool, base: str) -> None:
    """Carry a tab: left, right, up, down, into a new row, or back to auto."""
    ctx = context(client, wid)
    if ctx is None:
        return
    groups, shared, _ = arrange(ctx.state, ctx.sid, {})
    if how in ("left", "right"):
        changes = side_step(groups, shared, ctx.wid, how)
    elif how in ("up", "down"):
        dst = climb([tabs for _, tabs in ctx.nav], ctx.wid, how)
        changes = put(groups, shared, ctx.wid, dst,
                      on_line(groups, shared, ctx.nav, ctx.wid, dst, False)) if dst else {}
    elif how == "newrow":
        places = [parse_place(o["place"]) for o in ctx.state.options.values()]
        changes = new_row(groups, shared, ctx.wid, [p for p in places if p is not None])
    else:
        changes = {ctx.wid: None}
    apply(ctx, changes, base)
    if menu:
        show_menu(client, ctx.wid)


def drop(src: str, dst: str, x: str, line: str, rng: str, client: str, base: str) -> None:
    """A tab pressed on src and released on dst's slot: before or after dst by which half of
    its slot the release is in. A release on +N or on src itself does nothing (claude.conf
    treats the latter as a tap)."""
    if rng == "more" or src == dst or not WID.match(src) or not NUM.match(x) \
            or not NUM.match(line):
        return
    ctx = context(client, dst)
    if ctx is None or src not in [w for _, w, _ in ctx.state.windows[ctx.sid]]:
        return
    after = drop_side(ctx.nav, dst, int(x), int(line))
    if after is not None:
        groups, shared, _ = arrange(ctx.state, ctx.sid, {})
        apply(ctx, put(groups, shared, src, dst, on_line(groups, shared, ctx.nav, src, dst, after)),
              base)


def drop_row(src: str, x: str, line: str, client: str, base: str) -> None:
    """A tab released on a row's gutter or empty tail: first or last of that drawn row."""
    if not NUM.match(x) or not NUM.match(line):
        return
    ctx = context(client, src)
    end = ctx and row_end(ctx.nav, int(x), int(line))
    if end:
        groups, shared, _ = arrange(ctx.state, ctx.sid, {})
        apply(ctx, put(groups, shared, src, end[0],
                       on_line(groups, shared, ctx.nav, src, end[0], end[1])), base)


def name_row(client: str, wid: str | None, base: str) -> None:
    """Name the tab's custom row from the window's @tab_row_name_in, which the Name row prompt
    set (the typed text never passes through a shell), then unset it."""
    ctx = context(client, wid)
    if ctx is None:
        return
    raw = next((f[1] for f in read(2, "list-windows", NAME_IN_FMT, "-a") if f[0] == ctx.wid),
               None)
    if raw is None:
        return
    tmux("set-option", "-u", "-w", "-t", ctx.wid, "@tab_row_name_in")
    groups, _, _ = arrange(ctx.state, ctx.sid, {})
    apply(ctx, rename_row(groups, ctx.wid, clean_row_name(raw)), base)


def log_error(path: str, text: str) -> None:
    """The end of text into the run dir's error log (never a symlink; owner-only)."""
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    except OSError:
        return
    with os.fdopen(fd, "w", errors="replace") as f:
        f.write(text[-ERR_MAX:])


def server_key(tmux_env: str) -> str:
    """A short hash of the socket path in $TMUX ("<socket>,<pid>,<session>"): one lock per
    tmux server, so a test server never waits on the live one."""
    return hashlib.sha256(tmux_env.rsplit(",", 2)[0].encode(errors="surrogateescape")
                          ).hexdigest()[:12]


def touch(path: str) -> None:
    try:
        os.close(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600))
    except OSError:
        pass


def flock_within(fd: int, wait: float) -> bool:
    """Take an exclusive flock on fd, trying again for up to `wait` seconds; False if still
    held then (wait 0: one try)."""
    deadline = time.monotonic() + wait
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return True
        except OSError:
            if time.monotonic() >= deadline:
                return False
            time.sleep(0.01)


def lock_within(path: str, wait: float) -> int | None:
    """An fd holding an exclusive flock on `path` (made owner-only, never through a link), or
    None when it can't be opened or isn't free within `wait` seconds: the caller goes ahead
    without it."""
    try:
        fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    except OSError:
        return None
    if flock_within(fd, wait):
        return fd
    os.close(fd)
    return None


def run_locked(base: str, run=None, wait: float = 0.0) -> None:
    """layout() under a lock (files `<base>.lock` and `<base>.dirty`). Hooks fire in bursts (a
    restore opens 8 windows): every run marks the state dirty before it tries the lock, and one
    that finds the lock held leaves; the holder lays out again while dirty reappears (PASSES
    times per hold), and after letting go it looks once more and takes the lock again if dirty.
    Marking first means a holder that lets go can't miss a run that failed to get the lock: the
    mark is already there when it looks. A pass that raises ends its hold, but the look after
    letting go still happens (the runs that left meanwhile are counting on it); the first error
    is raised at the end, for main's catch-all to log.
    A move passes `wait` (LOCK_WAIT): it waits that long for a hook's layout in flight instead
    of leaving, so it has laid out when it returns and the next queued move reads the bar it
    drew; still held after that, it lays out without the lock.
    `run` stands in for layout() in tests."""
    run = run or (lambda: layout(base + ".err"))
    lock, dirty = base + ".lock", base + ".dirty"
    failure = None
    for _ in range(2):
        touch(dirty)                    # before the lock: a holder letting go will see it
        try:
            fd = os.open(lock, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        except OSError:
            run()                       # no lock to be had: still lay out
            break
        try:
            if not flock_within(fd, wait):
                if wait:
                    run()               # a move: lay out now, without the lock
                break                   # a hook: the holder lays out again for this one
            for _ in range(PASSES):
                try:
                    os.unlink(dirty)
                except OSError:
                    pass
                try:
                    run()
                except Exception as e:  # raised below, after the look
                    failure = failure or e
                    break
                if not os.path.exists(dirty):
                    break
        finally:
            os.close(fd)
        if not os.path.exists(dirty):
            break
    if failure is not None:
        raise failure


def main(argv: list) -> int:
    """`layout`, `nav <direction> <client>`, or an arrange command (move, drop, drop-row,
    name-row, menu, reset); all but a bad `layout` exit 0, since keys and mice run them."""
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd not in ("nav", "move", "drop", "drop-row", "name-row", "menu", "reset") \
            and argv[1:] != ["layout"]:
        return 2
    tmux_env = os.environ.get("TMUX")
    if not tmux_env:
        return 0                        # outside tmux: nothing to lay out or select
    run_dir = os.environ.get("TMUX_CLAUDE_STATUS_DIR") or "/tmp"
    base = os.path.join(run_dir, f".tmux-tab-bar.{os.getuid()}.{server_key(tmux_env)}")
    try:
        if cmd == "layout":
            run_locked(base)
        elif cmd == "nav":
            if len(argv) == 4:
                nav(argv[2], argv[3])
        else:
            arrange_command(argv[1:], base)
    except Exception:                   # fail-open: the bar keeps what it had
        log_error(base + {"layout": ".err", "nav": ".nav.err"}.get(cmd, ".move.err"),
                  traceback.format_exc())
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception:                   # never a traceback on stderr (it is /dev/null anyway)
        sys.exit(0)
