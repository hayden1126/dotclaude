#!/usr/bin/python3 -I
"""paste-inbox: paste the newest image or file that reached this PC into a tmux pane (Alt+V).

  paste-inbox receive [--check] <device> <bytes> [<name64>]
      one image, or with <name64> one file of any type, of <bytes> bytes on stdin into the
      inbox; prints its path (--check: validate it, keep nothing)
  paste-inbox paste <pane> <client>
      the newest image or file of the last 10 minutes, as a bracketed paste of its path into
      the pane; else a message on the client

Why: under WSL, Claude Code's Ctrl+V and an empty paste read this PC's Windows clipboard
(powershell.exe through the tmux server's WSL interop), so a screenshot copied on another device
never arrives. Claude Code does attach an image whose path is pasted (bracketed, or a chunk over
800 characters; read from the 2.1.301 binary), so this pastes a path. Any other file's path
lands as text, which Claude reads with Read (settings.json allows that for the default inbox,
since a Read outside the project asks first).

`receive` is what a remote device runs over ssh on the Windows shell port, through
`wsl.exe -d Ubuntu --cd ~ --exec .local/bin/paste-inbox receive <device> <bytes> [<name64>]`
(laptop/ holds the Windows side). Without <name64> it keeps a PNG, JPEG, GIF or WebP, judged by
its first bytes, which also pick the extension, as `<UTC time>-<device>-<random>.<ext>`. With
<name64>, the copied file's name as base64url of its UTF-8 (padding optional; the one charset
that crosses the laptop's PowerShell, the PC's cmd.exe and wsl.exe untouched), it keeps any
file as `<UTC time>-<device>-<random>-<stem>[.<ext>]`: the stem is the name's last part with
anything but letters (any script), digits, `_` and `-` turned into `-`, cut to 96 UTF-8 bytes,
and the extension 1-10 ASCII letters or digits, lowercased. An image's first bytes still pick
its extension, and a file that isn't an image but whose kept name would end like one is
refused, since Claude Code would try to attach it. Either way the file must be exactly the size
given (so a cut upload, or a byte added on the way, is refused) and at most 50 MB. The inbox is
$PASTE_INBOX_DIR (default ~/.cache/claude-paste, mode 700, files 600); a file goes to a temp
file and is renamed. The device name is cut to [a-z0-9._-], so neither name can steer the path
or put a control character in the paste. Each receive first deletes the inbox's own files (that
name pattern and stale temp files) once older than a day for images, which Claude Code reads at
paste time, or 7 days for other files, which Claude reads when it decides to. Anything else is
refused on stderr, exit 1, and so is an upload that sends no bytes for 60 seconds (a link that
died leaves no FIN, and this would otherwise wait for TCP to give up; a slow link that keeps
moving is fine); --check prints the path it would use and keeps nothing (the laptop installer's
self-test).

`paste` takes a file the inbox received in the last 30 seconds (the laptop's Ctrl+V sends
Alt+V right after its upload; inbox times and that check both use WSL's clock), else the newest
non-empty file modified in the last 10 minutes, and no more than 10 minutes in the future
(Downloads times come from Windows' clock, which WSL2's can fall behind after a sleep): in the
inbox, its own files of any type and any image; in Windows Downloads, where Taildrop saves
(Tailscale 1.34 and later; mtime is the arrival time), images only, since browser downloads
land there too. An image is a .png, .jpg, .jpeg, .gif or .webp, any case; dotfiles never count.
So past those 30 seconds a Taildrop, or a browser download on this PC, beats an older upload.
The Downloads folder is
$PASTE_INBOX_DOWNLOADS (empty: none), else the path cached in
$XDG_STATE_HOME/dotclaude/paste-inbox/downloads while that folder exists, else Windows'
Downloads known folder from powershell.exe (printed as base64 of its UTF-8, since a console
prints a non-ASCII name in its own code page) through `wslpath -u`, cached once found
(powershell.exe from PATH only, so outside WSL the inbox alone counts). A pane in copy mode
leaves it first. The path goes in as bytes through `load-buffer -` into a buffer named for the
pane (two clients at once don't share one) and out through `paste-buffer -p -d`, quoted when it
holds a space. Silent, exit 0: Alt+V runs it (tmux/claude.conf), and a failing run-shell would
put the pane in view mode, so a crash goes to $XDG_STATE_HOME/dotclaude/paste-inbox/error.log
and a line on the client. Linked into ~/.local/bin by setup-tmux.sh;
tests/setup/test_paste_inbox.py holds the cases.
"""
import base64
import os
import re
import secrets
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import traceback

USAGE = __doc__.split("\n\n")[1]
CAP = 50 * 1024 * 1024
CHUNK = 1024 * 1024
FRESH = 10 * 60
SKEW = FRESH
STALL = 60
RECENT = 30
KEEP = 24 * 3600
KEEP_FILES = 7 * 24 * 3600
STEM_BYTES = 96
IMAGE_EXTS = (".png", ".jpg", ".jpeg", ".gif", ".webp")   # Claude Code's pasted-path pattern
MAGIC = ((b"\x89PNG\r\n\x1a\n", "png"), (b"\xff\xd8\xff", "jpg"), (b"GIF87a", "gif"),
         (b"GIF89a", "gif"))
NAME64 = re.compile(r"[A-Za-z0-9_-]{1,1024}={0,2}")
OWN = re.compile(r"^(\d{8}T\d{6}Z-[a-z0-9._-]+-[0-9a-f]{6}(-[\w-]+)?(\.[a-z0-9]{1,10})?"
                 r"|\.incoming-.*\.tmp)$")
DOWNLOADS_B64 = ("[Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("
                 "(New-Object -ComObject Shell.Application).NameSpace('shell:Downloads')"
                 ".Self.Path))")
NONE_FRESH = ("No image or file arrived in the last 10 minutes. Ctrl+V a screenshot or a copied "
              "file on a laptop with laptop/remote-paste, or Taildrop an image to this PC, then "
              "Alt+V.")


def inbox_dir() -> str:
    return os.environ.get("PASTE_INBOX_DIR") or os.path.expanduser("~/.cache/claude-paste")


def state_dir() -> str:
    state = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(state, "dotclaude", "paste-inbox")


def image_ext(data: bytes) -> str | None:
    """The extension the bytes' magic names, or None for anything Claude Code won't attach."""
    for magic, ext in MAGIC:
        if data.startswith(magic):
            return ext
    if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        return "webp"
    return None


def is_image(name: str) -> bool:
    return name.lower().endswith(IMAGE_EXTS)


def slug(device: str) -> str:
    return re.sub(r"[^a-z0-9._-]+", "-", device.lower()).strip("-.")[:32].strip("-.") or "device"


def file_name(name64: str) -> tuple[str, str] | None:
    """(stem, ext) kept from a copied file's name sent as base64url, ext "" for none; None
    when name64 isn't base64url of UTF-8. Only letters, digits, `_` and `-` stay in the stem,
    so the extension's is the one dot."""
    if not NAME64.fullmatch(name64):
        return None
    bare = name64.rstrip("=")
    try:
        name = base64.b64decode(bare.translate(str.maketrans("-_", "+/")) + "=" * (-len(bare) % 4),
                                validate=True).decode("utf-8")
    except ValueError:                     # binascii.Error and UnicodeDecodeError both are
        return None
    base = re.split(r"[/\\]", name)[-1].lstrip(".")
    stem, dot, ext = base.rpartition(".")
    if not dot or not re.fullmatch(r"[A-Za-z0-9]{1,10}", ext):
        stem, ext = base, ""
    stem = re.sub(r"[^\w-]+", "-", stem).encode()[:STEM_BYTES].decode("utf-8", "ignore")
    return stem.strip("-_") or "file", ext.lower()


def prune(inbox: str) -> None:
    """Delete the inbox's own files (OWN) once older than KEEP for an image or a temp file,
    KEEP_FILES for anything else; leave the rest."""
    now = time.time()
    for entry in os.scandir(inbox):
        keep = KEEP if entry.name.startswith(".") or is_image(entry.name) else KEEP_FILES
        try:
            if OWN.match(entry.name) and entry.is_file(follow_symlinks=False) \
                    and entry.stat(follow_symlinks=False).st_mtime < now - keep:
                os.unlink(entry.path)
        except OSError:
            pass


def stalled(signum, frame):
    raise TimeoutError


def read_upload() -> bytes:
    """stdin, up to CAP + 1 bytes; TimeoutError once STALL seconds pass with no bytes."""
    signal.signal(signal.SIGALRM, stalled)
    chunks, got = [], 0
    try:
        while got <= CAP:
            signal.alarm(STALL)
            chunk = sys.stdin.buffer.read1(min(CHUNK, CAP + 1 - got))
            if not chunk:
                break
            chunks.append(chunk)
            got += len(chunk)
    finally:
        signal.alarm(0)
    return b"".join(chunks)


def receive(device: str, size: int, check: bool, name64: str | None = None) -> int:
    named = None
    if name64 is not None:
        named = file_name(name64)
        if named is None:
            return refuse("bad file name (not base64url of UTF-8, or over 1024 characters)")
    if size > CAP:
        return refuse("over 50 MB")
    try:
        data = read_upload()
    except TimeoutError:
        return refuse(f"the upload stalled for {STALL} s")
    if not data:
        return refuse("nothing on stdin")
    if len(data) > CAP:
        return refuse("over 50 MB")
    if len(data) != size:
        return refuse(f"got {len(data)} bytes, expected {size} (the upload was cut or changed)")
    magic = image_ext(data)
    if magic is None and named is None:
        return refuse("not a PNG, JPEG, GIF or WebP image")
    stem = named[0] if named else ""
    ext = magic or named[1]
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    leaf = f"{stamp}-{slug(device)}-{secrets.token_hex(3)}" + (f"-{stem}" if stem else "") \
        + (f".{ext}" if ext else "")
    if magic is None and leaf.lower().endswith(IMAGE_EXTS):
        return refuse(f"named .{ext} but not a PNG, JPEG, GIF or WebP image")
    inbox = inbox_dir()
    os.makedirs(inbox, exist_ok=True)
    os.chmod(inbox, 0o700)
    final = os.path.join(inbox, leaf)
    if check:
        if not os.access(inbox, os.W_OK):
            return refuse(f"can't write {inbox}")
        print(final)
        return 0
    prune(inbox)
    fd, tmp = tempfile.mkstemp(prefix=".incoming-", suffix=".tmp", dir=inbox)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        os.replace(tmp, final)
    except BaseException:
        os.unlink(tmp)
        raise
    print(final)
    return 0


def refuse(why: str) -> int:
    print(f"paste-inbox: refused: {why}", file=sys.stderr)
    return 1


def downloads_dir() -> str | None:
    """Windows Downloads as a WSL path ($PASTE_INBOX_DOWNLOADS, the cache while that folder
    exists, else asked of Windows), or None. Failing to write the cache changes nothing."""
    if "PASTE_INBOX_DOWNLOADS" in os.environ:
        return os.environ["PASTE_INBOX_DOWNLOADS"] or None
    cache = os.path.join(state_dir(), "downloads")
    try:
        with open(cache) as f:
            cached = f.read().strip()
        if os.path.isdir(cached):
            return cached
    except OSError:
        pass
    found = windows_downloads()
    if found:
        try:
            os.makedirs(os.path.dirname(cache), exist_ok=True)
            with open(cache, "w") as f:
                f.write(found + "\n")
        except OSError:
            pass
    return found


def windows_downloads() -> str | None:
    ps = shutil.which("powershell.exe")
    if not ps:
        return None
    try:
        out = subprocess.run([ps, "-NoProfile", "-NonInteractive", "-Command", DOWNLOADS_B64],
                             capture_output=True, timeout=10).stdout
        win = base64.b64decode(out.strip(), validate=True).decode("utf-8")
        if not re.match(r"^[A-Za-z]:\\", win):
            return None
        path = subprocess.run(["wslpath", "-u", win], capture_output=True, text=True,
                              timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    return path if path and os.path.isdir(path) else None


def is_upload(name: str) -> bool:
    """An inbox file worth pasting: one receive kept (any type), or any image."""
    return bool(OWN.match(name)) or is_image(name)


def fresh(folder: str | None, now: float, wanted) -> list:
    """(mtime, path) of each non-empty file in folder whose name wanted() takes (never a
    dotfile), modified within FRESH seconds (SKEW at most ahead)."""
    if not folder:
        return []
    try:
        entries = list(os.scandir(folder))
    except OSError:
        return []
    found = []
    for entry in entries:
        if entry.name.startswith(".") or not wanted(entry.name):
            continue
        try:
            if not entry.is_file():
                continue
            st = entry.stat()
        except OSError:
            continue
        if st.st_size > 0 and now - FRESH <= st.st_mtime <= now + SKEW:
            found.append((st.st_mtime, entry.path))
    return found


def newest() -> str | None:
    """An inbox upload from the last RECENT seconds (the laptop's Ctrl+V sends Alt+V right
    after one), else the newest upload in the inbox or image in Downloads."""
    now = time.time()
    inbox = fresh(inbox_dir(), now, is_upload)
    recent = [item for item in inbox if item[0] >= now - RECENT]
    if recent:
        return max(recent)[1]
    found = inbox + fresh(downloads_dir(), now, is_image)
    return max(found)[1] if found else None


def tmux(*args: str, stdin: bytes | None = None) -> str:
    """One tmux command; its stdout, or "" when tmux fails or is missing."""
    try:
        out = subprocess.run(["tmux", *args], input=stdin, capture_output=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ""
    return out.decode("utf-8", "replace")


def paste(pane: str, client: str) -> int:
    path = newest()
    if path is None:
        tmux("display-message", "-c", client, "-d", "5000", NONE_FRESH)
        return 0
    if tmux("display-message", "-p", "-t", pane, "#{pane_in_mode}").strip() == "1":
        tmux("send-keys", "-X", "-t", pane, "cancel")
    text = f'"{path}"' if re.search(r"\s", path) else path
    buffer = "claude-paste-" + re.sub(r"[^0-9A-Za-z]", "", pane)
    tmux("load-buffer", "-b", buffer, "-", stdin=os.fsencode(text))
    tmux("paste-buffer", "-p", "-d", "-b", buffer, "-t", pane)
    return 0


def crashed(client: str) -> int:
    """paste's backstop: the traceback to error.log, one line on the client, exit 0."""
    log = os.path.join(state_dir(), "error.log")
    try:
        os.makedirs(os.path.dirname(log), exist_ok=True)
        with open(log, "a") as f:
            f.write(time.strftime("%Y-%m-%dT%H:%M:%S ") + traceback.format_exc())
    except OSError:
        pass
    tmux("display-message", "-c", client, "-d", "5000", f"paste-inbox failed; see {log}")
    return 0


def main(argv: list) -> int:
    args = argv[1:]
    if args[:1] in (["-h"], ["--help"]):
        print(USAGE)
        return 0
    if args[:1] == ["receive"]:
        check = args[1:2] == ["--check"]
        rest = args[2:] if check else args[1:]
        if len(rest) in (2, 3) and re.fullmatch(r"[1-9][0-9]{0,9}", rest[1]):
            return receive(rest[0], int(rest[1]), check, *rest[2:])
    if len(args) == 3 and args[0] == "paste":
        try:
            return paste(args[1], args[2])
        except Exception:
            return crashed(args[2])
    print("usage:\n" + USAGE, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
