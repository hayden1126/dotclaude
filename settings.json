{
  "theme": "dark",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "effortLevel": "medium",
  "autoCompactWindow": 600000,
  "skipAutoPermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "statusLine": {
    "type": "command",
    "command": "\"$HOME/.bun/bin/ccstatusline\""
  },
  "worktree": {
    "baseRef": "head"
  },
  "teammateMode": "in-process",
  "permissions": {
    "allow": [
      "Bash(delegation-ledger wait *)",
      "Bash(pass-respawn -C *)",
      "Bash(git push origin *)",
      "Bash(gh pr create *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr close *)",
      "Bash(gh pr reopen *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list*)",
      "Bash(gh pr status*)",
      "Bash(gh pr diff *)",
      "Bash(gh run list*)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(head)",
      "Bash(head *)",
      "Bash(tail)",
      "Bash(tail *)",
      "Bash(wc)",
      "Bash(wc *)",
      "Bash(grep *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push -*)",
      "Bash(git push origin -*)",
      "Bash(git push *main*)",
      "Bash(git push *HEAD*)",
      "Bash(git push *@*)",
      "Bash(git push *--all*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *+*)",
      "Bash(git -C * push)",
      "Bash(git -C * push *)",
      "Bash(gh pr merge*)",
      "Bash(gh api *merge*)",
      "Bash(git *--output*)",
      "Bash(tmux)",
      "Bash(tmux -*)",
      "Bash(tmux *;*)",
      "Bash(tmux *#(*)",
      "Bash(tmux display* -*I*)",
      "Bash(tmux a*)",
      "Bash(tmux b*)",
      "Bash(tmux ch*)",
      "Bash(tmux cl*)",
      "Bash(tmux co*)",
      "Bash(tmux cu*)",
      "Bash(tmux de*)",
      "Bash(tmux display-men*)",
      "Bash(tmux display-p*)",
      "Bash(tmux displayp*)",
      "Bash(tmux f*)",
      "Bash(tmux i*)",
      "Bash(tmux j*)",
      "Bash(tmux k*)",
      "Bash(tmux la*)",
      "Bash(tmux lin*)",
      "Bash(tmux lo*)",
      "Bash(tmux m*)",
      "Bash(tmux n*)",
      "Bash(tmux p*)",
      "Bash(tmux r*)",
      "Bash(tmux sa*)",
      "Bash(tmux se*)",
      "Bash(tmux so*)",
      "Bash(tmux sp*)",
      "Bash(tmux st*)",
      "Bash(tmux su*)",
      "Bash(tmux sw*)",
      "Bash(tmux u*)",
      "Bash(tmux w*)",
      "Bash(claude *dangerously-skip-permissions*)",
      "Bash(claude *--setting*)",
      "Bash(claude *--allowedTools*)",
      "Bash(claude *--allowed-tools*)",
      "Bash(claude *--add-dir*)",
      "Bash(claude *--agents*)",
      "Bash(claude *--mcp-config*)",
      "Bash(claude *--plugin-dir*)",
      "Bash(claude *--plugin-url*)",
      "Bash(claude *--bare*)",
      "Bash(claude *--safe-mode*)",
      "Bash(claude *--debug-file*)",
      "Bash(claude *--file*)",
      "Bash(claude *--chrome*)",
      "Bash(claude *--cloud*)",
      "Bash(claude *--environment*)",
      "Bash(claude *--remote-control*)",
      "Bash(claude *--teleport*)",
      "Bash(claude *bypassPermissions*)",
      "Bash(claude *acceptEdits*)",
      "Bash(claude plugin* configure *--values-stdin*)",
      "Bash(claude gateway*)",
      "Bash(claude import*)",
      "Bash(claude install*)",
      "Bash(claude purge*)",
      "Bash(claude respawn*)",
      "Bash(claude rm*)",
      "Bash(claude setup-token*)",
      "Bash(claude stop*)",
      "Bash(claude kill*)",
      "Bash(claude update*)",
      "Bash(claude upgrade*)",
      "Bash(claude auth login*)",
      "Bash(claude auth logout*)",
      "Bash(claude auto-mode reset*)",
      "Bash(claude mcp add*)",
      "Bash(claude mcp login*)",
      "Bash(claude mcp logout*)",
      "Bash(claude mcp remove*)",
      "Bash(claude mcp reset-project-choices*)",
      "Bash(claude mcp serve*)",
      "Bash(claude sandbox install*)",
      "Bash(claude plugin* disable*)",
      "Bash(claude plugin* enable*)",
      "Bash(claude plugin* init*)",
      "Bash(claude plugin* new*)",
      "Bash(claude plugin* install*)",
      "Bash(claude plugin* i *)",
      "Bash(claude plugin* marketplace*)",
      "Bash(claude plugin* prune*)",
      "Bash(claude plugin* autoremove*)",
      "Bash(claude plugin* tag*)",
      "Bash(claude plugin* uninstall*)",
      "Bash(claude plugin* remove*)",
      "Bash(claude plugin* update*)",
      "Bash(git push *--receive-pack*)",
      "Bash(git push *--exec*)",
      "Bash(git fetch *--upload-pack*)",
      "Bash(git pull *--upload-pack*)",
      "Bash(git ls-remote *--upload-pack*)",
      "Bash(git ls-remote -u*)",
      "Bash(git ls-remote * -u*)",
      "Bash(gh auth token*)",
      "Bash(gh auth status *-t*)",
      "Bash(gh auth login*)",
      "Bash(gh auth logout*)",
      "Bash(gh auth refresh*)",
      "Bash(gh auth setup-git*)",
      "Bash(gh auth switch*)",
      "Bash(gh alias set*)",
      "Bash(gh alias import*)",
      "Bash(gh config set*)",
      "Bash(gh extension install*)",
      "Bash(gh ext install*)",
      "Bash(gh extension upgrade*)",
      "Bash(gh ext upgrade*)",
      "Bash(lane init *--setup*)",
      "Bash(lane init *--root*)",
      "Bash(lane done *--abandon*)",
      "Bash(codex-delegate *--network*)",
      "Bash(powershell.exe)",
      "Bash(powershell.exe *)",
      "Bash(cmd.exe)",
      "Bash(cmd.exe *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * --force*)",
      "Bash(git -C * push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git -C * reset * --hard*)",
      "Bash(git reset --merge*)",
      "Bash(git reset * --merge*)",
      "Bash(git -C * reset --merge*)",
      "Bash(git -C * reset * --merge*)",
      "Bash(git clean -*f*)",
      "Bash(git -C * clean -*f*)",
      "Bash(bash -c *git push*--force*)",
      "Bash(bash -c *git reset*--hard*)",
      "Bash(claude *ultrareview*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
      "git push",
      "git push *",
      "git fetch",
      "git fetch *",
      "git pull",
      "git pull *",
      "git ls-remote *",
      "gh *",
      "codex-delegate *",
      "delegation-ledger *",
      "lane init",
      "lane init *",
      "lane new *",
      "lane adopt *",
      "lane ls",
      "lane ls *",
      "lane open *",
      "lane done *",
      "pass-respawn",
      "pass-respawn *",
      "tmux ls",
      "tmux ls *",
      "tmux list-sessions",
      "tmux list-sessions *",
      "tmux list-windows *",
      "tmux list-panes *",
      "tmux list-clients",
      "tmux list-clients *",
      "tmux list-keys",
      "tmux list-keys *",
      "tmux list-commands",
      "tmux capture-pane *",
      "tmux display *",
      "tmux show *",
      "tmux show-options *",
      "tmux show-environment *",
      "tmux show-messages",
      "tmux show-messages *",
      "tmux show-hooks *",
      "claude *",
      "codex login status",
      "codex doctor",
      "codex debug models",
      "codex features list",
      "codex mcp list",
      "codex plugin list",
      "powershell.exe *",
      "cmd.exe *"
    ],
    "filesystem": {
      "denyRead": [
        "~/.config/gh",
        "~/.ssh",
        "~/.netrc",
        "~/.aws",
        "~/.git-credentials",
        "~/.claude/.credentials.json",
        "~/.codex/auth.json",
        "~/.google_workspace_mcp",
        "~/.secrets.env",
        "~/.npmrc",
        "~/.docker/config.json",
        "~/.config/.wrangler",
        "~/.supabase",
        "~/.azure",
        "~/.claude.json",
        "~/.codex/config.toml",
        "~/.zsh_history",
        "~/.bash_history"
      ],
      "denyWrite": [
        "~/dotclaude/settings.json",
        "~/dotclaude/hooks",
        "~/dotclaude/skills",
        "~/dotclaude/agents",
        "~/dotclaude/CLAUDE.md",
        "~/dotclaude/statusline",
        "~/dotclaude/notify-toast.ps1",
        "~/dotclaude/codex",
        "~/dotclaude/setup.sh",
        "~/dotclaude/merge-settings.py",
        "~/dotclaude/setup-chrome-wsl.sh",
        "~/dotclaude/sync.sh",
        "~/dotclaude/chrome-debug.ps1",
        "~/dotclaude/git",
        "~/dotclaude/plugins",
        "~/dotclaude/tools.json",
        "~/dotclaude/tmux",
        "~/dotclaude/setup-tmux.sh",
        "~/dotclaude/bin",
        "~/dotclaude/tests",
        "~/.claude/settings.json",
        "~/.claude/hooks",
        "~/.claude/skills",
        "~/.claude/agents"
      ],
      "allowWrite": [
        "~/.cache/uv",
        "~/.cache/pip",
        "~/.cache/pnpm",
        "~/.cache/node-gyp",
        "~/.cache/ms-playwright",
        "~/.local/share/uv/python",
        "~/.local/share/pnpm/store",
        "~/.npm",
        "~/.bun/install/cache"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "relay.fullyjustified.net",
        "data1b.fullyjustified.net"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "i=$(cat); case \"$i\" in *'\"agent_id\"'*) printf '%s' \"$i\" | timeout 8 bash \"$HOME/.claude/hooks/subagent-policy.sh\" || { echo \"subagent-policy missing, failed or timed out: this delegated call is blocked\" >&2; exit 2; } ;; esac",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/agent-spawn-guard.sh\" || exit 2",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/report-check.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/overwrite-guard.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/lane-guard.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "i=$(cat); case \"$i\" in *'\"dangerouslyDisableSandbox\":true'*|*'\"dangerouslyDisableSandbox\": true'*) printf '%s' \"$i\" | bash \"$HOME/.claude/hooks/delete-guard.sh\" ;; esac",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-state.sh\" busy",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "i=$(cat); case \"$i\" in *'\"agent_id\"'*) printf '%s' \"$i\" | bash \"$HOME/.claude/hooks/delegation-ledger.sh\" ;; esac",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "i=$(cat); case \"$i\" in *'\"agent_id\"'*) ;; *) printf '%s' \"$i\" | bash \"$HOME/.claude/hooks/context-watch.sh\" ;; esac",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-state.sh\" busy",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/delegation-due.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-registry.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/pass-banner.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/lane-identity.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/memory-git.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-registry.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/lane-identity.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/delegation-ledger.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/delegation-ledger.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/report-check.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/handoff-reminder.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-title.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-state.sh\" busy",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/stop-ring.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-summary.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/watch-guard.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/context-watch.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/memory-git.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-state.sh\" idle",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/lane-identity.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/notify.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-state.sh\" wait",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "codex@openai-codex": true
  }
}
