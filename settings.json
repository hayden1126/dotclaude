      "Bash(git fetch *--upl*)",
      "Bash(git pull *--upl*)",
      "Bash(git ls-remote *--u*)",
      "Bash(git ls-remote *--exe*)",
      "Bash(git ls-remote -u*)",
      "Bash(git ls-remote * -u*)",
      "Bash(gh auth status *-t*)",
      "Bash(gh auth status *-at*)",
      "Bash(gh run download*)",
      "Bash(gh *--body-file*)",
      "Bash(gh *--input*)",
      "Bash(gh * -F*)",
      "Bash(gh *--field*)",
      "Bash(lane init *--setup*)",
      "Bash(lane init *--root*)",
      "Bash(lane done *--abandon*)",
      "Bash(codex-delegate *--network*)",
      "Bash(codex-delegate *--no-scope*)",
      "Bash(powershell.exe)",
      "Bash(powershell.exe *)",
      "Bash(cmd.exe)",
      "Bash(cmd.exe *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * --force*)",
      "Bash(git -C * push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git -C * reset * --hard*)",
      "Bash(git reset --merge*)",
      "Bash(git reset * --merge*)",
      "Bash(git -C * reset --merge*)",
      "Bash(git -C * reset * --merge*)",
      "Bash(git clean -*f*)",
      "Bash(git -C * clean -*f*)",
      "Bash(bash -c *git push*--force*)",
      "Bash(bash -c *git reset*--hard*)",
      "Bash(claude *ultrareview*)",
      "Edit(~/.local/bin/**)",
      "Edit(~/.bun/bin/**)",
      "Edit(~/.cargo/bin/**)",
      "Edit(~/.local/share/claude/**)",
      "Edit(~/.local/lib/node_modules/**)",
      "Edit(~/.config/cd4a/**)",
      "Edit(~/chrome/**)",
      "Edit(~/.cache/chrome-devtools-mcp/**)"
