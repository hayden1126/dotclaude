{
  "theme": "dark",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "effortLevel": "medium",
  "autoCompactWindow": 600000,
  "skipAutoPermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "statusLine": {
    "type": "command",
    "command": "\"$HOME/.bun/bin/ccstatusline\""
  },
  "worktree": {
    "baseRef": "head"
  },
  "teammateMode": "in-process",
  "permissions": {
    "allow": [
      "Bash(delegation-ledger wait *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git -C * push)",
      "Bash(git -C * push *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * --force*)",
      "Bash(git -C * push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git -C * reset * --hard*)",
      "Bash(git reset --merge*)",
      "Bash(git reset * --merge*)",
      "Bash(git -C * reset --merge*)",
      "Bash(git -C * reset * --merge*)",
      "Bash(git clean -*f*)",
      "Bash(git -C * clean -*f*)",
      "Bash(bash -c *git push*--force*)",
      "Bash(bash -c *git reset*--hard*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
      "git push",
      "git push *",
      "git fetch",
      "git fetch *",
      "git pull",
      "git pull *",
      "git ls-remote *",
      "gh *",
      "codex-delegate *",
      "delegation-ledger *",
      "codex *",
      "claude *",
      "tmux *",
      "powershell.exe *",
      "cmd.exe *"
    ],
    "filesystem": {
      "denyRead": [
        "~/.config/gh",
        "~/.ssh",
        "~/.netrc",
        "~/.aws",
        "~/.git-credentials",
        "~/.claude/.credentials.json",
        "~/.codex/auth.json",
        "~/.google_workspace_mcp",
        "~/.secrets.env",
        "~/.npmrc",
        "~/.docker/config.json",
        "~/.config/.wrangler",
        "~/.supabase",
        "~/.azure",
        "~/.claude.json",
        "~/.codex/config.toml",
        "~/.zsh_history",
        "~/.bash_history"
      ],
      "denyWrite": [
        "~/dotclaude/settings.json",
        "~/dotclaude/hooks",
        "~/dotclaude/skills",
        "~/dotclaude/agents",
        "~/dotclaude/CLAUDE.md",
        "~/dotclaude/statusline",
        "~/dotclaude/notify-toast.ps1",
        "~/dotclaude/codex",
        "~/dotclaude/setup.sh",
        "~/dotclaude/merge-settings.py",
        "~/dotclaude/setup-chrome-wsl.sh",
        "~/dotclaude/sync.sh",
        "~/dotclaude/chrome-debug.ps1",
        "~/dotclaude/git",
        "~/dotclaude/plugins",
        "~/dotclaude/tools.json",
        "~/dotclaude/tmux",
        "~/dotclaude/setup-tmux.sh",
        "~/.claude/settings.json",
        "~/.claude/hooks",
        "~/.claude/skills",
        "~/.claude/agents"
      ],
      "allowWrite": [
        "~/.cache/uv",
        "~/.cache/pip",
        "~/.cache/pnpm",
        "~/.cache/node-gyp",
        "~/.cache/ms-playwright",
        "~/.local/share/uv/python",
        "~/.local/share/pnpm/store",
        "~/.npm",
        "~/.bun/install/cache"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "i=$(cat); case \"$i\" in *'\"agent_id\"'*) printf '%s' \"$i\" | timeout 8 bash \"$HOME/.claude/hooks/subagent-policy.sh\" || { echo \"subagent-policy missing, failed or timed out: this delegated call is blocked\" >&2; exit 2; } ;; esac",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/agent-spawn-guard.sh\" || exit 2",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/report-check.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-state.sh\" busy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "i=$(cat); case \"$i\" in *'\"agent_id\"'*) printf '%s' \"$i\" | bash \"$HOME/.claude/hooks/delegation-ledger.sh\" ;; esac",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-state.sh\" busy"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/delegation-due.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/delegation-ledger.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/delegation-ledger.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/report-check.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/handoff-reminder.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-title.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-state.sh\" busy"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/stop-ring.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-summary.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/watch-guard.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-state.sh\" idle"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/notify.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-state.sh\" wait"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true
  }
}
