  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
      "git push",
      "git push origin",
      "git push origin *",
      "git push -*",
      "git fetch",
      "git fetch *",
      "git pull",
      "git pull *",
      "git ls-remote *",
      "gh pr *",
      "gh run *",
      "gh issue *",
      "gh api *",
      "gh search *",
      "gh repo view",
      "gh repo view *",
      "gh repo list",
      "gh repo list *",
      "gh auth status",
      "gh auth status *",
      "gh release list",
      "gh release list *",
      "gh release view",
      "gh release view *",
      "codex-delegate *",
      "delegation-ledger *",
      "lane init",
      "lane init *",
      "lane new *",
      "lane adopt *",
      "lane ls",
      "lane ls *",
      "lane open *",
      "lane done *",
      "lane park *",
      "lane addr *",
      "lane lead",
      "pass-respawn",
      "pass-respawn *",
      "ed-pull *",
      "tmux ls",
      "tmux ls *",
      "tmux list-sessions",
      "tmux list-sessions *",
      "tmux list-windows *",
      "tmux list-panes *",
      "tmux list-clients",
      "tmux list-clients *",
      "tmux list-keys",
      "tmux list-keys *",
      "tmux list-commands",
      "tmux capture-pane *",
      "tmux display *",
      "tmux show *",
      "tmux show-options *",
      "tmux show-environment *",
      "tmux show-messages",
      "tmux show-messages *",
      "tmux show-hooks *",
      "claude *",
      "codex login status",
      "codex doctor",
      "codex debug models",
      "codex features list",
      "codex mcp list",
      "codex plugin list",
      "powershell.exe *",
      "cmd.exe *"
    ],
    "filesystem": {
      "denyRead": [
        "~/.config/gh",
        "~/.ssh",
        "~/.netrc",
        "~/.aws",
        "~/.git-credentials",
        "~/.claude/.credentials.json",
        "~/.codex/auth.json",
        "~/.google_workspace_mcp",
        "~/.secrets.env",
        "~/.npmrc",
        "~/.docker/config.json",
        "~/.config/.wrangler",
        "~/.supabase",
        "~/.azure",
        "~/.claude.json",
        "~/.codex/config.toml",
        "~/.zsh_history",
        "~/.bash_history"
      ],
      "denyWrite": [
        "~/dotclaude/settings.json",
        "~/dotclaude/hooks",
        "~/dotclaude/skills",
        "~/dotclaude/agents",
        "~/dotclaude/CLAUDE.md",
        "~/dotclaude/statusline",
        "~/dotclaude/notify-toast.ps1",
        "~/dotclaude/codex",
        "~/dotclaude/setup.sh",
        "~/dotclaude/merge-settings.py",
        "~/dotclaude/install-state.py",
        "~/dotclaude/setup-chrome-wsl.sh",
        "~/dotclaude/sync.sh",
        "~/dotclaude/chrome-debug.ps1",
        "~/dotclaude/chrome-bg.ps1",
        "~/dotclaude/git",
        "~/dotclaude/plugins",
        "~/dotclaude/tools.json",
        "~/dotclaude/tmux",
        "~/dotclaude/setup-tmux.sh",
        "~/dotclaude/bin",
        "~/dotclaude/tests",
        "~/.claude/settings.json",
        "~/.claude/hooks",
        "~/.claude/skills",
        "~/.claude/agents"
      ],
      "allowWrite": [
        "~/.cache/claude-sandbox"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "releases.astral.sh",
        "nodejs.org",
        "cdn.playwright.dev",
        "playwright.download.prss.microsoft.com",
        "relay.fullyjustified.net",
        "data1b.fullyjustified.net"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "i=$(cat); case \"$i\" in *'\"agent_id\"'*) printf '%s' \"$i\" | timeout 8 bash \"$HOME/.claude/hooks/subagent-policy.sh\" || { echo \"subagent-policy missing, failed or timed out: this delegated call is blocked\" >&2; exit 2; } ;; esac",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/agent-spawn-guard.sh\" || exit 2",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/report-check.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/overwrite-guard.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/ask-check.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/practices-check.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/lane-guard.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "i=$(cat); case \"$i\" in *'\"dangerouslyDisableSandbox\":true'*|*'\"dangerouslyDisableSandbox\": true'*) printf '%s' \"$i\" | bash \"$HOME/.claude/hooks/delete-guard.sh\" ;; esac",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "i=$(cat); printf '%s' \"$i\" | timeout 4 bash \"$HOME/.claude/hooks/excluded-guard.sh\" || { printf '%s' \"$i\" | grep -Eq '\"command\": ?\"[[:space:]]*(git|gh|lane|claude|codex|codex-delegate|delegation-ledger|pass-respawn|ed-pull|tmux|powershell[.]exe|cmd[.]exe)[ \"]' && { echo \"excluded-guard missing, failed or timed out: this excluded command is blocked\" >&2; exit 2; }; exit 0; }",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-state.sh\" busy",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "i=$(cat); case \"$i\" in *'\"agent_id\"'*) printf '%s' \"$i\" | bash \"$HOME/.claude/hooks/delegation-ledger.sh\" ;; esac",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "i=$(cat); case \"$i\" in *'\"agent_id\"'*) ;; *) printf '%s' \"$i\" | bash \"$HOME/.claude/hooks/context-watch.sh\" ;; esac",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "i=$(cat); case \"$i\" in *'\"agent_id\"'*) ;; *) printf '%s' \"$i\" | bash \"$HOME/.claude/hooks/pass-notice.sh\" ;; esac",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-state.sh\" busy",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/delegation-due.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-registry.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/pass-banner.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/lane-identity.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/blank-display.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/sandbox-caches.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/context-watch.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-state.sh\" idle",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/excluded-check.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/practices-check.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/memory-git.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-registry.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/lane-identity.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/delegation-ledger.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/delegation-ledger.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/report-check.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-state.sh\" busy",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/handoff-reminder.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-title.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tmux-state.sh\" busy",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/pass-notice.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/stop-ring.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-summary.sh\"",
            "timeout": 10
