{
  "theme": "dark",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ANTHROPIC_MODEL": "opus"
  },
  "effortLevel": "medium",
  "autoCompactWindow": 600000,
  "skipAutoPermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "statusLine": {
    "type": "command",
    "command": "\"$HOME/.bun/bin/ccstatusline\""
  },
  "worktree": {
    "baseRef": "head"
  },
  "teammateMode": "in-process",
