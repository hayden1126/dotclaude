#!/usr/bin/env python3
"""handoff-check: is this checkout's handoff complete? Exits 1 and lists each gap if not.

Works in a lane (the record is <lane>/.lane/STATUS.md), in the main checkout of a lanes repo and
in a plain repo (the root STATUS.md). Checks:
  clean      the tree is clean, or each leftover's repo-relative path is named in the status file;
             agent worktrees (.claude/worktrees/) and sandbox /dev/null stubs never count
  fresh      the status file was written after HEAD's commit (or HEAD carries it) and after this
             session started: in a lane the latest lane.json sessions[].startedAt; elsewhere the
             session named by $CLAUDE_CODE_SESSION_ID, else the newest Claude session file whose
             cwd is this checkout; skipped with a warning when none is found, and a failure
             when a session file won't read as JSON and no readable one names this session
  A checkout outside main that matches no lane record while one is left out fails at once:
  the left-out record may be its own.
  comments   every `<!--` outside code is closed by a `-->` in its own section (split at `#`
             and `##` headings), and no `-->` stands outside code and comments
             (lanelib.comment_flaw): either flaw makes the comment's text read as the record's,
             which can hide a `Keep open:`
  next       a non-empty section under a `##` heading starting with "Next", or "Notes for next
             session", with a step in it besides any `Keep open:` line (a flag, not a step)
  approval   every `(approved by Hayden` marker in that section carries a valid ISO date
             (`(approved by Hayden YYYY-MM-DD)`), and one on its first item (the step /pass
             resumes with; a marker on a later item is ignored) is dated on or after this
             session's start date, local time, and not after today. With the session start
             unknown, a first-item marker fails: nothing confirms it is this session's. A
             same-day marker from an earlier session passes (its date can't tell). /pass reads
             it to pick its resume mode
  absolute   no relative identity ("another session", "this session"; the guard's lint) outside
             HTML comments and code. A failure in a lanes repo; in a plain repo, where no peer
             misreads it, only a warning
  claims     in a lane, every lane.json claim is named in the record
  pushed     in a lane, unpushed commits are noted in the record (a warning: pushes need Hayden)
The handoff skill runs it last; a handoff is not done until it passes.

--closing is the check `lane done` runs before it ends a lane's sessions. It keeps clean,
comments, next, absolute, claims and pushed, but fresh compares the status file against HEAD's commit only, not
against the session's start (after /pass, the idle new session started after the handoff), and
approval is skipped (no session resumes from that Next block). It adds:
  kept       a `Keep open: <why>` item in the Next block fails, even one inside a comment:
             the lane has more PRs to come (lanelib.kept_flag; `lane done` checks it too, live
             session or not). Skipped with
             --abandon, which `lane done --abandon` passes on: it closes a kept lane anyway.
             --abandon skips comments too, which `lane done` checks for the same reason
"""
import argparse
import datetime
import os
import re
import stat
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "lanes",
                                "scripts"))
import lanelib  # noqa: E402
from lanelib import git  # noqa: E402


def session_start(repo: lanelib.Repo, lane: dict | None) -> tuple[float | None, str]:
    """This session's start (epoch seconds) and where it came from. Untrusted when no readable
    session file holds $CLAUDE_CODE_SESSION_ID and one won't read (lanelib.session_scan, which
    rules out one named for a pid that is gone where pids are visible: this session's claude
    runs): it may be this session's, with a later start than the newest readable one here."""
    if lane is not None:
        starts = [t for s in lane.get("sessions", []) if (t := lanelib.parse_iso(s.get("startedAt")))]
        return (max(starts), "lane.json sessions[]") if starts else (None, "lane.json sessions[]")
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    files, unread = lanelib.session_scan()
    files = [s for s in files if isinstance(s.get("startedAt"), (int, float))]
    if sid:
        for s in files:
            if s.get("sessionId") == sid:
                return s["startedAt"] / 1000, f"session {sid}"
    if unread:
        held = f"session {sid}" if sid else "this session (CLAUDE_CODE_SESSION_ID is unset)"
        raise lanelib.Untrusted(f"session start unknown: {unread[0]} can't be read as a session "
                                f"file, and no readable one holds {held}")
    here = [s for s in files if os.path.realpath(s.get("cwd") or "/nonexistent") == repo.toplevel]
    if here:
        newest = max(here, key=lambda s: s["startedAt"])
        return newest["startedAt"] / 1000, f"newest session in {repo.toplevel}"
    return None, "no session found"


AGENT_WORKTREES = ".claude/worktrees/"


def sandbox_stub(path: str) -> bool:
    """A character device: the Bash sandbox's /dev/null mount over a protected path the repo
    lacks (.claude/hooks, .bashrc). Never work, and gone outside the sandbox."""
    try:
        return stat.S_ISCHR(os.stat(path).st_mode)
    except OSError:
        return False


def leftovers(repo: lanelib.Repo) -> list[str]:
    """Uncommitted paths, repo-relative, minus agent worktrees (each is its own checkout) and
    sandbox stubs.

    `lane done` runs this sandbox-off in the lane, so the status runs nothing the lane can
    configure. --ignore-submodules=dirty still reports a submodule whose commit moved, but never
    runs a status inside one, whose own config the lane can write (its clean filter would run).
    --no-optional-locks keeps the index unwritten, so no post-index-change hook fires; it sets
    GIT_OPTIONAL_LOCKS=0 and leaves the rest of the environment alone, since `done` passes
    GIT_COMMON_DIR down. core.fsmonitor=false: a relative fsmonitor command in the repo's config
    would resolve in the lane."""
    p = git(["--no-optional-locks", "-c", "core.fsmonitor=false", "status", "--porcelain",
             "--untracked-files=all", "--ignore-submodules=dirty"], repo.toplevel, check=True)
    out = []
    for line in p.stdout.splitlines():
        path = line[3:].split(" -> ")[-1].strip('"')
        if not path.startswith(AGENT_WORKTREES) and not sandbox_stub(
                os.path.join(repo.toplevel, path)):
            out.append(path)
    return out


def named(path: str, text: str) -> bool:
    """Whether the status text names a leftover by its repo-relative path (a dir with or without
    its trailing slash), as a whole path, not a substring of a longer one."""
    forms = {path, path.rstrip("/")}
    return any(re.search(r"(?<![\w./-])" + re.escape(f) + r"(?![\w-]|\.\w|/\w)", text)
               for f in forms)


def head_carries(repo: lanelib.Repo, path: str) -> bool:
    """Whether HEAD's commit changes the file (the handoff commit carried the status file)."""
    rel = os.path.relpath(path, repo.toplevel)
    if rel.startswith(".."):
        return False
    # fsmonitor off, as in leftovers: diff-tree queries it too.
    p = git(["-c", "core.fsmonitor=false", "diff-tree", "--root", "--no-commit-id", "--name-only",
             "-r", "HEAD"], repo.toplevel)
    return rel in p.stdout.splitlines()


def checked_out(repo: lanelib.Repo, lane: dict) -> tuple[str, str]:
    """(label, branch) the lane's checkout has checked out, branch '' for a detached HEAD:
    lane.json's branch goes stale once the lane runs `git switch` for a follow-up PR (the same
    read as `lane_head` in the lane CLI and `checked_out` in hooks/lane_identity.py). The admin
    dir is sandbox-writable, so a HEAD that can't be read, or names a branch valid_branch
    refuses, gives lane.json's branch."""
    fallback = f"branch {lane['branch']}", lane["branch"]
    try:
        p = git(["symbolic-ref", "-q", "HEAD"], repo.toplevel)
    except (OSError, ValueError, subprocess.SubprocessError):  # ValueError: not UTF-8
        return fallback
    if p.returncode == 1:
        return "detached HEAD", ""
    ref = p.stdout.strip()
    name = ref.removeprefix("refs/heads/")
    if p.returncode != 0 or name == ref or not lanelib.valid_branch(name):
        return fallback
    return f"branch {name}", name


def unpushed(repo: lanelib.Repo, lane: dict) -> tuple[str, int]:
    """(label, count): commits on what the lane has checked out (checked_out) that neither the
    base nor any of origin's refs hold. Not against one chosen ref: a pushed copy of the same
    name can be an old PR's head that fetch never pruned, and measured against it a branch
    reused with `lane new --reuse-branch` counts every base commit since that PR."""
    label, branch = checked_out(repo, lane)
    base = repo.config().get("base", "origin/main")
    base = base if base.startswith("refs/") else f"refs/remotes/{base}"
    tip = f"refs/heads/{branch}" if branch else "HEAD"
    p = git(["rev-list", "--count", "--not", "--remotes=origin", "--not", "--end-of-options",
             tip, f"^{base}"], repo.toplevel)
    return label, int(p.stdout.strip()) if p.returncode == 0 else 0


def check(cwd: str, closing: bool = False,
          abandon: bool = False) -> tuple[str, list[str], list[str]]:
    """(header, failures, warnings) for the checkout holding cwd; closing: --closing's checks;
    abandon: skip --closing's kept and comments checks."""
    repo = lanelib.resolve(cwd)
    if repo is None:
        return "handoff-check: not inside a git work tree", ["not a git work tree"], []
    try:
        kind, lane = repo.identity()
    except lanelib.Untrusted as e:  # a left-out record may be this checkout's
        return f"handoff-check: {repo.toplevel}", [str(e)], []
    status = lanelib.status_path(repo, lane)
    mode = " --closing" if closing else ""
    header = f"handoff-check{mode}: {lane['id'] if lane else kind} ({status})"
    fails, warns = [], []
    try:
        with open(status) as f:
            text = f.read()
    except OSError:
        return header, [f"no status file at {status}"], []

    dirty = [p for p in leftovers(repo) if not named(p, text)]
    if dirty:
        fails.append("uncommitted and not named in the status file: " + ", ".join(dirty))

    mtime = os.path.getmtime(status)
    head = git(["log", "-1", "--format=%ct"], repo.toplevel)
    if head.returncode == 0 and head.stdout.strip():
        if mtime < float(head.stdout.strip()) and not head_carries(repo, status):
            fails.append("the status file is older than HEAD's commit: update it after the last "
                         "commit (it should cite the commit range)")
    try:
        start, source = (None, "") if closing else session_start(repo, lane)
    except lanelib.Untrusted as e:
        start, source = None, ""
        fails.append(str(e))
    if start is None and not closing and source:
        warns.append(f"session start unknown ({source}): freshness against this session skipped")
    elif start is not None and mtime < start:
        fails.append(f"the status file was not written during this session ({source})")

    if not (closing and abandon) and (flaw := lanelib.comment_flaw(text)):
        fails.append(f"{flaw[1]} at line {flaw[0]}: fix the comment (quote a marker in "
                     "backticks). Until then the tools read the comment's text as the record's, "
                     "and can miss a `Keep open:`")

    block = lanelib.next_block(text)
    if not block:
        fails.append("no non-empty `## Next...` (or `## Notes for next session`) section")
    elif not closing and not lanelib.first_item(block):
        fails.append("the Next block has only a `Keep open:` line, which is a flag, not a step: "
                     "add the next step after it")
    elif closing and not abandon and (kept := lanelib.kept_flag(text)):
        fails.append(f"the Next block says {kept.splitlines()[0].strip()!r}: the lane stays open "
                     "for more PRs. Its session drops that line at its last merge (`lane done "
                     "--abandon` closes it anyway)")
    elif not closing:
        since = datetime.date.fromtimestamp(start) if start is not None else None
        state = lanelib.approval(block, since)
        if state == lanelib.MALFORMED:
            fails.append("malformed approval marker in the Next block: write `(approved by "
                         "Hayden YYYY-MM-DD)` with the date Hayden approved the step, or drop it")
        elif state == lanelib.STALE and since is None:
            fails.append("approval marker on the first Next item, but can't confirm this "
                         "session's start: remove the marker or run inside the session")
        elif state == lanelib.STALE and max(lanelib.approval_dates(block)) > datetime.date.today():
            fails.append("approval marker is dated in the future: write the date Hayden "
                         "approved the step")
        elif state == lanelib.STALE:
            fails.append("approval marker predates this session: remove it or get a fresh "
                         "approval")

    if found := lanelib.relative_phrases(lanelib.prose_only(text)):
        gap = f"relative identity: {', '.join(sorted(set(found)))}. {lanelib.RELATIVE_HINT}"
        (fails if repo.has_lanes else warns).append(gap)

    if lane:
        missing = [c for c in lane.get("claims", [])
                   if not re.search(re.escape(c) + r"(?![\w-])", text)]
        if missing:
            fails.append(f"claims not named in the record: {', '.join(missing)}")
        label, n = unpushed(repo, lane)
        if n and not re.search(r"unpushed|not pushed", text, re.I):
            warns.append(f"{label} has {n} unpushed commit(s): note it in the record (pushing "
                         "needs Hayden)")
    return header, fails, warns


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="handoff-check", description=__doc__.split("\n\n")[0])
    ap.add_argument("-C", dest="cwd", default=os.getcwd(), help="check this dir's checkout")
    ap.add_argument("--closing", action="store_true",
                    help="the check before `lane done` ends the lane's sessions: fresh against "
                         "HEAD's commit only, approval skipped, a `Keep open:` line fails")
    ap.add_argument("--abandon", action="store_true",
                    help="with --closing: skip the `Keep open:` check, as `lane done --abandon` "
                         "closes a kept lane anyway")
    args = ap.parse_args(argv)
    header, fails, warns = check(args.cwd, args.closing, args.abandon)
    print(header)
    for w in warns:
        print(f"  warn  {w}")
    for f in fails:
        print(f"  FAIL  {f}")
    print("  ok    handoff complete" if not fails else f"  {len(fails)} gap(s): fix and re-run")
    return 1 if fails else 0


if __name__ == "__main__":
    sys.exit(main())
