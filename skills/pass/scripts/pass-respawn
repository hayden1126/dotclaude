#!/usr/bin/python3 -I
"""pass-respawn: restart this Claude session fresh in its tmux pane once the turn ends, but only on
a passing handoff.

  pass-respawn -C DIR [--compact] [--print] [--foreground] [--timeout SECONDS]
  pass-respawn -C DIR --cancel
  pass-respawn -C DIR --tasks

/pass runs it last (skills/pass/SKILL.md; PLAN.md "PR 3: /pass" has the design and the spike
results it rests on). At call time it refuses unless $TMUX_PANE names a pane (exit 2, printing
the line to do by hand) and `handoff-check -C <dir>` passes (exit 1, echoing its gaps). It also
refuses (exit 1) when it can't find this session: the nearest `claude` ancestor process, whose
Claude Code session file ~/.claude/sessions/<pid>.json must name $CLAUDE_CODE_SESSION_ID, the
process's own start time (procStart, so a reused pid can't pass) and this pane. One pass may be
pending per session: the waiter holds an exclusive flock on
$XDG_STATE_HOME/dotclaude/pass-pending/<session>.lock for its whole life, with its pid and start
time written in it, and a second call while it is held refuses (exit 1). Then it detaches the
waiter (a double fork; a fork or setsid that fails exits 1 and logs `error`) and exits 0.
--cancel ends this session's pending waiter: SIGTERM to the pid in the lock, only once that pid
is a live pass-respawn with the start time written beside it; the waiter logs `cancelled` and
exits. With nothing pending it says so and exits 0. Once the waiter passes its final re-check
it is acting: it appends ` acting` to the lock's line and ignores SIGTERM, so the act (the
respawn and its carry marker, or the keys) runs to its end and logs its own outcome, noting the
late cancel. A drop settles the outcome too: SIGTERM after it is only noted. Last, before it
lets the lock go, the waiter appends ` done:<outcome>`. --cancel that finds ` acting` or another
outcome than `cancelled`, before signalling or once the lock frees, says `too-late` (naming the
outcome when there is one) and exits 1, logging no `cancelled`. A pid that no longer matches,
or one gone at the signal (ProcessLookupError), may be a waiter that just ended: --cancel reads
a freed lock's marks the same way, and with none says nothing was pending. --tasks prints
this session's tasks from its last stop record (each one's label, description and id, and
whether it blocks a plain pass) for /pass step 2, and changes nothing: no lock, log or notice.
It exits 1 with no plain $CLAUDE_CODE_SESSION_ID, else 0, a missing or unreadable record
included (an unreadable one says a plain pass would refuse).

The waiter polls that session file every 0.2 s until this session's own turn has ended: its
status is `idle` (or `shell`, at the prompt with a background shell running) with a
statusUpdatedAt later than the call (the file says `busy` for the whole turn, tool calls
included, and stays busy when a hook blocks the Stop), or it says `busy` and the transcript past
the call shows the turn ended. Claude Code (2.1.300) says `busy` at the prompt too while an
agent, a teammate or a workflow runs (isLoading || delegatedActive), so without the transcript
a pass with background agents never saw its turn end (two live compact passes timed out). The
transcript is read from its size at the call, after the session file each poll, incrementally:
the offset and a torn last line are kept, so no poll re-reads it. The session file changes
first: turn_duration's bytes can be read 0.1 to 0.4 s later (the spike's poller; the entries'
own timestamps put them 10 to 15 ms earlier, but that is not when they land), so a busy session
is at the prompt only once they land. Only main-chain entries count (a sidechain one is a
subagent's). An end
marker is a `system` turn_duration entry (at every real turn end, never at a Stop a hook
blocked) or a user entry whose text block starts `[Request interrupted by user` (Esc writes no
turn_duration). A start marker is a user entry with an origin kind (a typed prompt, a task
notice, an agent's message), a queue `dequeue`, or an assistant entry after an end marker
(failing closed). Everything else (tool results, hook feedback, titles, modes, attachments, api
requests) is bookkeeping. The passing turn's own end is the first end marker past the call; the
turn ended when no start marker follows it. A start marker after it means the session went on,
even when that later turn has ended too (a later end says nothing about the passing turn), and
drops `resumed` at once, while waiting too. `waiting` (an open dialog) and any unknown status
keep it waiting. It settles 1 s and re-reads both: a start marker after that end is `resumed`,
and so is a status no longer at the prompt (`waiting`, or an unknown one). The status at the
turn's end picks the rest of the rule, after the settle and a fresh read of the transcript (the
poll that saw `idle` or `shell` usually came before the end landed). At `idle` (no background
work) nothing flips the status but a turn, so the status must hold: any new statusUpdatedAt is
`resumed` (a queued prompt restarted the turn). At `shell` or `busy` the status alone is no
resumption, since delegated work or a background shell flips it among idle, shell and busy with
no turn (the spike saw `shell` to `busy`), so only the transcript decides. With no end marker
even after the settle (the transcript can't show it), the status must hold too, failing closed:
a flip by background work then drops a pass that could have gone. Once the end is known
the settle and the final re-check look twice, 0.5 s apart, whatever the status did: a new turn
sets the file busy about 150 ms before its user entry reaches the transcript, and one that
begins while an agent keeps the status busy changes no statusUpdatedAt at all. At `shell` or
`busy` they look again after each flip, up to 3 looks after the first, so a flipping status
gives a new turn's start marker its time too. That costs about 1 s a pass (3 s at most); a
turn that begins within about 150 ms of the last look can still be missed, as one after it
always can. It re-runs
handoff-check (a failure: work after the handoff made it stale, `stale`), drops `resumed` when
the transcript gained a typed prompt after the call, or a prompt queued mid-turn (a queue
enqueue, or a queued_command attachment from a person: Claude Code folds those into the running
turn with no user entry), since Hayden spoke and his words may cancel the pass. The transcript
is the stop record's transcript_path, else the session file's cwd slug; one it can't read drops
`resumed` too. Only then it reads the resume mode and builds the prompt. In plain mode it
requires the session's stop record (hooks/stop-ring.sh, $XDG_STATE_HOME/dotclaude/stops/
<session>.json) dated after the call with no waits and no task but `dream` or an `artifact
watch` (lanelib.plain_pass_ignores), since a respawn kills background work, in-process agents
and monitors included, which no process check can see (`busy`, also with no record). An
artifact watch is the Artifact tool's live watch, whose id the model never sees: the respawn
ends it, and the log line ends `; ignored: artifact watch <url> (<id>)`.
Right before acting it re-checks: the turn still over, by the
settle's rule (`resumed`), the process alive with the same procStart, the pane
still running that claude (pane_pid is the claude or its ancestor, pane_current_command is
`claude`), tmux answering for the pane and the pane not in copy mode (`#{pane_in_mode}` 0), and
Claude Code's input box present and empty (`busy` otherwise, each with its own cause and fix:
typing would join a draft and a respawn would discard it; the dim ghost suggestion is not a
draft). A pane tmux can't find, a missing session file,
a dead or replaced process, or a session file naming another session or pane drops `gone` at
once, while waiting too. Past --timeout (600 s; at most 3600) it gives up (`timeout`). Each drop
is logged, then told to the session (below), then shown, and touches nothing else. A refusal of
a pass Hayden expects (`stale`,
`busy`, `timeout`, `failed`, `error`, and `partial` below) is loud: one line naming the cause,
the tab and the fix (for `busy`, the stop record's tasks, the first two named with their
description and id and the rest counted: 'monitor "deploy events" (b0fzd27l4) running ... Stop
it (/tasks, or ask Claude to TaskStop it), or /pass compact keeps it'; pass.log names every one
whole) on the status line of every client attached to the pane's session,
held until a key press (`display-message -d 0 -c <client>`), plus the Windows toast notify.sh
sends (toast_command; best-effort). The drops Hayden caused keep the brief status-line
message (QUIET): `cancelled`, `resumed` and `gone` (his own /clear or exit). A quiet `resumed`
is a prompt or a new turn after the call (his prompt, which SKILL.md offers as a way to cancel,
a queued prompt, a task notice or an agent's message) or a status change after the turn, and
its line names which. A `resumed` for a transcript it couldn't read is loud: Hayden didn't
cause it, and every pass drops the same way until it can be read. Outcomes at
call time (`refused`, a detach `error`) and --cancel's (`too-late`, `none`) print to the
caller, which reads them before its reply, so they show nothing in tmux. Never respawn or
compact on a failing check: the respawn throws away the context that could fix the gap.
tmux never reaches the session itself, which went on saying a dropped pass was still queued, so
every drop the waiter makes, and `partial`, also leaves it a notice:
$XDG_STATE_HOME/dotclaude/pass-notice/<session>.json, {"v": 1, session_id, outcome, mode,
called, dropped (epoch secs), text}, written atomically and 0600 after the pass.log line and
before any tmux call (a dying tmux server can't delay or skip it), best-effort (a failed write
changes no outcome). hooks/pass-notice.sh claims it once and injects `text` into the session's
next turn. The text is the model's: the mode, the call's and the drop's UTC times, the cause,
that no pass is pending (so it stops saying one is queued), the fix and "Tell Hayden in one
line". The quiet drops say less: `resumed` names its reason (a typed or queued prompt, a new
turn in the transcript, a status change, or a transcript it couldn't read, whose fix is to tell
Hayden, since passing again drops the same way and an autopass would loop). `partial`, and a
`failed` compact whose resume prompt was lost after /compact and its Enter went out (send-keys
3 or 4: passing again would compact twice), hand over the resume prompt instead. The latter
stays `failed`, but its held tmux line and toast hand the prompt over too ("pass failed after
/compact was sent; type the resume prompt yourself: ..."), and its pass.log line ends with it,
as `partial`'s do. Once the prompt may already sit in the input box (the final Enter failed, or
tmux gave no answer, so the keys may have gone), typing it again would double it: the line says
"pass failed after the resume prompt was typed; press Enter (or type it if the box is empty):
...", and the notice says the prompt may sit unsent there. A tmux error with no text reads "no
error text". Its free-text detail is one line of at most 300
characters. The call, once it holds the pending lock, deletes the
session's old notice and prunes, once a day, notices older than 7 days and claimed ones
(*.taken) older than a day; the prune's stamp, pass-notice.pruned, sits beside the dir, which so
holds only notices. A call-time refusal or detach error prints to the caller and leaves none.
  plain    write the Star carry marker (tmux/claude-saved re-keys a starred chat to the new
           session on its `startup`) and the replies of the last 5 turns
           (pass-last/<pane number>.json: the stop record's `replies`, Hayden's prompt for
           each turn from the transcript's last 8 MiB, and the tab, for hooks/pass-banner.sh's
           banner and the Ctrl-b Up popup, tmux/pass-last; with no reply text, any older one
           for the pane goes),
           then `tmux respawn-pane -k -t <pane> -c <toplevel> -- <abs claude>
           [--permission-mode plan] <prompt>`; both files are removed again when the respawn
           fails (`failed`) or anything after writing them raises
  compact  type `/compact <focus>` and Enter, wait 1 s, type the prompt and Enter (it queues
           behind the compact, spike S4); no respawn and no carry. A send-keys that fails
           stops there and logs `failed` (past /compact, every report of it hands over the
           prompt).
           Before the prompt it re-checks the pane (tmux not answering, copy mode,
           a draft, no input box): on a problem the prompt is not typed but shown loud, as a
           drop is (the status line until a key press, and the toast), for Hayden to type,
           and written whole into pass.log, and the outcome is `partial` (/compact sent, not
           confirmed; no prompt)
The resume mode is plan mode unless the first item of the status file's Next block carries
`(approved by Hayden YYYY-MM-DD)` dated on or after the session's start and not after today
(lanelib.approval); then --permission-mode is left out and the user's default applies. An
unknown session start reads as unapproved. A same-day marker from an earlier session can't be
told apart by its date, so it counts. --print shows the mode and the
exact argv instead of acting; --foreground runs the waiter in-process (tests). Each decision
appends one line to $XDG_STATE_HOME/dotclaude/pass.log (an exception in the waiter: `error`).

Sandbox. It runs bare, so excludedCommands takes it out of the sandbox (it needs the tmux socket,
the session's processes and Claude Code's files). Code that runs sandbox-off never trusts what
the sandbox can write (docs/lanes.md S3). Every input, and why each is safe:
  - The status file (the lane record or the root STATUS.md) is sandbox-writable. It only picks
    plan versus default mode and is never run or interpolated. A forged approval marker gains
    the default mode, which still prompts by the user's rules.
  - lane.json is sandbox-writable. It only says whether this checkout is a lane (lanelib checks
    each field at load). Its path is never used: the status path in the prompt and the focus
    is computed, `.lane/STATUS.md` (from the checkout's top level) in a lane, else `STATUS.md`.
    The prompts are fixed text with that path and nothing read from a file.
  - The checkout (cwd, git state) comes from the call, which the permission gate shows, and is
    read through handoff-check and lanelib, which run git with fixed argv and full refs.
  - The interpreter is /usr/bin/python3 -I, named in the shebang, so no PATH lookup picks it,
    and handoff-check runs under the same `-I`. Isolated mode keeps PYTHONPATH, PYTHONHOME,
    PYTHONSTARTUP and the like (the call's environment) and the user site dir out, and puts
    neither the script's dir nor the cwd on sys.path; both scripts add lanelib's dir themselves.
  - This script (as invoked, which may be setup.sh's link, and its target), the handoff-check
    it runs and the lanelib it imports must sit outside the sandbox-writable dirs, as found
    and through their links; otherwise it refuses. Those dirs are the checkout, the main
    checkout, the session's launch dir (its session file's cwd), /tmp, $TMPDIR, and every
    settings file's sandbox.filesystem.allowWrite and permissions.additionalDirectories: the
    user's (~/.claude/settings.json), managed (/etc/claude-code/managed-settings.json and
    managed-settings.d/*.json) and the project's (.claude/settings.json and
    .claude/settings.local.json at the top level and at the launch dir). A
    sandbox.filesystem.denyWrite entry from the user or managed tier carves its path back
    out (the user tier denies ~/dotclaude/skills, where this script lives); the project
    tier's is ignored, as a project file could forge it. The session's own launch flags count
    too, read from its claude's command line (/proc/<pid>/cmdline, the kernel's): every
    --add-dir value and each --settings file's (or inline JSON's) allowWrite and
    additionalDirectories. A --settings file the sandbox can write refuses the pass, before
    git or tmux runs (against the early roots, and again once the checkout is known): it may
    have been edited since launch, so what it listed then can't be read back. A dir added at
    runtime with /add-dir lives only in Claude Code's memory, so it can't be seen and isn't
    counted: an accepted limit. So is the command line itself: the native install keeps
    claude's full argv there (seen live on Claude Code 2.1.296, a session launched with
    --settings), but an npm install may overwrite its process title, and then no session flag
    is seen. Code can't tell "launched with no flags" from "title overwritten". And the early
    --settings check, made before git runs, knows only the dirs that need no git: a --settings
    file in the main checkout of a lane session launched from the lane is caught only by the
    late check, after lanelib's git has run once.
  - PATH is the call's, so it keeps only the absolute entries outside those dirs (as given and
    resolved). git, tmux and claude resolve through that PATH and must also resolve, as found
    and through their links, outside them; otherwise it refuses. The sanitized PATH replaces
    the process's own (lanelib's git inherits it) and goes explicitly to every child:
    handoff-check, tmux, at the call and in the waiter. It is computed once before the
    checkout is known (with the call's dir standing in) and again after. tmux and claude run
    by absolute path, so the binary checked is the binary run. tmux's PATH lacks
    ~/.local/bin, so the respawned claude is named by absolute path too (spike S2).
  - The environment ($TMUX_PANE, $CLAUDE_CODE_SESSION_ID, $HOME, $XDG_STATE_HOME) is the Bash
    call's; TMUX_PANE must be `%<n>`, and the session id must match the session file.
  - The session file (~/.claude/sessions/<pid>.json) is Claude Code's, and the sandbox can't
    write ~/.claude/sessions. Only `idle` there (or `shell`: at the prompt with a background
    shell running), or `busy` with the transcript's turn end, lets the waiter act.
  - The transcript (~/.claude/projects/...) is Claude Code's too, also out of the sandbox's
    reach. It only decides: whether the turn ended (with the session file's `busy`) and
    whether a prompt came after the call (which drops a pass). Its entries are parsed as JSON
    and matched against fixed markers, never run or interpolated.
  - The stop record, the carry marker, the replies, the pending lock, the session's notice and
    pass.log live in the state dir, which sandboxed Bash can't write, so a session can't forge
    or plant a notice for the hook to inject. The session id names the stop record, the lock
    and the notice, so it must be a plain id ([A-Za-z0-9][A-Za-z0-9._-]*). The replies are
    copied as data, never run or interpolated. The notice's text is fixed text plus details
    made one line of at most 300 characters (handoff-check's gaps, which name checkout files,
    tmux's error text, an exception's text) and the stop record's tasks as the tmux notice
    names them; it is data for the model, never run.
  - The pane's capture (the input box) is tmux's; it can only drop a pass.
  - The toast (toast_command, resolved at the call against the same roots): powershell.exe and
    wslpath resolve through the sanitized PATH and are refused (no toast) when sandbox-writable,
    like tmux; notify-toast.ps1 is the config dir's, whose target the user tier's denyWrite
    covers (~/dotclaude/notify-toast.ps1), and is checked the same way. The message is fixed
    text plus tmux's window name and the stop record's tasks: ids and URLs bound by
    stop_ring's patterns, and labels (Claude Code's type names, or ours) and descriptions (the
    model's text), both made one plain line at write (stop_ring.clean: no control or format
    characters, `"` made `'`, at most 200 characters). It is passed as one argument to a fixed /bin/sh script, never interpolated
    (WSL hands an embedded `"` to Windows escaped); on the status line `%` and `#` are doubled
    (shown_literally), so tmux shows it rather than expanding strftime or a format. --tasks
    prints the same text to the caller and changes nothing.
  - tmux's answers come from the tmux server, and /proc (the session's claude, its ancestors
    and its start time) is the kernel's.
"""
import argparse
import contextlib
import dataclasses
import datetime
import fcntl
import glob
import json
import math
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import unicodedata

INVOKED = os.path.abspath(sys.argv[0] if __name__ == "__main__" else __file__)
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HERE, "..", "..", "lanes", "scripts"))
import lanelib  # noqa: E402

HANDOFF_CHECK = os.path.join(HERE, "..", "..", "handoff", "scripts", "handoff-check")
MANAGED_SETTINGS = "/etc/claude-code/managed-settings.json"
MANAGED_DIR = "/etc/claude-code/managed-settings.d"
POLL = 0.2         # secs between session file reads
SETTLE = 1.0       # secs idle must hold, so a queued prompt can restart the turn first
# Secs the settle and the final re-check wait, once the turn's end is known, for a new turn's
# start marker: Claude Code sets the session file busy about 150 ms before the turn's user entry
# reaches the transcript (lane pass-timeout's spike, 20:17:40), and a turn that begins while an
# agent keeps the status busy changes no statusUpdatedAt at all.
TRANSCRIPT_LAG = 0.5
LAG_ROUNDS = 3     # the most looks a status that keeps flipping gets (look_again)
# Session-file statuses that mean "at the prompt, turn over": `idle`, and `shell` when a
# background shell is still running (live, 2026-10-12; a foreground Bash call reads `busy`).
# `busy` counts too once the transcript shows the turn ended (turn_over): Claude Code 2.1.300
# says busy at the prompt while an agent, a teammate or a workflow runs. `waiting` (an open
# dialog) and anything unknown keep the waiter waiting.
AT_PROMPT = {"idle", "shell"}
# The interrupt's text: Esc ends a turn with this user entry and no turn_duration (spike).
INTERRUPTED = "[Request interrupted by user"
COMPACT_GAP = 1.0  # secs between typing /compact and the prompt (it queues, S4)
TIMEOUT = 600.0
MAX_TIMEOUT = 3600.0
PANE_RE = re.compile(r"%\d+")
SID_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}")
PANE_FORMAT = "#{pane_pid} #{pane_current_command}"
PROMPT_MARK = chr(0x276F)  # the input box's prompt mark, then a no-break space
PROMPT_LINE = re.compile(PROMPT_MARK + "[" + chr(0xA0) + " ]")
ESCAPE = re.compile(r"\x1b(?:\[[0-?]*[ -/]*[@-~]|\][^\x07\x1b]*(?:\x07|\x1b\\)?|[()*+][0-~]|[@-_])")
DROPS = {
    "stale": "pass dropped: the handoff is stale (work landed after it). Run the delta handoff, "
             "then /pass",
    "resumed": "pass dropped: the session went on (a typed or queued prompt). Finish that turn, "
               "then /pass if it still applies",
    "busy": "pass refused: background work was in flight at the stop. /pass compact keeps it, "
            "or wait for it and /pass",
    "gone": "pass dropped: the pane or its claude went away or changed (a /clear, an exit). "
            "/pass again from the live session",
    "timeout": "pass dropped: the turn never went idle before the timeout. /pass again",
    "failed": "pass failed: tmux could not respawn or type into the pane. See pass.log, then "
              "/pass again",
    "error": "pass failed: an error in the waiter. See pass.log, then /pass again",
    "cancelled": "pass cancelled",
}
# The drops Hayden caused, which keep the brief status-line message: a cancel, a prompt or a new
# turn after the call or a status change after the turn (`resumed`; SKILL.md documents typing a
# prompt as a way to cancel), and his own /clear or exit (`gone`). Every other drop is a refusal
# of a pass he expects, so it is loud (notify). One `resumed` is loud too (drop's loud): an
# unreadable transcript, which he didn't cause and which drops every pass the same way.
QUIET = {"cancelled", "resumed", "gone"}
# How a task label reads in a count ("3 monitors"); any other label reads as itself.
NOUNS = lanelib.TASK_NOUNS
# A busy notice names this many tasks, each description cut to this many characters, so it fits
# a status line; pass.log and --tasks keep LOG_CHARS (stop-ring.sh caps a description at 200).
SHOWN, SHOWN_CHARS, LOG_CHARS = 2, 40, 200
TOAST_PS1 = "notify-toast.ps1"  # in the config dir, as hooks/notify.sh finds it
PANE_FIXES = {  # pane_problem's causes, and what to do about each
    "pane in copy mode": "Leave copy mode (q), then /pass",
    "unsent draft in the input box": "Send or clear the draft, then /pass",
    "no input box": "Close the dialog or view, then /pass",
    "tmux didn't answer": "/pass again once the tab is back",
}


class Cancelled(Exception):
    """SIGTERM reached the waiter: `pass-respawn --cancel`."""


class Refuse(Exception):
    def __init__(self, code: int, message: str, reason: str):
        super().__init__(message)
        self.code, self.message, self.reason = code, message, reason


@dataclasses.dataclass
class Plan:
    mode: str  # plain | compact
    pane: str
    toplevel: str
    in_lane: bool
    status_rel: str        # computed, never read from a file
    tmux: str
    claude: str | None
    claude_pid: int
    proc_start: int
    session_id: str
    session: dict          # the session file at the call
    called: float          # epoch secs at the start of the call
    transcript: str | None
    transcript_size: int | None  # None: unreadable at the call
    timeout: float
    path: str = ""         # the sanitized PATH every child gets
    toast: list[str] | None = None  # the toast's argv less its message (toast_command)
    lock_fd: int | None = None  # the pending lock the waiter holds (None: not taken)
    acting: bool = False   # past the final re-check: SIGTERM no longer cancels
    late_cancel: bool = False  # a SIGTERM came while acting, and was ignored
    settled: bool = False  # the outcome is decided (a drop, or the end): SIGTERM is only noted
    # The transcript past the call (scan_turns): the next byte to read (None: unreadable at
    # the call), the line the last read cut short, and the turn markers read, numbered in order.
    read_at: int | None = None
    torn: bytes = b""
    marks: int = 0
    first_end: int | None = None   # the first end marker's number: the passing turn's own end
    turn_start: int | None = None  # the last start marker's number

    def __post_init__(self):
        if self.read_at is None:
            self.read_at = self.transcript_size

    @property
    def status_file(self) -> str:
        return os.path.join(self.toplevel, self.status_rel)

    def actions(self, approved: bool) -> list[list[str]]:
        prompt = resume_prompt(self.status_rel, self.in_lane, approved, self.mode == "compact")
        if self.mode == "plain":
            perm = [] if approved else ["--permission-mode", "plan"]
            return [[self.tmux, "respawn-pane", "-k", "-t", self.pane, "-c", self.toplevel, "--",
                     self.claude, *perm, prompt]]
        keys = [self.tmux, "send-keys", "-t", self.pane]
        return [[*keys, "-l", f"/compact {compact_focus(self.status_rel)}"], [*keys, "Enter"],
                [*keys, "-l", prompt], [*keys, "Enter"]]


# ---- processes ----

def proc_table(proc: str = "/proc") -> dict[int, tuple[str, int]]:
    """{pid: (comm, ppid)} for every process /proc shows."""
    out = {}
    for name in os.listdir(proc):
        if not name.isdigit():
            continue
        try:
            with open(os.path.join(proc, name, "stat")) as f:
                stat = f.read()
        except OSError:
            continue
        left, right = stat.find("("), stat.rfind(")")  # comm may hold spaces and parens
        fields = stat[right + 1:].split() if 0 <= left < right else []
        if len(fields) >= 2 and fields[1].isdigit():
            out[int(name)] = (stat[left + 1:right], int(fields[1]))
    return out


def proc_start(pid: int, proc: str = "/proc") -> int | None:
    """pid's start time (stat field 22, clock ticks since boot), the procStart Claude Code's
    session file records; None when the process is gone or a zombie."""
    try:
        with open(os.path.join(proc, str(int(pid)), "stat")) as f:
            fields = f.read().rsplit(")", 1)[1].split()
        return None if fields[0] in ("Z", "X") else int(fields[19])
    except (OSError, ValueError, IndexError, TypeError):
        return None


def proc_cmdline(pid: int, proc: str = "/proc") -> list[str] | None:
    """pid's argv (/proc/<pid>/cmdline, NUL-separated), or None when it can't be read."""
    try:
        with open(os.path.join(proc, str(int(pid)), "cmdline"), "rb") as f:
            data = f.read()
    except (OSError, ValueError, TypeError):
        return None
    args = data.split(b"\0")
    if args and args[-1] == b"":
        args.pop()  # the terminating NUL
    return [a.decode("utf-8", "surrogateescape") for a in args]


def ancestry(table: dict, pid: int | None) -> list[int]:
    """pid and its parents, as far as the table goes (a cycle stops it)."""
    chain = []
    while pid in table and pid not in chain:
        chain.append(pid)
        pid = table[pid][1]
    return chain


def session_claude(table: dict, me: int) -> int | None:
    """The nearest ancestor of me whose comm is `claude`: the session that ran this call."""
    return next((p for p in ancestry(table, me)[1:] if table[p][0] == "claude"), None)


# ---- Claude Code's files ----

def config_dir() -> str:
    return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")


def load_session(pid: int) -> dict | None:
    """Claude Code's session file for pid (lanelib.sessions_dir()/<pid>.json), or None."""
    try:
        with open(os.path.join(lanelib.sessions_dir(), f"{int(pid)}.json")) as f:
            data = json.load(f)
    except (OSError, ValueError, TypeError, RecursionError):   # json recurses on nesting
        return None
    return data if isinstance(data, dict) else None


def session_problem(session: dict | None, sid: str, pid: int, start: int | None,
                    pane: str) -> str | None:
    """Why the session file isn't this session's, live in this pane, or None. start is the
    procStart the call saw (None at the call itself: /proc's must match the file's)."""
    if session is None:
        return f"no session file for claude {pid}"
    if session.get("sessionId") != sid:
        return f"the session file's session id is {session.get('sessionId')!r}, not {sid}"
    if session.get("pid") != pid:
        return f"the session file names pid {session.get('pid')!r}, not {pid}"
    live = proc_start(pid)
    if live is None:
        return f"claude {pid} has ended"
    if str(session.get("procStart")) != str(live) or (start is not None and live != start):
        return f"claude {pid}'s procStart is {live}, not the session file's or the call's"
    m = re.search(r"(%\d+)$", str(session.get("tmux") or ""))
    if not m or m.group(1) != pane:
        return f"the session file names pane {session.get('tmux')!r}, not {pane}"
    return None


def stop_path(sid: str) -> str:
    """Where hooks/stop-ring.sh writes the session's stop record."""
    return os.path.join(lanelib.state_dir(), "stops", f"{sid}.json")


def stop_record(sid: str) -> dict | None:
    """The session's stop record (hooks/stop-ring.sh), or None: missing, unreadable or not an
    object."""
    try:
        with open(stop_path(sid), encoding="utf-8") as f:
            rec = json.load(f)
    except (OSError, ValueError, RecursionError):   # json recurses on nesting
        return None
    return rec if isinstance(rec, dict) else None


def transcript_path(session: dict, sid: str, record: dict | None = None) -> str | None:
    """The session's transcript: the stop record's transcript_path (the Stop payload's), else
    the session file's, else <config>/projects/<cwd with each non-alphanumeric as '-'>/<sid>.jsonl."""
    for given in ((record or {}).get("transcript_path"), session.get("transcript_path")):
        if isinstance(given, str) and given:
            return given
    cwd = session.get("cwd")
    if not isinstance(cwd, str) or not cwd:
        return None
    return os.path.join(config_dir(), "projects", re.sub(r"[^A-Za-z0-9]", "-", cwd),
                        f"{sid}.jsonl")


def typed_prompt(entry) -> bool:
    """A transcript entry that is a prompt the person typed: a user entry whose origin kind is
    human, not a tool result."""
    if not isinstance(entry, dict) or entry.get("type") != "user":
        return False
    origin = entry.get("origin")
    if not isinstance(origin, dict) or origin.get("kind") != "human":
        return False
    message = entry.get("message")
    content = message.get("content") if isinstance(message, dict) else None
    return not (isinstance(content, list) and any(
        isinstance(c, dict) and c.get("type") == "tool_result" for c in content))


def queued_prompt(entry) -> bool:
    """A transcript entry for a prompt queued mid-turn, which Claude Code folds into the running
    turn without a user entry: a queue enqueue (any, so a queued notice also counts and the pass
    drops, failing closed), or a queued_command attachment whose origin kind is human. An
    attachment entry with no attachment object is skipped."""
    if not isinstance(entry, dict):
        return False
    if entry.get("type") == "queue-operation":
        return entry.get("operation") == "enqueue"
    att = entry.get("attachment")
    if entry.get("type") != "attachment" or not isinstance(att, dict):
        return False
    origin = att.get("origin")
    return (att.get("type") == "queued_command" and isinstance(origin, dict)
            and origin.get("kind") == "human")


def typed_since(path: str | None, offset: int | None) -> bool | None:
    """Whether the transcript gained a typed or queued prompt past byte offset; None when it
    can't be read (or couldn't at the call, offset None)."""
    if offset is None:
        return None
    try:
        with open(path, "rb") as f:
            f.seek(offset)
            data = f.read()
    except (OSError, TypeError):
        return None
    for line in data.split(b"\n"):
        try:
            entry = json.loads(line)
        except (ValueError, RecursionError):   # json recurses on nesting
            continue
        if typed_prompt(entry) or queued_prompt(entry):
            return True
    return False


def turn_marker(entry, ended: bool) -> str | None:
    """`end`, `start` or None for a transcript entry (Claude Code 2.1.300, lane pass-timeout's
    spike). An end is a `system` turn_duration entry (every real turn end, never a Stop a hook
    blocked) or a user entry whose text block starts with the interrupt's text (Esc writes no
    turn_duration). A start is a user entry with an origin kind (a typed prompt, a task notice,
    an agent's message), a queue dequeue, or an assistant entry once a turn has ended (ended;
    failing closed). Everything else is bookkeeping (tool results, hook feedback, titles,
    modes, attachments, api requests), so a new turn is this allowlist, never "anything
    newer". A sidechain entry is a subagent's, never this session's turn."""
    if not isinstance(entry, dict) or entry.get("isSidechain"):
        return None
    kind = entry.get("type")
    if kind == "system":
        return "end" if entry.get("subtype") == "turn_duration" else None
    if kind == "queue-operation":
        return "start" if entry.get("operation") == "dequeue" else None
    if kind == "assistant":
        return "start" if ended else None
    if kind != "user":
        return None
    origin = entry.get("origin")
    if isinstance(origin, dict) and isinstance(origin.get("kind"), str):
        return "start"
    message = entry.get("message")
    content = message.get("content") if isinstance(message, dict) else None
    if isinstance(content, list) and any(
            isinstance(c, dict) and c.get("type") == "text" and isinstance(c.get("text"), str)
            and c["text"].startswith(INTERRUPTED) for c in content):
        return "end"
    return None


def scan_turns(plan: Plan) -> None:
    """Read the transcript's bytes past plan.read_at (its size at the call, then wherever the
    last read stopped), so a 0.2 s poll never re-reads it, and number the turn markers in them
    (turn_marker) on the plan: first_end, set once (the passing turn's own end; a later end is a
    later turn's), and turn_start, the latest start. A line the read cut short waits in
    plan.torn for its rest. An unreadable transcript (now, or at the call) changes nothing."""
    if plan.read_at is None:
        return
    try:
        with open(plan.transcript, "rb") as f:
            f.seek(plan.read_at)
            data = f.read()
    except (OSError, TypeError, ValueError):
        return
    plan.read_at += len(data)
    *lines, plan.torn = (plan.torn + data).split(b"\n")
    for line in lines:
        try:
            entry = json.loads(line)
        except (ValueError, RecursionError):   # json recurses on nesting
            continue
        mark = turn_marker(entry, plan.first_end is not None)
        if mark is not None:
            plan.marks += 1
            if mark == "start":
                plan.turn_start = plan.marks
            elif plan.first_end is None:
                plan.first_end = plan.marks


def began_after_end(plan: Plan) -> bool:
    """Whether a start marker came after the passing turn's own end (the first end marker past
    the call): the session went on. A whole later turn, its start and its own end, still counts:
    the latest end having no start after it says nothing about the passing turn."""
    return plan.first_end is not None and (plan.turn_start or 0) > plan.first_end


def turn_over(plan: Plan) -> bool:
    """Whether the transcript past the call shows the passing turn ended, and nothing since."""
    return plan.first_end is not None and not began_after_end(plan)


NEW_TURN = "a new turn started after the call (a prompt, a task notice or an agent's message)"
# A `resumed` drop's brief status-line message (QUIET) for each reason but a typed or queued
# prompt, which keeps DROPS["resumed"].
TURN_SHOWN = "pass dropped: a new turn started after the call. /pass again if it still applies"
STATUS_SHOWN = ("pass dropped: the session's status changed after its turn. /pass again if it "
                "still applies")


def status_cause(status: str) -> str:
    """The notice's cause for a resumption the session file showed."""
    if status in ("idle", "shell", "busy"):
        return (f"the session's status changed after its turn ended (now {status}), so a new "
                "turn can't be ruled out")
    return (f"the session's status became {clipped(status)} (a dialog, or a change the waiter "
            "can't read)")


def went_on(plan: Plan, state: str, detail: str, session: dict, seen, strict: bool
            ) -> tuple[str, str, str] | None:
    """Why the session went on since the waiter saw its turn end, as (pass.log's detail, the
    notice's cause, the status-line message), or None. A start marker after the passing turn's
    end always counts, and so does a status no longer at the prompt (`waiting`, or an unknown
    one). strict also counts any change of statusUpdatedAt since seen: the status at the turn's
    end was `idle`, where nothing flips it but a turn, or no end marker was seen even after the
    settle (failing closed). Otherwise (`shell` or `busy` at the end) the status alone doesn't
    count: delegated
    work or a background shell flips it among idle, shell and busy with no turn (the spike saw
    shell to busy), and look_again has given a new turn TRANSCRIPT_LAG to show its start
    marker."""
    if began_after_end(plan):
        return "a new turn in the transcript", NEW_TURN, TURN_SHOWN
    if state != "idle" or (strict and session.get("statusUpdatedAt") != seen):
        return f"status {detail}", status_cause(detail), STATUS_SHOWN
    return None


def counted(labels: list[str]) -> str:
    """Labels as counts in first-seen order: monitor, monitor, shell -> "2 monitors, 1 shell"."""
    counts: dict[str, int] = {}
    for label in labels:
        counts[label] = counts.get(label, 0) + 1
    return ", ".join(f"{n} {NOUNS.get(label, label)}{'' if n == 1 else 's'}"
                     for label, n in counts.items())


def described_by_record(entry: dict) -> bool:
    """Whether the record says more of a task than its label: an id, a description or a page."""
    return bool(entry.get("id") or entry.get("description") or entry.get("url"))


def task_line(entries: list[dict], limit: int = SHOWN) -> str:
    """Tasks for a notice that fits a status line: the first `limit` that the record describes
    (described_by_record) described, the rest counted ("+2 more (1 monitor, 1 shell)"; with
    none described, only the count, as a record of bare labels reads)."""
    shown = [e for e in entries if described_by_record(e)][:limit]
    rest = [e["label"] for e in entries if not any(e is s for s in shown)]
    if not shown:
        return counted(rest)
    head = ", ".join(lanelib.describe_task(e, SHOWN_CHARS) for e in shown)
    return head + (f", +{len(rest)} more ({counted(rest)})" if rest else "")


def logged(entries: list[dict]) -> str:
    """Tasks for pass.log: every one described whole (LOG_CHARS), with its id."""
    return ", ".join(lanelib.describe_task(e, LOG_CHARS) for e in entries)


def ignored(rec: dict | None) -> str:
    """'; ignored: artifact watch <url> (<id>), ...' for the stop record's tasks a plain pass
    lets the respawn end (lanelib.plain_pass_ignores, but memory upkeep), or ''. The respawn ends
    a watch on a page Hayden may still comment on; the log keeps the page to watch again."""
    entries = lanelib.task_entries(rec.get("tasks")) if isinstance(rec, dict) else None
    kept = [e for e in entries or []
            if lanelib.plain_pass_ignores(e) and e["label"] != "dream"]
    return "; ignored: " + logged(kept) if kept else ""


def readable_time(when) -> bool:
    """Whether a stop record's `time` is a finite number, not a bool (an int to isinstance).
    json reads NaN, Infinity and ints past a float's range, which math.isfinite rejects or can't
    convert."""
    try:
        return (isinstance(when, (int, float)) and not isinstance(when, bool)
                and math.isfinite(when))
    except OverflowError:
        return False


def stop_problem(plan: Plan, rec: dict | None) -> tuple[str, str] | None:
    """Why the session's stop record rec doesn't clear a respawn, as (the log's detail, the
    notice), or None: it must be dated after the call and list no waits (stop-ring.sh's
    subagent, shell, workflow, cloud session) and no task at all but `dream` (memory upkeep) or
    an `artifact watch` (lanelib.plain_pass_blockers, which the autopass watcher shares).
    stop-ring.sh rings past a teammate or a monitor, since one lingers or runs for hours, but a
    respawn kills either, and any type it doesn't know (unlabeled ones included), so a plain
    pass doesn't. The detail says `waits:` for the record's waits and `tasks:` for its tasks,
    each described whole, then what it ignored; the notice names the first tasks, counts the
    rest and gives the fix."""
    unsure = "so background work can't be ruled out. /pass compact is safe either way"
    if rec is None:
        return "no stop record", f"pass refused: the Stop wrote no record, {unsure}"
    when = rec.get("time")
    if not readable_time(when) or when <= plan.called:
        return ("no stop record since the call",
                f"pass refused: the Stop wrote no record since the call, {unsure}")
    waits = rec.get("waits")
    if waits != []:
        if not isinstance(waits, list):
            return (f"waits: {waits!r}",
                    f"pass refused: the stop record's waits can't be read, {unsure}")
        names = {str(w) for w in waits}
        tasks = rec.get("tasks")
        blockers = lanelib.plain_pass_blockers(tasks) if isinstance(tasks, list) else []
        # The record keeps the waits as labels; its tasks describe them. Any other blocker is
        # named too, so waiting out the waits doesn't meet a second refusal.
        waiting = [e for e in blockers if e["label"] in names]
        described = {e["label"] for e in waiting}
        waiting += [{"label": str(w)} for w in waits if str(w) not in described]
        rest = [e for e in blockers if e["label"] not in names]
        them = "it" if len(waiting) + len(rest) == 1 else "them"
        if not rest:
            return ("waits: " + logged(waiting) + ignored(rec),
                    f"pass refused: waiting on {task_line(waiting)} (a respawn would kill "
                    f"{them}). /pass compact keeps {them}, or let {them} finish and /pass")
        # SHOWN named across both parts: the waits first, then the rest.
        left = SHOWN - min(SHOWN, sum(map(described_by_record, waiting)))
        return ("waits: " + logged(waiting) + "; tasks: " + logged(rest) + ignored(rec),
                f"pass refused: waiting on {task_line(waiting)}, and {task_line(rest, left)} "
                f"running "
                f"(a respawn would kill {them}). /pass compact keeps {them}, or let the waits "
                f"finish, stop the rest (/tasks, or ask Claude to TaskStop {them}) and /pass")
    tasks = rec.get("tasks")
    if not isinstance(tasks, list):
        return ("no task list in the stop record",
                f"pass refused: the stop record lists no tasks, {unsure}")
    if blockers := lanelib.plain_pass_blockers(tasks):
        them = "it" if len(blockers) == 1 else "them"
        return ("tasks: " + logged(blockers) + ignored(rec),
                f"pass refused: {task_line(blockers)} running (a respawn would kill {them}). "
                f"Stop {them} (/tasks, or ask Claude to TaskStop {them}), or /pass compact "
                f"keeps {them}")
    return None


def approved_now(plan: Plan, session: dict | None) -> bool:
    """Whether the status file's first Next item is approved in this session: its marker is
    dated on or after the session's start (startedAt, local time). Read when acting."""
    started = (session or {}).get("startedAt")
    if isinstance(started, bool) or not isinstance(started, (int, float)):
        return False
    try:
        with open(plan.status_file) as f:
            text = f.read()
    except OSError:
        return False
    since = datetime.date.fromtimestamp(started / 1000)
    return lanelib.approval(lanelib.next_block(text), since) == lanelib.APPROVED


# ---- the input box ----

def sgr_dim(params: str, dim: bool) -> bool:
    """Whether text is dim after an SGR sequence with these params: 2 turns dim on, 0, 22 and a
    bare reset turn it off. An extended colour's own numbers (38;5;2) are skipped, not read."""
    codes = [int(p) if p.isdigit() else 0 for p in params.replace(":", ";").split(";")]
    i = 0
    while i < len(codes):
        if codes[i] in (38, 48, 58):
            i += 3 if i + 1 < len(codes) and codes[i + 1] == 5 else 5
            continue
        if codes[i] == 2:
            dim = True
        elif codes[i] in (0, 22):
            dim = False
        i += 1
    return dim


def visible(line: str) -> str:
    """line (tmux capture-pane -e) as plain text, less its dim spans (Claude Code's ghost
    suggestion) and every escape. Dim starts off on each line: a dim span tmux carried over
    without repeating it then reads as a draft, which only drops the pass."""
    out, dim, pos = [], False, 0
    for m in ESCAPE.finditer(line):
        if not dim:
            out.append(line[pos:m.start()])
        pos = m.end()
        seq = m.group(0)
        if seq.startswith("\x1b[") and seq.endswith("m"):
            dim = sgr_dim(seq[2:-1], dim)
    if not dim:
        out.append(line[pos:])
    return "".join(out)


def input_box(screen: str) -> str | None:
    """The text in Claude Code's input box on a captured pane, "" when empty, None when there is
    no box. The box is the last line holding the prompt mark and a space; a wrapped draft goes on
    below it, up to the status bar's rule (a box-drawing character). The mark and the rule are
    found with every escape stripped (the rule is dim); the text is read without dim spans."""
    raw = screen.split("\n")
    plain = [ESCAPE.sub("", ln) for ln in raw]
    at = next((i for i in range(len(raw) - 1, -1, -1) if PROMPT_LINE.search(plain[i])), None)
    if at is None:
        return None
    text = [visible(raw[at].split(PROMPT_MARK, 1)[1])]
    for line, bare in zip(raw[at + 1:], plain[at + 1:]):
        if bare.strip() and 0x2500 <= ord(bare.strip()[0]) <= 0x257F:
            break
        text.append(visible(line))
    return " ".join(t.strip() for t in text if t.strip())


# ---- inputs ----

SANDBOX_KEYS = ("sandbox", "filesystem")


def listed(tree, keys: tuple[str, ...], bases: list[str]) -> list[str]:
    """A settings tree's list at keys as absolute paths (~ expanded). A relative one resolves
    against each of bases (any may be meant), or is skipped when there are none."""
    try:
        for key in keys:
            tree = tree[key]
    except (KeyError, IndexError, TypeError):
        return []
    out = []
    for p in tree if isinstance(tree, list) else []:
        if not isinstance(p, str) or not p:
            continue
        p = os.path.expanduser(p)
        if p.startswith("/"):
            out.append(os.path.normpath("/" + p.lstrip("/")))
        else:
            out += [os.path.normpath(os.path.join(b, p)) for b in bases]
    return out


def listed_paths(path: str, keys: tuple[str, ...], base: str | None) -> list[str]:
    """A settings file's list at keys as absolute paths (listed): a relative one resolves against
    base and against the file's own dir, or is skipped when base is None."""
    try:
        with open(path) as f:
            tree = json.load(f)
    except (OSError, ValueError, RecursionError):   # json recurses on nesting
        return []
    return listed(tree, keys, [base, os.path.dirname(path)] if base is not None else [])


def session_flags(argv: list[str] | None) -> tuple[list[str], list[str]]:
    """The session claude's own --add-dir values and --settings values (a file or inline JSON),
    from its argv. --add-dir takes several values: every argument after it up to the next flag
    counts (a prompt read as a dir only adds a root, which can only refuse more). The scan goes
    past `--`: Claude Code's parser can take it as an option's value and still parse a later
    --settings, and a false hit only refuses more or adds a root."""
    dirs, settings, args, i = [], [], (argv or [])[1:], 0
    while i < len(args):
        arg = args[i]
        i += 1
        name, eq, value = arg.partition("=")
        if name == "--add-dir":
            if eq:
                dirs.append(value)
            while i < len(args) and not args[i].startswith("-"):
                dirs.append(args[i])
                i += 1
        elif name == "--settings":
            if eq:
                settings.append(value)
            elif i < len(args):
                settings.append(args[i])
                i += 1
    return [d for d in dirs if d], [v for v in settings if v]


def tier_files() -> list[str]:
    """The user's and the managed settings files: out of the sandbox's reach."""
    return [os.path.join(config_dir(), "settings.json"), MANAGED_SETTINGS,
            *sorted(glob.glob(os.path.join(MANAGED_DIR, "*.json")))]


def flag_base(repo: lanelib.Repo | None, cwd: str, launch: str | None) -> str:
    """The dir a session flag's relative path resolves against: the launch dir, else the
    toplevel (or the call's dir)."""
    if launch and os.path.isabs(launch):
        return os.path.normpath(launch)
    return repo.toplevel if repo else os.path.realpath(cwd)


def flag_settings(argv: list[str] | None, base: str) -> tuple[list[str], list[dict]]:
    """The session's --settings values: (absolute file paths, parsed inline JSON objects)."""
    files, inline = [], []
    for value in session_flags(argv)[1]:
        if value.lstrip().startswith("{"):
            with contextlib.suppress(ValueError, RecursionError):   # json recurses on nesting
                inline.append(json.loads(value))
        else:
            files.append(os.path.normpath(os.path.join(base, os.path.expanduser(value))))
    return files, inline


def writable_roots(repo: lanelib.Repo | None, cwd: str, launch: str | None = None,
                   session_argv: list[str] | None = None) -> list[str]:
    """Dirs sandboxed Bash can write: the checkout and the main checkout (before git has found
    them, the call's dir), the session's launch dir, the temp dirs, every settings file's
    allowWrite and additionalDirectories (the project's at the top level and the launch dir),
    and the session's own flags (session_argv, its claude's command line): each --add-dir, and
    the allowWrite and additionalDirectories of each --settings file or inline JSON. A relative
    flag value resolves against the launch dir (the claude's cwd), else the checkout."""
    top = repo.toplevel if repo else os.path.realpath(cwd)
    roots = [repo.toplevel, repo.main] if repo else [top]
    dirs = [top]
    if launch and os.path.isabs(launch):
        roots.append(os.path.normpath(launch))
        dirs.append(os.path.normpath(launch))
    roots += ["/tmp", tempfile.gettempdir()]
    if os.environ.get("TMPDIR"):
        roots.append(os.environ["TMPDIR"])
    files = tier_files()
    for d in dict.fromkeys(dirs):
        files += [os.path.join(d, ".claude", "settings.json"),
                  os.path.join(d, ".claude", "settings.local.json")]
    base = os.path.normpath(launch) if launch and os.path.isabs(launch) else top
    add_dirs, _ = session_flags(session_argv)
    roots += [os.path.normpath(os.path.join(base, os.path.expanduser(d))) for d in add_dirs]
    flag_files, inline = flag_settings(session_argv, base)
    files += flag_files
    for path in files:
        roots += listed_paths(path, (*SANDBOX_KEYS, "allowWrite"), top)
        roots += listed_paths(path, ("permissions", "additionalDirectories"), top)
    for tree in inline:
        roots += listed(tree, (*SANDBOX_KEYS, "allowWrite"), [base, top])
        roots += listed(tree, ("permissions", "additionalDirectories"), [base, top])
    return roots


def deny_roots() -> list[str]:
    """sandbox.filesystem.denyWrite from the user and managed tiers, absolute entries only: the
    paths the sandbox can't write inside a writable root. A project file's is never read."""
    return [p for f in tier_files() for p in listed_paths(f, (*SANDBOX_KEYS, "denyWrite"), None)]


def within(path: str, root: str) -> bool:
    """path (already resolved as far as wanted) is root or under it, root fully resolved."""
    root = os.path.realpath(root)
    return path == root or path.startswith(root.rstrip(os.sep) + os.sep)


def writable_root(path: str, roots: list[str], denies: list[str]) -> str | None:
    """The writable root holding path, or None (also when a denyWrite entry covers it)."""
    if any(within(path, d) for d in denies):
        return None
    return next((r for r in roots if within(path, r)), None)


def link_chain(path: str) -> list[str]:
    """Each hop from path to the file it finally names: every link on the way (its own dir
    resolved), then the target. A middle link counts as much as the first: the sandbox could
    repoint one it can write."""
    hops, p = [], os.path.abspath(path)
    for _ in range(40):  # the kernel's own limit on a chain
        hop = os.path.join(os.path.realpath(os.path.dirname(p)), os.path.basename(p))
        hops.append(hop)
        if not os.path.islink(hop):
            break
        p = os.path.join(os.path.dirname(hop), os.readlink(hop))
    return hops + [os.path.realpath(path)]


def refuse_writable(name: str, found: str, roots: list[str], denies: list[str]) -> None:
    """Refuse when found, any link on its way, or the file it names sits in a dir the sandbox
    can write (this runs sandbox-off, so a planted file would too)."""
    for path in link_chain(found):
        if root := writable_root(path, roots, denies):
            raise Refuse(1, f"pass-respawn: {name} resolves to {path}, inside the sandbox-writable "
                         f"{root}; refusing to run it sandbox-off", f"{name} sandbox-writable")


def refuse_writable_settings(argv: list[str] | None, base: str, roots: list[str]) -> None:
    """Refuse when one of the session's --settings files sits in a sandbox-writable dir: it may
    have been edited since launch, so the dirs it listed then (and the sandbox still honors)
    can't be read back from it now. Run before git or tmux, which such a dir could plant."""
    denies = deny_roots()
    for flagged in flag_settings(argv, base)[0]:
        refuse_writable("a --settings file", flagged, roots, denies)


def safe_path(path: str, roots: list[str], denies: list[str]) -> str:
    """PATH less every entry that is relative or empty (it follows the cwd) or sits, as given or
    resolved, in a sandbox-writable dir."""
    keep = [e for e in path.split(os.pathsep) if os.path.isabs(e)
            and writable_root(os.path.normpath(e), roots, denies) is None
            and writable_root(os.path.realpath(e), roots, denies) is None]
    return os.pathsep.join(dict.fromkeys(keep))


def pin(roots: list[str]) -> str:
    """Refuse when this script, handoff-check or lanelib is sandbox-writable; then sanitize PATH
    (safe_path), make it the process's own (lanelib's git inherits it) and return it."""
    denies = deny_roots()
    for name, path in (("pass-respawn", INVOKED), ("handoff-check", HANDOFF_CHECK),
                       ("lanelib", lanelib.__file__)):
        refuse_writable(name, path, roots, denies)
    os.environ["PATH"] = safe_path(os.environ.get("PATH", ""), roots, denies)
    return os.environ["PATH"]


def resolve_bin(name: str, roots: list[str], path: str) -> str:
    """name's absolute path on the sanitized PATH, refused when it, or what it links to, sits in
    a dir the sandbox can write."""
    found = shutil.which(name, path=path)
    if found is None:
        raise Refuse(1, f"pass-respawn: {name} is not on PATH", f"no {name}")
    refuse_writable(name, found, roots, deny_roots())
    return os.path.abspath(found)


def toast_command(roots: list[str], path: str) -> list[str] | None:
    """The Windows toast's argv less its message, as hooks/notify.sh runs it: powershell.exe
    -ExecutionPolicy Bypass -File <notify-toast.ps1 as a Windows path> -Message. notify.sh
    itself isn't called: it reads a Notification payload on stdin and rings and logs a
    permission prompt, which a refused pass is not. WSL only (wslpath; tmux and pass-respawn
    don't run under git-bash). None when anything is missing or sits where the sandbox can
    write (the same checks as tmux's): the toast is best-effort and never refuses a pass."""
    ps1 = os.path.join(config_dir(), TOAST_PS1)
    if not os.path.isfile(ps1):
        return None
    try:
        refuse_writable(TOAST_PS1, ps1, roots, deny_roots())
        powershell = resolve_bin("powershell.exe", roots, path)
        wslpath = resolve_bin("wslpath", roots, path)
        p = subprocess.run([wslpath, "-w", ps1], capture_output=True, text=True, timeout=5,
                           env=dict(os.environ, PATH=path))
    except (Refuse, OSError, subprocess.SubprocessError):
        return None
    winpath = p.stdout.strip()
    if p.returncode != 0 or not winpath or "\n" in winpath:
        return None
    return [powershell, "-ExecutionPolicy", "Bypass", "-File", winpath, "-Message"]


def resume_prompt(status_rel: str, in_lane: bool, approved: bool, compact: bool) -> str:
    step = "continue with the approved next step" if approved else "plan the next step"
    text = (f"Read your lane record {status_rel}, then {step}." if in_lane
            else f"Read STATUS.md (and PLAN.md if present), then {step}.")
    return text + (" Call EnterPlanMode first." if compact and not approved else "")


def compact_focus(status_rel: str) -> str:
    return ("Keep the failed approaches and why each failed, exact identifiers (paths, commands, "
            f"ids, error text) and the repro command. {status_rel} holds the exact facts: re-read "
            "it rather than trusting this summary.")


def gate(toplevel: str, path: str) -> tuple[int, str]:
    """handoff-check on the checkout, with the sanitized PATH: (exit code, its output)."""
    try:
        p = subprocess.run([sys.executable, "-I", HANDOFF_CHECK, "-C", toplevel],
                           capture_output=True, text=True, timeout=120,
                           env=dict(os.environ, PATH=path))
    except (OSError, subprocess.SubprocessError) as e:
        return 1, f"handoff-check didn't run: {e}"
    return p.returncode, p.stdout + p.stderr


# ---- the log ----

def log(mode: str, outcome: str, pane: str | None, detail: str = "") -> None:
    line = (f"{datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')} "
            f"session={os.environ.get('CLAUDE_CODE_SESSION_ID') or '-'} pane={pane or '-'} "
            f"mode={mode} outcome={outcome}" + (f" {detail}" if detail else ""))
    with contextlib.suppress(OSError):
        os.makedirs(lanelib.state_dir(), exist_ok=True)
        with open(os.path.join(lanelib.state_dir(), "pass.log"), "a") as f:
            f.write(line.replace("\n", " ") + "\n")


# ---- call time ----

def timeout_arg(text: str) -> float:
    try:
        value = float(text)
    except ValueError:
        value = math.nan
    if not (math.isfinite(value) and 0 < value <= MAX_TIMEOUT):
        raise argparse.ArgumentTypeError(f"{text!r} is not a number of seconds above 0 and at "
                                         f"most {MAX_TIMEOUT:g}")
    return value


def parse(argv=None) -> argparse.Namespace:
    # No abbreviated flags, like the other excluded wrappers.
    ap = argparse.ArgumentParser(prog="pass-respawn", description=__doc__.split("\n\n")[0],
                                 allow_abbrev=False)
    ap.add_argument("--compact", action="store_true", help="compact in place instead of respawning")
    ap.add_argument("--print", action="store_true", help="print the mode and argv, do nothing")
    ap.add_argument("--cancel", action="store_true",
                    help="end this session's pending waiter, if any")
    ap.add_argument("--tasks", action="store_true",
                    help="list this session's tasks at its last Stop, and whether each blocks a "
                         "plain pass; change nothing")
    ap.add_argument("--foreground", action="store_true", help="wait in-process (tests)")
    ap.add_argument("--timeout", type=timeout_arg, default=TIMEOUT, metavar="SECONDS",
                    help=f"give up when the turn isn't idle by then (default {TIMEOUT:g}, at most "
                         f"{MAX_TIMEOUT:g})")
    ap.add_argument("-C", dest="cwd", default=os.getcwd(), help="the checkout to pass")
    return ap.parse_args(argv)


def prepare(args: argparse.Namespace, procs, cmdline=proc_cmdline) -> Plan:
    """The checks at call time, then the plan; raises Refuse. procs and cmdline read /proc
    (injected by tests)."""
    called = time.time()
    mode = "compact" if args.compact else "plain"
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID") or ""
    sid = sid if SID_RE.fullmatch(sid) else ""  # it names files: a plain id or nothing
    claude_pid = session_claude(procs(), os.getpid())
    # These two refuse before anything runs sandbox-off: without its claude the session's own
    # launch flags (--settings, --add-dir) can't be read, so the roots below would be short.
    if claude_pid is None:
        raise Refuse(1, "pass-respawn: can't find this session's claude process, so it can't "
                     "tell when the turn ends. Run it bare (sandbox-off)", "no claude")
    if not sid:
        raise Refuse(1, "pass-respawn: CLAUDE_CODE_SESSION_ID is unset (or not a plain id), so "
                     "it can't tell this session's file from another's", "no session id")
    session = load_session(claude_pid)
    launch = session.get("cwd") if session and isinstance(session.get("cwd"), str) else None
    claude_argv = cmdline(claude_pid) if claude_pid else None
    early = writable_roots(None, args.cwd, launch, session_argv=claude_argv)
    refuse_writable_settings(claude_argv, flag_base(None, args.cwd, launch), early)
    resolve_bin("git", early, pin(early))  # lanelib.resolve runs it next
    repo = lanelib.resolve(args.cwd)
    if repo is None:
        raise Refuse(1, "pass-respawn: not inside a git work tree", "not a work tree")
    _, lane = repo.identity()
    status_rel = os.path.join(lanelib.RECORD_DIR, "STATUS.md") if lane else "STATUS.md"
    transcript = transcript_path(session, sid, stop_record(sid)) if session and sid else None
    try:
        size = os.path.getsize(transcript) if transcript else None
    except OSError:
        size = None
    pane = os.environ.get("TMUX_PANE") or ""
    if not PANE_RE.fullmatch(pane):
        draft = Plan(mode, "", repo.toplevel, lane is not None, status_rel, "", None, 0, 0, sid,
                     {}, called, None, 0, args.timeout)
        ours = session if session and session.get("sessionId") == sid else None
        prompt = resume_prompt(status_rel, lane is not None, approved_now(draft, ours),
                               args.compact)
        by_hand = f"/compact {compact_focus(status_rel)}" if args.compact else "/clear"
        raise Refuse(2, f"pass-respawn: not in a tmux pane. Do it by hand: {by_hand}, then: "
                     f"{prompt}", "no tmux pane")
    roots = writable_roots(repo, args.cwd, launch, session_argv=claude_argv)
    # Again against the full roots: the main checkout and the toplevel's relative allowWrite
    # entries are known only now, and without a launch dir a relative --settings value
    # resolves against the toplevel, not the call's dir.
    refuse_writable_settings(claude_argv, flag_base(repo, args.cwd, launch), roots)
    path = pin(roots)
    resolve_bin("git", roots, path)
    tmux = resolve_bin("tmux", roots, path)
    claude = None if args.compact else resolve_bin("claude", roots, path)
    code, out = gate(repo.toplevel, path)
    if code != 0:
        raise Refuse(1, out.rstrip() + "\npass-respawn: refused: handoff-check failed; fix the "
                     "gaps and run it again", "handoff-check failed")
    if why := session_problem(session, sid, claude_pid, None, pane):
        raise Refuse(1, f"pass-respawn: {why} (~/.claude/sessions/{claude_pid}.json, procStart "
                     "checked); it can't tell when this session's turn ends", why)
    return Plan(mode, pane, repo.toplevel, lane is not None, status_rel, tmux, claude, claude_pid,
                proc_start(claude_pid), sid, session, called, transcript, size, args.timeout,
                path, toast_command(roots, path))


# ---- the waiter ----

def tmux(plan: Plan, *args: str) -> subprocess.CompletedProcess | None:
    try:
        return subprocess.run([plan.tmux, *args], capture_output=True, text=True, timeout=10,
                              env=dict(os.environ, PATH=plan.path))
    except (OSError, subprocess.SubprocessError):
        return None


def observe(plan: Plan, procs=None) -> tuple[str, str, dict | None]:
    """(state, detail, session file): `gone` when the pane, the session file or the process
    isn't this session's any more; `idle` when the turn is over: the file says idle (or shell)
    since the call, or it says busy and the transcript past the call shows the turn ended
    (scan_turns, turn_over; Claude Code 2.1.300 says busy at the prompt while delegated work
    runs); else `busy` (`waiting` and any unknown status too). The transcript is read after the
    session file. The file changes first: turn_duration's bytes land 0.1 to 0.4 s later (the
    spike's poller), so busy reads as over only once they land, and a poll that sees idle or
    shell has usually not seen the end yet (wait_and_act picks its rule after the settle).
    Given procs (the final re-check), the pane must also run this claude: its pane_pid the claude
    or an ancestor of it, its current command `claude`. detail is the file's status."""
    p = tmux(plan, "display-message", "-p", "-t", plan.pane, PANE_FORMAT)
    if p is None or p.returncode != 0:
        return "gone", f"pane {plan.pane}: " + (p.stderr.strip() if p else "tmux didn't run"), None
    session = load_session(plan.claude_pid)
    if why := session_problem(session, plan.session_id, plan.claude_pid, plan.proc_start,
                              plan.pane):
        return "gone", why, None
    if procs is not None:
        pid, _, cmd = p.stdout.strip().partition(" ")
        if cmd != "claude" or not pid.isdigit() or int(pid) not in ancestry(procs(),
                                                                            plan.claude_pid):
            return "gone", f"pane {plan.pane} runs {cmd or '?'} (pid {pid or '?'}), not claude " \
                           f"{plan.claude_pid}", None
    scan_turns(plan)
    status, updated = session.get("status"), session.get("statusUpdatedAt")
    idle = ((status in AT_PROMPT and isinstance(updated, (int, float))
             and not isinstance(updated, bool) and updated > plan.called * 1000)
            or (status == "busy" and turn_over(plan)))
    return ("idle" if idle else "busy"), str(status), session


def look_again(plan: Plan, rounds: int, procs=None) -> tuple[str, str, dict | None]:
    """observe, for the settle and the final re-check, then up to `rounds` more looks, each
    TRANSCRIPT_LAG after the last (observe re-scans): the first whatever the status did, the
    rest only while the latest look's statusUpdatedAt differs from the look before. A turn that
    began before a look may not have reached the transcript yet, and while an agent keeps the
    status busy its start marker is the only sign of it; a status that keeps flipping (delegated
    work starting and stopping) gets a look after each flip, up to the cap. wait_and_act sets
    rounds after the settle's fresh scan: 0 with no end marker seen even then (the status rule
    alone), 1 when the turn ended at `idle` (a turn flips the status at once) and LAG_ROUNDS
    when it ended at `shell` or `busy`. A turn that begins
    within about 150 ms of the last look can still be missed, as one after it always can."""
    state, detail, session = observe(plan, procs)
    for _ in range(rounds):
        if state == "gone":
            break
        before = session.get("statusUpdatedAt")
        time.sleep(TRANSCRIPT_LAG)
        state, detail, session = observe(plan, procs)
        if state == "gone" or session.get("statusUpdatedAt") == before:
            break
    return state, detail, session


def pane_problem(plan: Plan) -> str | None:
    """Why the pane can't take keys or a respawn now, or None: tmux gave no answer, copy mode
    (keys would scroll it, not type), or text Hayden is composing in the input box (typing would
    join it, a respawn would discard it), or no input box at all (a dialog or a full-screen
    view)."""
    p = tmux(plan, "display-message", "-p", "-t", plan.pane, "#{pane_in_mode}")
    if p is None or p.returncode != 0:
        return "tmux didn't answer"
    if p.stdout.strip() != "0":
        return "pane in copy mode"
    p = tmux(plan, "capture-pane", "-e", "-p", "-t", plan.pane)
    box = input_box(p.stdout) if p is not None and p.returncode == 0 else None
    if box is None:
        return "no input box"
    return "unsent draft in the input box" if box else None


def pane_place(plan: Plan) -> tuple[str | None, str, str]:
    """(the pane's session id, its window index, its window name) from tmux, or (None, "", "")
    when tmux can't find the pane."""
    p = tmux(plan, "display-message", "-p", "-t", plan.pane,
             "#{session_id} #{window_index} #{window_name}")
    parts = p.stdout.rstrip("\n").split(" ", 2) if p and p.returncode == 0 else []
    if len(parts) < 2 or not re.fullmatch(r"\$\d+", parts[0]) or not parts[1].isdigit():
        return None, "", ""
    return parts[0], parts[1], (parts[2] if len(parts) > 2 else "").strip()


def session_clients(plan: Plan, session_id: str) -> list[str]:
    """The clients attached to the session (tmux list-clients -t), in tmux's order."""
    p = tmux(plan, "list-clients", "-t", session_id, "-F", "#{client_name}")
    names = p.stdout.split("\n") if p is not None and p.returncode == 0 else []
    return [c for c in dict.fromkeys(names) if c and not any(ch.isspace() for ch in c)]


def placed(text: str, where: str) -> str:
    """text with `in <where>` after its first word group: "pass refused: x" -> "pass refused in
    tab 3: x"."""
    head, sep, tail = text.partition(": ")
    return f"{head} in {where}: {tail}" if sep and where else text


def toast(plan: Plan, text: str) -> None:
    """The Windows toast (toast_command), detached as notify.sh detaches it (`( cmd & )`): a
    fixed /bin/sh script backgrounds it and exits, the message passed as an argument, never
    interpolated. Best-effort: no toast command, a failed start or a toast that fails changes
    nothing."""
    if not plan.toast:
        return
    with contextlib.suppress(OSError, subprocess.SubprocessError):
        subprocess.run(["/bin/sh", "-c", '"$@" </dev/null >/dev/null 2>&1 &', "toast",
                        *plan.toast, text], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, cwd="/", timeout=5,
                       env=dict(os.environ, PATH=plan.path))


def shown_literally(text: str) -> str:
    """text escaped for display-message, which expands its message twice: strftime first (`%%` is
    a `%`), then tmux's formats (`##` is a `#`). Each pass undoes only its own doubling, and
    neither creates the other's character, so the order of the two replaces doesn't matter and
    no doubled pair can combine into a live `%H` or `#(cmd)`. -l would print it unchanged, but
    tmux before 3.4 rejects it."""
    return text.replace("%", "%%").replace("#", "##")


def notify(plan: Plan, text: str) -> None:
    """A loud notice: text, naming the tab, on the status line of every client attached to the
    pane's session until a key press (`display-message -d 0 -c <client>`), then the Windows
    toast. A status-line message belongs to a client, not a window, so each client of the
    session shows it whichever window it is on; tmux's default (no -c) picks only one, which
    may be a stale terminal. With no client attached (Hayden switched his to another session)
    or the pane gone, it goes to tmux's own choice of client, the most recently active one.
    The text is escaped (shown_literally), so a task label shows as itself."""
    session_id, index, name = pane_place(plan)
    shown = shown_literally(placed(text, f"tab {index}" if index else ""))
    clients = session_clients(plan, session_id) if session_id else []
    targets = (([["-c", c, "-t", plan.pane] for c in clients] or [["-t", plan.pane]])
               if session_id else [[]])
    for target in targets:
        tmux(plan, "display-message", "-d", "0", *target, shown)
    toast(plan, placed(text, f"tab {index}" + (f" ({name})" if name else "") if index else ""))


def drop(plan: Plan, outcome: str, detail: str = "", shown: str | None = None,
         cause: str | None = None, fix: str | None = None, prompt: str = "",
         loud: bool = False) -> str:
    """Log the drop, leave the session its notice (tell; cause and fix override the notice's
    defaults for the outcome, and prompt hands over a resume prompt lost after /compact), then
    show it: loud (notify) unless Hayden caused it (QUIET: a cancel, a prompt or a new turn after
    the call, his /clear or exit), which keeps the brief status-line message. loud makes one
    drop of a QUIET outcome loud: an unreadable transcript drops `resumed` though Hayden did
    nothing, and drops every pass the same way. The notice comes before any tmux call, so a
    dying tmux server can't delay or skip it."""
    plan.settled = True
    dropped = time.time()
    log(plan.mode, outcome, plan.pane, detail)
    tell(plan, outcome, dropped, detail, cause=cause, fix=fix, prompt=prompt)
    text = shown or DROPS[outcome]
    if outcome in QUIET and not loud:
        tmux(plan, "display-message", "-t", plan.pane, shown_literally(text))
    else:
        with contextlib.suppress(Exception):  # the outcome is logged; the notice is best-effort
            notify(plan, text)
    return outcome


# ---- the session's notice ----

NOTICE_CHARS = 300      # a notice's free-text detail is cut to this
TAKEN_AGE = 86400       # a notice the hook claimed (*.taken) and left is pruned after a day
CAUSES = {  # a loud drop's cause in the notice, from the drop's detail (drop's cause overrides)
    "stale": "the handoff went stale (work landed after it: {detail})",
    "timeout": "the turn didn't end within {timeout:g} s of the call",
    "failed": "tmux could not respawn or type into the pane ({detail})",
    "error": "the waiter hit an error ({detail})",
}
FIXES = {  # what the session does about a loud drop (drop's fix overrides)
    "stale": "Run the delta handoff and handoff-check, then run the pass skill again if it still "
             "applies.",
    "busy": "Follow the pass skill's step 2 (pass-respawn -C {toplevel} --tasks, then TaskStop "
            "the leftovers) or pass in compact mode.",
    "timeout": "Make pass-respawn the turn's last action, then run the pass skill again.",
    "failed": "Read pass.log, then run the pass skill again.",
    "error": "Read pass.log, then run the pass skill again.",
}


def notice_path(sid: str) -> str:
    """The session's notice, which hooks/pass-notice.sh injects into its next turn."""
    return os.path.join(lanelib.state_dir(), "pass-notice", f"{sid}.json")


def clock(when: float) -> str:
    """Epoch secs as a UTC clock time, HH:MM:SS (the notice adds the Z)."""
    return datetime.datetime.fromtimestamp(when, datetime.timezone.utc).strftime("%H:%M:%S")


def clipped(text) -> str:
    """Free text as one line for a notice: control and format characters dropped (an escape
    sequence, a bidi override), whitespace (newlines too) folded to single spaces, cut to
    NOTICE_CHARS characters."""
    kept = "".join(c for c in str(text)
                   if c.isspace() or unicodedata.category(c) not in ("Cc", "Cf"))
    line = " ".join(kept.split())
    return line if len(line) <= NOTICE_CHARS else line[:NOTICE_CHARS - 3] + "..."


def told(plan: Plan, outcome: str, dropped: float, detail: str = "", cause: str | None = None,
         fix: str | None = None, prompt: str = "") -> str:
    """What the notice tells the session (model-facing, one paragraph): which pass, queued when,
    and for a loud drop when and why it dropped (cause, by default CAUSES' with detail) and the
    fix (FIXES'); that none is pending, so the session stops saying one is queued. For `partial`,
    and for a `failed` whose resume prompt was lost after /compact went out (prompt given: a
    second pass would compact again, and cause says how far the keys got, the prompt perhaps
    sitting unsent in the input box), it hands over the resume prompt instead. A `resumed`
    names its reason (cause) and, given one, its fix. detail is clipped; cause and fix come
    whole."""
    head = f"[pass] The {plan.mode} pass you queued at {clock(plan.called)}Z"
    take = ("No pass is pending now. Treat this as your resume prompt unless Hayden's message "
            f"says otherwise: {prompt}")
    if outcome == "partial":
        return (f"{head} sent /compact, but the resume prompt wasn't typed ({clipped(detail)}). "
                f"{take}")
    if outcome == "failed" and prompt:   # cause says how far the keys got
        return (f"{head} {cause or 'sent /compact, but the resume prompt was not sent'}. "
                f"{take}")
    if outcome == "cancelled":
        return f"{head} was cancelled. No pass is pending now."
    if outcome == "resumed":
        tail = (f"No pass is pending now. {fix}" if fix else "No pass is pending now; run the "
                "pass skill again once this work is done, if it still applies.")
        return f"{head} was dropped: {cause or clipped(detail)}. {tail}"
    if outcome == "gone":
        return (f"{head} was dropped: the pane or its claude changed ({clipped(detail)}). No pass "
                "is pending now.")
    if cause is None:
        cause = CAUSES.get(outcome, "{detail}").format(detail=clipped(detail),
                                                         timeout=plan.timeout)
    fix = fix or FIXES[outcome].format(toplevel=plan.toplevel)
    return (f"{head} was dropped at {clock(dropped)}Z ({outcome}): {cause}. No pass is pending "
            f"now, so don't tell anyone one is queued. {fix} Tell Hayden in one line.")


def tell(plan: Plan, outcome: str, dropped: float, detail: str = "", **how) -> None:
    """Leave the session its notice (notice_path): {v: 1, session_id, outcome, mode, called,
    dropped, text (told)}, times in epoch secs, written atomically and 0600 (write_utf8_json's
    mkstemp). Best-effort: a failure here never changes the outcome."""
    with contextlib.suppress(Exception):
        write_utf8_json(notice_path(plan.session_id), {
            "v": 1, "session_id": plan.session_id, "outcome": outcome, "mode": plan.mode,
            "called": plan.called, "dropped": dropped,
            "text": told(plan, outcome, dropped, detail, **how)})


def clear_notice(sid: str) -> None:
    """At the call, with the pending lock held: the session's old notice goes (it told of an
    earlier pass), and once a day so do notices older than 7 days and claimed ones (*.taken)
    older than a day. The stamp sits beside the dir, which so holds only notices. Best-effort."""
    with contextlib.suppress(Exception):
        path = notice_path(sid)
        remove(path)
        prune(os.path.dirname(path), time.time(), {"*.json": PRUNE_AGE, "*.taken": TAKEN_AGE},
              stamp=os.path.dirname(path) + ".pruned")


def carry_path(pane: str) -> str:
    return os.path.join(lanelib.state_dir(), "pass-carry", pane[1:] + ".json")


def pane_tab(plan: Plan) -> dict | None:
    """The pane on its tmux server, keyed as claude-saved's make_tab keys it, or None when tmux
    can't say."""
    p = tmux(plan, "display-message", "-p", "-t", plan.pane, "#{start_time} #{pid} #{socket_path}")
    parts = p.stdout.strip().split(" ", 2) if p and p.returncode == 0 else []
    if len(parts) != 3 or not (parts[0].isdigit() and parts[1].isdigit()):
        return None
    return {"socket": parts[2], "server_start": int(parts[0]), "server_pid": int(parts[1]),
            "pane": plan.pane}


def write_carry(plan: Plan, tab: dict | None) -> str | None:
    """The one-shot marker tmux/claude-saved reads on the respawned session's `startup`: the
    session leaving and its tab. Its path, or None when it was skipped because either can't be
    read (the star then stays on the old chat, detached, as before)."""
    if tab is None:
        return None
    path = carry_path(plan.pane)
    try:
        lanelib.write_json(path, {"session_id": plan.session_id, "tab": tab,
                                  "written_at": time.time()})
    except OSError:
        return None
    return path


def last_path(pane: str) -> str:
    return os.path.join(lanelib.state_dir(), "pass-last", pane[1:] + ".json")


PRUNE_AGE, PRUNE_EVERY = 7 * 86400, 86400


def replies_of(record: dict | None) -> list[dict]:
    """The stop record's `replies` (hooks/stop_ring.py) with a non-empty text, oldest first."""
    replies = (record or {}).get("replies")
    return [r for r in replies if isinstance(r, dict) and isinstance(r.get("text"), str)
            and r["text"] and isinstance(r.get("prompt_id"), str)] \
        if isinstance(replies, list) else []


def prune(directory: str, now: float, ages: dict[str, float] | None = None,
          stamp: str | None = None) -> None:
    """Delete the directory's files older than their pattern's age (ages, {glob: secs}; by
    default *.json past PRUNE_AGE), at most once per PRUNE_EVERY (the mtime of stamp, by default
    its .pruned), as hooks/stop_ring.py prunes stops/. Best-effort."""
    stamp = stamp or os.path.join(directory, ".pruned")
    with contextlib.suppress(OSError):
        if now - os.path.getmtime(stamp) < PRUNE_EVERY:
            return
    try:
        os.makedirs(directory, exist_ok=True)
        with open(stamp, "a"):
            pass
        os.utime(stamp, (now, now))
    except OSError:
        return
    for pattern, age in (ages or {"*.json": PRUNE_AGE}).items():
        for path in glob.glob(os.path.join(glob.escape(directory), pattern)):
            with contextlib.suppress(OSError):
                if now - os.path.getmtime(path) > age:
                    os.unlink(path)


def write_utf8_json(path: str, data) -> None:
    """Atomic write as UTF-8 (ensure_ascii off, so a long non-ASCII reply stays its own size;
    a lone surrogate becomes '?'): a temp file in the same dir, fsynced, then renamed."""
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp-")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(json.dumps(data, ensure_ascii=False).encode("utf-8", "replace"))
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


PROMPT_TAIL = 8 * 1024 * 1024        # bytes of the transcript read for the prompts
PROMPT_BYTES, PROMPT_LINES = 1024, 12  # each prompt is cut at whichever comes first
COMMAND_NAME = re.compile(r"<command-name>(.*?)</command-name>", re.S)
COMMAND_ARGS = re.compile(r"<command-args>(.*?)</command-args>", re.S)
ELLIPSIS = chr(0x2026)


def prompt_text(content) -> str | None:
    """A typed prompt's content as Hayden typed it: a slash command as `/name args` (not its
    <command-message> block, spike A6), an image block as [image]; None with no text."""
    if isinstance(content, str):
        if content.lstrip().startswith("<command-message>"):
            name, args = COMMAND_NAME.search(content), COMMAND_ARGS.search(content)
            if name and name.group(1).strip():
                cmd = name.group(1).strip()
                cmd = cmd if cmd.startswith("/") else "/" + cmd
                return f"{cmd} {args.group(1).strip()}".rstrip() if args else cmd
        return content
    if not isinstance(content, list):
        return None
    parts = []
    for block in content:
        if not isinstance(block, dict):
            continue
        if block.get("type") == "text" and isinstance(block.get("text"), str):
            parts.append(block["text"])
        elif block.get("type") == "image":
            parts.append("[image]")
    return "\n".join(parts) if parts else None


def clip_prompt(text: str) -> str:
    """text cut to PROMPT_BYTES of UTF-8 or PROMPT_LINES lines, whichever comes first: a line
    cut on a character boundary ends with an ellipsis, and the lines dropped after it are
    counted on a last line, "... (N more lines)". A lone surrogate (a paste cut mid-emoji)
    becomes '?', as write_utf8_json writes it."""
    text = text.encode("utf-8", "replace").decode("utf-8")
    lines = text.strip("\n").rstrip().split("\n")
    keep, used = [], 0
    for line in lines[:PROMPT_LINES]:
        sep = 1 if keep else 0
        need = len(line.encode("utf-8")) + sep
        if used + need > PROMPT_BYTES:
            room = PROMPT_BYTES - used - sep
            if room > 0:
                keep.append(line.encode("utf-8")[:room].decode("utf-8", "ignore") + ELLIPSIS)
            break
        keep.append(line)
        used += need
    left = len(lines) - len(keep)
    tail = f"\n{ELLIPSIS} ({left} more line{'' if left == 1 else 's'})" if left else ""
    return "\n".join(keep) + tail


def epoch(stamp) -> float | None:
    """A transcript timestamp (ISO 8601, Z for UTC) as epoch seconds, or None."""
    try:
        return datetime.datetime.fromisoformat(stamp.replace("Z", "+00:00")).timestamp()
    except (AttributeError, TypeError, ValueError):
        return None


def read_prompts(path: str | None, ids: list[str]) -> list[dict] | None:
    """Hayden's prompt for each turn in ids, from the transcript's last PROMPT_TAIL bytes, in
    the order of ids: {prompt_id, text, time} when the turn's first main-chain user entry that
    isn't a tool result is a typed prompt (typed_prompt), {prompt_id, notice: true, time} when
    it has another origin (a task notice is `task-notification`, an agent's message `peer`,
    which is also meta). A turn whose start is past the read has neither, so the popup says the
    prompt wasn't saved rather than guess. None when the transcript can't be read."""
    try:
        with open(path, "rb") as f:
            start = max(0, f.seek(0, os.SEEK_END) - PROMPT_TAIL)
            f.seek(start)
            data = f.read()
    except (OSError, TypeError, ValueError):
        return None
    if start:
        data = data.partition(b"\n")[2]   # the first line is likely torn
    wanted, found = set(ids), {}
    for line in data.split(b"\n"):
        try:
            entry = json.loads(line)
        except (ValueError, RecursionError):   # json recurses on nesting
            continue
        if (not isinstance(entry, dict) or entry.get("type") != "user"
                or entry.get("isSidechain") or not isinstance(entry.get("message"), dict)):
            continue
        pid = entry.get("promptId")
        if not isinstance(pid, str) or pid not in wanted or pid in found:
            continue
        origin = entry.get("origin")
        kind = origin.get("kind") if isinstance(origin, dict) else None
        if not isinstance(kind, str):
            continue   # a tool result, a skill body, an interrupt: not what started the turn
        if kind != "human":
            found[pid] = {"prompt_id": pid, "notice": True,
                          "time": epoch(entry.get("timestamp"))}
            continue
        if not typed_prompt(entry) or entry.get("isMeta"):
            continue
        text = prompt_text(entry["message"].get("content"))
        if isinstance(text, str) and text.strip():
            found[pid] = {"prompt_id": pid, "text": clip_prompt(text),
                          "time": epoch(entry.get("timestamp"))}
    return [found[p] for p in dict.fromkeys(ids) if p in found]


def write_last(plan: Plan, tab: dict | None) -> str | None:
    """What the old session said in its last 5 turns, for the respawned session's banner
    (hooks/pass-banner.sh, which shows the last turn and sets `shown`) and the popup
    (tmux/pass-last, Ctrl-b Up, which shows every turn): the stop record's `replies` and
    Hayden's prompt for each turn (read_prompts), with the tab, at pass-last/<pane number>.json
    as {tab, from_session, written_at, replies, prompts, shown}. The transcript is
    transcript_path()'s: the stop record's, else the session file's, else the session file's
    cwd slug; with none readable there is no
    `prompts` key. The prompts are cosmetic: no error reading them stops the pass. Not
    one-shot, and apart from the carry marker, which claude-saved consumes on the same
    SessionStart. Its path, or None when nothing was written: with no reply text or no tab,
    any older file for the pane goes, so the popup never shows an earlier pass's replies as
    this one's. Files older than 7 days go once a day."""
    path = last_path(plan.pane)
    now = time.time()
    prune(os.path.dirname(path), now)
    record = stop_record(plan.session_id)
    replies = replies_of(record)
    if tab is None or not replies:
        remove(path)
        return None
    last = {"tab": tab, "from_session": plan.session_id, "written_at": now, "replies": replies}
    try:
        prompts = read_prompts(transcript_path(plan.session or {}, plan.session_id, record),
                               [r["prompt_id"] for r in replies])
    except Exception:  # cosmetic: nothing in a transcript may stop the pass
        prompts = None
    if prompts is not None:
        last["prompts"] = prompts
    try:
        write_utf8_json(path, {**last, "shown": False})
    except (OSError, ValueError):
        remove(path)
        return None
    return path


def remove(path: str | None) -> None:
    if path:
        with contextlib.suppress(OSError):
            os.unlink(path)


def begin_acting(plan: Plan) -> None:
    """From here the waiter acts: SIGTERM (`--cancel`) no longer cancels, since the respawn or
    the keys may already be out and only the act's own outcome is true. The pending lock's line
    gains ` acting`, so --cancel can say it came too late."""
    plan.acting = True
    if plan.lock_fd is not None:
        with contextlib.suppress(OSError):
            claim(plan.lock_fd, "acting")


def late(plan: Plan, detail: str) -> str:
    """detail, noting a SIGTERM that came once acting had begun."""
    return detail + ("; a --cancel came after acting began, ignored" if plan.late_cancel else "")


def wait_and_act(plan: Plan, procs) -> str:
    """Wait for this session's turn to end, recheck, then act; returns the outcome logged."""
    deadline = time.monotonic() + plan.timeout
    while True:
        state, detail, session = observe(plan)
        if state == "gone":
            return drop(plan, "gone", detail)
        if began_after_end(plan):  # a turn after the passing turn's end, before it was seen
            return drop(plan, "resumed", "a new turn in the transcript while waiting",
                        TURN_SHOWN, cause=NEW_TURN)
        if state == "idle":
            break
        if time.monotonic() >= deadline:
            return drop(plan, "timeout", f"status {detail}")
        time.sleep(POLL)
    # The status at the turn's end picks the resumption rule (went_on) and how many looks the
    # settle and the final re-check take (look_again): at `idle` only a turn flips it, so any
    # change counts; at `shell` or `busy` background work flips it too, so only the transcript.
    # It is picked after the settle, from a fresh scan: the session file changes 0.1 to 0.4 s
    # before turn_duration's bytes can be read (the spike's poller), so the break poll at `shell`
    # usually hasn't seen the end yet. With no end even then, the strict rule (failing closed).
    seen, ended_at = session.get("statusUpdatedAt"), session.get("status")
    time.sleep(SETTLE)
    scan_turns(plan)
    strict = plan.first_end is None or ended_at == "idle"
    rounds = 0 if plan.first_end is None else 1 if strict else LAG_ROUNDS
    state, detail, session = look_again(plan, rounds)
    if state == "gone":
        return drop(plan, "gone", detail)
    if why := went_on(plan, state, detail, session, seen, strict):
        return drop(plan, "resumed", f"{why[0]} in the settle", why[2], cause=why[1])
    code, out = gate(plan.toplevel, plan.path)
    if code != 0:
        gaps = [ln.strip()[len("FAIL"):].strip() for ln in out.splitlines()
                if ln.strip().startswith("FAIL")]
        return drop(plan, "stale", "; ".join(gaps) or clipped(out))
    typed = typed_since(plan.transcript, plan.transcript_size)
    if typed is None:
        # Passing again drops the same way, so the notice sends it to Hayden, not round again
        # (an autopass tier would loop).
        return drop(plan, "resumed", "resumed: transcript unreadable",
                    "pass dropped: the transcript couldn't be read; passing again drops the "
                    "same way",
                    cause="the transcript couldn't be read, so a prompt after the call can't be "
                          "ruled out",
                    fix="Tell Hayden; passing again drops the same way until the transcript can "
                        "be read.", loud=True)
    if typed:
        return drop(plan, "resumed", "a typed or queued prompt after the call",
                    cause="a prompt was typed or queued after the call")
    approved = approved_now(plan, session)
    actions = plan.actions(approved)
    rec = stop_record(plan.session_id) if plan.mode == "plain" else None
    if plan.mode == "plain" and (problem := stop_problem(plan, rec)):
        return drop(plan, "busy", f"busy: {problem[0]}", problem[1],
                    cause=problem[1].removeprefix("pass refused: "))
    state, detail, session = look_again(plan, rounds, procs)
    if state == "gone":
        return drop(plan, "gone", detail)
    if why := went_on(plan, state, detail, session, seen, strict):
        return drop(plan, "resumed", f"{why[0]} at the final re-check", why[2], cause=why[1])
    if why := pane_problem(plan):
        return drop(plan, "busy", f"busy: {why}", f"pass dropped: {why}. {PANE_FIXES[why]}",
                    cause=f"{why} at the final check",
                    fix="Run the pass skill again once " + (
                        "the tab is back." if why == "tmux didn't answer"
                        else "Hayden has cleared it."))
    begin_acting(plan)
    if plan.mode == "plain":
        carry = last = None
        try:
            tab = pane_tab(plan)
            carry = write_carry(plan, tab)
            last = write_last(plan, tab)
            p = tmux(plan, *actions[0][1:])
            if p is None or p.returncode != 0:
                remove(carry)
                remove(last)
                return drop(plan, "failed", late(plan, p.stderr.strip() if p
                                                 else "tmux didn't run"))
        except BaseException:
            remove(carry)
            remove(last)
            raise
        log(plan.mode, "respawn", plan.pane,
            late(plan, ("default mode" if approved else "plan mode") + ignored(rec)))
        return "respawn"
    for i, argv in enumerate(actions):  # /compact <focus>, Enter, the prompt, Enter
        if i == 2:
            time.sleep(COMPACT_GAP)
            if why := pane_problem(plan):  # copy mode, a draft or no box came up in the gap
                # notify keeps it on the status line until a key press (the default is about
                # 750 ms) and sends the toast; pass.log keeps the whole prompt, which the status
                # line may cut.
                log(plan.mode, "partial", plan.pane,
                    late(plan, f"/compact sent, resume prompt not typed: {why}")
                    + f"; resume prompt: {argv[-1]}")
                tell(plan, "partial", time.time(), why, prompt=argv[-1])
                with contextlib.suppress(Exception):
                    notify(plan, f"pass: /compact sent; type the resume prompt yourself: "
                                 f"{argv[-1]}")
                return "partial"
        p = tmux(plan, *argv[1:])
        if p is None or p.returncode != 0:
            said = (p.stderr.strip() if p else "tmux didn't run") or "no error text"
            detail = late(plan, f"send-keys {i + 1} of 4: {said}")
            if i < 2:
                return drop(plan, "failed", detail)
            # Past /compact and its Enter a second pass would compact again, so the held tmux
            # line, the toast, pass.log and the notice hand over the resume prompt, as
            # `partial`'s do; the outcome stays `failed`. Once the prompt may be in the box (the
            # Enter failed, or tmux gave no answer, so the keys may have gone), typing it again
            # would double it: Hayden presses Enter instead.
            prompt, in_box = actions[2][-1], i == 3 or p is None
            if in_box:
                shown = ("pass failed after the resume prompt was typed; press Enter (or type it "
                         f"if the box is empty): {prompt}")
                cause = (f"sent /compact and typed the resume prompt, but its Enter may not have "
                         f"gone through (tmux: {clipped(said)}), so the prompt may sit unsent in "
                         "the input box")
            else:
                shown = ("pass failed after /compact was sent; type the resume prompt yourself: "
                         f"{prompt}")
                cause = (f"sent /compact, but the resume prompt wasn't typed or sent (tmux: "
                         f"{clipped(said)})")
            return drop(plan, "failed", f"{detail}; resume prompt: {prompt}", shown,
                        cause=cause, prompt=prompt)
    log(plan.mode, "compact", plan.pane, late(plan, "default mode" if approved else "plan mode"))
    return "compact"


def finish(plan: Plan, outcome: str) -> None:
    """The waiter's last word, before it lets the lock go: ` done:<outcome>` on the lock's line,
    so a --cancel whose SIGTERM came after a drop (or the act) reports that, not a cancel."""
    plan.settled = True
    if plan.lock_fd is not None:
        with contextlib.suppress(OSError):
            claim(plan.lock_fd, *(["acting"] if plan.acting else []), f"done:{outcome}")


def run_waiter(plan: Plan, procs) -> str:
    """wait_and_act, with SIGTERM (`--cancel`) logged as `cancelled` and any exception as
    `error` (in the detached waiter nothing else can see it). Once acting has begun, or the
    outcome is settled (a drop), SIGTERM is only noted: the act runs to its end and logs its
    own outcome. The outcome goes into the lock's line last (finish)."""
    def on_term(signum, frame):
        if plan.acting or plan.settled:
            plan.late_cancel = True
            return
        raise Cancelled()
    old = signal.signal(signal.SIGTERM, on_term)
    outcome = "error"
    try:
        outcome = wait_and_act(plan, procs)
    except Cancelled:
        outcome = drop(plan, "cancelled", "on SIGTERM")
    except BaseException as e:  # noqa: BLE001  logged and shown, as nothing else can be
        plan.settled = True  # a SIGTERM from here on is only noted: the error still gets logged
        dropped, detail = time.time(), f"{type(e).__name__}: {e}"
        log(plan.mode, "error", plan.pane, detail)
        tell(plan, "error", dropped, detail)
        with contextlib.suppress(Exception):
            notify(plan, DROPS["error"])
        outcome = "error"
    finally:
        finish(plan, outcome)
        signal.signal(signal.SIGTERM, old)
    return outcome


# ---- one pending pass per session ----

def pending_path(sid: str) -> str:
    return os.path.join(lanelib.state_dir(), "pass-pending", f"{sid}.lock")


def take_pending(plan: Plan) -> int:
    """An fd holding the exclusive flock on the session's pending lock, which the waiter keeps
    for its whole life; refused when another waiter holds it. Once it holds the lock, the
    session's old notice goes (clear_notice)."""
    path = pending_path(plan.session_id)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        raise Refuse(1, f"pass-respawn: a pass is already pending; `pass-respawn -C "
                     f"{plan.toplevel} --cancel` drops it", "pending") from None
    clear_notice(plan.session_id)
    return fd


def claim(fd: int, *marks: str) -> None:
    """Write the waiter's pid and start time into the lock it holds, for --cancel, then its
    marks as it goes: ` acting` once it acts, ` done:<outcome>` last (finish). Each later line
    extends the one before, so it overwrites it in place with no truncation a reader could
    catch empty."""
    line = (" ".join([str(os.getpid()), str(proc_start(os.getpid())), *marks]) + "\n").encode()
    if not marks:
        os.ftruncate(fd, 0)
    os.pwrite(fd, line, 0)
    os.ftruncate(fd, len(line))


def lock_fields(fd: int) -> list[str]:
    """The pending lock's line: pid, start time, then the waiter's marks."""
    return os.pread(fd, 256, 0).decode("ascii", "replace").split()


def done_mark(marks: list[str]) -> str | None:
    """The outcome a ` done:<outcome>` mark records, or None."""
    return next((m[len("done:"):] for m in marks if m.startswith("done:")), None)


def wait_free(fd: int, tries: int = 50) -> bool:
    """Whether the waiter let the pending lock go (this fd now holds it), polling 0.1 s."""
    for i in range(tries):
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return True
        except BlockingIOError:
            if i + 1 < tries:
                time.sleep(0.1)
    return False


def too_late(pane: str | None, pid: int | None, outcome: str | None = None) -> int:
    if outcome:
        print(f"pass-respawn: too late to cancel ({outcome}): waiter {pid} had already ended; "
              "see pass.log for what it did")
        log("cancel", "too-late", pane, f"({outcome}) waiter {pid} had ended")
    else:
        print(f"pass-respawn: too late to cancel: waiter {pid} had begun acting (the respawn or "
              "the keys may be out); see pass.log for what it did")
        log("cancel", "too-late", pane, f"waiter {pid} was acting")
    return 1


def ended(fd: int, sid: str, pane: str | None, pid: int | None, signalled: bool) -> int:
    """Report on a waiter whose lock has freed, from the marks it left: its outcome
    (` done:<outcome>`), else ` acting`. A `cancelled` outcome, or no mark at all (it died on
    the SIGTERM before its handler was in), is this cancel's only when it signalled."""
    marks = lock_fields(fd)[2:]
    done = done_mark(marks)
    if signalled and (done == "cancelled" or (done is None and "acting" not in marks)):
        print(f"pass-respawn: cancelled the pending pass (waiter {pid})")
        log("cancel", "cancelled", pane, f"waiter {pid}")
        return 0
    if (done is not None and done != "cancelled") or "acting" in marks:
        return too_late(pane, pid, done)
    print(f"pass-respawn: no pass pending for session {sid} (waiter {pid} had ended)")
    log("cancel", "none", pane, f"nothing pending: waiter {pid} had ended")
    return 0


def is_pass_respawn(pid: int, proc: str = "/proc") -> bool:
    """Whether pid runs this script: argv[0], or the interpreter's first argument past its own
    flags (the shebang's `python3 -I <script>`), is pass-respawn. `-c` or `-m` means it isn't."""
    argv = proc_cmdline(pid, proc) or []
    if argv and os.path.basename(argv[0]) == "pass-respawn":
        return True
    for arg in argv[1:]:
        if not arg.startswith("-"):
            return os.path.basename(arg) == "pass-respawn"
        if arg[1:2] in ("c", "m"):
            return False
    return False


def list_tasks() -> int:
    """--tasks: this session's tasks as its last stop record lists them, one line each with
    whether it blocks a plain pass (the waiter's rule: lanelib.plain_pass_blockers), for /pass
    step 2. Read-only: no lock, no log, no notice. A task started or ended since that Stop isn't
    in it, which the header says."""
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID") or ""
    if not SID_RE.fullmatch(sid):
        print("pass-respawn: CLAUDE_CODE_SESSION_ID is unset (or not a plain id)")
        return 1
    rec = stop_record(sid)
    if rec is None and not os.path.lexists(stop_path(sid)):
        print(f"pass-respawn: no stop record for session {sid} yet (stop-ring.sh writes one at "
              "each Stop)")
        return 0
    if rec is None:
        print(f"pass-respawn: session {sid}: the stop record can't be read: a plain pass would "
              "refuse")
        return 0
    when = rec.get("time")
    if not readable_time(when):
        print(f"pass-respawn: session {sid}: the record's time can't be read: a plain pass "
              "would refuse")
        return 0
    age = max(0, time.time() - when)
    ago = f"{int(age)} s" if age < 60 else f"{int(age // 60)} min"
    print(f"pass-respawn: session {sid} at its last Stop, {ago} ago. Tasks started or ended "
          "since then aren't listed.")
    entries = lanelib.task_entries(rec.get("tasks"))
    if entries is None:
        print("  (no task list: a plain pass would refuse)")
        return 0
    waits = rec.get("waits")
    if not isinstance(waits, list):
        print("  (waits can't be read: a plain pass would refuse)")
        waits = []
    waits = [str(w) for w in waits]
    # A wait the tasks don't describe still blocks, as the waiter reads it (stop_problem).
    extra = [{"label": w} for w in waits if w not in {e["label"] for e in entries}]
    for e in entries + extra:
        verdict = ("blocks a plain pass; the turn waits on it" if e["label"] in waits
                   else "doesn't block a plain pass" if lanelib.plain_pass_ignores(e)
                   else "blocks a plain pass")
        print(f"  {lanelib.describe_task(e, LOG_CHARS)}: {verdict}")
    if not entries + extra:
        print("  none")
    return 0


def cancel() -> int:
    """End this session's pending waiter: SIGTERM to the pid in its lock, once that pid is a
    live pass-respawn with the start time written beside it (a reused pid is not), then wait
    for the lock to free and report from the marks the waiter left (ended). A waiter whose line
    says ` acting` or ` done:<outcome>` (not `cancelled`), before the signal or once the lock
    frees, had acted or dropped on its own: that is `too-late` (exit 1), not a cancel."""
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID") or ""
    pane = os.environ.get("TMUX_PANE")
    if not SID_RE.fullmatch(sid):
        print("pass-respawn: CLAUDE_CODE_SESSION_ID is unset (or not a plain id)")
        log("cancel", "refused", pane, "no session id")
        return 1
    try:
        fd = os.open(pending_path(sid), os.O_RDWR | os.O_NOFOLLOW | os.O_CLOEXEC)
    except FileNotFoundError:
        fd = None
    try:
        if fd is not None:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                held = True
            else:
                held = False
        if fd is None or not held:
            print(f"pass-respawn: no pass pending for session {sid}")
            log("cancel", "none", pane, "nothing pending")
            return 0
        # The call takes the lock and the detached grandchild writes its pid a moment later, so
        # an empty or stale line on a held lock gets up to 2 s to name a live waiter.
        for _ in range(20):
            fields = lock_fields(fd)
            pid = int(fields[0]) if fields and fields[0].isdigit() else None
            start = fields[1] if len(fields) > 1 else None
            if pid is not None and str(proc_start(pid)) == start and is_pass_respawn(pid):
                break
            if wait_free(fd, tries=1):
                return ended(fd, sid, pane, pid, signalled=False)
            time.sleep(0.1)
        if pid is None or str(proc_start(pid)) != start or not is_pass_respawn(pid):
            # It may have acted (or dropped) and exited since the read: a freed lock holds
            # its last word.
            if wait_free(fd, tries=1):
                return ended(fd, sid, pane, pid, signalled=False)
            print(f"pass-respawn: the pending lock names pid {pid}, which doesn't match a live "
                  "pass-respawn started then; not signalling it")
            log("cancel", "refused", pane, f"pid {pid} doesn't match")
            return 1
        if "acting" in fields[2:] or done_mark(fields[2:]) not in (None, "cancelled"):
            return too_late(pane, pid, done_mark(fields[2:]))
        try:
            os.kill(pid, signal.SIGTERM)
            signalled = True
        except ProcessLookupError:  # gone since the check: its lock holds its last word
            signalled = False
        if not wait_free(fd):
            print(f"pass-respawn: sent SIGTERM to waiter {pid}, but it still holds the lock")
            log("cancel", "error", pane, f"waiter {pid} still pending after SIGTERM")
            return 1
        return ended(fd, sid, pane, pid, signalled)
    finally:
        if fd is not None:
            os.close(fd)


def detach(plan: Plan, procs, lock: int) -> str:
    """Run the waiter in a double-forked grandchild (fork, setsid, fork), reparented away from
    this call so the Bash tool's end can't reach it, with /dev/null for stdin, stdout and stderr,
    no other inherited descriptor but the pending lock, which it keeps (holding the flock) and
    writes its pid into, and / as its directory (watch-guard's spawn_waiter). Returns
    "" once the grandchild runs the waiter, else why it didn't start: the middle process and the
    grandchild's setup say so down a pipe, and the middle's exit status must be 0."""
    r, report = os.pipe()
    sys.stdout.flush()
    sys.stderr.flush()
    middle = os.fork()
    if middle == 0:
        status = 1
        try:
            os.close(r)
            os.setsid()
            if os.fork() == 0:
                try:
                    null = os.open(os.devnull, os.O_RDWR)
                    for fd in (0, 1, 2):
                        os.dup2(null, fd)
                    low = 3
                    for keep in sorted((report, lock)):
                        os.closerange(low, keep)
                        low = keep + 1
                    os.closerange(low, os.sysconf("SC_OPEN_MAX"))
                    os.chdir("/")
                    claim(lock)
                    plan.lock_fd = lock
                except BaseException as e:  # noqa: BLE001  said down the pipe
                    with contextlib.suppress(OSError):
                        os.write(report, f"{type(e).__name__}: {e}".encode())
                    os._exit(1)
                os.close(report)  # EOF: the waiter runs
                try:
                    run_waiter(plan, procs)
                finally:
                    os._exit(0)
            status = 0
        except BaseException as e:  # noqa: BLE001  said down the pipe: no waiter started
            with contextlib.suppress(OSError):
                os.write(report, f"{type(e).__name__}: {e}".encode())
        finally:
            os._exit(status)
    os.close(report)
    _, status = os.waitpid(middle, 0)
    with os.fdopen(r, "rb") as f:
        err = f.read().decode("utf-8", "replace")
    if not err and not (os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0):
        err = f"the forking process ended with status {status}"
    return err


def main(argv=None, procs=proc_table, cmdline=proc_cmdline) -> int:
    args = parse(argv)
    if args.cancel:
        return cancel()
    if args.tasks:
        return list_tasks()
    mode = "compact" if args.compact else "plain"
    try:
        plan = prepare(args, procs, cmdline)
    except Refuse as r:
        print(r.message)
        log(mode, "refused", os.environ.get("TMUX_PANE"), r.reason)
        return r.code
    if args.print:
        approved = approved_now(plan, plan.session)
        print(f"mode: {plan.mode} ({'default' if approved else 'plan'})")
        if plan.mode == "plain":
            print(f"carry: {carry_path(plan.pane)}")
        for action in plan.actions(approved):
            print(shlex.join(action))
        return 0
    try:
        lock = take_pending(plan)
    except Refuse as r:
        print(r.message)
        log(mode, "refused", plan.pane, r.reason)
        return r.code
    if args.foreground:
        try:
            claim(lock)
            plan.lock_fd = lock
            return 0 if run_waiter(plan, procs) in ("respawn", "compact") else 1
        finally:
            os.close(lock)
    try:
        err = detach(plan, procs, lock)
    except OSError as e:
        err = f"{type(e).__name__}: {e}"
    finally:
        os.close(lock)
    if err:
        print(f"pass-respawn: the waiter didn't start: {err}")
        log(mode, "error", plan.pane, f"detach: {err}")
        return 1
    what = ("respawn this pane with a fresh claude" if plan.mode == "plain"
            else "type /compact, then the resume prompt")
    print(f"pass-respawn: once this turn ends and session {plan.session_id} goes idle in pane "
          f"{plan.pane}, it will recheck the handoff and {what}, in plan mode unless the first "
          "Next item is approved then.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
