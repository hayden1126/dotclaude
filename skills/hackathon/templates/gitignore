# Secrets: never commit. The scan step checks this too, since an ignore rule can be forced past.
# This also hides Babylon.js's environment texture. To keep one, add `!environment.env` below the
# safe names, and tell the scan with `--allow-name environment.env`, on the user's word.
*.env
# The shape of the config, with no values: these are meant to be committed.
!example.env
!sample.env
!template.env
!dist.env
!default.env
!defaults.env
!*[._-]example.env
!*[._-]sample.env
!*[._-]template.env
!*[._-]dist.env
!*[._-]default.env
!*[._-]defaults.env
# These come after the lines above, so `.env.local.default.env` stays hidden.
.env
.env.*
.env-*
.env_*
.env *
.env(*
.envrc
.envrc.*
.envrc-*
.envrc_*
.envrc *
.envrc(*
!.env[._-]example
!.env[._-]sample
!.env[._-]template
!.env[._-]dist
!.env[._-]default
!.env[._-]defaults
!.envrc[._-]example
!.envrc[._-]sample
!.envrc[._-]template
!.envrc[._-]dist
!.envrc[._-]default
!.envrc[._-]defaults
*.pem
# This also hides a Keynote deck. To keep one, add `!pitch.key` below it, and tell the scan with
# `--allow-name pitch.key`, on the user's word.
*.key
*.p12
*.pfx
*.jks
# This also hides React Native's `debug.keystore`. To keep it, add `!debug.keystore` below it, and
# tell the scan with `--allow-name debug.keystore`, on the user's word.
*.keystore
id_rsa
id_dsa
id_ecdsa
id_ed25519
credentials.json
service-account*.json
service_account*.json
.netrc
.pgpass
.htpasswd
.git-credentials

# Backups and swap files: a backup of a secret holds the secret. The scan also reads copies like
# `credentials (1).json`, and `.save`, which no line here hides since a game may keep those.
*~
\#*\#
[._]*.sw[a-p]
*.bak
*.back
*.backup
*.old
*.ori
*.orig
*.original
*.tmp
*.temp
*.temporary

# Local to this machine
.claude/settings.local.json

# Build output and dependencies
node_modules/
dist/
build/
.next/
__pycache__/
*.pyc
.venv/
.DS_Store
