#!/usr/bin/python3 -I
"""secret-scan: look for secrets in commits, as a separate step before a push.

secret-scan [--remote R] [REF ...]

Default: the commits reachable from REF (default HEAD) that aren't on any remote-tracking ref, so
a push of another branch names that branch. --remote R: those that aren't on R, for a push to
another remote or a new one. No remote-tracking refs: the whole history of REF, which a shallow
clone refuses. --all: every commit on every ref of this clone, also for a repo going public where
it sits, since --remote skips what that remote already holds. A branch or pull request only the
remote holds isn't here to read, so fetch those first. A ref holding no commit (a tag on a blob)
stops --all with exit 2. The last line states what was covered.

It reads added lines and file names, and prints commit, path, line, rule and a masked value,
never the secret. Exit 0 clean, 1 findings, 2 can't run: a git error is never "clean".
A comment `secret-scan: allow` suppresses the content rules on that one line. --allow-name BASENAME
excuses a file name, not its content. Both are counted in the last line, on the user's word only.

Git attributes, the big-file threshold and replace refs can't hide content: every file is read as
text, and NUL bytes are dropped so UTF-16 matches. Not read: commit and tag messages, submodules,
and anything compressed. The rules only find what they know, so exit 0 doesn't prove there are none.
Run it as a plain step in the sandbox, not as a git hook.
"""
import argparse
import base64
import binascii
import math
import os
import re
import subprocess
import sys

CLEAN, FINDINGS, CANT_RUN = 0, 1, 2

# (rule, pattern). Each match is a value to report; anything these catch skips the generic rule.
TOKEN_RULES = [
    ("aws-access-key", re.compile(r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b")),
    ("github-token", re.compile(r"\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{22,})")),
    ("stripe-key", re.compile(r"\b(?:(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,}|whsec_[A-Za-z0-9]{24,})")),
    ("google-key", re.compile(r"\b(?:AIza[0-9A-Za-z_-]{35}|ya29\.[0-9A-Za-z_-]{20,}|GOCSPX-[0-9A-Za-z_-]{20,})")),
    ("slack-token", re.compile(r"\bxox[abeoprs]-[0-9A-Za-z-]{10,}|\bxapp-[0-9A-Za-z-]{10,}")),
    ("slack-webhook", re.compile(r"hooks\.slack\.com/services/T[0-9A-Za-z]+/B[0-9A-Za-z]+/[0-9A-Za-z]+")),
    ("anthropic-key", re.compile(r"\bsk-ant-[A-Za-z0-9_-]{20,}")),
    ("openrouter-key", re.compile(r"\bsk-or-v1-[A-Za-z0-9_-]{20,}")),
    ("openai-key", re.compile(r"\bsk-(?:(?:proj|svcacct|admin)-[A-Za-z0-9_-]{20,}|[A-Za-z0-9]{20,})")),
    ("groq-key", re.compile(r"\bgsk_[A-Za-z0-9]{20,}")),
    ("huggingface-token", re.compile(r"\bhf_[A-Za-z0-9]{20,}")),
    ("replicate-token", re.compile(r"\br8_[A-Za-z0-9]{20,}")),
    ("xai-key", re.compile(r"\bxai-[A-Za-z0-9]{20,}")),
    ("sendgrid-key", re.compile(r"\bSG\.[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{16,}")),
    ("npm-token", re.compile(r"\bnpm_[A-Za-z0-9]{36}\b")),
    ("supabase-token", re.compile(r"\bsbp_[a-f0-9]{40}\b")),
    ("jwt", re.compile(r"\beyJ[A-Za-z0-9_-]{5,}\.eyJ[A-Za-z0-9_-]{5,}\.")),
    ("private-key-block", re.compile(r"-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY(?: BLOCK)?-----")),
]

# Any line, whatever the name around it. A token the rules above name stays under its own rule.
BEARER = re.compile(r"(?i)\bbearer\s+([A-Za-z0-9._~+/-]{20,}=*)")
BASIC = re.compile(r"\bBasic\s+([A-Za-z0-9+/]{12,}={0,2})(?![A-Za-z0-9+/=])")

# name = value, name: "value", name := value, "name": "value", name => value, name: str = "value".
# The name is bounded so a very long run of word characters can't make the search quadratic.
NAME = r"""([A-Za-z_][\w.-]{0,128})["']?\s*(?::\s*[\w.\[\]|]+\s*(?==))?"""
ASSIGNMENT = re.compile(NAME + r"""(?::=|=>|=|:)\s*(?:[A-Za-z]{0,2}(["'`]))?"""
                        r"""([^\s"'`,;(){}<>\[\]]{16,2048})""")
SECRET_WORDS = {"key", "keys", "apikey", "apikeys", "secret", "secrets", "token", "tokens",
                "password", "passwords", "passwd", "pwd", "pass", "credential", "credentials",
                "auth", "authorization"}
# All-caps or lowercase compounds, which split into one word: PGPASSWORD, AUTHTOKEN, clientsecret.
# Only stems no ordinary word ends in, so monkey, compass and cwd stay out.
SECRET_ENDINGS = ("password", "passwords", "passwd", "secret", "secrets", "token", "tokens",
                  "apikey", "apikeys", "secretkey", "authkey")
PASSWORD_ENDINGS = ("password", "passwd")
# A name that is a secret by its last word, so a value of plain words counts too. A `key` needs the
# word before it: secret_key is one, storage_key and token_key name a slot.
STRONG_ENDINGS = ("secret", "secrets", "token", "tokens", "apikey", "apikeys", "secretkey", "authkey",
                  "credential", "credentials")
KEY_OF = {"secret", "api", "signing", "private", "encryption", "jwt", "access", "session", "auth",
          "master"}
SLUG = re.compile(r"[A-Za-z]+(?:[-_.:/](?:[A-Za-z]+|[A-Za-z]{0,2}\d{1,4}))*")  # demo-state-v1
ENV_NAME = re.compile(r"[A-Z][A-Z0-9_]*")  # api_key = "OPENWEATHER_API_KEY" names where it lives

# A password can be short and plain, so it takes a literal of 8 or more, quoted or bare, and a
# comparison counts: `if password == "..."` holds it just the same.
PASSWORD = re.compile(NAME + r"""(?:[!=]==?|:=|=>|=|:)\s*"""
                      r"""(?:[A-Za-z]{0,2}(["'`])((?:(?!\2).){8,256})\2|([^\s"'`,;(){}<>\[\]]{8,256}))""")
PASSWORD_WORDS = {"password", "passwd", "pwd", "pass"}
NOT_A_LITERAL = re.compile(r"\$\{|\{\s*[\w.]*\s*\}|%\(|%[sd]\b|^<.*>$|^\.{0,2}/|^~/")
CODE_REFERENCE = re.compile(r"[A-Za-z_.]+|[A-Za-z_]\w*(?:\.[A-Za-z_]\w*)+")  # db_password, a.b2.c
ENV_LINE_PREFIXES = ("", "export", "-", "env")  # shell, .env, compose lists, Dockerfile
# A label or an error message beside a password field, rather than a passphrase.
MESSAGE = re.compile(r"(?i)\b(?:passwords?|required|invalid|incorrect|wrong|must|enter|please|"
                     r"match|characters?|at least|try again|forgot|confirm|new|current|your)\b")

URL_PASSWORD = re.compile(r"\b[a-z][a-z0-9+.-]*://[^\s/:@'\"]*:([^\s/:@'\"]{3,})@([^\s/:'\"]+)")
# postgres://{user}:{password}@host, <password>, $PASS, %(pw)s, or the bare word in a doc's example.
URL_TEMPLATE = re.compile(r"(?i)[{}<>$\[\]]|%\(|^(?:pass(?:word|wd)?|pwd|secret|token)$")
PLACEHOLDER = re.compile(r"(?i)example|placeholder|changeme|change_me|your[_-]|xxxx|dummy|sample"
                         r"|redacted|process\.env|os\.environ|import\.meta|^\$|://")
LOCAL_HOSTS = ("localhost", "127.0.0.1", "0.0.0.0", "db", "postgres", "mysql", "redis")

# Matched on the file's base name, lowercased. Example files are content-scanned like any other.
SECRET_FILE = re.compile(r"\.env(?:\..+)?|.+\.(?:pem|key|p12|pfx|jks|keystore)"
                         r"|id_(?:rsa|dsa|ecdsa|ed25519)|\.netrc|\.pgpass|\.htpasswd"
                         r"|\.git-credentials|credentials\.json|service[-_]account.*\.json")
SAFE_FILE = re.compile(r"\.env\.(?:example|sample|template|dist|defaults?)")

GIT = ["git", "--no-pager", "--no-replace-objects"]  # a replace ref can't change what's read
os.environ["GIT_GRAFT_FILE"] = os.devnull + "/none"  # and a graft file can't hide a commit
ALLOW = "secret-scan: allow"
HUNK = re.compile(rb"^@@ -\S+ \+(\d+)")


class CantRun(Exception):
    pass


def entropy(value):
    return -sum(n / len(value) * math.log2(n / len(value))
                for n in (value.count(c) for c in set(value)))


def name_words(name):
    spaced = re.sub(r"(?<=[a-z0-9])(?=[A-Z])", "_", name).lower()
    return [word for word in re.split(r"[_.-]+", spaced) if word]


def is_secret_name(name):
    words = name_words(name)
    return (bool(SECRET_WORDS.intersection(words)) or "service_role" in "_".join(words)
            or any(word.endswith(SECRET_ENDINGS) for word in words))


def is_strong_name(name):
    """The last word makes it a secret, so a value of plain words counts too."""
    words = name_words(name)
    if not words:
        return False
    return (words[-1].endswith(STRONG_ENDINGS)
            or (words[-1] == "key" and len(words) > 1 and words[-2] in KEY_OF))


def says_password(name):
    """The last word decides: ADMIN_PASSWORD is a password, password_hint is a hint."""
    words = name_words(name)
    if not words:
        return False
    last = words[-1].rstrip("0123456789")
    return last in PASSWORD_WORDS or last.endswith(PASSWORD_ENDINGS)


def is_env_line(name, name_end, value_end, text):
    """NAME=value alone on its line, as in a .env file, a shell script or a compose list. An
    indented lowercase name with no prefix is a keyword argument on its own line instead."""
    if text[name_end:name_end + 1] != "=":
        return False
    rest = text[value_end:].strip()
    if rest and not rest.startswith("#"):
        return False
    before = text[:name_end - len(name)]
    word = before.strip().lower()
    return word in ENV_LINE_PREFIXES and (not before or bool(word) or name.isupper())


def is_password_literal(m, text):
    """A match of PASSWORD holds a typed-in value: quoted, or bare on an env-file line, or bare
    and unable to be a variable. Never a placeholder, an interpolation, a path, a call or a
    message."""
    value = m.group(3) or m.group(4)
    if (PLACEHOLDER.search(value) or NOT_A_LITERAL.search(value)
            or not any(c.isalnum() for c in value)):
        return False
    if m.group(3):
        return not (re.search(r"\s", value) and MESSAGE.search(value))
    if text[m.end(4):m.end(4) + 1] == "(":
        return False
    return is_env_line(m.group(1), m.end(1), m.end(4), text) or not CODE_REFERENCE.fullmatch(value)


def looks_random(value):
    return (any(c.isdigit() for c in value) and any(c.isalpha() for c in value)
            and entropy(value) > 3.2 and not PLACEHOLDER.search(value))


def is_assignment_secret(m, text):
    """A match of ASSIGNMENT holds a secret: random-looking under any secret name, unless it reads
    as a slug under a weak one, or plain words under a strong name, closed in quotes or alone on
    an env-file line."""
    name, quote, value = m.group(1), m.group(2), m.group(3)
    if not is_secret_name(name) or text[m.end(3):m.end(3) + 1] == "(":
        return False
    strong = is_strong_name(name)
    if looks_random(value):
        return strong or not SLUG.fullmatch(value)
    if not strong or PLACEHOLDER.search(value) or NOT_A_LITERAL.search(value):
        return False
    closed = bool(quote) and text[m.end(3):m.end(3) + 1] == quote
    return ((closed or is_env_line(name, m.end(1), m.end(3), text))
            and not ENV_NAME.fullmatch(value) and any(c.isalpha() for c in value))


def is_basic_credential(value):
    """A base64 value that decodes to printable user:password, so `Basic usage` stays out."""
    try:
        decoded = base64.b64decode(value + "=" * (-len(value) % 4), validate=True).decode("ascii")
    except (binascii.Error, ValueError):
        return False
    return ":" in decoded and decoded.isprintable()


def overlapping(pattern, text):
    """Every match on the line, looking again right after each name, since what follows can hold
    the next name: https://host/?apiKey=..., run: API_KEY=..., jdbc:...?password=..."""
    pos = 0
    while (m := pattern.search(text, pos)):
        yield m
        pos = m.end(1)


def mask(value, keep=4):
    """The fixed prefix of a provider token says which key to rotate; a free-form value shows
    nothing at all."""
    return value[:keep] + "***" if keep else "***"


def scan_line(text):
    """[(rule, masked value)] for one added line, whether or not it carries an allow comment."""
    found, spans = [], []

    def add(rule, masked, span):
        found.append((rule, masked))
        spans.append(span)

    def taken(start, end):
        return any(s < end and start < e for s, e in spans)

    for rule, pattern in TOKEN_RULES:
        for m in pattern.finditer(text):
            if not PLACEHOLDER.search(m.group(0)) and entropy(m.group(0)) >= 2.5:
                add(rule, mask(m.group(0)), m.span())
    for m in BEARER.finditer(text):
        if not taken(*m.span(1)) and not PLACEHOLDER.search(m.group(1)):
            add("bearer-token", mask(m.group(1), 0), m.span(1))
    for m in BASIC.finditer(text):
        if is_basic_credential(m.group(1)):
            add("basic-auth", mask(m.group(1), 0), m.span(1))
    for m in overlapping(ASSIGNMENT, text):
        if is_assignment_secret(m, text) and not taken(*m.span(3)):
            add("assignment", mask(m.group(3), 0), m.span(3))
    for m in overlapping(PASSWORD, text):
        span = m.span(3) if m.group(3) else m.span(4)
        if says_password(m.group(1)) and is_password_literal(m, text) and not taken(*span):
            add("assignment", mask(m.group(3) or m.group(4), 0), span)
    for m in URL_PASSWORD.finditer(text):
        host = m.group(2).split("/")[0].split(":")[0].lower()
        if (host not in LOCAL_HOSTS and not PLACEHOLDER.search(m.group(1))
                and not URL_TEMPLATE.search(m.group(1))):
            found.append(("url-password", mask(m.group(1), 0)))
    return found


def base_name(path):
    return path.strip('"').rsplit("/", 1)[-1]


def is_secret_file(path):
    base = base_name(path).lower()
    return bool(SECRET_FILE.fullmatch(base)) and not SAFE_FILE.fullmatch(base)


def git(*args):
    """A git call that must work: its stdout, or CantRun."""
    try:
        p = subprocess.run([*GIT, *args], capture_output=True, text=True)
    except OSError as e:
        raise CantRun(f"can't start git: {e}") from e
    if p.returncode != 0:
        raise CantRun(p.stderr.strip() or f"git {args[0]} exited {p.returncode}")
    return p.stdout.strip()


def resolve(ref):
    """REF's commit. The scan passes on this hash, so a REF can't reach git log as an option."""
    try:
        return git("rev-parse", "--verify", "--quiet", "--end-of-options", f"{ref}^{{commit}}")
    except CantRun as e:
        raise CantRun(f"{ref} doesn't resolve to a commit") from e


def refuse_shallow(why):
    if git("rev-parse", "--is-shallow-repository") == "true":
        raise CantRun(f"shallow clone {why}: older commits aren't here to scan")


def refuse_refs_without_a_commit():
    """git log --all skips a ref on a blob or a tree, and a push of it publishes that content."""
    listing = git("for-each-ref", "--format=%(refname) %(objecttype) %(*objecttype)")
    for row in listing.splitlines():
        name, *kinds = row.split()
        if kinds[-1] != "commit":
            raise CantRun(f"{name} points at a {kinds[-1]}, not a commit, so --all can't read it")


def choose_revisions(refs, remote, scan_all):
    """(git log revision args, what they cover)."""
    git("rev-parse", "--git-dir")
    names = " ".join(refs or ["HEAD"])
    commits = [resolve(ref) for ref in refs or ["HEAD"]]
    if scan_all:
        refuse_shallow("with --all")
        refuse_refs_without_a_commit()
        return ["--exclude=refs/stash", "--all"], "every commit on this clone's refs"
    if remote is not None and (not remote or re.search(r"[*?\[\\]", remote)):
        raise CantRun(f"--remote takes one remote's name, not {remote!r}")
    tracked = "refs/remotes/" + (f"{remote}/" if remote else "")
    if git("for-each-ref", "--count=1", "--format=%(refname)", tracked):
        exclude = f"--remotes={remote}" if remote else "--remotes"
        return ([*commits, "--not", exclude],
                f"{names}, commits not on {remote or 'any remote-tracking ref'}")
    refuse_shallow("with nothing to exclude")
    nothing = f"nothing tracked from {remote}" if remote else "no remote-tracking refs"
    return commits, f"all of {names}'s history ({nothing})"


def log_command(revisions):
    # Each flag pins something a user's git config or attributes change: a prefix, the root
    # commit's diff, a subdir-only view, a renamed file hiding its content, a file printed as
    # "Binary files differ". A merge is read against its first parent, so content that only the
    # merge adds is still seen; what another parent already held is dropped in Scan.
    return [*GIT, "-c", "core.quotepath=off", "-c", "log.showroot=true",
            "-c", "core.bigFileThreshold=2g", "-c", "core.attributesFile=", "log",
            "--format=%x00%H %P", "-p", "-U0", "--inter-hunk-context=0", "--text", "--no-color", "--no-ext-diff",
            "--no-textconv", "--no-renames", "--no-relative", "--no-show-signature",
            "--src-prefix=a/", "--dst-prefix=b/", "--diff-merges=first-parent", "--topo-order",
            "--reverse", *revisions]


def parent_blob(parent, path):
    """The file's bytes in that parent, or None. Failing to read it only means it gets reported."""
    try:
        p = subprocess.run([*GIT, "cat-file", "blob", f"{parent}:{path}"], capture_output=True)
    except OSError:
        return None
    return p.stdout if p.returncode == 0 else None


def header_path(line):
    """The path from `diff --git a/P b/P` (or the quoted form). With renames off both sides
    hold the same path, so its length follows from the line's, and a space in P can't mislead."""
    rest = line[len("diff --git "):]
    half = rest[:(len(rest) - 1) // 2]
    return half.replace('"a/', '"', 1) if half.startswith('"') else half[2:]


class Scan:
    def __init__(self, allow_names=()):
        self.allow_names = set(allow_names)
        self.findings = []  # (commit, path, line, rule, masked)
        self.seen = set()   # (path, rule, masked) from ordinary commits, to quiet their merges
        self.allowed_lines = 0
        self.allowed_seen = set()  # (path, findings) of comment-allowed lines, the same way
        self.allowed_paths = set()
        self.commits = 0
        self.commit = ""
        self.is_merge = False
        self.other_parents = []
        self.parent_lines = {}  # path -> lines the merge's other parents hold, or None for no file
        self.path = None
        self.in_header = False
        self.pending_file = False
        self.line_no = 0

    def other_parents_hold(self):
        """What this merge's other parents hold at this path. Those commits are either read in this
        range, and reported there, or excluded from it because they're already pushed."""
        key = (self.commit, self.path)
        if key not in self.parent_lines:
            blobs = [parent_blob(parent, self.path) for parent in self.other_parents]
            found = [blob for blob in blobs if blob is not None]
            self.parent_lines[key] = {line for blob in found for line in blob.split(b"\n")} if found else None
        return self.parent_lines[key]

    def report(self, line, rule, masked):
        key = (self.path, rule, masked)
        if self.is_merge and key in self.seen:
            return  # a merge repeats what its side branch already reported
        self.seen.add(key)
        self.findings.append((self.commit[:12], self.path, line, rule, masked))

    def allow_line(self, found):
        key = (self.path, tuple(found))
        if not (self.is_merge and key in self.allowed_seen):
            self.allowed_lines += 1
        self.allowed_seen.add(key)

    def flush_file(self):
        if self.pending_file:
            if self.is_merge and self.other_parents_hold() is not None:
                pass  # the file came with another parent
            elif base_name(self.path) in self.allow_names:
                self.allowed_paths.add(self.path)
            else:
                self.report("-", "secret-file", "(file name)")
        self.pending_file = False

    def feed(self, raw):
        raw = raw.rstrip(b"\n")
        if raw.startswith(b"\0"):
            self.flush_file()
            words = raw[1:].decode("ascii", "replace").split()
            self.commit, self.is_merge = words[0], len(words) > 2
            self.other_parents = words[2:]
            self.commits += 1
            self.path = None
            return
        if raw.startswith(b"diff --git "):
            self.flush_file()
            self.path = header_path(raw.decode("utf-8", "replace"))
            self.in_header = True
            self.pending_file = is_secret_file(self.path)
            return
        if self.in_header:
            hunk = HUNK.match(raw)
            if hunk:
                self.in_header = False
                self.line_no = int(hunk.group(1))
            elif raw.startswith(b"deleted file mode"):
                self.pending_file = False
            elif raw.startswith(b"Binary files "):  # --text rules this out: never skip a file
                raise CantRun(f"git hid the content of {self.path}")
            return
        hunk = HUNK.match(raw)
        if hunk:
            self.line_no = int(hunk.group(1))
        elif raw.startswith(b"+"):
            # NUL bytes out, so a UTF-16 file's letters line up for the rules.
            text = raw[1:].replace(b"\0", b"").decode("utf-8", "replace")
            found = scan_line(text)
            if found and self.is_merge and raw[1:] in (self.other_parents_hold() or ()):
                pass  # this exact line came with another parent
            elif found and ALLOW in text:
                self.allow_line(found)
            else:
                for rule, masked in found:
                    self.report(self.line_no, rule, masked)
            self.line_no += 1


def run_scan(revisions, allow_names):
    scan = Scan(allow_names)
    try:
        proc = subprocess.Popen(log_command(revisions), stdout=subprocess.PIPE)
    except OSError as e:
        raise CantRun(f"can't start git: {e}") from e
    with proc.stdout:
        for raw in proc.stdout:
            scan.feed(raw)
    scan.flush_file()
    if proc.wait() != 0:  # git's own message went to stderr
        raise CantRun(f"git log exited {proc.returncode}, so the scan is incomplete")
    return scan


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0],  # bad args: exit 2
                                     allow_abbrev=False)
    parser.add_argument("refs", nargs="*", metavar="REF", help="what's being pushed (default HEAD)")
    parser.add_argument("--remote", metavar="R",
                        help="scan what isn't on R, rather than on any remote-tracking ref")
    parser.add_argument("--all", action="store_true", help="scan every commit on every ref")
    parser.add_argument("--allow-name", action="append", default=[], metavar="BASENAME",
                        help="excuse this file name, only on the user's word (repeatable)")
    args = parser.parse_args()
    if args.all and (args.refs or args.remote is not None):
        parser.error("--all reads every ref: give it no REF and no --remote")
    sys.stdout.reconfigure(errors="backslashreplace")
    sys.stderr.reconfigure(errors="backslashreplace")
    try:
        revisions, covers = choose_revisions(args.refs, args.remote, args.all)
        scan = run_scan(revisions, args.allow_name)
    except CantRun as e:
        print(f"secret-scan: can't run: {e}", file=sys.stderr)
        return CANT_RUN
    for commit, path, line, rule, masked in scan.findings:
        print(f"{commit} {path}:{line} {rule} {masked}")
    for path in sorted(scan.allowed_paths):
        print(f"secret-scan: file name allowed by --allow-name: {path}")
    summary = [f"{scan.commits} commit(s)"]
    if scan.allowed_lines:
        summary.append(f"{scan.allowed_lines} line(s) allowed by comment")
    if scan.allowed_paths:
        summary.append(f"{len(scan.allowed_paths)} file name(s) allowed by --allow-name")
    summary = ", ".join([*summary, covers])
    if scan.findings:
        print(f"secret-scan: {len(scan.findings)} finding(s) in {summary}")
        return FINDINGS
    print(f"secret-scan: clean, {summary}")
    return CLEAN


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:  # a crash is "couldn't scan", never a clean exit or a "finding"
        print(f"secret-scan: can't run: {type(e).__name__}: {e}", file=sys.stderr)
        sys.exit(CANT_RUN)
