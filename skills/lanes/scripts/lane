#!/usr/bin/env python3
"""lane: parallel Claude sessions, one git worktree ("lane") each, with single-writer records.

  lane init [--root DIR] [--setup CMD] [--ports A-B] [--cap N] [--locks A,B]
            [--autopass | --no-autopass]
  lane new <id> [--branch B] [--claim N ...] [--goal T] [--files T] [--overlaps T]
               [--done-when T] [--constraints T]
  lane adopt <path> [--id SLUG]
  lane ls [--json] [--requests]
  lane open <id> [--focus] [--print] [prompt]
  lane lock <name> [--wait SECS] -- <cmd...>
  lane whoami [--json]
  lane claim <req> ... | lane release <req> ... | lane who <req>
  lane note <text>
  lane asks
  lane done <id> [--abandon]

Records: CLI data in <common-dir>/lanes/<id>/lane.json, the lane's prose in <lane>/.lane/STATUS.md,
the config in $XDG_STATE_HOME/dotclaude/lanes/ (why, and what is checked before sandbox-off code
acts on a sandbox-writable file: docs/lanes.md S3). Every write takes the flock on <common-dir>/lanes/.lock. Board fields (ahead/behind, PR state,
liveness, flags) are derived on each `ls`, never stored. skills/lanes/SKILL.md is the guide and
docs/lanes.md the design. Run `init`, `new`, `adopt`, `ls`, `open` and `done` bare, so their
excludedCommands entries take them out of the sandbox: `new`, `ls` and `done` need the network and
the GitHub credential (`new` refuses without them; `ls` and `done` say what they skipped), and
`ls`, `open` and `done` need to see other processes. Every other subcommand runs sandboxed; `lock` must, so the command it wraps
stays sandboxed too.

`lock` exits with its command's code, or dies of the signal that killed it; `--wait` running out
exits 75, which a command's own 75 can't be told from: only the "gave up on lock" line on stderr
marks a timeout.
"""
import argparse
import contextlib
import datetime
import errno
import fcntl
import json
import os
import re
import resource
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import lanelib  # noqa: E402  (beside this script's real path)
from lanelib import Repo, git, lock, now_iso, write_json  # noqa: E402

TEMPLATE = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "..",
                        "templates", "LANE.md")
HOOKS = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "..", "hooks")
SID = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}")  # hooks/stop_ring.py SID
CTX_MARK = {"soft": "*", "wrap": "*", "hard": "!"}  # the board's CTX mark per auto-pass tier
DEFAULT_CAP = 4
LOCK_BUSY = 75  # EX_TEMPFAIL: `lane lock --wait` gave up on a held lock
PROBE_GRACE = 0.05  # secs `lane lock` waits out a `lane ls` probe before it reports a holder
HOLDER_CMD_MAX = 120  # chars of the wrapped command kept in a lock's holder line
# new's brief flags -> the <placeholder> each fills in templates/LANE.md
BRIEF = {"goal": "goal", "files": "files", "overlaps": "overlaps", "done_when": "done-when",
         "constraints": "constraints"}


class LaneError(Exception):
    """A refusal or failure with a message for the user; exits 1."""


def say(msg: str) -> None:
    print(msg, flush=True)


def warn(msg: str) -> None:
    print(f"lane: {msg}", file=sys.stderr, flush=True)


def repo_here() -> Repo:
    repo = lanelib.resolve(os.getcwd())
    if repo is None:
        raise LaneError("not inside a git work tree")
    return repo


def lanes_repo() -> Repo:
    repo = repo_here()
    if not repo.has_lanes:
        old = os.path.join(repo.lanes_dir, "config.toml")
        hint = (f". {old} is the old layout's config, which sandboxed Bash could write, so it is "
                "no longer read: run `lane init` with the flags you want (don't copy its `setup` "
                "or `root` unread), then delete it") if os.path.isfile(old) else ""
        raise LaneError(f"no lanes config at {repo.config_path}: run `lane init` in the main "
                        f"checkout{hint}")
    return repo


def own_lane(repo: Repo) -> dict:
    kind, lane = repo.identity()
    if kind != "lane":
        raise LaneError(f"this checkout is {kind}, not a lane: run this from inside the lane")
    return lane


def toml_value(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, int):
        return str(v)
    s = str(v).replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")
    return f'"{s}"'


def write_config(repo: Repo, cfg: dict) -> None:
    """Flat keys only: the config never nests."""
    body = "# lanes config, written by `lane init`; flat keys only.\n"
    body += f"# repo: {repo.common_dir}\n"
    body += "".join(f"{k} = {toml_value(v)}\n" for k, v in cfg.items())
    lanelib.write_text(repo.config_path, body)


def parse_ports(spec: str) -> range | None:
    if not spec:
        return None
    try:
        lo, hi = (int(x) for x in spec.split("-", 1))
    except ValueError:
        raise LaneError(f"--ports wants A-B, got {spec!r}")
    if not 0 < lo <= hi < 65536:
        raise LaneError(f"bad port range {spec!r}")
    return range(lo, hi + 1)


def parse_locks(spec: str) -> list[str]:
    """The config's `locks`, "gate,e2e" -> ["gate", "e2e"]; each name becomes a file name."""
    names = [n.strip() for n in (spec or "").split(",") if n.strip()]
    bad = [n for n in names if not lanelib.ID_RE.fullmatch(n) or ".." in n]
    if bad:
        raise LaneError(f"bad lock name(s) {', '.join(bad)}: a slug of letters, digits, '.', '_', "
                        "'-' that starts with a letter or digit, with no '..'")
    return names


def lock_path(repo: Repo, name: str) -> str:
    return os.path.join(repo.lanes_dir, lanelib.LOCKS, name)


def holder_of(fd: int) -> str:
    """The holder line a `lane lock` run writes into its lock file once it holds the lock."""
    return (os.pread(fd, 4096, 0).decode(errors="replace").strip()
            or "an unknown holder (it has just taken the lock)")


def lock_holder(repo: Repo, name: str) -> str | None:
    """Who holds lock name, or None when it is free: a shared, non-blocking probe, let go at once."""
    try:
        fd = os.open(lock_path(repo, name), os.O_RDONLY | os.O_CLOEXEC)
    except FileNotFoundError:
        return None
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError:
            return holder_of(fd)
        fcntl.flock(fd, fcntl.LOCK_UN)
        return None
    finally:
        os.close(fd)


def sessions_in(live: list[dict], path: str) -> list[dict]:
    """The live sessions whose cwd is path or under it."""
    return [s for s in live if lanelib.inside(s.get("cwd") or "/nonexistent", path)]


def window_of(target: str) -> str:
    """A session file's tmux target `session:@window.%pane` -> `session:@window` (tmux allows no
    '.' in a session name)."""
    return target.rpartition(".")[0] or target


def fetch(repo: Repo) -> bool:
    p = git(["fetch", "--quiet", "origin"], repo.toplevel)
    if p.returncode != 0:
        line = (p.stderr.strip().splitlines() or ["unknown error"])[-1]
        warn(f"fetch skipped ({line}); using the local remote-tracking refs")
        return False
    return True


def rev(repo: Repo, ref: str) -> str | None:
    p = git(["rev-parse", "--verify", "--quiet", "--end-of-options", ref + "^{commit}"],
            repo.toplevel)
    return p.stdout.strip() if p.returncode == 0 else None


def base_ref(cfg: dict) -> str:
    """The base as a full ref. A short `origin/main` also names a tag or branch of that name,
    which sandboxed Bash can make and git would prefer to the remote-tracking ref."""
    base = cfg.get("base", "origin/main")
    return base if base.startswith("refs/") else f"refs/remotes/{base}"


def fetched_base(repo: Repo, cfg: dict) -> str:
    """The commit the remote's base branch is at now, fetched. `new` branches only from this:
    sandboxed Bash can write every local ref, so neither a failed fetch's fallback to the local
    remote-tracking ref nor a ref rewritten after the fetch may choose the commit a lane's
    setup then runs on, sandbox-off."""
    ref = base_ref(cfg)
    rest = ref.removeprefix("refs/remotes/")
    # The longest remote name that prefixes it: a remote's name may hold a '/' (my/fork).
    remotes = git(["remote"], repo.toplevel).stdout.split()
    remote = max((r for r in remotes if rest.startswith(r + "/")), key=len, default="")
    branch = rest[len(remote) + 1:] if remote else ""
    if not ref.startswith("refs/remotes/") or not branch:
        raise LaneError(f"the config's base {cfg.get('base')!r} must be <remote>/<branch> for a "
                        f"remote this repo has (a lane branches from the remote's commit): fix it "
                        f"in {repo.config_path}")
    def failed(what, p):
        line = (p.stderr.strip().splitlines() or ["unknown error"])[-1]
        return LaneError(f"{what} failed ({line}): a lane branches only from a freshly fetched "
                         f"{remote}/{branch}. Run a bare `lane new` (outside the sandbox) with "
                         "the network up")

    # Asked first, fetched second: the fetch then brings that commit (or a descendant of it, if
    # someone pushes in between), so only a force-push in between fails the check below.
    head = f"refs/heads/{branch}"
    p = git(["ls-remote", "--exit-code", remote, head], repo.toplevel)
    if p.returncode not in (0, 2):  # 2: no matching ref
        raise failed("ls-remote", p)
    # ls-remote matches a pattern against a ref's tail (a/refs/heads/main matches too): only the
    # exact ref counts.
    shas = [f[0] for f in map(str.split, p.stdout.splitlines()) if len(f) == 2 and f[1] == head]
    if len(shas) != 1 or not lanelib.SHA_RE.fullmatch(shas[0]):
        raise LaneError(f"the remote has no {head} for base {remote}/{branch}")
    p = git(["fetch", "--quiet", remote], repo.toplevel)
    if p.returncode != 0:
        raise failed("fetch", p)
    if rev(repo, shas[0]) != shas[0]:
        raise LaneError(f"the fetch didn't bring {remote}/{branch}'s commit {shas[0][:12]}: the "
                        f"remote was force-pushed meanwhile, or {remote}'s fetch refspec doesn't "
                        f"cover {branch}")
    return shas[0]


def worktrees(repo: Repo) -> dict[str, str]:
    """Registered worktree path (real) -> branch name ('' when detached)."""
    p = git(["worktree", "list", "--porcelain"], repo.toplevel, check=True)
    out, path = {}, None
    for line in p.stdout.splitlines():
        if line.startswith("worktree "):
            path = os.path.realpath(line[len("worktree "):])
            out[path] = ""
        elif line.startswith("branch ") and path:
            out[path] = line[len("branch "):].removeprefix("refs/heads/")
    return out


def check_id(lane_id: str) -> None:
    """Every subcommand that takes an id checks it first: an id becomes a path under lanes/."""
    if not lanelib.valid_id(lane_id):
        raise LaneError(f"bad lane id {lane_id!r}: a slug of letters, digits, '.', '_', '-' that "
                        "starts with a letter or digit, with no '..'; not 'main'")


def requests(raw: list[str]) -> list[str]:
    """Requests as claimed: '42' -> '#42', and each a short token (lanelib.CLAIM_RE), since a
    record holding anything else is refused on load."""
    reqs = [lanelib.norm_request(r) for r in raw]
    if bad := [r for r in reqs if not lanelib.CLAIM_RE.fullmatch(r)]:
        raise LaneError(f"bad request {bad[0]!r}: a number, or a tracker key of letters, "
                        "digits, '.', '_', '-'")
    return reqs


def check_unregistered(repo: Repo, lane_id: str) -> None:
    check_id(lane_id)
    if os.path.lexists(repo.lane_dir(lane_id)):
        raise LaneError(f"lane {lane_id} is already registered (or {repo.lane_dir(lane_id)} "
                        "exists)")


def lane_data_dir(repo: Repo, lane_id: str) -> str:
    """lanes/<id>, asserted to sit directly inside lanes/ before anything deletes it."""
    check_id(lane_id)
    d = os.path.realpath(repo.lane_dir(lane_id))
    if os.path.dirname(d) != os.path.realpath(repo.lanes_dir):
        raise LaneError(f"refusing: {d} is not a lane dir inside {repo.lanes_dir}")
    return d


def free_port(repo: Repo, cfg: dict) -> int | None:
    ports = parse_ports(cfg.get("ports", ""))
    if ports is None:
        return None
    used = {lane.get("port") for lane in repo.lanes(shared=True)}
    for port in ports:
        if port not in used:
            return port
    raise LaneError(f"no free port in {cfg['ports']}: every one is held by a lane")


def add_exclude(repo: Repo) -> None:
    """Hide every lane's .lane/ through the shared info/exclude, once. This runs sandbox-off, so
    a linked info/ or exclude (which sandboxed Bash could plant) is refused, not appended to."""
    info = os.path.join(repo.common_dir, "info")
    path = os.path.join(info, "exclude")
    if os.path.islink(info) or os.path.islink(path):
        raise LaneError(f"refusing: {info} or its exclude is a symlink")
    try:
        with open(path) as f:
            text = f.read()
    except FileNotFoundError:
        text = ""
    if "/.lane/" in text.splitlines():
        return
    os.makedirs(info, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, "a") as f:
        f.write(("" if not text or text.endswith("\n") else "\n") + "/.lane/\n")


def copy_includes(repo: Repo, dest: str) -> list[str]:
    """Copy the main checkout's gitignored files that .worktreeinclude matches (gitignore syntax).
    An existing file is never overwritten: in a finished lane it may hold a lane-local fix."""
    include = os.path.join(repo.main, ".worktreeinclude")
    if not os.path.isfile(include):
        return []
    p = git(["ls-files", "--others", "--ignored", f"--exclude-from={include}"], repo.main, check=True)
    matched = [x for x in p.stdout.splitlines() if x]
    if not matched:
        return []
    ignored = subprocess.run(["git", "check-ignore", "--stdin"], cwd=repo.main, input="\n".join(matched),
                             capture_output=True, text=True).stdout.splitlines()
    copied = []
    for rel in ignored:
        if any(part in ("", ".", "..") for part in rel.split("/")):
            warn(f"not copied from .worktreeinclude: {rel!r} is no plain path")
            continue
        try:
            if copy_one(repo.main, dest, rel):
                copied.append(rel)
        except NotADirectoryError:
            warn(f"not copied from .worktreeinclude: {rel} (a dir on its way is a symlink)")
    return copied


def open_parent(root: str, rel: str, create: bool) -> tuple[int, str]:
    """(fd of root/rel's dir, rel's last name), opening each dir below root by fd with
    O_NOFOLLOW: a symlink anywhere on the way, even one swapped in mid-walk, fails the open
    instead of leading out of root. create makes missing dirs."""
    fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY)
    *dirs, name = rel.split("/")
    try:
        for d in dirs:
            if create:
                with contextlib.suppress(FileExistsError):
                    os.mkdir(d, dir_fd=fd)
            try:
                nxt = os.open(d, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            except OSError as e:
                if e.errno in (errno.ELOOP, errno.ENOTDIR):
                    raise NotADirectoryError(e.errno, e.strerror, d)
                raise
            os.close(fd)
            fd = nxt
    except BaseException:
        os.close(fd)
        raise
    return fd, name


def copy_fd(src: int, out: int) -> None:
    os.lseek(src, 0, os.SEEK_SET)
    while chunk := os.read(src, 1 << 20):
        view = memoryview(chunk)
        while view:
            view = view[os.write(out, view):]


def copy_one(main: str, dest: str, rel: str) -> bool:
    """Copy main/rel to dest/rel, unless dest/rel exists; True if copied. This runs sandbox-off,
    and sandboxed Bash can plant both the file and .worktreeinclude, and the lane's own session
    can plant links in dest. So both sides go by dir fd (open_parent); a link is copied as a
    link, never read through, so the sandbox's read deny still holds at its target (a relative
    one is made absolute, naming the same file from the lane); a regular file is read from an
    fd opened with O_NOFOLLOW and checked by fstat; anything else is left alone. The copy goes
    to a fresh temp renamed into place whole: a failure never leaves half a file, and no
    neighbouring file (a `<name>.part` of the lane's own) is clobbered or deleted."""
    sdir, name = open_parent(main, rel, create=False)
    src = link = None
    try:
        st = os.stat(name, dir_fd=sdir, follow_symlinks=False)
        if stat.S_ISLNK(st.st_mode):
            link = os.readlink(name, dir_fd=sdir)
            if not os.path.isabs(link):
                link = os.path.normpath(os.path.join(main, os.path.dirname(rel), link))
        else:
            try:  # O_NONBLOCK: opening a FIFO must not wait for a writer
                src = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=sdir)
            except OSError as e:
                if e.errno != errno.ELOOP:  # ELOOP: swapped for a link since the stat
                    raise
            if src is None or not stat.S_ISREG((st := os.fstat(src)).st_mode):
                warn(f"not copied from .worktreeinclude: {rel} is not a regular file")
                return False
        ddir, dname = open_parent(dest, rel, create=True)
        try:
            with contextlib.suppress(FileNotFoundError):
                os.stat(dname, dir_fd=ddir, follow_symlinks=False)
                return False
            if link is not None:
                os.symlink(link, dname, dir_fd=ddir)
                return True
            tmp = f".tmp-lane-{os.getpid()}-{time.monotonic_ns()}"
            out = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600,
                          dir_fd=ddir)
            try:
                try:
                    copy_fd(src, out)
                    os.fchmod(out, stat.S_IMODE(st.st_mode))
                    os.utime(out, ns=(st.st_atime_ns, st.st_mtime_ns))
                finally:
                    os.close(out)
                os.rename(tmp, dname, src_dir_fd=ddir, dst_dir_fd=ddir)
            except BaseException:
                with contextlib.suppress(OSError):
                    os.unlink(tmp, dir_fd=ddir)
                raise
            return True
        finally:
            os.close(ddir)
    finally:
        os.close(sdir)
        if src is not None:
            os.close(src)


def lane_files(repo: Repo, lane: dict, brief: dict) -> list[str]:
    """The 'copy' step of making a lane: included files, the shared exclude, the seeded record.
    A failure becomes a LaneError naming the half-made lane and how to finish it."""
    if lanelib.record_is_link(lane):
        raise LaneError(f"{lanelib.record_dir(lane)} is a symlink in the repo's tree, and a lane's "
                        "record must be a real dir (a link would mirror and archive its target). "
                        f"Remove the link from the repo, then `lane adopt {lane['path']}`, or "
                        f"`lane done {lane['id']} --abandon`")
    try:
        copied = copy_includes(repo, usable_path(repo, lane))
        add_exclude(repo)
        seed_record(lane, brief)
    except (OSError, subprocess.CalledProcessError) as e:
        raise LaneError(f"lane {lane['id']} is half made at {lane['path']} ({e}). Fix the cause, "
                        f"then finish it with `lane adopt {lane['path']}`, or remove it with "
                        f"`lane done {lane['id']} --abandon`")
    return copied


def run_setup(repo: Repo, lane: dict) -> None:
    """The 'setup' step: the configured command in the lane, with LANE_ID and LANE_PORT set. A
    failure marks the lane setup-failed at this step and raises."""
    setup = repo.config().get("setup")
    if not setup:
        return
    env = dict(os.environ, LANE_ID=lane["id"], LANE_PORT=str(lane.get("port") or ""))
    say(f"  setup: {setup}")
    if subprocess.run(setup, shell=True, cwd=usable_path(repo, lane), env=env).returncode != 0:
        with lock(repo):
            lanelib.update_lane(repo, lane["id"], lambda x: x.update(state="setup-failed",
                                                                     setup_failed="setup"))
        raise LaneError(f"setup failed in {lane['path']}; the lane is registered (setup-failed): "
                        f"fix it there, then `lane adopt {lane['path']}` re-runs only the setup, "
                        f"or `lane done {lane['id']} --abandon`")


def mark_active(lane: dict) -> None:
    lane["state"] = "active"
    lane.pop("setup_failed", None)


def seed_record(lane: dict, brief: dict) -> None:
    path = lanelib.record_path(lane)
    if os.path.exists(path):
        return
    with open(TEMPLATE) as f:
        text = f.read()
    fill = {"id": lane["id"], "branch": lane["branch"], "date": now_iso()[:10],
            "requests": ", ".join(lane["claims"]) or "none claimed"}
    fill.update({k: v for k, v in brief.items() if v})
    for key, value in fill.items():
        text = text.replace(f"<{key}>", value)
    lanelib.write_text(path, text)


def new_record(lane_id: str, branch: str, path: str, base_sha: str | None, port: int | None,
    claims: list[str],
) -> dict:
    stamp = now_iso()
    return {"id": lane_id, "branch": branch, "path": path, "base_sha": base_sha, "port": port,
            "claims": claims, "state": "active", "sessions": [], "created": stamp,
            "updated": stamp}


def claim_conflicts(repo: Repo, lane_id: str, reqs: list[str]) -> list[str]:
    """Requests a live lane other than lane_id already claims, as '#42 (chart-fix)'."""
    out = []
    for other in repo.lanes(shared=True):
        if other["id"] == lane_id or not lanelib.is_live(other):
            continue  # a stale lane (worktree gone) is not live, so its claims don't hold
        out += [f"{r} ({other['id']})" for r in reqs if r in other.get("claims", [])]
    return out


# ---- subcommands ----------------------------------------------------------------------------

def cmd_init(args) -> None:
    repo = repo_here()
    if not repo.is_main:
        raise LaneError(f"run `lane init` in the main checkout ({repo.main})")
    parse_ports(args.ports or "")
    if args.locks is not None:
        args.locks = ",".join(parse_locks(args.locks))
    with lock(repo):
        cfg = repo.config() if repo.has_lanes else {}
        name = os.path.basename(repo.main)
        cfg.setdefault("root", os.path.join(os.path.dirname(repo.main), f"{name}-lanes"))
        cfg.setdefault("setup", "")
        cfg.setdefault("ports", "")
        cfg.setdefault("cap", DEFAULT_CAP)
        cfg.setdefault("base", "origin/main")
        cfg.setdefault("locks", "")
        for key in ("root", "setup", "ports", "cap", "locks"):
            value = getattr(args, key)
            if value is not None:
                cfg[key] = os.path.abspath(os.path.expanduser(value)) if key == "root" else value
        if args.autopass is not None:  # unset means on (autopass_state.decide)
            cfg["autopass"] = args.autopass
        try:
            write_config(repo, cfg)
        except OSError as e:
            raise LaneError(f"can't write {repo.config_path} ({e.strerror}). The Bash sandbox "
                            "can't write the state dir, by design: run it as a bare `lane init`, "
                            "which excludedCommands runs outside the sandbox")
        add_exclude(repo)
    say(f"lanes config: {repo.config_path}")
    for key, value in cfg.items():
        say(f"  {key} = {toml_value(value) if isinstance(value, bool) else value}")
    # Claude Code asks "trust this folder?" for an untrusted cwd, and a trusted parent covers its
    # subdirs (probed 2026-10-11, 2.1.296): without this, every `lane open` window stops there.
    say(f"Trust the lanes root once, or each `lane open` window waits at Claude Code's trust "
        f"dialog: mkdir -p {shlex.quote(cfg['root'])} && cd {shlex.quote(cfg['root'])} && "
        "claude, then accept and exit")


def cmd_new(args) -> None:
    repo = lanes_repo()
    cfg = repo.config()
    reqs = requests(args.claim)
    branch = args.branch or args.id
    if not lanelib.valid_branch(branch):
        raise LaneError(f"bad branch name {branch!r}: letters, digits, '.', '_', '/', '+', '-', "
                        "starting with a letter or digit")
    path = os.path.join(cfg["root"], args.id)
    base = cfg.get("base", "origin/main")
    base_sha = fetched_base(repo, cfg)
    with lock(repo):
        check_unregistered(repo, args.id)
        live = list(filter(lanelib.is_live, repo.lanes(shared=True)))
        if len(live) >= int(cfg.get("cap", DEFAULT_CAP)):
            raise LaneError(f"{len(live)} live lanes, at the cap of {cfg.get('cap')}: close one "
                            "with `lane done`, or raise it with `lane init --cap`")
        if os.path.exists(path):
            raise LaneError(f"{path} already exists")
        if held := holders(repo, path):  # a stale record would make the new lane its twin
            raise LaneError(f"lane {', '.join(x['id'] for x in held)} still holds {path}: close "
                            "it with `lane done` first")
        if conflicts := claim_conflicts(repo, args.id, reqs):
            raise LaneError("already claimed: " + ", ".join(conflicts))
        port = free_port(repo, cfg)
        os.makedirs(cfg["root"], exist_ok=True)
        # From the commit, not the ref name: no upstream is set, and no ref rewritten since the
        # fetch can choose the tree.
        p = git(["worktree", "add", "-b", branch, path, base_sha], repo.toplevel)
        if p.returncode != 0:
            raise LaneError("git worktree add failed: " + p.stderr.strip())
        # Registered the moment the worktree exists, so a failure below leaves a lane that
        # `adopt` finishes or `done --abandon` removes, never an orphan worktree.
        lane = new_record(args.id, branch, os.path.realpath(path), base_sha, port, reqs)
        lane.update(state="setup-failed", setup_failed="copy")
        write_json(repo.lane_json(args.id), lane)
        copied = lane_files(repo, lane, {ph: getattr(args, attr) for attr, ph in BRIEF.items()})
        lane = lanelib.update_lane(repo, args.id, mark_active)
    say(f"lane {args.id}: branch {branch} from {base} ({base_sha[:12]}), port {port or 'none'}")
    if copied:
        say(f"  copied {len(copied)} file(s) from .worktreeinclude")
    say(f"  record {lanelib.record_path(lane)}")
    run_setup(repo, lane)
    say(f"cd {lane['path']} && claude")


def finish(repo: Repo, lane: dict) -> None:
    """Finish a lane `new` left setup-failed, redoing only the failed step onward: a failed copy
    redoes the copy (never over a file the lane already has) and then the setup; a failed setup
    redoes the setup alone."""
    with lock(repo):
        if lane.get("setup_failed", "copy") == "copy":
            lane_files(repo, lane, {})
            lane = lanelib.update_lane(repo, lane["id"], lambda x: x.update(setup_failed="setup"))
    run_setup(repo, lane)
    with lock(repo):
        lane = lanelib.update_lane(repo, lane["id"], mark_active)
    say(f"finished lane {lane['id']}: branch {lane['branch']}, port {lane['port'] or 'none'}")
    say(f"  record {lanelib.record_path(lane)}")


def cmd_adopt(args) -> None:
    repo = lanes_repo()
    cfg = repo.config()
    path = os.path.realpath(args.path)
    trees = worktrees(repo)
    if path not in trees:
        raise LaneError(f"{path} is not a worktree of this repo (`git worktree list`)")
    if path == repo.main:
        raise LaneError("the main checkout is `main`, not a lane")
    if not trees[path]:
        raise LaneError(f"{path} is on a detached HEAD: check out its branch first")
    if not lanelib.valid_branch(trees[path]):
        raise LaneError(f"its branch {trees[path]!r} is no name a lane can carry: letters, "
                        "digits, '.', '_', '/', '+', '-', starting with a letter or digit")
    if why := lanelib.worktree_problem(repo, path, repo.lanes(shared=True)):
        raise LaneError(f"refusing to adopt: {why}")
    held = holders(repo, path)
    if len(held) > 1:
        raise LaneError(f"lanes {', '.join(x['id'] for x in held)} all claim {path}. Sandboxed "
                        f"Bash can write any lane.json: look at each under {repo.lanes_dir}/ and "
                        "remove the ones the CLI didn't write")
    known = held[0] if held else None
    if known and known.get("state") == "setup-failed":
        finish(repo, known)
        return
    if known:
        raise LaneError(f"{path} is already registered as lane {known['id']}")
    lane_id = args.id or os.path.basename(path)
    if not args.id and not lanelib.valid_id(lane_id):
        raise LaneError(f"the dir name {lane_id!r} is no lane id (a slug that starts with a "
                        "letter or digit, at most 64 chars, not 'main'): pass `--id <slug>`, or "
                        "rename the worktree with `git worktree move`")
    if os.path.islink(os.path.join(path, lanelib.RECORD_DIR)):
        raise LaneError(f"{path}/.lane is a symlink, and a lane's record must be a real dir (a "
                        "link would mirror and archive its target): remove it, then adopt")
    with lock(repo):
        check_unregistered(repo, lane_id)
        if held := holders(repo, path):  # again under the lock: a racing adopt or new
            raise LaneError(f"{path} is already registered as lane {held[0]['id']}")
        mb = git(["merge-base", "--end-of-options", f"refs/heads/{trees[path]}", base_ref(cfg)],
                 repo.toplevel)
        lane = new_record(lane_id, trees[path], path, mb.stdout.strip() or None,
                          free_port(repo, cfg), [])
        lane["adopted"] = True  # its base is a merge-base, which a fast-forward merge makes its tip
        try:
            add_exclude(repo)
            seed_record(lane, {})
        except OSError as e:
            raise LaneError(f"could not seed {lanelib.record_path(lane)}: {e}")
        write_json(repo.lane_json(lane_id), lane)
    say(f"adopted lane {lane_id}: branch {lane['branch']}, port {lane['port'] or 'none'}")
    say(f"  record {lanelib.record_path(lane)}")


def pr_states(repo: Repo) -> dict[str, str] | None:
    """Head branch -> PR state from one gh call; None when gh can't answer (no network or token)."""
    try:
        p = subprocess.run(["gh", "pr", "list", "--state", "all", "--limit", "200", "--json",
                            "number,state,headRefName"], cwd=repo.toplevel, capture_output=True,
                           text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    if p.returncode != 0:
        return None
    try:
        rows = json.loads(p.stdout)
    except ValueError:
        return None
    out = {}
    for row in sorted(rows, key=lambda r: r.get("number", 0)):  # the newest PR wins
        out[row.get("headRefName")] = f"#{row.get('number')} {str(row.get('state')).lower()}"
    return out


def autopass_state():
    """hooks/autopass_state (the tiers, the ctx files), found from this script's real path, or
    None: the board's CTX is then unknown."""
    if HOOKS not in sys.path:
        sys.path.insert(0, HOOKS)
    try:
        import autopass_state as mod
    except Exception:
        return None
    return mod


def ctx_of(aps, sids: list) -> dict | None:
    """The most urgent context among the live sessions, from the watcher's ctx/<session>.json:
    {"session", "tokens", "tier"}, where tier is the highest auto-pass tier the count has passed
    on that session's window (None below soft, or when the window has no tiers). The highest
    tier wins, then the most tokens. None when no session has a count, or without aps."""
    best = None
    rank = {None: 0, "soft": 1, "wrap": 2, "hard": 3}
    for sid in sids if aps is not None else []:
        if not isinstance(sid, str) or not SID.fullmatch(sid):
            continue
        rec = aps.read_ctx(sid)
        tokens = rec.get("tokens")
        if not aps.is_int(tokens) or tokens < 0:
            continue
        try:
            tiers = aps.tiers(aps.window(None, rec.get("window")))
        except Exception:
            tiers = None
        tier = next((t for t in ("hard", "wrap", "soft") if tiers and tokens >= tiers[t]), None)
        row = {"session": sid, "tokens": tokens, "tier": tier}
        if best is None or (rank[tier], tokens) > (rank[best["tier"]], best["tokens"]):
            best = row
    return best


def ctx_cell(ctx: dict | None) -> str:
    if ctx is None:
        return "-"
    return "%dk%s" % (round(ctx["tokens"] / 1000), CTX_MARK.get(ctx["tier"], ""))


def board(repo: Repo) -> list[dict]:
    """Each lane's record plus its derived state: nothing here is stored."""
    cfg = repo.config()
    base = base_ref(cfg)
    trees = worktrees(repo)
    prs = pr_states(repo)
    live = lanelib.live_sessions()
    aps = autopass_state()
    lanes = repo.lanes()
    claimers = {}
    for lane in lanes:
        if os.path.realpath(lane["path"]) in trees and os.path.isdir(lane["path"]):
            for r in lane.get("claims", []):
                claimers.setdefault(r, []).append(lane["id"])
    rows = []
    for lane in lanes:
        path = os.path.realpath(lane["path"])
        stale = path not in trees or not os.path.isdir(path)
        row = dict(lane, stale=stale, ahead=None, behind=None,
                   pr=(prs.get(lane["branch"], "none") if prs is not None else "?"))
        counts = git(["rev-list", "--left-right", "--count", "--end-of-options",
                      f"{base}...refs/heads/{lane['branch']}"], repo.toplevel)
        if counts.returncode == 0:
            row["behind"], row["ahead"] = (int(x) for x in counts.stdout.split())
        here = sessions_in(live or [], path)
        row["live_sessions"] = None if live is None else [s.get("sessionId") for s in here]
        row["ctx"] = ctx_of(aps, row["live_sessions"] or [])
        # Derived from the live session, never stored: a stored window id drifts when the window
        # closes or tmux renumbers it (invariant 4).
        row["window"] = ",".join(sorted({window_of(s["tmux"]) for s in here
                                         if s.get("tmux")})) or None
        flags = []
        if lane.get("state") == "setup-failed":  # still holds its port, claims and a cap slot
            flags.append("setup-failed")
        if stale:
            flags.append("stale")
        if row["behind"]:
            flags.append("rebase")
        if any(len(claimers.get(r, [])) > 1 for r in lane.get("claims", [])):
            flags.append("conflict")
        if not stale and row["live_sessions"] == []:
            flags.append("orphan")
        if needs_handoff(repo, lane, stale):
            flags.append("handoff?")
        row["flags"] = flags
        rows.append(row)
    return rows


def record_text(repo: Repo, lane: dict) -> tuple[str | None, float | None]:
    """The lane's STATUS.md text and mtime, from the worktree or, when it is gone, the mirror.
    No lock is held, so the mirror is read in place, and a hook's swap can move it between
    mirror_dir's answer and the open: one fresh answer and retry covers that."""
    def read(path):
        try:
            with open(path) as f:
                return f.read(), os.path.getmtime(path)
        except OSError:
            return None

    if not lanelib.record_is_link(lane) and (found := read(lanelib.record_path(lane))):
        return found
    for _ in range(2):
        mirror = lanelib.mirror_dir(repo, lane["id"], restore=False)
        if mirror is None:
            break
        if found := read(os.path.join(mirror, "STATUS.md")):
            return found
    return None, None


def needs_handoff(repo: Repo, lane: dict, stale: bool) -> bool:
    """The lane's last commit or last session end is newer than its record."""
    _, mtime = record_text(repo, lane)
    if mtime is None:
        return True
    p = git(["log", "-1", "--format=%ct", "--end-of-options", f"refs/heads/{lane['branch']}"],
            repo.toplevel)
    last = [float(p.stdout.strip())] if p.returncode == 0 and p.stdout.strip() else []
    last += [t for s in lane.get("sessions", []) if (t := lanelib.parse_iso(s.get("endedAt")))]
    return bool(last) and max(last) > mtime + 1


def cmd_ls(args) -> None:
    repo = lanes_repo()
    if args.requests:
        reqs = {}
        for lane in filter(lanelib.is_live, repo.lanes(shared=True)):  # stale: claims void
            for r in lane.get("claims", []):
                reqs.setdefault(r, []).append(lane["id"])
        if args.json:
            say(json.dumps(reqs, indent=2))
            return
        if not reqs:
            say("no claims")
        for r in sorted(reqs, key=lambda x: (len(x), x)):
            mark = "  conflict" if len(reqs[r]) > 1 else ""
            say(f"{r:<10} {', '.join(reqs[r])}{mark}")
        return
    rows = board(repo)
    for lane_id, why in repo.rejected:
        warn(f"left out lanes/{lane_id}: {why}. Sandboxed Bash can write any lane.json, so a "
             "record the CLI didn't write is never acted on; look at it before removing it")
    if args.json:
        say(json.dumps(rows, indent=2))
        return
    if rows:
        print_board(rows)
    else:
        say("no lanes (`lane new <id>` makes one)")
    for name in parse_locks(repo.config().get("locks", "")):
        if (holder := lock_holder(repo, name)) is not None:
            say(f"locks: {name} held by {holder}")


def print_board(rows: list[dict]) -> None:
    if any(r["pr"] == "?" for r in rows):
        warn("gh unavailable (no network or credential): PR state shows ?")
    if any(r["live_sessions"] is None for r in rows):
        warn("sandboxed: session liveness unknown; run `lane ls` bare")
    head = ("LANE", "BRANCH", "+/-", "PR", "PORT", "CLAIMS", "SESSIONS", "CTX", "WINDOW",
            "FLAGS")
    table = [head]
    for r in rows:
        ab = "?" if r["ahead"] is None else f"+{r['ahead']}/-{r['behind']}"
        unknown = r["live_sessions"] is None  # sandboxed: liveness, so ctx and window, unknown
        sess = "?" if unknown else str(len(r["live_sessions"]))
        ctx = "?" if unknown else ctx_cell(r["ctx"])
        window = "?" if unknown else r["window"] or "-"
        table.append((r["id"], r["branch"], ab, r["pr"], str(r["port"] or "-"),
                      ",".join(r.get("claims", [])) or "-", sess, ctx, window,
                      " ".join(r["flags"]) or "-"))
    widths = [max(len(row[i]) for row in table) for i in range(len(head))]
    for row in table:
        say("  ".join(c.ljust(w) for c, w in zip(row, widths)).rstrip())


def cmd_whoami(args) -> None:
    repo = repo_here()
    kind, lane = repo.identity()
    info = {"identity": lane["id"] if lane else kind, "kind": kind, "toplevel": repo.toplevel,
            "common_dir": repo.common_dir}
    if lane:
        info.update(branch=lane["branch"], port=lane.get("port"), claims=lane.get("claims", []),
                    record=lanelib.record_path(lane))
    if args.json:
        say(json.dumps(info, indent=2))
        return
    if lane:
        say(f"{lane['id']}  (lane; branch {lane['branch']}, port {lane.get('port') or 'none'}, "
            f"claims {', '.join(lane.get('claims', [])) or 'none'})")
        say(f"record {info['record']}")
    else:
        say({"main": "main  (the main checkout of a lanes repo)",
             "unregistered": "unregistered  (a worktree of a lanes repo that is no lane: "
                             "`lane adopt` it, or work from a lane)",
             "plain": "plain  (no lanes in this repo)"}[kind])


def cmd_claim(args) -> None:
    repo = lanes_repo()
    reqs = requests(args.req)
    with lock(repo):
        lane = own_lane(repo)
        if conflicts := claim_conflicts(repo, lane["id"], reqs):
            raise LaneError("already claimed: " + ", ".join(conflicts) + ". Ownership moves only "
                            "when that lane releases it (`lane release`)")
        lanelib.update_lane(repo, lane["id"], lambda x: x["claims"].extend(
            r for r in reqs if r not in x["claims"]))
    say(f"lane {lane['id']} claims {', '.join(reqs)}")


def cmd_release(args) -> None:
    repo = lanes_repo()
    reqs = requests(args.req)
    with lock(repo):
        lane = own_lane(repo)
        missing = [r for r in reqs if r not in lane.get("claims", [])]
        if missing:
            raise LaneError(f"lane {lane['id']} does not claim {', '.join(missing)}")
        lanelib.update_lane(repo, lane["id"], lambda x: x.update(
            claims=[r for r in x["claims"] if r not in reqs]))
    say(f"lane {lane['id']} released {', '.join(reqs)}")


def cmd_who(args) -> None:
    repo = lanes_repo()
    req = lanelib.norm_request(args.req)
    holders = [lane for lane in repo.lanes(shared=True) if req in lane.get("claims", [])]
    if not holders:
        say(f"{req}: unclaimed")
        return
    for lane in holders:
        live = lanelib.is_live(lane)
        say(f"{req}: lane {lane['id']}" + ("" if live else "  (stale: worktree gone, claim void)"))


def insert_in_section(text: str, heading: str, line: str) -> str:
    """Append line at the end of the `## heading` section, or of the file when there is none."""
    lines = text.splitlines()
    start = next((i for i, x in enumerate(lines) if x.strip().lower() == f"## {heading}".lower()),
                 None)
    if start is None:
        return text.rstrip("\n") + "\n" + line + "\n"
    end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("## ")), len(lines))
    while end > start + 1 and not lines[end - 1].strip():
        end -= 1
    lines.insert(end, line)
    return "\n".join(lines) + "\n"


def cmd_note(args) -> None:
    repo = lanes_repo()
    text = " ".join(args.text).strip()
    if not text:
        raise LaneError("empty note")
    if found := lanelib.relative_phrases(text):
        raise LaneError(f"relative identity ({', '.join(found)}). {lanelib.RELATIVE_HINT}")
    with lock(repo):
        lane = own_lane(repo)
        path = lanelib.record_path(lane)
        try:
            with open(path) as f:
                body = f.read()
        except FileNotFoundError:
            raise LaneError(f"no record at {path}")
        stamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
        lanelib.write_text(path, insert_in_section(body, "State", f"- {stamp} {text}"))
    say(f"noted in {path}")


def cmd_asks(args) -> None:
    repo = lanes_repo()
    found = False
    for lane in repo.lanes():
        text, _ = record_text(repo, lane)
        body = lanelib.section(text or "", "Asks for Hayden", "Asks")
        for line in (body or "").splitlines():
            found = True
            say(f"{lane['id']}: {line.strip()}")
    if not found:
        say("no open asks")


def holders(repo: Repo, path: str) -> list[dict]:
    """Every checked record whose path is path, twins included (Repo.lanes)."""
    real = os.path.realpath(path)
    return [lane for lane in repo.lanes(shared=True) if os.path.realpath(lane["path"]) == real]


def load_lane(repo: Repo, lane_id: str) -> dict:
    """The lane's checked record, refused while another record claims its path: one of the two
    was planted, and `open` or `done` on either would act in the other's worktree."""
    check_id(lane_id)
    try:
        lane = lanelib.read_record(repo, lane_id)
    except FileNotFoundError:
        raise LaneError(f"no lane {lane_id}")
    if twins := [x["id"] for x in holders(repo, lane["path"]) if x["id"] != lane_id]:
        raise LaneError(f"refusing lane {lane_id}: lane {', '.join(twins)} claims its path "
                        f"{lane['path']} too. Sandboxed Bash can write any lane.json: look at "
                        f"each under {repo.lanes_dir}/ and remove the one the CLI didn't write")
    return lane


def usable_path(repo: Repo, lane: dict) -> str:
    """The lane's path, once worktree_problem passes: every sandbox-off act in a lane (the cwd
    of `open` and the setup, the copy's destination, `done`) goes through this."""
    if why := lanelib.worktree_problem(repo, lane["path"], repo.lanes(shared=True)):
        raise LaneError(f"refusing lane {lane['id']}: {why}")
    return lane["path"]


def cmd_open(args) -> None:
    repo = lanes_repo()
    lane = load_lane(repo, args.id)
    path = lane["path"]
    if not lanelib.is_live(lane):
        raise LaneError(f"lane {args.id} is stale: its worktree {path} is gone (`lane done "
                        f"{args.id}` closes it)")
    usable_path(repo, lane)  # the window's cwd, where `claude` loads that dir's .claude/ config
    if lane.get("state") == "setup-failed":
        raise LaneError(f"lane {args.id} is setup-failed: finish it with `lane adopt {path}` first")
    live = lanelib.live_sessions()
    if live is None:
        unknown = (f"sandboxed: session liveness unknown, so this can't tell whether lane "
                   f"{args.id} already has a session")
        if not args.print:
            raise LaneError(f"{unknown}. Run it as a bare `lane open {args.id}` "
                            "(excludedCommands runs that outside the sandbox)")
        warn(f"{unknown}: the printed command may duplicate a live session")
    if here := sessions_in(live or [], path):
        focus_session(args, here)
        return
    claude = shutil.which("claude")
    if claude is None:
        raise LaneError("claude is not on PATH")
    prompt = args.prompt or (f"You are lane `{args.id}`. Read your lane record "
                             f"`{lanelib.record_path(lane)}`, then plan the brief it holds.")
    # The absolute claude path: tmux's PATH lacks ~/.local/bin.
    argv = ["tmux", "new-window", "-P", "-F", "#{session_name}:#{window_index} (#{window_name})",
            "-c", path, "-n", args.id, *([] if args.focus else ["-d"]), "--",
            os.path.abspath(claude), "--permission-mode", "plan", prompt]
    if args.print:
        say(shlex.join(argv))
        return
    if not os.environ.get("TMUX"):
        raise LaneError(f"not inside tmux; run this instead: cd {shlex.quote(path)} && claude")
    p = subprocess.run(argv, capture_output=True, text=True)
    if p.returncode != 0:
        raise LaneError(f"tmux new-window failed: {p.stderr.strip()}")
    # Only the time: the window is derived from the live session on each `ls` (invariant 4).
    with lock(repo):
        lanelib.update_lane(repo, args.id, lambda x: x.update(opened=now_iso()))
    say(f"opened {args.id} in tmux window {p.stdout.strip()}")


def focus_session(args, here: list[dict]) -> None:
    """`open` on a lane that has a live session: refuse, or with --focus select its window."""
    targets = [s["tmux"] for s in here if s.get("tmux")]
    named = ", ".join(targets or [f"session {s.get('sessionId')} (not in tmux)" for s in here])
    if not args.focus:
        raise LaneError(f"lane {args.id} already has a live session: {named}. "
                        f"`lane open {args.id} --focus` switches to its window")
    if not targets:
        raise LaneError(f"lane {args.id}'s live session has no tmux window to focus: {named}")
    window = window_of(targets[0])
    argv = ["tmux", "select-window", "-t", window]
    if args.print:
        say(shlex.join(argv))
        return
    p = subprocess.run(argv, capture_output=True, text=True)
    if p.returncode != 0:
        raise LaneError(f"tmux select-window failed: {p.stderr.strip()}")
    say(f"lane {args.id} already has a live session: focused tmux window {window}")


def holder_line(repo: Repo, command: list[str]) -> str:
    """Who runs what since when; no pid, since each sandboxed command has its own pid namespace."""
    kind, lane = repo.identity()
    who = lane["id"] if lane else (kind if kind == "main" else f"{kind} {repo.toplevel}")
    cmd = shlex.join(command)
    if len(cmd) > HOLDER_CMD_MAX:
        cmd = cmd[:HOLDER_CMD_MAX - 3] + "..."
    return f"{who} since {now_iso()}: {cmd}"


def try_lock(fd: int) -> bool:
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return True
    except BlockingIOError:
        return False


def take_lock(fd: int, name: str, wait: float | None) -> bool:
    """flock fd, saying who holds it while it waits; False when --wait ran out."""
    deadline = None if wait is None else time.monotonic() + wait
    # `lane ls` probes a lock by taking LOCK_SH for an instant (lock_holder). One retry after a
    # short pause keeps a single probe from reading as a holder (a false "waiting", or a
    # `--wait 0` that gives up on a free lock); two probes PROBE_GRACE apart still can.
    if try_lock(fd):
        return True
    time.sleep(PROBE_GRACE)
    if try_lock(fd):
        return True
    if wait != 0:
        warn(f"waiting for lock {name}: held by {holder_of(fd)}")
    if deadline is None:
        fcntl.flock(fd, fcntl.LOCK_EX)
        return True
    while time.monotonic() < deadline:
        time.sleep(0.05)
        if try_lock(fd):
            return True
    warn(f"gave up on lock {name} after {wait:g}s: held by {holder_of(fd)}")
    return False


def run_child(command: list[str]) -> int:
    """Run command and wait for it; its exit code, or -n (as Popen has it) if signal n killed it.

    The command shares this process group, so a Ctrl-C from the tty or a kill of the whole tree
    (Claude Code's Bash tool stops a command that way) already reaches it. SIGINT and SIGTERM are
    therefore only recorded here, never forwarded: a second copy reads as "force quit" to Go and
    Node tools. One that arrives before the command starts is replayed to it once. A Python
    handler, not SIG_IGN, so the command doesn't inherit an ignored signal. The costs:
    - A signal sent to `lane` alone no longer stops the command, and the lock stays held while it
      runs. A supervisor that signals `lane` alone and then SIGKILLs it (`timeout -k`,
      `terminate()` then `kill()`, systemd `KillMode=process`) frees the lock while the orphaned
      command still runs: signal the process group instead.
    - A group signal that lands after the command has exec'd but before Popen returns (while it
      reads the exec status pipe) is taken as pending and replayed, so the command gets it twice.
      Blocking the signals around Popen can't tell a pre-fork arrival from a post-fork one."""
    child, pending = None, []

    def record(sig, _frame):
        if child is None:
            pending.append(sig)

    old = {sig: signal.signal(sig, record) for sig in (signal.SIGINT, signal.SIGTERM)}
    try:
        try:
            child = subprocess.Popen(command)
        except OSError as e:
            warn(f"can't run {command[0]}: {e.strerror}")
            return 127
        for sig in pending:
            child.send_signal(sig)
        rc = child.wait()
    finally:
        for sig, handler in old.items():
            signal.signal(sig, handler)
    return rc


def die_of(sig: int) -> int:
    """Die of signal sig, as the locked command did; 128+sig if this process survives it.

    bash quits a script on Ctrl-C only when its child died of SIGINT, so an exit of 130 would run
    the script's next gate. coreutils `timeout` re-raises the same way, with core dumps off."""
    resource.setrlimit(resource.RLIMIT_CORE, (0, resource.getrlimit(resource.RLIMIT_CORE)[1]))
    with contextlib.suppress(OSError):  # SIGKILL takes no handler: it is always the default
        signal.signal(sig, signal.SIG_DFL)
    os.kill(os.getpid(), sig)
    return 128 + sig


def cmd_lock(args) -> int:
    repo = lanes_repo()
    names = parse_locks(repo.config().get("locks", ""))
    if args.name not in names:
        raise LaneError(f"no lock {args.name!r} in the lanes config (locks:{', '.join(names) or 'none'})"
                        ": add it with `lane init --locks <full,list>` (it replaces the list); an "
                        "unlisted name would split the mutual exclusion")
    path = lock_path(repo, args.name)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    # O_CLOEXEC, and Popen's close_fds: the command and anything it backgrounds never inherit the
    # lock, so it ends with this process.
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o644)
    try:
        if not take_lock(fd, args.name, args.wait):
            return LOCK_BUSY
        try:
            os.ftruncate(fd, 0)
            os.pwrite(fd, (holder_line(repo, args.command) + "\n").encode(), 0)
            return run_child(args.command)
        finally:
            # Cleared while still held: a waiter that reads between the next holder's acquire and
            # its write sees "an unknown holder", never this run.
            os.ftruncate(fd, 0)
    except KeyboardInterrupt:  # a Ctrl-C while waiting, or before or after the command runs
        return -signal.SIGINT
    finally:
        os.close(fd)


def processes_inside(path: str) -> list[str]:
    out = []
    for proc in os.listdir("/proc"):
        if not proc.isdigit() or int(proc) == os.getpid():
            continue
        try:
            cwd = os.readlink(f"/proc/{proc}/cwd")
        except OSError:
            continue
        if lanelib.inside(cwd, path):
            try:
                with open(f"/proc/{proc}/comm") as f:
                    out.append(f"{proc} ({f.read().strip()})")
            except OSError:
                out.append(proc)
    return out


def work_references(repo: Repo, lane: dict) -> list[str]:
    """Symlinks in other lanes, and mentions in their records, that point into <lane>/work."""
    work = os.path.join(lane["path"], "work")
    if not os.path.isdir(work):
        return []
    hits = []
    peers, walked = repo.lanes(shared=True), set()  # a planted twin must not hide a peer
    for other in peers:
        if other["id"] == lane["id"] or not lanelib.is_live(other) or other["path"] in walked:
            continue
        if lanelib.worktree_problem(repo, other["path"], peers):
            continue  # walked sandbox-off: only a real lane worktree
        walked.add(other["path"])
        text, _ = record_text(repo, other)
        if text and work in text:
            hits.append(f"lane {other['id']} record mentions {work}")
        for root, dirs, files in os.walk(other["path"]):
            dirs[:] = [d for d in dirs if d not in (".git", "node_modules")
                       and root.count(os.sep) - other["path"].count(os.sep) < 3]
            for name in dirs + files:
                p = os.path.join(root, name)
                if os.path.islink(p) and lanelib.inside(os.path.realpath(p), work):
                    hits.append(f"{p} -> {os.path.realpath(p)}")
    return hits


def closable(repo: Repo, lane: dict, fetched: bool) -> tuple[str | None, str, str]:
    """(label, state, why not) for closing a lane without --abandon; label None means it needs
    --abandon. Merged means the branch has commits past its base and either a merged PR's head
    commit is the branch tip (a squash merge leaves the tip out of the base) or the tip is in the
    base; an old PR from a same-named branch at another commit proves nothing. A lane made by
    `new` with nothing past its base did no work, so it needs --abandon. An adopted lane's base is
    a merge-base: with nothing past it the tip is already in the base, so nothing can be lost. It
    can't tell "no work" from "fast-forwarded in before adoption", so it closes with state
    `closed`, "closed (nothing past <base>)", unless a merged PR names that tip. `abandoned` is
    kept for --abandon."""
    branch = lane["branch"]
    tip = rev(repo, f"refs/heads/{branch}")
    if tip is None:
        return None, "", f"branch {branch} does not exist"
    cfg = repo.config()
    ref, base = base_ref(cfg), cfg.get("base", "origin/main")  # git gets the full ref
    fork = lane.get("base_sha") or tip
    count = git(["rev-list", "--count", "--end-of-options", f"{fork}..{tip}"], repo.toplevel)
    no_work = count.returncode == 0 and count.stdout.strip() == "0"
    if no_work and not lane.get("adopted"):
        return None, "", f"no commits past its base {fork[:12]}"
    try:
        p = subprocess.run(["gh", "pr", "list", "--head", branch, "--state", "merged", "--json",
                            "number,headRefOid"], cwd=repo.toplevel, capture_output=True,
                           text=True, timeout=30)
        rows = json.loads(p.stdout or "[]") if p.returncode == 0 else []
        for row in rows:
            if row.get("headRefOid") == tip:
                return f"PR #{row.get('number')} merged", "merged", ""
    except (OSError, subprocess.SubprocessError, ValueError):
        pass
    in_base = git(["merge-base", "--is-ancestor", "--end-of-options", tip, ref],
                  repo.toplevel).returncode == 0
    if in_base and no_work:
        return f"closed (nothing past {base})", "closed", ""
    if in_base:
        return f"fully in {base}" + ("" if fetched else " (unfetched copy)"), "merged", ""
    return None, "", f"no merged PR at its tip {tip[:12]}, and the tip is not in {base}"


def cmd_done(args) -> None:
    repo = lanes_repo()
    data_dir = lane_data_dir(repo, args.id)
    lane = load_lane(repo, args.id)
    path = os.path.realpath(lane["path"])
    if path == repo.main:
        raise LaneError(f"refusing: lane {args.id}'s path is the main checkout")
    present = os.path.isdir(path)
    if present:  # its record is archived and its worktree removed, sandbox-off
        usable_path(repo, lane)
    fetched = fetch(repo)
    how, state, why = closable(repo, lane, fetched)
    if not how and not args.abandon:
        raise LaneError(f"branch {lane['branch']} is not merged: {why}. Pass --abandon to close "
                        "it anyway")
    how, state = (how, state) if how else ("abandoned", "abandoned")
    if present and not lanelib.pids_visible():
        raise LaneError("sandboxed: this command can't see other processes, so it can't tell "
                        f"whether a session still runs in {path}. Run it as a bare "
                        f"`lane done {args.id}` (excludedCommands runs that outside the sandbox)")
    if present and (procs := processes_inside(path)):
        raise LaneError(f"processes still have their cwd in {path}: {', '.join(procs)}. Close "
                        "those sessions (or cd out) first")
    for hit in work_references(repo, lane) if present else []:
        warn(f"reference into {lane['id']}/work: {hit}")
    stamp = datetime.date.today().isoformat()
    with lock(repo):
        closed = os.path.join(repo.lanes_dir, lanelib.CLOSED)
        archive = os.path.join(closed, f"{args.id}-{stamp}")
        n = 2
        while os.path.exists(archive):
            archive = os.path.join(closed, f"{args.id}-{stamp}-{n}")
            n += 1
        # Built under a .tmp name and renamed into place only when complete, so a failure (or a
        # retry after one) never leaves a partial archive.
        tmp = archive + ".tmp"
        source = lanelib.record_dir(lane)
        if lanelib.record_is_link(lane):
            warn(f"{source} is a symlink: its target is not archived (the last mirror is, if any)")
            source = lanelib.mirror_dir(repo, args.id, restore=True)
        elif not os.path.isdir(source):
            source = lanelib.mirror_dir(repo, args.id, restore=True)  # under the lock
        lane.update(state=state, closed=now_iso(), outcome=how)
        try:
            shutil.rmtree(tmp, ignore_errors=True)
            os.makedirs(tmp)
            if source and os.path.isdir(source):
                lanelib.copy_record(source, os.path.join(tmp, lanelib.RECORD_DIR))
            write_json(os.path.join(tmp, "lane.json"), lane)
        except OSError as e:
            shutil.rmtree(tmp, ignore_errors=True)
            raise LaneError(f"could not archive lane {args.id} ({e}); nothing was removed")
        if path in worktrees(repo):
            p = git(["worktree", "remove", path], repo.toplevel)
            if p.returncode != 0:
                shutil.rmtree(tmp, ignore_errors=True)
                raise LaneError(f"git worktree remove refused: {p.stderr.strip()}")
        os.rename(tmp, archive)
        shutil.rmtree(data_dir)
    say(f"lane {args.id} closed ({how}); archived to {archive}")
    # With no upstream, -d judges against the main checkout's HEAD, which may not have pulled the
    # merge yet; the base as upstream makes it judge against what was actually merged.
    git(["branch", f"--set-upstream-to={base_ref(repo.config())}", "--end-of-options",
         lane["branch"]], repo.toplevel)
    p = git(["branch", "-d", "--end-of-options", lane["branch"]], repo.toplevel)
    if p.returncode != 0:
        warn(f"branch {lane['branch']} kept: {p.stderr.strip()} (a squash merge leaves it "
             "unmerged to git; check, then delete it yourself)")


def parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(prog="lane", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("init", help="write the lanes config (in the state dir)")
    p.add_argument("--root", help="dir that holds the lane worktrees (default <repo>-lanes beside it)")
    p.add_argument("--setup", help="shell command run in each new lane (LANE_ID, LANE_PORT set)")
    p.add_argument("--ports", help="port range A-B handed out one per lane")
    p.add_argument("--cap", type=int, help=f"live-lane cap (default {DEFAULT_CAP})")
    p.add_argument("--locks", help="comma-separated names `lane lock` accepts, e.g. gate,e2e")
    p.add_argument("--autopass", action=argparse.BooleanOptionalAction, default=None,
                   help="auto-pass in the lanes and the main checkout (on when never set)")
    p = sub.add_parser("new", help="make a lane: worktree, branch, record, port, setup")
    p.add_argument("id")
    p.add_argument("--branch", help="branch name (default: the id)")
    p.add_argument("--claim", action="append", default=[], metavar="REQ")
    p.add_argument("--goal")
    p.add_argument("--files", help="files the lane expects to touch")
    p.add_argument("--overlaps", help="lanes (by id) whose files overlap")
    p.add_argument("--done-when", dest="done_when", help="done criteria")
    p.add_argument("--constraints")
    p = sub.add_parser("adopt", help="register an existing worktree as a lane, or finish one "
                                     "`new` left setup-failed")
    p.add_argument("path")
    p.add_argument("--id", help="lane id when the dir name is no slug (default: the dir name)")
    p = sub.add_parser("ls", help="the board (derived live)")
    p.add_argument("--json", action="store_true")
    p.add_argument("--requests", action="store_true", help="request -> lane, from claims only")
    p = sub.add_parser("open", help="start a lane's session in a new tmux window, in plan mode")
    p.add_argument("id")
    p.add_argument("--focus", action="store_true",
                   help="switch to the window (a new one, or the live session's)")
    p.add_argument("--print", action="store_true", help="print the tmux command, run nothing")
    p.add_argument("prompt", nargs="?", help="first prompt (default: read the record, plan the brief)")
    p = sub.add_parser("lock", help="run a command under a named lock (`lane lock <name> -- <cmd>`)",
                       usage="lane lock <name> [--wait SECS] -- <cmd...>")
    p.add_argument("name")
    p.add_argument("--wait", type=float, metavar="SECS",
                   help=f"give up after SECS, exit {LOCK_BUSY} (default: wait as long as it "
                        f"takes); the command's own {LOCK_BUSY} looks the same, but only a "
                        "timeout prints \"gave up on lock\" on stderr")
    p = sub.add_parser("whoami", help="this checkout's lane id, main, or plain")
    p.add_argument("--json", action="store_true")
    for name in ("claim", "release"):
        p = sub.add_parser(name, help=f"{name} requests for this lane")
        p.add_argument("req", nargs="+")
    p = sub.add_parser("who", help="which lane claims a request")
    p.add_argument("req")
    p = sub.add_parser("note", help="append a timestamped line to this lane's State")
    p.add_argument("text", nargs="+")
    sub.add_parser("asks", help="every lane's open asks for Hayden")
    p = sub.add_parser("done", help="close a merged (or abandoned) lane")
    p.add_argument("id")
    p.add_argument("--abandon", action="store_true", help="close an unmerged lane")
    return ap


def main(argv=None) -> int:
    argv = sys.argv[1:] if argv is None else list(argv)
    # `lock`'s command is everything after the first `--`, split off before argparse sees it:
    # a REMAINDER positional would swallow `--wait` and keep the `--`.
    command = None
    if argv[:1] == ["lock"] and "--" in argv:
        cut = argv.index("--")
        argv, command = argv[:cut], argv[cut + 1:]
    ap = parser()
    args, extra = ap.parse_known_args(argv)
    # argparse fills `open`'s optional prompt (empty) together with the id, so a prompt after a
    # flag (`lane open x --focus "..."`) comes back unrecognized: it is the prompt.
    if args.cmd == "open" and args.prompt is None and len(extra) == 1 \
            and not extra[0].startswith("-"):
        args.prompt, extra = extra[0], []
    if extra:
        ap.error("unrecognized arguments: " + " ".join(extra))
    if args.cmd == "lock":
        if not command:
            ap.error("lane lock <name> [--wait SECS] -- <cmd...>: no command after --")
        args.command = command
    try:
        rc = globals()["cmd_" + args.cmd](args)
    except (LaneError, lanelib.Untrusted) as e:
        warn(str(e))
        return 1
    except subprocess.CalledProcessError as e:
        warn(f"{' '.join(e.cmd)} failed: {(e.stderr or '').strip()}")
        return 1
    except OSError as e:  # shutil.Error included: a clean message, never a traceback
        warn(f"{type(e).__name__}: {e}")
        return 1
    if rc and rc < 0:  # lock's command died of signal -rc, or a Ctrl-C hit `lane` itself
        return die_of(-rc)  # only now: cmd_lock has cleared the holder line and let go
    return rc or 0  # only `lock` returns a code: its command's


if __name__ == "__main__":
    sys.exit(main())
