#!/usr/bin/env python3
"""lane: parallel Claude sessions, one git worktree ("lane") each, with single-writer records.

  lane init [--root DIR] [--setup CMD] [--ports A-B] [--cap N] [--locks A,B]
            [--autopass | --no-autopass] [--model M] [--effort E]
  lane new <id> [--branch B] [--claim N ...] [--goal T] [--files T] [--overlaps T]
               [--done-when T] [--constraints T]
  lane adopt <path> [--id SLUG]
  lane ls [--json] [--requests]
  lane open <id> [--focus] [--print] [--model M] [--effort E] [prompt]
  lane addr <id> | lane addr lead
  lane lead
  lane lock <name> [--wait SECS] -- <cmd...>
  lane trial [<id> ...] [--wait SECS] [--keep] --run CMD [--run CMD ...]
  lane whoami [--json]
  lane claim <req> ... | lane release <req> ... | lane who <req>
  lane note <text>
  lane asks
  lane done <id> [--abandon]

Records: CLI data in <common-dir>/lanes/<id>/lane.json, the lane's prose in <lane>/.lane/STATUS.md,
the config in $XDG_STATE_HOME/dotclaude/lanes/ (why, and what is checked before sandbox-off code
acts on a sandbox-writable file: docs/lanes.md S3). Every write takes the flock on <common-dir>/lanes/.lock. Board fields (ahead/behind, PR state,
liveness, flags) are derived on each `ls`, never stored. skills/lanes/SKILL.md is the guide and
docs/lanes.md the design. Run `init`, `new`, `adopt`, `ls`, `open`, `done`, `addr` and `lead` bare,
so their excludedCommands entries take them out of the sandbox: `new`, `ls` and `done` need the
network and the GitHub credential (`new` refuses without them; `ls` and `done` say what they
skipped), `ls`, `open`, `done`, `addr` and `lead` need to see other processes, and `lead` writes
the lead record in the state dir. Every other subcommand runs sandboxed; `lock` and `trial`
must, so the commands they run stay sandboxed too.

`trial`, from inside a lane, merges the base and every other live lane's commits (or only the
ids given) onto the lane's HEAD in dangling commits, checks the merge out in a fresh scratch
tree under the temp dir, and runs each `--run` there under the `suite` lock. A suite
that fails reruns on the baseline (HEAD plus the base) at the same path; it passes when every
test id it failed on the merge fails there too. It exits 0 with no conflict and no failure of
the merge's own, 1 otherwise, and 75 when `--wait` runs out, as `lock` does.

The lead is the main-checkout session that last acted as lead: a bare `init`, `new`, `adopt`,
`open` (not `--print`) or `done` that succeeds from an interactive session in the main checkout,
or `lead`, records it in the state dir (lanelib.read_lead). hooks/lane_identity.py runs `lead`
for a session that proves it continues the recorded lead (lanelib.lead_relink: a resume, a
/clear or a /pass successor), so the record follows it. `addr lead` picks it among the main
checkout's running sessions by its pid, else by the one continuation of it (a resume of its
session id, or a /pass successor in its pane), else the one session there unless the recorded
lead is stopped (lanelib.lead_of). `ls` names a crowded checkout, or a stopped lead to `fg`, under
the board. A stopped session (Ctrl+Z) is never an address: nothing reads its socket until it is
continued. It still holds its lane, which the board flags `stopped`.

`lock` exits with its command's code, or dies of the signal that killed it; `--wait` running out
exits 75, which a command's own 75 can't be told from: only the "gave up on lock" line on stderr
marks a timeout.

`done` runs only from the main checkout (the lead), never under a lane's session. It ends what
provably belongs to the lane before it archives the record and removes the worktree: the lane's
Claude sessions (SIGTERM, and SIGCONT for a stopped one and its stopped tree so the SIGTERM
lands), the processes under them, their tmux pane shells (SIGHUP) and leftovers started with a
lane session's id; survivors get SIGTERM (a pane shell SIGHUP), then SIGKILL. Every signal but
a session's first (and its SIGCONTs) is checked just before it is sent, and held while the
target or a process under it holds a file open in the git dir. Proof comes only from /proc and
Claude Code's own session files and transcripts, never lane.json, and on a rerun from the pane
shells an earlier run proved, recorded in the state dir before its first signal. Anything else
with its cwd in the lane refuses the close by name before any signal, as do installed links into the
lane (it holds the install: install-state.py, checked again under setup.sh's install.lock just
before the remove), a dirty, locked or submodule worktree, a background session, a `done` run
from anywhere but the main checkout or under a lane's session (only the lead closes lanes), a
repo that sets extensions.worktreeConfig (git in the lane would read the lane-writable
config.worktree), a record whose Next says `Keep open:` (more PRs to come; --abandon closes it
anyway), and, when there is something to end, a failing `handoff-check --closing`.
A close refused after a signal, or one that couldn't record its proof (nothing signalled), leaves
the lane `closing`, which `open` refuses: rerun `done`, which keeps the pane shells the first run
proved. With nothing to end, a refused close leaves the lane as it was.
"""
import argparse
import contextlib
import datetime
import errno
import fcntl
import functools
import glob
import importlib.util
import json
import os
import re
import resource
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import threading
import time
from typing import NamedTuple

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import lanelib  # noqa: E402  (beside this script's real path)
from lanelib import Repo, git, lock, now_iso, write_json  # noqa: E402

TEMPLATE = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "..",
                        "templates", "LANE.md")
HOOKS = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "..", "hooks")
INSTALL_STATE = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "..",
                             "install-state.py")
STATUS = re.compile(r"[a-z][a-z_-]{0,19}")  # a session file's status word
CTX_MARK = {"soft": "*", "wrap": "*", "hard": "!"}  # the board's CTX mark per auto-pass tier
DEFAULT_CAP = 4
LOCK_BUSY = 75  # EX_TEMPFAIL: `lane lock --wait` gave up on a held lock
PROBE_GRACE = 0.05  # secs `lane lock` waits out a `lane ls` probe before it reports a holder
HOLDER_CMD_MAX = 120  # chars of the wrapped command kept in a lock's holder line
RECORD_READ = 1 << 20  # bytes of a lane's STATUS.md read by `ls` and `done`
PR_LIMIT = 200  # PRs `ls` lists in its one gh call, newest first
CLOCK_SLACK = 10  # secs: HAYPC's wall clock steps by about 5 s, and GitHub keeps another clock
TEE_GRACE = 1.0  # secs run_child keeps reading a teed pipe a grandchild holds once its child exits
TRIAL_GIT_WAIT = 120  # secs each git call of `lane trial` may take
TRIAL_IDENTITY = ("lane-trial", "lane-trial@localhost")  # the author of its dangling merges
# The lock every trial holds, one name for all: a trial clears this lane's leftover trees under
# it, so a second trial of the lane under another lock could remove the first one's live tree
TRIAL_LOCK = "suite"
OVERLAP_WAIT = 10  # secs each git call behind the board's overlap flag may take
OVERLAP_SHOWN = 5  # files each overlap line under the board names
# Every git behind the overlap flag: no transport at all, so not even a partial clone's lazy
# fetch runs a program its config names (install-state.py commits_past's set)
OVERLAP_ENV = {"GIT_NO_LAZY_FETCH": "1", "GIT_ALLOW_PROTOCOL": "none"}
# init's defaults and open's flags for claude's --model and --effort -> each one's check
PICKS = {"model": lanelib.model_problem, "effort": lanelib.effort_problem}
# new's brief flags -> the <placeholder> each fills in templates/LANE.md
BRIEF = {"goal": "goal", "files": "files", "overlaps": "overlaps", "done_when": "done-when",
         "constraints": "constraints"}


class LaneError(Exception):
    """A refusal or failure with a message for the user; exits 1."""


def say(msg: str) -> None:
    print(msg, flush=True)


def warn(msg: str) -> None:
    print(f"lane: {msg}", file=sys.stderr, flush=True)


def repo_here() -> Repo:
    repo = lanelib.resolve(os.getcwd())
    if repo is None:
        raise LaneError("not inside a git work tree")
    return repo


def lanes_repo() -> Repo:
    repo = repo_here()
    if not repo.has_lanes:
        old = os.path.join(repo.lanes_dir, "config.toml")
        hint = (f". {old} is the old layout's config, which sandboxed Bash could write, so it is "
                "no longer read: run `lane init` with the flags you want (don't copy its `setup` "
                "or `root` unread), then delete it") if os.path.isfile(old) else ""
        raise LaneError(f"no lanes config at {repo.config_path}: run `lane init` in the main "
                        f"checkout{hint}")
    return repo


def own_lane(repo: Repo) -> dict:
    kind, lane = repo.identity()
    if kind != "lane":
        raise LaneError(f"this checkout is {kind}, not a lane: run this from inside the lane")
    return lane


def toml_value(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, int):
        return str(v)
    s = str(v).replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")
    return f'"{s}"'


def write_config(repo: Repo, cfg: dict) -> None:
    """Flat keys only: the config never nests."""
    body = "# lanes config, written by `lane init`; flat keys only.\n"
    body += f"# repo: {repo.common_dir}\n"
    body += "".join(f"{k} = {toml_value(v)}\n" for k, v in cfg.items())
    lanelib.write_text(repo.config_path, body)


def parse_ports(spec: str) -> range | None:
    if not spec:
        return None
    try:
        lo, hi = (int(x) for x in spec.split("-", 1))
    except ValueError:
        raise LaneError(f"--ports wants A-B, got {spec!r}")
    if not 0 < lo <= hi < 65536:
        raise LaneError(f"bad port range {spec!r}")
    return range(lo, hi + 1)


def parse_locks(spec: str) -> list[str]:
    """The config's `locks`, "gate,e2e" -> ["gate", "e2e"]; each name becomes a file name."""
    names = [n.strip() for n in (spec or "").split(",") if n.strip()]
    bad = [n for n in names if not lanelib.ID_RE.fullmatch(n) or ".." in n]
    if bad:
        raise LaneError(f"bad lock name(s) {', '.join(bad)}: a slug of letters, digits, '.', '_', "
                        "'-' that starts with a letter or digit, with no '..'")
    return names


def lock_path(repo: Repo, name: str) -> str:
    return os.path.join(repo.lanes_dir, lanelib.LOCKS, name)


def holder_of(fd: int) -> str:
    """The holder line a `lane lock` run writes into its lock file once it holds the lock."""
    return (os.pread(fd, 4096, 0).decode(errors="replace").strip()
            or "an unknown holder (it has just taken the lock)")


def lock_holder(repo: Repo, name: str) -> str | None:
    """Who holds lock name, or None when it is free: a shared, non-blocking probe, let go at once."""
    try:
        fd = os.open(lock_path(repo, name), os.O_RDONLY | os.O_CLOEXEC)
    except FileNotFoundError:
        return None
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError:
            return holder_of(fd)
        fcntl.flock(fd, fcntl.LOCK_UN)
        return None
    finally:
        os.close(fd)


def sessions_in(live: list[dict], path: str) -> list[dict]:
    """The live sessions whose cwd is path or under it."""
    return [s for s in live if lanelib.inside(s.get("cwd") or "/nonexistent", path)]


def window_of(target: str) -> str:
    """A session file's tmux target `session:@window.%pane` -> `session:@window` (tmux allows no
    '.' in a session name)."""
    return target.rpartition(".")[0] or target


def window_label(session: dict) -> str:
    """A session file's tmux window (window_of), or "no tmux"; unmasked, so pass it through
    shown() with the line it goes in."""
    tmux = session.get("tmux")
    return window_of(tmux) if isinstance(tmux, str) and tmux else "no tmux"


def stopped_note(who: str, session: dict) -> str:
    """`<who> (pid N, <window>) is stopped (Ctrl+Z): fg it there`, for a session whose process
    exists but is stopped (lanelib.session_stopped): its socket still accepts a message that
    nothing reads until it is continued. Unmasked, like window_label."""
    return (f"{who} (pid {session['pid']}, {window_label(session)}) is stopped (Ctrl+Z): fg it "
            "there")


def fetch(repo: Repo) -> bool:
    p = git(["fetch", "--quiet", "origin"], repo.toplevel)
    if p.returncode != 0:
        line = (p.stderr.strip().splitlines() or ["unknown error"])[-1]
        warn(f"fetch skipped ({line}); using the local remote-tracking refs")
        return False
    return True


def rev(repo: Repo, ref: str) -> str | None:
    p = git(["rev-parse", "--verify", "--quiet", "--end-of-options", ref + "^{commit}"],
            repo.toplevel)
    return p.stdout.strip() if p.returncode == 0 else None


def base_ref(cfg: dict) -> str:
    """The base as a full ref. A short `origin/main` also names a tag or branch of that name,
    which sandboxed Bash can make and git would prefer to the remote-tracking ref."""
    base = cfg.get("base", "origin/main")
    return base if base.startswith("refs/") else f"refs/remotes/{base}"


def base_parts(repo: Repo, cfg: dict) -> tuple[str, str]:
    """(remote, branch) of the config's base, by the longest remote name that prefixes it: a
    remote's name may hold a '/' (my/fork)."""
    ref = base_ref(cfg)
    rest = ref.removeprefix("refs/remotes/")
    remotes = git(["remote"], repo.toplevel).stdout.split()
    remote = max((r for r in remotes if rest.startswith(r + "/")), key=len, default="")
    branch = rest[len(remote) + 1:] if remote else ""
    if not ref.startswith("refs/remotes/") or not branch:
        raise LaneError(f"the config's base {cfg.get('base')!r} must be <remote>/<branch> for a "
                        f"remote this repo has (a lane branches from the remote's commit): fix it "
                        f"in {repo.config_path}")
    return remote, branch


def fetched_base(repo: Repo, cfg: dict) -> str:
    """The commit the remote's base branch is at now, fetched. `new` branches only from this:
    sandboxed Bash can write every local ref, so neither a failed fetch's fallback to the local
    remote-tracking ref nor a ref rewritten after the fetch may choose the commit a lane's
    setup then runs on, sandbox-off."""
    remote, branch = base_parts(repo, cfg)

    def failed(what, p):
        line = (p.stderr.strip().splitlines() or ["unknown error"])[-1]
        return LaneError(f"{what} failed ({line}): a lane branches only from a freshly fetched "
                         f"{remote}/{branch}. Run a bare `lane new` (outside the sandbox) with "
                         "the network up")

    # Asked first, fetched second: the fetch then brings that commit (or a descendant of it, if
    # someone pushes in between), so only a force-push in between fails the check below.
    head = f"refs/heads/{branch}"
    p = git(["ls-remote", "--exit-code", remote, head], repo.toplevel)
    if p.returncode not in (0, 2):  # 2: no matching ref
        raise failed("ls-remote", p)
    # ls-remote matches a pattern against a ref's tail (a/refs/heads/main matches too): only the
    # exact ref counts.
    shas = [f[0] for f in map(str.split, p.stdout.splitlines()) if len(f) == 2 and f[1] == head]
    if len(shas) != 1 or not lanelib.SHA_RE.fullmatch(shas[0]):
        raise LaneError(f"the remote has no {head} for base {remote}/{branch}")
    p = git(["fetch", "--quiet", remote], repo.toplevel)
    if p.returncode != 0:
        raise failed("fetch", p)
    if rev(repo, shas[0]) != shas[0]:
        raise LaneError(f"the fetch didn't bring {remote}/{branch}'s commit {shas[0][:12]}: the "
                        f"remote was force-pushed meanwhile, or {remote}'s fetch refspec doesn't "
                        f"cover {branch}")
    return shas[0]


def worktree_heads(repo: Repo) -> dict[str, tuple[str, str]]:
    """Registered worktree path (real) -> (branch name, '' when detached; HEAD commit, '' when
    unborn)."""
    p = git(["worktree", "list", "--porcelain"], repo.toplevel, check=True)
    out, path = {}, None
    for line in p.stdout.splitlines():
        if line.startswith("worktree "):
            path = os.path.realpath(line[len("worktree "):])
            out[path] = ("", "")
        elif line.startswith("HEAD ") and path:
            out[path] = (out[path][0], line[len("HEAD "):])
        elif line.startswith("branch ") and path:
            out[path] = (line[len("branch "):].removeprefix("refs/heads/"), out[path][1])
    return out


def worktrees(repo: Repo) -> dict[str, str]:
    """Registered worktree path (real) -> branch name ('' when detached)."""
    return {path: branch for path, (branch, _) in worktree_heads(repo).items()}


def lane_head(lane: dict, heads: dict[str, tuple[str, str]]) -> tuple[str, str]:
    """(branch, ref) of the lane's work: the branch its worktree has checked out, since a `git
    switch` in the lane leaves lane.json's behind. A detached worktree gives ('', its HEAD
    commit); one that is gone, lane.json's branch."""
    path = os.path.realpath(lane["path"])
    if path in heads:
        branch, sha = heads[path]
        return (branch, f"refs/heads/{branch}") if branch else ("", sha)
    return lane["branch"], f"refs/heads/{lane['branch']}"


def branch_label(branch: str, ref: str) -> str:
    """lane_head's branch as `ls` and `whoami` show it."""
    return branch or f"(detached {ref[:12]})"


def rebasing_branch(repo: Repo, path: str) -> str:
    """The branch a detached worktree at `path` is rebasing, from the head-name git keeps in
    its admin dir (the one whose gitdir file names `path`), or ''. Any lane can write that dir,
    so it is read bounded, never through a link, and only a valid branch name counts: it picks
    only the PR `ls` shows and the merges handoff? judges besides lane.json's branch's, which a
    planted name can't hide."""
    for admin in glob.glob(os.path.join(repo.common_dir, "worktrees", "*")):
        named = lanelib.read_head(os.path.join(admin, "gitdir"), 4096)
        if named is None or os.path.realpath(os.path.dirname(
                named.decode(errors="replace").strip())) != path:
            continue
        for sub in ("rebase-merge", "rebase-apply"):
            head = lanelib.read_head(os.path.join(admin, sub, "head-name"), 4096)
            name = (head or b"").decode(errors="replace").strip().removeprefix("refs/heads/")
            if head and lanelib.valid_branch(name):
                return name
    return ""


def check_id(lane_id: str) -> None:
    """Every subcommand that takes an id checks it first: an id becomes a path under lanes/."""
    if not lanelib.valid_id(lane_id):
        raise LaneError(f"bad lane id {lane_id!r}: a slug of letters, digits, '.', '_', '-' that "
                        "starts with a letter or digit, with no '..'; not 'main'")


def requests(raw: list[str]) -> list[str]:
    """Requests as claimed: '42' -> '#42', and each a short token (lanelib.CLAIM_RE), since a
    record holding anything else is refused on load."""
    reqs = [lanelib.norm_request(r) for r in raw]
    if bad := [r for r in reqs if not lanelib.CLAIM_RE.fullmatch(r)]:
        raise LaneError(f"bad request {bad[0]!r}: a number, or a tracker key of letters, "
                        "digits, '.', '_', '-'")
    return reqs


def check_unregistered(repo: Repo, lane_id: str) -> None:
    check_id(lane_id)
    if lane_id == "lead":  # refused only for a new lane, so an existing one still loads
        raise LaneError("lane id 'lead' is reserved: `lane addr lead` names the main checkout's "
                        "session")
    if os.path.lexists(repo.lane_dir(lane_id)):
        raise LaneError(f"lane {lane_id} is already registered (or {repo.lane_dir(lane_id)} "
                        "exists)")


def lane_data_dir(repo: Repo, lane_id: str) -> str:
    """lanes/<id>, asserted to sit directly inside lanes/ before anything deletes it."""
    check_id(lane_id)
    d = os.path.realpath(repo.lane_dir(lane_id))
    if os.path.dirname(d) != os.path.realpath(repo.lanes_dir):
        raise LaneError(f"refusing: {d} is not a lane dir inside {repo.lanes_dir}")
    return d


def free_port(repo: Repo, cfg: dict) -> int | None:
    ports = parse_ports(cfg.get("ports", ""))
    if ports is None:
        return None
    used = {lane.get("port") for lane in repo.lanes(shared=True)}
    for port in ports:
        if port not in used:
            return port
    raise LaneError(f"no free port in {cfg['ports']}: every one is held by a lane")


def add_exclude(repo: Repo) -> None:
    """Hide every lane's .lane/ through the shared info/exclude, once. This runs sandbox-off, so
    a linked info/ or exclude (which sandboxed Bash could plant) is refused, not appended to."""
    info = os.path.join(repo.common_dir, "info")
    path = os.path.join(info, "exclude")
    if os.path.islink(info) or os.path.islink(path):
        raise LaneError(f"refusing: {info} or its exclude is a symlink")
    try:
        with open(path) as f:
            text = f.read()
    except FileNotFoundError:
        text = ""
    if "/.lane/" in text.splitlines():
        return
    os.makedirs(info, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, "a") as f:
        f.write(("" if not text or text.endswith("\n") else "\n") + "/.lane/\n")


def copy_includes(repo: Repo, dest: str) -> list[str]:
    """Copy the main checkout's gitignored files that .worktreeinclude matches (gitignore syntax).
    An existing file is never overwritten: in a finished lane it may hold a lane-local fix."""
    include = os.path.join(repo.main, ".worktreeinclude")
    if not os.path.isfile(include):
        return []
    p = git(["ls-files", "--others", "--ignored", f"--exclude-from={include}"], repo.main, check=True)
    matched = [x for x in p.stdout.splitlines() if x]
    if not matched:
        return []
    ignored = subprocess.run(["git", "check-ignore", "--stdin"], cwd=repo.main, input="\n".join(matched),
                             capture_output=True, text=True).stdout.splitlines()
    copied = []
    for rel in ignored:
        if any(part in ("", ".", "..") for part in rel.split("/")):
            warn(f"not copied from .worktreeinclude: {rel!r} is no plain path")
            continue
        try:
            if copy_one(repo.main, dest, rel):
                copied.append(rel)
        except NotADirectoryError:
            warn(f"not copied from .worktreeinclude: {rel} (a dir on its way is a symlink)")
    return copied


def open_parent(root: str, rel: str, create: bool) -> tuple[int, str]:
    """(fd of root/rel's dir, rel's last name), opening each dir below root by fd with
    O_NOFOLLOW: a symlink anywhere on the way, even one swapped in mid-walk, fails the open
    instead of leading out of root. create makes missing dirs."""
    fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY)
    *dirs, name = rel.split("/")
    try:
        for d in dirs:
            if create:
                with contextlib.suppress(FileExistsError):
                    os.mkdir(d, dir_fd=fd)
            try:
                nxt = os.open(d, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            except OSError as e:
                if e.errno in (errno.ELOOP, errno.ENOTDIR):
                    raise NotADirectoryError(e.errno, e.strerror, d)
                raise
            os.close(fd)
            fd = nxt
    except BaseException:
        os.close(fd)
        raise
    return fd, name


def copy_fd(src: int, out: int) -> None:
    os.lseek(src, 0, os.SEEK_SET)
    while chunk := os.read(src, 1 << 20):
        view = memoryview(chunk)
        while view:
            view = view[os.write(out, view):]


def copy_one(main: str, dest: str, rel: str) -> bool:
    """Copy main/rel to dest/rel, unless dest/rel exists; True if copied. This runs sandbox-off,
    and sandboxed Bash can plant both the file and .worktreeinclude, and the lane's own session
    can plant links in dest. So both sides go by dir fd (open_parent); a link is copied as a
    link, never read through, so the sandbox's read deny still holds at its target (a relative
    one is made absolute, naming the same file from the lane); a regular file is read from an
    fd opened with O_NOFOLLOW and checked by fstat; anything else is left alone. The copy goes
    to a fresh temp renamed into place whole: a failure never leaves half a file, and no
    neighbouring file (a `<name>.part` of the lane's own) is clobbered or deleted."""
    sdir, name = open_parent(main, rel, create=False)
    src = link = None
    try:
        st = os.stat(name, dir_fd=sdir, follow_symlinks=False)
        if stat.S_ISLNK(st.st_mode):
            link = os.readlink(name, dir_fd=sdir)
            if not os.path.isabs(link):
                link = os.path.normpath(os.path.join(main, os.path.dirname(rel), link))
        else:
            try:  # O_NONBLOCK: opening a FIFO must not wait for a writer
                src = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=sdir)
            except OSError as e:
                if e.errno != errno.ELOOP:  # ELOOP: swapped for a link since the stat
                    raise
            if src is None or not stat.S_ISREG((st := os.fstat(src)).st_mode):
                warn(f"not copied from .worktreeinclude: {rel} is not a regular file")
                return False
        ddir, dname = open_parent(dest, rel, create=True)
        try:
            with contextlib.suppress(FileNotFoundError):
                os.stat(dname, dir_fd=ddir, follow_symlinks=False)
                return False
            if link is not None:
                os.symlink(link, dname, dir_fd=ddir)
                return True
            tmp = f".tmp-lane-{os.getpid()}-{time.monotonic_ns()}"
            out = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600,
                          dir_fd=ddir)
            try:
                try:
                    copy_fd(src, out)
                    os.fchmod(out, stat.S_IMODE(st.st_mode))
                    os.utime(out, ns=(st.st_atime_ns, st.st_mtime_ns))
                finally:
                    os.close(out)
                os.rename(tmp, dname, src_dir_fd=ddir, dst_dir_fd=ddir)
            except BaseException:
                with contextlib.suppress(OSError):
                    os.unlink(tmp, dir_fd=ddir)
                raise
            return True
        finally:
            os.close(ddir)
    finally:
        os.close(sdir)
        if src is not None:
            os.close(src)


def lane_files(repo: Repo, lane: dict, brief: dict) -> list[str]:
    """The 'copy' step of making a lane: included files, the shared exclude, the seeded record.
    A failure becomes a LaneError naming the half-made lane and how to finish it."""
    if lanelib.record_is_link(lane):
        raise LaneError(f"{lanelib.record_dir(lane)} is a symlink in the repo's tree, and a lane's "
                        "record must be a real dir (a link would mirror and archive its target). "
                        f"Remove the link from the repo, then `lane adopt {lane['path']}`, or "
                        f"`lane done {lane['id']} --abandon`")
    try:
        copied = copy_includes(repo, usable_path(repo, lane))
        add_exclude(repo)
        seed_record(lane, brief)
    except (OSError, subprocess.CalledProcessError) as e:
        raise LaneError(f"lane {lane['id']} is half made at {lane['path']} ({e}). Fix the cause, "
                        f"then finish it with `lane adopt {lane['path']}`, or remove it with "
                        f"`lane done {lane['id']} --abandon`")
    return copied


def run_setup(repo: Repo, lane: dict) -> None:
    """The 'setup' step: the configured command in the lane, with LANE_ID and LANE_PORT set. A
    failure marks the lane setup-failed at this step and raises."""
    setup = repo.config().get("setup")
    if not setup:
        return
    env = dict(os.environ, LANE_ID=lane["id"], LANE_PORT=str(lane.get("port") or ""))
    say(f"  setup: {setup}")
    if subprocess.run(setup, shell=True, cwd=usable_path(repo, lane), env=env).returncode != 0:
        with lock(repo):
            lanelib.update_lane(repo, lane["id"], lambda x: x.update(state="setup-failed",
                                                                     setup_failed="setup"))
        raise LaneError(f"setup failed in {lane['path']}; the lane is registered (setup-failed): "
                        f"fix it there, then `lane adopt {lane['path']}` re-runs only the setup, "
                        f"or `lane done {lane['id']} --abandon`")


def mark_active(lane: dict) -> None:
    lane["state"] = "active"
    lane.pop("setup_failed", None)


def seed_record(lane: dict, brief: dict) -> None:
    path = lanelib.record_path(lane)
    if os.path.exists(path):
        return
    with open(TEMPLATE) as f:
        text = f.read()
    fill = {"id": lane["id"], "branch": lane["branch"], "date": now_iso()[:10],
            "requests": ", ".join(lane["claims"]) or "none claimed"}
    fill.update({k: v for k, v in brief.items() if v})
    for key, value in fill.items():
        text = text.replace(f"<{key}>", value)
    lanelib.write_text(path, text)


def new_record(lane_id: str, branch: str, path: str, base_sha: str | None, port: int | None,
    claims: list[str],
) -> dict:
    stamp = now_iso()
    return {"id": lane_id, "branch": branch, "path": path, "base_sha": base_sha, "port": port,
            "claims": claims, "state": "active", "sessions": [], "created": stamp,
            "updated": stamp}


def claim_conflicts(repo: Repo, lane_id: str, reqs: list[str]) -> list[str]:
    """Requests a live lane other than lane_id already claims, as '#42 (chart-fix)'."""
    out = []
    for other in repo.lanes(shared=True):
        if other["id"] == lane_id or not lanelib.is_live(other):
            continue  # a stale lane (worktree gone) is not live, so its claims don't hold
        out += [f"{r} ({other['id']})" for r in reqs if r in other.get("claims", [])]
    return out


# ---- subcommands ----------------------------------------------------------------------------

def cmd_init(args) -> None:
    repo = repo_here()
    if not repo.is_main:
        raise LaneError(f"run `lane init` in the main checkout ({repo.main})")
    parse_ports(args.ports or "")
    if args.locks is not None:
        args.locks = ",".join(parse_locks(args.locks))
    for key, problem in PICKS.items():
        if (value := getattr(args, key)) and (why := problem(value)):
            raise LaneError(why)
    with lock(repo):
        cfg = repo.config() if repo.has_lanes else {}
        name = os.path.basename(repo.main)
        cfg.setdefault("root", os.path.join(os.path.dirname(repo.main), f"{name}-lanes"))
        cfg.setdefault("setup", "")
        cfg.setdefault("ports", "")
        cfg.setdefault("cap", DEFAULT_CAP)
        cfg.setdefault("base", "origin/main")
        cfg.setdefault("locks", "")
        for key in ("root", "setup", "ports", "cap", "locks"):
            value = getattr(args, key)
            if value is not None:
                cfg[key] = os.path.abspath(os.path.expanduser(value)) if key == "root" else value
        if args.autopass is not None:  # unset means on (autopass_state.decide)
            cfg["autopass"] = args.autopass
        for key in PICKS:  # empty means the user's default: no flag at `open`
            value = getattr(args, key)
            if value == "":
                cfg.pop(key, None)
            elif value is not None:
                cfg[key] = value
        try:
            write_config(repo, cfg)
        except OSError as e:
            raise LaneError(f"can't write {repo.config_path} ({e.strerror}). The Bash sandbox "
                            "can't write the state dir, by design: run it as a bare `lane init`, "
                            "which excludedCommands runs outside the sandbox")
        add_exclude(repo)
    say(f"lanes config: {repo.config_path}")
    for key, value in cfg.items():
        say(f"  {key} = {toml_value(value) if isinstance(value, bool) else value}")
    # Claude Code asks "trust this folder?" for an untrusted cwd, and a trusted parent covers its
    # subdirs (probed 2026-10-11, 2.1.296): without this, every `lane open` window stops there.
    say(f"Trust the lanes root once, or each `lane open` window waits at Claude Code's trust "
        f"dialog: mkdir -p {shlex.quote(cfg['root'])} && cd {shlex.quote(cfg['root'])} && "
        "claude, then accept and exit")


def cmd_new(args) -> None:
    repo = lanes_repo()
    cfg = repo.config()
    reqs = requests(args.claim)
    branch = args.branch or args.id
    if not lanelib.valid_branch(branch):
        raise LaneError(f"bad branch name {branch!r}: letters, digits, '.', '_', '/', '+', '-', "
                        "starting with a letter or digit")
    path = os.path.join(cfg["root"], args.id)
    base = cfg.get("base", "origin/main")
    base_sha = fetched_base(repo, cfg)
    with lock(repo):
        check_unregistered(repo, args.id)
        live = list(filter(lanelib.is_live, repo.lanes(shared=True)))
        if len(live) >= int(cfg.get("cap", DEFAULT_CAP)):
            raise LaneError(f"{len(live)} live lanes, at the cap of {cfg.get('cap')}: close one "
                            "with `lane done`, or raise it with `lane init --cap`")
        if os.path.exists(path):
            raise LaneError(f"{path} already exists")
        if held := holders(repo, path):  # a stale record would make the new lane its twin
            raise LaneError(f"lane {', '.join(x['id'] for x in held)} still holds {path}: close "
                            "it with `lane done` first")
        if conflicts := claim_conflicts(repo, args.id, reqs):
            raise LaneError("already claimed: " + ", ".join(conflicts))
        port = free_port(repo, cfg)
        os.makedirs(cfg["root"], exist_ok=True)
        # From the commit, not the ref name: no upstream is set, and no ref rewritten since the
        # fetch can choose the tree.
        p = git(["worktree", "add", "-b", branch, path, base_sha], repo.toplevel)
        if p.returncode != 0:
            raise LaneError("git worktree add failed: " + p.stderr.strip())
        # Registered the moment the worktree exists, so a failure below leaves a lane that
        # `adopt` finishes or `done --abandon` removes, never an orphan worktree.
        lane = new_record(args.id, branch, os.path.realpath(path), base_sha, port, reqs)
        lane.update(state="setup-failed", setup_failed="copy")
        write_json(repo.lane_json(args.id), lane)
        copied = lane_files(repo, lane, {ph: getattr(args, attr) for attr, ph in BRIEF.items()})
        lane = lanelib.update_lane(repo, args.id, mark_active)
    say(f"lane {args.id}: branch {branch} from {base} ({base_sha[:12]}), port {port or 'none'}")
    if copied:
        say(f"  copied {len(copied)} file(s) from .worktreeinclude")
    say(f"  record {lanelib.record_path(lane)}")
    run_setup(repo, lane)
    check_worktree(lane, seed_ask=True)  # after the setup, which may set core.hooksPath
    say(f"cd {lane['path']} && claude")


def finish(repo: Repo, lane: dict) -> None:
    """Finish a lane `new` left setup-failed, redoing only the failed step onward: a failed copy
    redoes the copy (never over a file the lane already has) and then the setup; a failed setup
    redoes the setup alone."""
    with lock(repo):
        if lane.get("setup_failed", "copy") == "copy":
            lane_files(repo, lane, {})
            lane = lanelib.update_lane(repo, lane["id"], lambda x: x.update(setup_failed="setup"))
    run_setup(repo, lane)
    check_worktree(lane, seed_ask=True)  # still setup-failed, which `open` refuses: no session
    with lock(repo):
        lane = lanelib.update_lane(repo, lane["id"], mark_active)
    say(f"finished lane {lane['id']}: branch {lane['branch']}, port {lane['port'] or 'none'}")
    say(f"  record {lanelib.record_path(lane)}")


def cmd_adopt(args) -> None:
    repo = lanes_repo()
    cfg = repo.config()
    path = os.path.realpath(args.path)
    trees = worktrees(repo)
    if path not in trees:
        raise LaneError(f"{path} is not a worktree of this repo (`git worktree list`)")
    if path == repo.main:
        raise LaneError("the main checkout is `main`, not a lane")
    if not trees[path]:
        raise LaneError(f"{path} is on a detached HEAD: check out its branch first")
    if not lanelib.valid_branch(trees[path]):
        raise LaneError(f"its branch {trees[path]!r} is no name a lane can carry: letters, "
                        "digits, '.', '_', '/', '+', '-', starting with a letter or digit")
    if why := lanelib.worktree_problem(repo, path, repo.lanes(shared=True)):
        raise LaneError(f"refusing to adopt: {why}")
    held = holders(repo, path)
    if len(held) > 1:
        raise LaneError(f"lanes {', '.join(x['id'] for x in held)} all claim {path}. Sandboxed "
                        f"Bash can write any lane.json: look at each under {repo.lanes_dir}/ and "
                        "remove the ones the CLI didn't write")
    known = held[0] if held else None
    if known and known.get("state") == "setup-failed":
        finish(repo, known)
        return
    if known:
        raise LaneError(f"{path} is already registered as lane {known['id']}")
    lane_id = args.id or os.path.basename(path)
    if not args.id and not lanelib.valid_id(lane_id):
        raise LaneError(f"the dir name {lane_id!r} is no lane id (a slug that starts with a "
                        "letter or digit, at most 64 chars, not 'main'): pass `--id <slug>`, or "
                        "rename the worktree with `git worktree move`")
    if os.path.islink(os.path.join(path, lanelib.RECORD_DIR)):
        raise LaneError(f"{path}/.lane is a symlink, and a lane's record must be a real dir (a "
                        "link would mirror and archive its target): remove it, then adopt")
    with lock(repo):
        check_unregistered(repo, lane_id)
        if held := holders(repo, path):  # again under the lock: a racing adopt or new
            raise LaneError(f"{path} is already registered as lane {held[0]['id']}")
        mb = git(["merge-base", "--end-of-options", f"refs/heads/{trees[path]}", base_ref(cfg)],
                 repo.toplevel)
        lane = new_record(lane_id, trees[path], path, mb.stdout.strip() or None,
                          free_port(repo, cfg), [])
        lane["adopted"] = True  # its base is a merge-base, which a fast-forward merge makes its tip
        try:
            add_exclude(repo)
            seed_record(lane, {})
        except OSError as e:
            raise LaneError(f"could not seed {lanelib.record_path(lane)}: {e}")
        write_json(repo.lane_json(lane_id), lane)
    say(f"adopted lane {lane_id}: branch {lane['branch']}, port {lane['port'] or 'none'}")
    say(f"  record {lanelib.record_path(lane)}")
    check_worktree(lane, seed_ask=False)


class PRs(NamedTuple):
    """pr_states' answer, by head branch. label: the newest PR's "#N state". merges: the mergedAt
    of each merged PR (None where unreadable). horizon: when the list hit PR_LIMIT, the oldest
    createdAt it holds, since older PRs may be cut (inf when one won't parse); else None."""
    label: dict[str, str]
    merges: dict[str, list[float | None]]
    horizon: float | None


def pr_states(repo: Repo) -> PRs | None:
    """The newest PR_LIMIT PRs from one gh call, a fork's too: a lane may push to one, and a
    stranger's merge can only light handoff?, never clear it. None when gh can't answer (no
    network or token)."""
    try:
        p = subprocess.run(["gh", "pr", "list", "--state", "all", "--limit", str(PR_LIMIT),
                            "--json", "number,state,headRefName,mergedAt,createdAt"],
                           cwd=repo.toplevel, capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    if p.returncode != 0:
        return None
    try:
        rows = json.loads(p.stdout)
    except ValueError:
        return None
    label, merges = {}, {}
    for row in sorted(rows, key=lambda r: r.get("number", 0)):  # the newest PR wins the label
        state, head = str(row.get("state")), row.get("headRefName")
        label[head] = f"#{row.get('number')} {state.lower()}"
        if state == "MERGED":
            merges.setdefault(head, []).append(lanelib.parse_iso(row.get("mergedAt")))
    horizon = None
    if len(rows) >= PR_LIMIT:  # gh lists newest first, so what it cut is older than all it kept
        stamps = [lanelib.parse_iso(r.get("createdAt")) for r in rows]
        horizon = float("inf") if None in stamps else min(stamps)
    return PRs(label, merges, horizon)


def merges_of(prs: PRs | None, lane: dict, guess: str) -> list[float | None] | None:
    """The mergedAt of every merged PR from the lane's branches: the one `ls` shows the PR of,
    and lane.json's, which a switch for a follow-up PR leaves behind. None when that can't be
    known: gh can't answer, or a full list may have cut the lane's PRs (the lane is older than
    its horizon, adopted, or switched branches, so a branch may hold a PR older than the lane)."""
    if prs is None:
        return None
    created = lanelib.parse_iso(lane.get("created"))
    if prs.horizon is not None and (lane.get("adopted") or guess != lane["branch"]
                                    or created is None or created < prs.horizon):
        return None
    return [m for b in dict.fromkeys((guess, lane["branch"])) for m in prs.merges.get(b, [])]


def hook_module(name: str):
    """A module in hooks/, found from this script's real path, or None."""
    if HOOKS not in sys.path:
        sys.path.insert(0, HOOKS)
    try:
        return importlib.import_module(name)
    except Exception:
        return None


def autopass_state():
    """hooks/autopass_state (the tiers, the ctx files), or None: the board's CTX is then
    unknown."""
    return hook_module("autopass_state")


def check_worktree(lane: dict, seed_ask: bool) -> None:
    """What the excluded-command guard (hooks/excluded_guard) would refuse an excluded call (git
    push, gh, lane) from the lane's own session, each dir with the Edit deny rule that protects
    it. A repo whose setup sets a relative core.hooksPath gives every worktree its own hooks dir,
    and the guard reads no glob, so each lane needs a rule of its own. `new`, and `adopt`
    finishing a lane `new` left setup-failed (which `open` refuses), also seed the ask into the
    record `new` wrote, before any session; adopting another worktree only warns, as its record
    is the lane's to write. Advisory: it never fails the lane."""
    guard = hook_module("excluded_guard")
    try:
        if guard is None:
            raise ImportError(f"no excluded_guard in {HOOKS}")
        refusals, error = guard.project_refusals(dict(os.environ), lane["path"])
    except Exception as e:
        refusals, error = [], e
    if error:
        warn(f"could not check lane {lane['id']}'s git config for the excluded-command guard "
             f"({type(error).__name__}: {error})")
    if not refusals:
        return
    found = [guard.finding(r) for r in refusals]
    warn(f"excluded-guard will refuse lane {lane['id']}'s excluded calls (git push, gh, lane) "
         "until these are fixed:")
    for line in found:
        warn(f"  {line}")
    warn("Look at each dir first (`python3 -I ~/.claude/hooks/excluded_guard.py --scan`, sandbox "
         "off), then add the rules to permissions.deny in ~/.claude/settings.machine.json and "
         "rerun ./setup.sh")
    if seed_ask:
        ask = (f"- excluded-guard refuses this lane's excluded calls until: {'; '.join(found)} "
               "(rules into ~/.claude/settings.machine.json, then ./setup.sh). Seeded by "
               "`lane new`.")
        if not seed_line(lane, "## Asks for Hayden", ask):
            warn(f"could not add that to {lanelib.record_path(lane)}'s Asks for Hayden")


def seed_line(lane: dict, heading: str, line: str) -> bool:
    """Add `line` under `heading` (after its comment) in the record `new` seeded, unless a
    session is live in the lane: the record is then its to write (invariant 2). The setup ran in
    the lane in between, so every step goes through one fd of the real .lane dir, opened without
    following a link: the record is read without following one, as a regular file under the read
    limit, and replaced whole, byte for byte. False when it isn't there as seeded."""
    live = lanelib.live_sessions()
    if live is None or sessions_in(live, os.path.realpath(lane["path"])):
        return False
    try:
        d = os.open(lanelib.record_dir(lane), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError:
        return False
    tmp = f".tmp-seed-{os.getpid()}"
    try:
        fd = os.open("STATUS.md", os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW, dir_fd=d)
        with os.fdopen(fd, "rb") as f:
            if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
                return False
            data = f.read(RECORD_READ + 1)
        if len(data) > RECORD_READ:  # rewriting a cut read would lose the rest
            return False
        m = re.search(rb"^" + re.escape(heading.encode()) + rb"\n(<!--.*?-->\n)?", data,
                      re.M | re.S)
        if not m:
            return False
        out = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644, dir_fd=d)
        with os.fdopen(out, "wb") as f:
            f.write(data[:m.end()] + os.fsencode(line) + b"\n" + data[m.end():])
        os.replace(tmp, "STATUS.md", src_dir_fd=d, dst_dir_fd=d)
        return True
    except OSError:
        try:
            os.unlink(tmp, dir_fd=d)
        except OSError:
            pass
        return False
    finally:
        os.close(d)


def orphaned_rules(lane_id: str, path: str) -> None:
    """After a close: the Edit deny rules that named paths in the removed worktree."""
    guard = hook_module("excluded_guard")
    try:
        if guard is None:
            raise ImportError(f"no excluded_guard in {HOOKS}")
        found = guard.rules_naming(path, os.environ)
    except Exception as e:
        warn(f"could not read the deny rules naming {path} ({type(e).__name__}: {e})")
        return
    claude = os.path.join(os.path.expanduser("~"), ".claude")
    overlay = {rule for f, rule in found if f == os.path.join(claude, "settings.machine.json")}
    # settings.json's copy of an overlay rule is setup.sh's: dropping it from the overlay drops it.
    found = [(f, rule) for f, rule in found
             if not (f == os.path.join(claude, "settings.json") and rule in overlay)]
    if not found:
        return
    say(f"lane {lane_id}'s worktree is gone, so these permissions.deny rules name nothing now:")
    for f, rule in found:
        say(f"  {rule}  in {f}")
    say("Drop each from its file (for settings.machine.json, then rerun ./setup.sh).")


def status_of(session: dict) -> str:
    """A live session's status from its session file (busy, idle, waiting, or shell while a
    background shell runs at the prompt), else "?" (also for anything but one short word)."""
    v = session.get("status")
    return v if isinstance(v, str) and STATUS.fullmatch(v) else "?"


def transcript_of(aps, sid: str):
    """The session's transcript path from its stop record (stops/<session>.json, which
    stop-ring writes at every Stop), so its window comes from its own config dir, as the
    watcher's does. None before the first Stop: lane's own config dir then decides."""
    rec = aps.load_json(os.path.join(aps.state_dir(), "stops", sid + ".json"))
    tp = rec.get("transcript_path") if isinstance(rec, dict) else None
    return tp if isinstance(tp, str) and tp else None


def ctx_of(aps, sessions: list[dict]) -> dict | None:
    """The most urgent context among the live sessions, from the watcher's ctx/<session>.json:
    {"session", "tokens", "tier", "status"}, where tier is the highest auto-pass tier the count
    has passed on that session's window (None below soft, or when the window has no tiers) and
    status is status_of. The highest tier wins, then the most tokens. None when no session has
    a count, or without aps."""
    best = None
    rank = {None: 0, "soft": 1, "wrap": 2, "hard": 3}
    for s in sessions if aps is not None else []:
        sid = s.get("sessionId")
        if not isinstance(sid, str) or not lanelib.SID.fullmatch(sid):
            continue
        rec = aps.read_ctx(sid)
        tokens = rec.get("tokens")
        if not aps.is_int(tokens) or tokens < 0:
            continue
        try:
            tiers = aps.tiers(aps.window(transcript_of(aps, sid), rec.get("window")))
        except Exception:
            tiers = None
        tier = next((t for t in ("hard", "wrap", "soft") if tiers and tokens >= tiers[t]), None)
        row = {"session": sid, "tokens": tokens, "tier": tier, "status": status_of(s)}
        if best is None or (rank[tier], tokens) > (rank[best["tier"]], best["tokens"]):
            best = row
    return best


def ctx_cell(ctx: dict | None) -> str:
    if ctx is None:
        return "-"
    return "%dk%s" % (round(ctx["tokens"] / 1000), CTX_MARK.get(ctx["tier"], ""))


def read_git(args: list[str], cwd: str, env: dict[str, str],
             ok: tuple[int, ...] = (0,)) -> tuple[subprocess.CompletedProcess | None, str]:
    """(git's result, '') when it exits with a code in ok, else (None, why): `ls` shows its board
    whatever git does, so a failure, OVERLAP_WAIT running out, or output that isn't UTF-8 (a
    lane names its own files) becomes a reason to warn with. env is lanelib.git's."""
    try:
        p = git(args, cwd, timeout=OVERLAP_WAIT, env=env)
    except subprocess.TimeoutExpired:
        return None, f"git took over {OVERLAP_WAIT} s"
    except (OSError, subprocess.SubprocessError, ValueError) as e:  # ValueError: not UTF-8
        return None, f"git didn't run: {e}"
    if p.returncode not in ok:
        return None, next(iter(p.stderr.strip().splitlines()), f"git exit {p.returncode}")
    return p, ""


def per_worktree_config(repo: Repo) -> bool | None:
    """Whether the repo sets extensions.worktreeConfig, as `done` checks it (the common dir's own
    config file); None when git can't tell, which `ls` treats as set."""
    p, _ = read_git(["config", "--file", os.path.join(repo.common_dir, "config"), "--type=bool",
                     "--get", "extensions.worktreeConfig"], repo.main, dict(OVERLAP_ENV),
                    ok=(0, 1))  # 1: unset
    return None if p is None else p.stdout.strip() == "true"


def changed_files(repo: Repo, lane: dict, base: str, ref: str, lanes: list[dict],
                  per_worktree: bool | None) -> tuple[set[str], str | None]:
    """The files a live lane's work changes, for the board's overlap flag, and why part of them
    went unread (None when nothing did). Committed: the three-dot diff from base to ref
    (lane_head's), so main's later commits and a merged lane's work drop out; it reads objects
    only. Uncommitted: modified, staged and untracked files, from `git status` in the lane.

    That status is the first git `ls` runs in a lane, sandbox-off, so it runs only once each
    gate passes, else the lane keeps its committed set and `ls` warns. lanes is every record
    (Repo.lanes(shared=True)) for worktree_problem; per_worktree is per_worktree_config's.
      - worktree_problem: the lane is a real worktree of this repo;
      - per_worktree false: git there would read the lane-writable config.worktree too;
      - no filter's clean or process command configured: status re-hashes a stat-dirty file
        through the clean filter the lane picks by its own .gitattributes (or by the
        sandbox-writable <common>/info/attributes);
      - GIT_COMMON_DIR: config only from this repo's common dir, never the lane-writable
        commondir file worktree_problem checked (a lane could repoint it after);
      - GIT_OPTIONAL_LOCKS=0: no index write, so no index.lock taken under the lane's own `git
        commit`, and no post-index-change hook, which a relative core.hooksPath would run from
        the lane's worktree;
      - core.fsmonitor=false: a relative fsmonitor command would resolve in the lane;
      - --ignore-submodules=all: git never runs a status in a submodule, whose own config the
        lane can write. That child gets GIT_CONFIG_PARAMETERS, so the -c above turns off its
        fsmonitor too, but nothing else here would keep its clean filter from running."""
    env = dict(OVERLAP_ENV)
    files, unread = set(), []
    p, why = read_git(["diff", "--name-only", "-z", "--no-renames", "--no-ext-diff",
                       "--end-of-options", f"{base}...{ref}", "--"], repo.toplevel, env)
    if p is not None:
        files.update(filter(None, p.stdout.split("\0")))
    else:
        unread.append(f"its commits went unread ({why})")
    path = lane["path"]
    env.update(GIT_COMMON_DIR=repo.common_dir, GIT_OPTIONAL_LOCKS="0")
    why = lanelib.worktree_problem(repo, path, lanes)
    if why is None and per_worktree is not False:
        why = ("this repo sets extensions.worktreeConfig, so git there reads the lane-writable "
               "config.worktree" if per_worktree else
               "can't tell whether this repo sets extensions.worktreeConfig")
    if why is None:
        p, err = read_git(["config", "--get-regexp", r"^filter\..*\.(clean|process)$"], path, env,
                          ok=(0, 1))  # 1: none set
        if p is None:
            why = f"its filter config went unread: {err}"
        elif p.returncode == 0:
            why = ("a filter's clean or process command is configured, which `git status` there "
                   "would run on files the lane picks")
    if why is None:
        p, why = read_git(["-c", "core.fsmonitor=false", "status", "--porcelain=v1", "-z",
                           "--untracked-files=all", "--no-renames", "--ignore-submodules=all"],
                          path, env)
        if p is not None:  # each entry is `XY path`: --no-renames leaves no second path
            files.update(entry[3:] for entry in p.stdout.split("\0") if entry)
    if why:
        unread.append(f"its uncommitted files went unread ({why})")
    return files, "; ".join(unread) or None


def overlap_lines(rows: list[dict]) -> list[str]:
    """The board's line for each pair of lanes whose changed files overlap (board's overlaps),
    naming at most OVERLAP_SHOWN files, control characters masked: a lane names its own
    files."""
    out = []
    for row in rows:
        for other, both in sorted(row["overlaps"].items()):
            if other < row["id"]:
                continue  # each pair once, from its first lane
            more = (f" (and {len(both) - OVERLAP_SHOWN} more)" if len(both) > OVERLAP_SHOWN
                    else "")
            out.append(shown(f"overlap: {row['id']} and {other} both change "
                             f"{', '.join(both[:OVERLAP_SHOWN])}{more}"))
    return out


def board(repo: Repo) -> list[dict]:
    """Each lane's record plus its derived state: nothing here is stored."""
    cfg = repo.config()
    base = base_ref(cfg)
    trees = worktree_heads(repo)
    prs = pr_states(repo)
    live = lanelib.live_sessions()
    aps = autopass_state()
    lanes = repo.lanes()
    claimers = {}
    for lane in lanes:
        if os.path.realpath(lane["path"]) in trees and os.path.isdir(lane["path"]):
            for r in lane.get("claims", []):
                claimers.setdefault(r, []).append(lane["id"])
    # The overlap flag: each live lane's changed files, read now and never stored. A stale
    # lane's are left out, as its claims are.
    shared, per_worktree, changed = repo.lanes(shared=True), per_worktree_config(repo), {}
    for lane in lanes:
        if os.path.realpath(lane["path"]) in trees and os.path.isdir(lane["path"]):
            changed[lane["id"]], why = changed_files(repo, lane, base, lane_head(lane, trees)[1],
                                                     shared, per_worktree)
            if why:
                warn(shown(f"overlap for lane {lane['id']} may be short: {why}"))
    overlaps = {a: {b: sorted(changed[a] & changed[b]) for b in changed
                    if b != a and changed[a] & changed[b]} for a in changed}
    rows = []
    for lane in lanes:
        path = os.path.realpath(lane["path"])
        stale = path not in trees or not os.path.isdir(path)
        branch, ref = lane_head(lane, trees)
        # Detached mid-rebase, the PR is the rebased branch's; otherwise lane.json's best guess.
        guess = branch or rebasing_branch(repo, path) or lane["branch"]
        row = dict(lane, branch=branch_label(branch, ref), registered_branch=lane["branch"],
                   stale=stale, ahead=None, behind=None,
                   pr="?" if prs is None else prs.label.get(guess, "none"))
        counts = git(["rev-list", "--left-right", "--count", "--end-of-options",
                      f"{base}...{ref}"], repo.toplevel)
        if counts.returncode == 0:
            row["behind"], row["ahead"] = (int(x) for x in counts.stdout.split())
        # A stopped session (Ctrl+Z) still holds the lane but answers nothing until `fg`, so it
        # drives no column: only the `stopped` flag.
        here = sessions_in(live or [], path)
        stopped = [s for s in here if lanelib.session_stopped(s)]
        here = [s for s in here if s not in stopped]
        row["live_sessions"] = None if live is None else [s.get("sessionId") for s in here]
        row["stopped_sessions"] = None if live is None else [s.get("sessionId") for s in stopped]
        row["states"] = None if live is None else [status_of(s) for s in here]
        row["ctx"] = ctx_of(aps, here)
        # Derived from the live session, never stored: a stored window id drifts when the window
        # closes or tmux renumbers it (invariant 4).
        row["window"] = ",".join(sorted({window_of(s["tmux"]) for s in here
                                         if s.get("tmux")})) or None
        flags = []
        # Either still holds its port, claims and a cap slot; a closing one waits on `done`.
        if lane.get("state") in ("setup-failed", "closing"):
            flags.append(lane["state"])
        if stale:
            flags.append("stale")
        if row["behind"]:
            flags.append("rebase")
        if any(len(claimers.get(r, [])) > 1 for r in lane.get("claims", [])):
            flags.append("conflict")
        row["overlaps"] = overlaps.get(lane["id"], {})
        if row["overlaps"]:
            flags.append("overlap")
        if not stale and row["live_sessions"] == []:
            flags.append("orphan")
        if stopped:
            flags.append("stopped")
        if needs_handoff(repo, lane, ref, merges_of(prs, lane, guess)):
            flags.append("handoff?")
        row["flags"] = flags
        rows.append(row)
    return rows


def record_text(repo: Repo, lane: dict) -> tuple[str | None, float | None]:
    """The lane's STATUS.md text and mtime, from the worktree or, when it is gone, the mirror.
    No lock is held, so the mirror is read in place, and a hook's swap can move it between
    mirror_dir's answer and the open: one fresh answer and retry covers that. Read bounded and
    never waiting on a FIFO (lanelib.read_head): `ls` and `done` run sandbox-off, and any lane
    can write its own record."""
    def read(path):
        data = lanelib.read_head(path, RECORD_READ)
        if data is None:
            return None
        try:
            return data.decode(errors="replace"), os.path.getmtime(path)
        except OSError:
            return None

    if not lanelib.record_is_link(lane) and (found := read(lanelib.record_path(lane))):
        return found
    for _ in range(2):
        mirror = lanelib.mirror_dir(repo, lane["id"], restore=False)
        if mirror is None:
            break
        if found := read(os.path.join(mirror, "STATUS.md")):
            return found
    return None, None


def needs_handoff(repo: Repo, lane: dict, ref: str, merges: list[float | None] | None) -> bool:
    """Whether the lane's record may be behind its work: a PR from its branches merged and the
    record isn't newer than mergedAt + CLOCK_SLACK (the lane never did its after-merge handoff);
    the last commit at `ref` (lane_head's) is newer; or a session ended that started after the
    record's last write, so it never wrote it. A session's end alone proves nothing: every
    session ends after its own last write, a /pass's too. merges is merges_of's. Anything it
    can't read lights the flag: the hand-back gate fails closed."""
    _, mtime = record_text(repo, lane)
    if mtime is None or merges is None:
        return True
    if any(m is None or mtime <= m + CLOCK_SLACK for m in merges):
        return True
    p = git(["log", "-1", "--format=%ct", "--end-of-options", ref], repo.toplevel)
    try:
        last = float(p.stdout) if p.returncode == 0 else None
    except ValueError:
        last = None
    if last is None or last > mtime + 1:
        return True
    for s in lane.get("sessions", []):
        if not s.get("endedAt"):
            continue  # live, or ended unstamped
        start, end = lanelib.parse_iso(s.get("startedAt")), lanelib.parse_iso(s["endedAt"])
        # One local clock, but it steps by seconds: a start this close may follow the write.
        if start is None or end is None or start > mtime - CLOCK_SLACK:
            return True
    return False


def cmd_ls(args) -> None:
    repo = lanes_repo()
    if args.requests:
        reqs = {}
        for lane in filter(lanelib.is_live, repo.lanes(shared=True)):  # stale: claims void
            for r in lane.get("claims", []):
                reqs.setdefault(r, []).append(lane["id"])
        if args.json:
            say(json.dumps(reqs, indent=2))
            return
        if not reqs:
            say("no claims")
        for r in sorted(reqs, key=lambda x: (len(x), x)):
            mark = "  conflict" if len(reqs[r]) > 1 else ""
            say(f"{r:<10} {', '.join(reqs[r])}{mark}")
        return
    rows = board(repo)
    for lane_id, why in repo.rejected:
        warn(f"left out lanes/{lane_id}: {why}. Sandboxed Bash can write any lane.json, so a "
             "record the CLI didn't write is never acted on; look at it before removing it")
    if args.json:
        say(json.dumps(rows, indent=2))
        return
    if rows:
        print_board(rows)
    else:
        say("no lanes (`lane new <id>` makes one)")
    for name in parse_locks(repo.config().get("locks", "")):
        if (holder := lock_holder(repo, name)) is not None:
            say(f"locks: {name} held by {holder}")
    for line in overlap_lines(rows):
        say(line)
    if line := main_footer(repo):
        say(line)
    try:
        held = install_state().holders(repo.main)
    except Exception as e:  # the board still shows; only the hold line is lost
        warn(f"install hold unknown ({type(e).__name__}: {e})")
        held = []
    ids = {os.path.realpath(x["path"]): x["id"] for x in repo.lanes(shared=True)}
    for h in held:
        who = f"lane {ids[h['root']]}" if h["root"] in ids else h["root"]
        n = len(h["links"])
        say(f"install: held by {who} (branch {h['branch']}, {n} link{'' if n == 1 else 's'}): "
            f"the lead's ./setup.sh in {h['main']} releases it")


def main_footer(repo: Repo) -> str | None:
    """The board's line for a crowded main checkout or a stopped lead, None otherwise or
    sandboxed (none in sight): each live session's window, the lead marked first, then the rest
    by pid, `no tmux` outside tmux and `agent worktree` for one launched in .claude/worktrees;
    with two or more and no lead picked, the way to pick one (LEAD_HINT); with no lead picked
    and the recorded one stopped (Ctrl+Z), its window to `fg` it in. A picked continuation (a
    resume of the stopped lead's session) leaves nothing to fg, so it says nothing of the
    stopped one."""
    if not lanelib.pids_visible():
        return None
    sessions = lanelib.main_sessions(repo)
    lead = lanelib.lead_of(repo, sessions)
    stopped = None if lead else lanelib.stopped_lead(repo)
    if len(sessions) < 2 and not stopped:
        return None
    agents = os.path.join(repo.main, ".claude", "worktrees")
    cells = []
    for s in sorted(sessions, key=lambda x: x is not lead):  # stable: by pid after the lead
        notes = (["lead"] if s is lead else []) + [f"pid {s['pid']}", status_of(s)]
        if lanelib.cwd_inside(s.get("cwd"), agents):
            notes.append("agent worktree")
        cells.append(f"{window_label(s)} ({', '.join(notes)})")
    n = len(sessions)
    line = ("main checkout: no live session" if not n else
            f"main checkout: {n} live session{'' if n == 1 else 's'}: {', '.join(cells)}")
    tail = ([LEAD_HINT] if n > 1 and not lead else []) + (
        [stopped_note("The lead", stopped)] if stopped else [])
    return shown(". ".join([line, *tail]))


def print_board(rows: list[dict]) -> None:
    if any(r["pr"] == "?" for r in rows):
        warn("gh unavailable (no network or credential): PR state shows ?, so handoff? can't "
             "clear")
    if any(r["live_sessions"] is None for r in rows):
        warn("sandboxed: session liveness unknown; run `lane ls` bare")
    head = ("LANE", "BRANCH", "+/-", "PR", "PORT", "CLAIMS", "SESSIONS", "CTX", "STATE",
            "WINDOW", "FLAGS")
    table = [head]
    for r in rows:
        ab = "?" if r["ahead"] is None else f"+{r['ahead']}/-{r['behind']}"
        unknown = r["live_sessions"] is None  # sandboxed: liveness, so ctx and window, unknown
        sess = "?" if unknown else str(len(r["live_sessions"]))
        ctx = "?" if unknown else ctx_cell(r["ctx"])
        state = "?" if unknown else ",".join(r["states"]) or "-"
        window = "?" if unknown else r["window"] or "-"
        table.append((r["id"], r["branch"], ab, r["pr"], str(r["port"] or "-"),
                      ",".join(r.get("claims", [])) or "-", sess, ctx, state, window,
                      " ".join(r["flags"]) or "-"))
    widths = [max(len(row[i]) for row in table) for i in range(len(head))]
    for row in table:
        say("  ".join(c.ljust(w) for c, w in zip(row, widths)).rstrip())


def cmd_whoami(args) -> None:
    repo = repo_here()
    kind, lane = repo.identity()
    info = {"identity": lane["id"] if lane else kind, "kind": kind, "toplevel": repo.toplevel,
            "common_dir": repo.common_dir}
    if lane:
        try:
            branch, ref = lane_head(lane, worktree_heads(repo))
        except (OSError, subprocess.SubprocessError):  # git can't list them: the stored name
            branch, ref = lane["branch"], ""
        info.update(branch=branch_label(branch, ref), registered_branch=lane["branch"],
                    port=lane.get("port"), claims=lane.get("claims", []),
                    record=lanelib.record_path(lane))
    if args.json:
        say(json.dumps(info, indent=2))
        return
    if lane:
        say(f"{lane['id']}  (lane; branch {info['branch']}, port {lane.get('port') or 'none'}, "
            f"claims {', '.join(lane.get('claims', [])) or 'none'})")
        say(f"record {info['record']}")
    else:
        say({"main": "main  (the main checkout of a lanes repo)",
             "unregistered": "unregistered  (a worktree of a lanes repo that is no lane: "
                             "`lane adopt` it, or work from a lane)",
             "plain": "plain  (no lanes in this repo)"}[kind])


def cmd_claim(args) -> None:
    repo = lanes_repo()
    reqs = requests(args.req)
    with lock(repo):
        lane = own_lane(repo)
        if conflicts := claim_conflicts(repo, lane["id"], reqs):
            raise LaneError("already claimed: " + ", ".join(conflicts) + ". Ownership moves only "
                            "when that lane releases it (`lane release`)")
        lanelib.update_lane(repo, lane["id"], lambda x: x["claims"].extend(
            r for r in reqs if r not in x["claims"]))
    say(f"lane {lane['id']} claims {', '.join(reqs)}")


def cmd_release(args) -> None:
    repo = lanes_repo()
    reqs = requests(args.req)
    with lock(repo):
        lane = own_lane(repo)
        missing = [r for r in reqs if r not in lane.get("claims", [])]
        if missing:
            raise LaneError(f"lane {lane['id']} does not claim {', '.join(missing)}")
        lanelib.update_lane(repo, lane["id"], lambda x: x.update(
            claims=[r for r in x["claims"] if r not in reqs]))
    say(f"lane {lane['id']} released {', '.join(reqs)}")


def cmd_who(args) -> None:
    repo = lanes_repo()
    req = lanelib.norm_request(args.req)
    holders = [lane for lane in repo.lanes(shared=True) if req in lane.get("claims", [])]
    if not holders:
        say(f"{req}: unclaimed")
        return
    for lane in holders:
        live = lanelib.is_live(lane)
        say(f"{req}: lane {lane['id']}" + ("" if live else "  (stale: worktree gone, claim void)"))


def insert_in_section(text: str, heading: str, line: str) -> str:
    """Append line at the end of the `## heading` section, or of the file when there is none."""
    lines = text.splitlines()
    start = next((i for i, x in enumerate(lines) if x.strip().lower() == f"## {heading}".lower()),
                 None)
    if start is None:
        return text.rstrip("\n") + "\n" + line + "\n"
    end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("## ")), len(lines))
    while end > start + 1 and not lines[end - 1].strip():
        end -= 1
    lines.insert(end, line)
    return "\n".join(lines) + "\n"


def cmd_note(args) -> None:
    repo = lanes_repo()
    text = " ".join(args.text).strip()
    if not text:
        raise LaneError("empty note")
    if found := lanelib.relative_phrases(text):
        raise LaneError(f"relative identity ({', '.join(found)}). {lanelib.RELATIVE_HINT}")
    with lock(repo):
        lane = own_lane(repo)
        path = lanelib.record_path(lane)
        try:
            with open(path) as f:
                body = f.read()
        except FileNotFoundError:
            raise LaneError(f"no record at {path}")
        stamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
        lanelib.write_text(path, insert_in_section(body, "State", f"- {stamp} {text}"))
    say(f"noted in {path}")


def cmd_asks(args) -> None:
    repo = lanes_repo()
    found = False
    for lane in repo.lanes():
        text, _ = record_text(repo, lane)
        body = lanelib.section(text or "", "Asks for Hayden", "Asks")
        for line in (body or "").splitlines():
            found = True
            say(f"{lane['id']}: {line.strip()}")
    if not found:
        say("no open asks")


def holders(repo: Repo, path: str) -> list[dict]:
    """Every checked record whose path is path, twins included (Repo.lanes)."""
    real = os.path.realpath(path)
    return [lane for lane in repo.lanes(shared=True) if os.path.realpath(lane["path"]) == real]


def load_lane(repo: Repo, lane_id: str) -> dict:
    """The lane's checked record, refused while another record claims its path: one of the two
    was planted, and `open` or `done` on either would act in the other's worktree."""
    check_id(lane_id)
    try:
        lane = lanelib.read_record(repo, lane_id)
    except FileNotFoundError:
        raise LaneError(f"no lane {lane_id}")
    if twins := [x["id"] for x in holders(repo, lane["path"]) if x["id"] != lane_id]:
        raise LaneError(f"refusing lane {lane_id}: lane {', '.join(twins)} claims its path "
                        f"{lane['path']} too. Sandboxed Bash can write any lane.json: look at "
                        f"each under {repo.lanes_dir}/ and remove the one the CLI didn't write")
    return lane


def usable_path(repo: Repo, lane: dict) -> str:
    """The lane's path, once worktree_problem passes: every sandbox-off act in a lane (the cwd
    of `open` and the setup, the copy's destination, `done`) goes through this."""
    if why := lanelib.worktree_problem(repo, lane["path"], repo.lanes(shared=True)):
        raise LaneError(f"refusing lane {lane['id']}: {why}")
    return lane["path"]


def cmd_open(args) -> None:
    repo = lanes_repo()
    lane = load_lane(repo, args.id)
    path = lane["path"]
    if lane.get("state") == "closing":  # a `done` is ending it, or one refused partway
        raise LaneError(f"lane {args.id} is closing: rerun `lane done {args.id}`")
    if not lanelib.is_live(lane):
        raise LaneError(f"lane {args.id} is stale: its worktree {path} is gone (`lane done "
                        f"{args.id}` closes it)")
    usable_path(repo, lane)  # the window's cwd, where `claude` loads that dir's .claude/ config
    if lane.get("state") == "setup-failed":
        raise LaneError(f"lane {args.id} is setup-failed: finish it with `lane adopt {path}` first")
    live = lanelib.live_sessions()
    if live is None:
        unknown = (f"sandboxed: session liveness unknown, so this can't tell whether lane "
                   f"{args.id} already has a session")
        if not args.print:
            raise LaneError(f"{unknown}. Run it as a bare `lane open {args.id}` "
                            "(excludedCommands runs that outside the sandbox)")
        warn(f"{unknown}: the printed command may duplicate a live session")
    if here := sessions_in(live or [], path):
        if args.model is not None or args.effort is not None:
            raise LaneError(f"lane {args.id} already has a live session, and a pick applies only "
                            "at launch: /model or /effort in its window changes it")
        focus_session(args, here)
        return
    pick = open_pick(args, repo.config())
    claude = shutil.which("claude")
    if claude is None:
        raise LaneError("claude is not on PATH")
    prompt = args.prompt or (f"You are lane `{args.id}`. Read your lane record "
                             f"`{lanelib.record_path(lane)}`, then plan the brief it holds.")
    # The absolute claude path: tmux's PATH lacks ~/.local/bin.
    argv = ["tmux", "new-window", "-P", "-F", "#{session_name}:#{window_index} (#{window_name})",
            "-c", path, "-n", args.id, *([] if args.focus else ["-d"]), "--",
            os.path.abspath(claude), *pick, "--permission-mode", "plan", prompt]
    if args.print:
        say(shlex.join(argv))
        return
    if not os.environ.get("TMUX"):
        raise LaneError(f"not inside tmux; run this instead: cd {shlex.quote(path)} && claude")
    p = subprocess.run(argv, capture_output=True, text=True)
    if p.returncode != 0:
        raise LaneError(f"tmux new-window failed: {p.stderr.strip()}")
    # Only the time: the window is derived from the live session on each `ls` (invariant 4).
    with lock(repo):
        lanelib.update_lane(repo, args.id, lambda x: x.update(opened=now_iso()))
    say(f"opened {args.id} in tmux window {p.stdout.strip()}"
        + (f" with {shlex.join(pick)}" if pick else ""))


def open_pick(args, cfg: dict) -> list[str]:
    """claude's --model and --effort for `open`: each flag, else the lanes config's default, else
    none (the user's default; an empty flag skips the config's). A plain pass, a tab restore and
    the shelf's Open carry them (lanelib.carried_pick), so they are checked here, where Hayden
    sees the refusal: a bad model would only show as an API error in a detached window
    (docs/lanes.md, "Model and effort")."""
    pick = []
    for key, problem in PICKS.items():
        value, flag = getattr(args, key), getattr(args, key) is not None
        if not flag:
            value = cfg.get(key)
        if not value:
            continue
        if why := problem(value):
            raise LaneError(why if flag else f"the lanes config's {key}: {why}. Fix it with "
                            f"`lane init --{key} <{key}>`, or `lane init --{key} ''` for none")
        pick += [f"--{key}", value]
    return pick


def focus_session(args, here: list[dict]) -> None:
    """`open` on a lane that has a live session, a stopped one (Ctrl+Z) among them: refuse, or
    with --focus select its window, where `fg` brings a stopped one back."""
    def label(s: dict) -> str:
        name = s["tmux"] if s.get("tmux") else f"session {s.get('sessionId')} (not in tmux)"
        return f"{name} (stopped: fg it there)" if lanelib.session_stopped(s) else name

    tmuxed = [s for s in here if s.get("tmux")]
    targets = [s["tmux"] for s in tmuxed]
    named = ", ".join(label(s) for s in tmuxed or here)
    if not args.focus:
        raise LaneError(f"lane {args.id} already has a live session: {named}. "
                        f"`lane open {args.id} --focus` switches to its window")
    if not targets:
        raise LaneError(f"lane {args.id}'s live session has no tmux window to focus: {named}")
    window = window_of(targets[0])
    argv = ["tmux", "select-window", "-t", window]
    if args.print:
        say(shlex.join(argv))
        return
    p = subprocess.run(argv, capture_output=True, text=True)
    if p.returncode != 0:
        raise LaneError(f"tmux select-window failed: {p.stderr.strip()}")
    say(f"lane {args.id} already has a live session: focused tmux window {window}")


def cmd_addr(args) -> None:
    """`uds:<socket>` of the one live session in a lane, or in the main checkout for `lead`: a
    SendMessage address that holds while the session's title (its ListAgents name) changes. A
    pass or restart gives the session a new pid and socket, so resolve it before each send.
    A session is where its file's cwd says, the dir it launched in (as `ls` and `open` read it;
    a Bash cd doesn't move it, probed on 2.1.296), and live when /proc agrees it runs
    (lanelib.session_running): sandboxed Bash can write neither. A stopped session (Ctrl+Z) is
    never an address, since nothing reads its socket until `fg`; a refusal names its window
    instead. A lane's path comes from its lane.json, which it can, so load_lane and usable_path
    check it first. `lead` names the lead lanelib.lead_of picks among the main checkout's live
    sessions, or refuses with the way to pick one (LEAD_HINT) and any stopped lead's window."""
    if not lanelib.pids_visible():
        raise LaneError(f"sandboxed: other sessions' processes are out of sight, so a live "
                        f"session can't be told from a stale file. Run it as a bare `lane addr "
                        f"{args.id}` (excludedCommands runs that outside the sandbox)")
    repo = lanes_repo()
    if args.id == "lead":
        # Agent worktrees sit under main, so they count as the lead's; a lane never does
        # (lanelib.worktree_problem refuses a lane path inside the main checkout).
        where, hint, path = "the main checkout (the lead)", "", repo.main
        if os.path.lexists(repo.lane_dir("lead")):  # a lane from before `lead` was reserved
            raise LaneError("ambiguous: a lane is named lead too. `lane addr lead` means the main "
                            "checkout; rename that lane (`lane done lead`, then a new id)")
    else:
        lane = load_lane(repo, args.id)
        if not lanelib.is_live(lane):
            raise LaneError(f"lane {args.id} is stale: its worktree {lane['path']} is gone")
        path = usable_path(repo, lane)
        where, hint = f"lane {args.id}", f": `lane open {args.id}` starts one"
    pick, note, stopped = None, None, []
    if args.id == "lead":
        found = lanelib.main_sessions(repo)
        pick = lanelib.lead_of(repo, found)  # the recorded lead, its continuation, or the one
        if pick:
            found = [pick]
        elif lead := lanelib.stopped_lead(repo):
            note = shown(stopped_note("The lead", lead))
    else:
        here = [s for s in lanelib.session_files() if lanelib.cwd_inside(s.get("cwd"), path)]
        found = [s for s in here if lanelib.session_running(s)]
        stopped = [s for s in here if lanelib.session_stopped(s)]
    found = [(s, sock) for s in found if (sock := lanelib.socket_of(s))]
    if not found:
        if stopped:  # instead of `lane open`, which refuses beside a stopped session
            hint = ": " + "; ".join(shown(stopped_note("a session", s)) for s in stopped)
        raise LaneError(f"no live session in {where}{hint}" + (f". {note}" if note else ""))
    if len(found) > 1 or (args.id == "lead" and not pick):
        rows = "; ".join(shown(" ".join([f"pid {s['pid']}", str(s.get("kind") or "?"),
                                         window_label(s), str(s.get("status") or "?"),
                                         "uds:" + sock]))
                         for s, sock in found)
        tail = []
        if args.id == "lead":  # one running beside a stopped lead isn't it (lanelib.lead_of)
            tail = ([LEAD_HINT] if len(found) > 1 or not note else []) + ([note] if note else [])
        head = (f"{len(found)} live sessions in {where}, so no one address" if len(found) > 1
                else f"1 live session in {where}, and it is not the lead")
        raise LaneError(". ".join([f"{head}: {rows}", *tail]))
    say("uds:" + found[0][1])


def holder_line(repo: Repo, command: list[str]) -> str:
    """Who runs what since when; no pid, since each sandboxed command has its own pid namespace."""
    kind, lane = repo.identity()
    who = lane["id"] if lane else (kind if kind == "main" else f"{kind} {repo.toplevel}")
    cmd = shlex.join(command)
    if len(cmd) > HOLDER_CMD_MAX:
        cmd = cmd[:HOLDER_CMD_MAX - 3] + "..."
    return f"{who} since {now_iso()}: {cmd}"


def try_lock(fd: int) -> bool:
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return True
    except BlockingIOError:
        return False


def take_lock(fd: int, name: str, wait: float | None) -> bool:
    """flock fd, saying who holds it while it waits; False when --wait ran out."""
    deadline = None if wait is None else time.monotonic() + wait
    # `lane ls` probes a lock by taking LOCK_SH for an instant (lock_holder). One retry after a
    # short pause keeps a single probe from reading as a holder (a false "waiting", or a
    # `--wait 0` that gives up on a free lock); two probes PROBE_GRACE apart still can.
    if try_lock(fd):
        return True
    time.sleep(PROBE_GRACE)
    if try_lock(fd):
        return True
    if wait != 0:
        warn(f"waiting for lock {name}: held by {holder_of(fd)}")
    if deadline is None:
        fcntl.flock(fd, fcntl.LOCK_EX)
        return True
    while time.monotonic() < deadline:
        time.sleep(0.05)
        if try_lock(fd):
            return True
    warn(f"gave up on lock {name} after {wait:g}s: held by {holder_of(fd)}")
    return False


def tee(stream, on_line) -> None:
    """Copy stream (a child's merged stdout and stderr) to stdout line by line as it comes, and
    hand each line, newline cut, to on_line."""
    for raw in stream:
        line = raw.decode(errors="replace")
        sys.stdout.write(line)
        sys.stdout.flush()
        on_line(line.rstrip("\r\n"))


def run_child(command: list[str], cwd: str | None = None, on_line=None) -> int:
    """Run command and wait for it; its exit code, or -n (as Popen has it) if signal n killed it.

    With on_line, its stdout and stderr go through one pipe that tee streams to stdout and hands
    on line by line (`trial` parses failing test ids from them). A reader thread drains it while
    this thread waits, so signals land here as they do without it; a grandchild left holding the
    pipe once the command exits gets TEE_GRACE before the rest of its output is dropped.

    The command shares this process group, so a Ctrl-C from the tty or a kill of the whole tree
    (Claude Code's Bash tool stops a command that way) already reaches it. SIGINT and SIGTERM are
    therefore only recorded here, never forwarded: a second copy reads as "force quit" to Go and
    Node tools. One that arrives before the command starts is replayed to it once. A Python
    handler, not SIG_IGN, so the command doesn't inherit an ignored signal. The costs:
    - A signal sent to `lane` alone no longer stops the command, and the lock stays held while it
      runs. A supervisor that signals `lane` alone and then SIGKILLs it (`timeout -k`,
      `terminate()` then `kill()`, systemd `KillMode=process`) frees the lock while the orphaned
      command still runs: signal the process group instead.
    - A group signal that lands after the command has exec'd but before Popen returns (while it
      reads the exec status pipe) is taken as pending and replayed, so the command gets it twice.
      Blocking the signals around Popen can't tell a pre-fork arrival from a post-fork one."""
    child, pending = None, []

    def record(sig, _frame):
        if child is None:
            pending.append(sig)

    old = {sig: signal.signal(sig, record) for sig in (signal.SIGINT, signal.SIGTERM)}
    piped = {"stdout": subprocess.PIPE, "stderr": subprocess.STDOUT} if on_line else {}
    try:
        try:
            child = subprocess.Popen(command, cwd=cwd, **piped)
        except OSError as e:
            warn(f"can't run {command[0]}: {e.strerror}")
            return 127
        for sig in pending:
            child.send_signal(sig)
        reader = None
        if on_line:
            reader = threading.Thread(target=tee, args=(child.stdout, on_line), daemon=True)
            reader.start()
        rc = child.wait()
        if reader:
            reader.join(TEE_GRACE)
    finally:
        for sig, handler in old.items():
            signal.signal(sig, handler)
    return rc


def die_of(sig: int) -> int:
    """Die of signal sig, as the locked command did; 128+sig if this process survives it.

    bash quits a script on Ctrl-C only when its child died of SIGINT, so an exit of 130 would run
    the script's next gate. coreutils `timeout` re-raises the same way, with core dumps off."""
    resource.setrlimit(resource.RLIMIT_CORE, (0, resource.getrlimit(resource.RLIMIT_CORE)[1]))
    with contextlib.suppress(OSError):  # SIGKILL takes no handler: it is always the default
        signal.signal(sig, signal.SIG_DFL)
    os.kill(os.getpid(), sig)
    return 128 + sig


@contextlib.contextmanager
def held_lock(repo: Repo, name: str, wait: float | None, command: list[str]):
    """Hold lock name, one of the config's locks, with its holder line naming command, for the
    body of a `with`: yields True once held, False when wait ran out (nothing held). The holder
    line is cleared and the lock let go however the body ends. `lock` and `trial` both run under
    it; a Ctrl-C while waiting comes out as KeyboardInterrupt."""
    names = parse_locks(repo.config().get("locks", ""))
    if name not in names:
        raise LaneError(f"no lock {name!r} in the lanes config (locks:"
                        f"{', '.join(names) or 'none'}): add it with `lane init --locks "
                        "<full,list>` (it replaces the list); an unlisted name would split the "
                        "mutual exclusion")
    path = lock_path(repo, name)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    # O_CLOEXEC, and Popen's close_fds: the command and anything it backgrounds never inherit the
    # lock, so it ends with this process.
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o644)
    try:
        if not take_lock(fd, name, wait):
            yield False
            return
        try:
            os.ftruncate(fd, 0)
            os.pwrite(fd, (holder_line(repo, command) + "\n").encode(), 0)
            yield True
        finally:
            # Cleared while still held: a waiter that reads between the next holder's acquire and
            # its write sees "an unknown holder", never this run.
            os.ftruncate(fd, 0)
    finally:
        os.close(fd)


def cmd_lock(args) -> int:
    repo = lanes_repo()
    try:
        with held_lock(repo, args.name, args.wait, args.command) as held:
            return run_child(args.command) if held else LOCK_BUSY
    except KeyboardInterrupt:  # a Ctrl-C while waiting, or before or after the command runs
        return -signal.SIGINT


# ---- trial: the suites on a merge with every other live lane ---------------------------------
UNITTEST_FAIL = re.compile(r"(?:FAIL|ERROR): \S")
# An id never starts with '(': unittest's own summary, `FAILED (failures=12, skipped=4)`, isn't
# one, and its counts change whenever a lane adds a test.
PYTEST_FAIL = re.compile(r"(?:FAILED|ERROR) ([^\s(].*?)(?: - .*)?")


class TrialStopped(Exception):
    """A suite died of SIGINT or SIGTERM: the whole trial stops, as `lock` would."""

    def __init__(self, sig: int):
        super().__init__(sig)
        self.sig = sig


def failing_ids(lines: list[str]) -> list[str]:
    """The failing test ids a run printed, in order, each once: a unittest `FAIL: ...` or
    `ERROR: ...` line whole (a subtest's parameters, which can embed the tree's path, with it),
    a pytest `FAILED x` or `ERROR x` summary line's x, its ` - message` tail cut."""
    found = []
    for line in lines:
        line = line.rstrip()
        if UNITTEST_FAIL.match(line):
            found.append(line)
        elif m := PYTEST_FAIL.fullmatch(line):
            found.append(m.group(1))
    return list(dict.fromkeys(found))


def trial_git(repo: Repo, args: list[str],
              ok: tuple[int, ...] = (0,)) -> subprocess.CompletedProcess:
    """git in the lane (`trial` runs sandboxed), bounded by TRIAL_GIT_WAIT. Running out, or an
    exit outside ok, aborts the trial with git's message."""
    sub = next((a for a in args if a[:1] != "-" and "=" not in a), "git")
    try:
        p = git(args, repo.toplevel, timeout=TRIAL_GIT_WAIT)
    except subprocess.TimeoutExpired:
        raise LaneError(f"git {sub} took over {TRIAL_GIT_WAIT} s, so the trial stopped")
    if p.returncode not in ok:
        line = (p.stderr.strip().splitlines() or [f"exit {p.returncode}"])[-1]
        raise LaneError(f"git {sub} failed ({shown(line)}), so the trial stopped")
    return p


def merged_in(repo: Repo, sha: str, cur: str) -> bool:
    """Whether commit sha is already in cur's history."""
    return trial_git(repo, ["merge-base", "--is-ancestor", "--end-of-options", sha, cur],
                     ok=(0, 1)).returncode == 0


def merge_tree(repo: Repo, ours: str, theirs: str, label: str) -> tuple[str | None, list[str]]:
    """(the merged tree, []) when commit theirs merges cleanly into ours, else (None, the paths
    git names as conflicted, which may be none). Writes objects only. Any other git outcome
    (unrelated histories, a bad commit) aborts."""
    p = trial_git(repo, ["merge-tree", "--write-tree", "-z", "--name-only", "--no-messages",
                         "--end-of-options", ours, theirs], ok=(0, 1))
    tree, *paths = p.stdout.split("\0")
    if p.returncode == 1:
        return None, [x for x in paths if x]
    if not lanelib.SHA_RE.fullmatch(tree):
        raise LaneError(f"git merge-tree gave no tree for {label}, so the trial stopped")
    return tree, []


def merge_onto(repo: Repo, cur: str, sha: str, label: str) -> tuple[str, list[str] | None]:
    """(the merge commit of sha onto cur, None) when it merges cleanly, else (cur, the paths git
    names as conflicted, which may be none). The commit is dangling (no ref moves) and carries
    a fixed identity, so no user config is needed and none signs it."""
    tree, paths = merge_tree(repo, cur, sha, label)
    if tree is None:
        return cur, paths
    p = trial_git(repo, ["-c", f"user.name={TRIAL_IDENTITY[0]}", "-c",
                         f"user.email={TRIAL_IDENTITY[1]}", "commit-tree", "--no-gpg-sign",
                         "-p", cur, "-p", sha, "-m", f"lane trial: merge {label}", tree])
    return p.stdout.strip(), None


def trial_prefix(repo: Repo, lane_id: str) -> str:
    """The name of a trial's scratch dir in the temp dir, before mkdtemp's 8 characters. Keyed by
    repo: another repo's lane of the same id shares the temp dir but not this repo's suite
    lock, so its live tree must never look like this lane's leftover."""
    return f"lane-trial-{repo.key}-{lane_id}-"


def trial_leftovers(repo: Repo, lane_id: str, tmp: str) -> None:
    """Clear what earlier trials of this lane left in tmp: one killed by the Bash cap or a
    respawn never reaches its `finally`. Only this repo's lane's names (trial_prefix and
    mkdtemp's 8 characters, so lane a never takes lane a-b's), and only registrations of a
    `tree` there: never a blanket `git worktree prune`, since the common dir holds other
    prunable entries that aren't this lane's. A sandboxed command can't remove an admin dir the
    sandbox mounted when it started, so a registration it can't remove is named, once, with the
    command to run sandbox-off."""
    mine = re.compile(re.escape(trial_prefix(repo, lane_id)) + "[a-z0-9_]{8}")
    cleared, stuck = [], []
    for path in worktree_heads(repo):
        parent = os.path.dirname(path)
        if (os.path.basename(path) == "tree" and os.path.dirname(parent) == tmp
                and mine.fullmatch(os.path.basename(parent))):
            p = trial_git(repo, ["worktree", "remove", "--force", "--end-of-options", path],
                          ok=tuple(range(256)))
            (cleared if p.returncode == 0 else stuck).append(path)
    for d in glob.glob(os.path.join(tmp, "lane-trial-*")):
        if mine.fullmatch(os.path.basename(d)) and not os.path.islink(d):
            shutil.rmtree(d, ignore_errors=True)
    if cleared:
        warn(shown(f"cleared the tree an earlier trial left registered (it never reached its "
                   f"cleanup): {', '.join(cleared)}"))
    if stuck:
        warn(shown("an earlier trial's tree is still registered and the sandbox can't remove "
                   "it; run sandbox-off: " + "; ".join(
                       f"git worktree remove --force {shlex.quote(p)}" for p in stuck)))


def run_suites(tree: str, commands: list[str], label: str,
               picked) -> list[tuple[int, list[str]]]:
    """Run each picked command (by index) as `sh -c` in tree, its output streamed: (exit code,
    failing_ids) each. A suite that dies of SIGINT or SIGTERM (a Ctrl-C, a stop of the whole
    tree) stops the trial."""
    out = []
    for i in picked:
        say(shown(f"lane trial: {label} run of suite {i + 1}/{len(commands)}: {commands[i]}"))
        lines = []
        rc = run_child(["sh", "-c", commands[i]], cwd=tree, on_line=lines.append)
        if rc in (-signal.SIGINT, -signal.SIGTERM):
            raise TrialStopped(-rc)
        out.append((rc, failing_ids(list(lines))))
    return out


def trial_lanes(repo: Repo, me: dict, ids: list[str],
                trees: dict[str, tuple[str, str]]) -> list[dict]:
    """The live lanes to merge, sorted by id: every other one, or only those ids."""
    live = [x for x in repo.lanes() if x["id"] != me["id"]
            and os.path.realpath(x["path"]) in trees and os.path.isdir(x["path"])]
    for lane_id in ids:
        check_id(lane_id)
        if lane_id == me["id"]:
            raise LaneError(f"lane {lane_id} is this lane: name the lanes to merge into it")
        if lane_id not in {x["id"] for x in live}:
            raise LaneError(f"no live lane {lane_id} to merge (`lane ls` lists them)")
    return [x for x in live if not ids or x["id"] in ids]


def cmd_trial(args) -> int:
    """Merge the base and every other live lane's commits onto this lane's HEAD in dangling
    commits, check the merge out in a fresh scratch tree, and run each suite there under a
    lock; a failed suite reruns on the baseline (HEAD plus the base) at the same path, so a
    failure the location alone causes, or one already on the base, isn't the merge's.
    PLAN.md of lane cross-lane, section B, and docs/lanes.md have the design."""
    repo = lanes_repo()
    me = own_lane(repo)
    command = ["lane", "trial", *args.ids, *[x for c in args.run for x in ("--run", c)]]
    try:
        with held_lock(repo, TRIAL_LOCK, args.wait, command) as held:
            return trial(repo, me, args) if held else LOCK_BUSY
    except KeyboardInterrupt:  # a Ctrl-C while waiting, merging or cleaning up
        return -signal.SIGINT
    except TrialStopped as e:
        return -e.sig


def trial(repo: Repo, me: dict, args) -> int:
    """cmd_trial's work, under its lock."""
    cfg = repo.config()
    base_name = cfg.get("base", "origin/main")
    trees = worktree_heads(repo)
    others = trial_lanes(repo, me, args.ids, trees)
    tmp = os.path.realpath(tempfile.gettempdir())
    trial_leftovers(repo, me["id"], tmp)
    head = rev(repo, "HEAD")
    base = rev(repo, base_ref(cfg))
    if head is None or base is None:
        raise LaneError(f"{'HEAD' if head is None else base_name} doesn't name a commit here")
    if trial_git(repo, ["status", "--porcelain"]).stdout.strip():
        warn(f"lane {me['id']} has uncommitted changes: only its HEAD is tried")
    cur = head
    if not merged_in(repo, base, cur):
        cur, conflicted = merge_onto(repo, cur, base, base_name)
        if conflicted is not None:
            raise LaneError(shown(f"{base_name} doesn't merge cleanly into lane {me['id']} ("
                                  f"{', '.join(conflicted) or 'git named no path'}): merge "
                                  f"{base_name} into the lane first"))
    baseline = cur
    merged, already, conflicts = [], [], {}
    for lane in others:
        sha = rev(repo, lane_head(lane, trees)[1])
        if sha is None:
            raise LaneError(f"lane {lane['id']}'s head doesn't name a commit, so the trial "
                            "stopped")
        if merged_in(repo, sha, cur):
            already.append(lane["id"])
            continue
        cur, conflicted = merge_onto(repo, cur, sha, lane["id"])
        if conflicted is None:
            merged.append((lane["id"], sha))
        else:
            conflicts[lane["id"]] = conflict_line(repo, lane["id"], sha, conflicted, baseline,
                                                  merged, args.run)
    if already:
        say(f"lane trial: nothing to merge from {', '.join(already)} (already in)")
    for line in conflicts.values():
        say(shown(line))
    if not merged:
        say("lane trial: no other lane's work merged, so no suite ran")
        return 1 if conflicts else 0
    say("lane trial: merged " + ", ".join(f"{i} ({s[:12]})" for i, s in merged)
        + f" onto lane {me['id']}'s HEAD and {base_name}")
    warn("other lanes' uncommitted work isn't in the merge, only their commits")
    tmpdir = tempfile.mkdtemp(prefix=trial_prefix(repo, me["id"]), dir=tmp)
    tree, holds = os.path.join(tmpdir, "tree"), None
    try:
        trial_git(repo, ["worktree", "add", "--detach", "--quiet", "--end-of-options", tree, cur])
        holds = "merge"
        runs = run_suites(tree, args.run, "merge", range(len(args.run)))
        failed = [i for i, (rc, ids) in enumerate(runs) if rc or ids]
        again = {}
        if failed:
            # At the same path: subtest ids that embed it, and the admin dir's name, then match.
            holds = None
            trial_git(repo, ["worktree", "remove", "--force", "--end-of-options", tree])
            trial_git(repo, ["worktree", "add", "--detach", "--quiet", "--end-of-options", tree,
                             baseline])
            holds = "baseline"
            again = dict(zip(failed, run_suites(tree, args.run, "baseline", failed)))
        rc = trial_report(args.run, runs, again)
    finally:
        if args.keep and holds:
            say(shown(f"lane trial: kept the tree (the {holds}) at {tree}; remove it with `git "
                      f"worktree remove --force {shlex.quote(tree)}`"))
        else:
            drop_tree(repo, tree, tmpdir)
    if conflicts:
        many = len(conflicts) > 1
        say(f"lane trial: FAILED: lane{'s' * many} {', '.join(conflicts)} didn't merge, so "
            f"{'their' if many else 'its'} work went untried")
        return 1
    return rc


def conflict_line(repo: Repo, lane_id: str, sha: str, conflicted: list[str], baseline: str,
                  merged: list[tuple[str, str]], commands: list[str]) -> str:
    """The report's line for lane lane_id, whose head sha conflicted with the merge so far. When
    it merges cleanly into the baseline alone, the conflict is with lanes merged before it, not
    with this one: it names each of them it conflicts with by itself (or, when none does, the
    merge of them all) and how to try the lane with this one alone. Otherwise the conflict is
    this lane's, with the paths git named."""
    paths = ", ".join(conflicted) or "git named no path"
    if not merged or merge_tree(repo, baseline, sha, lane_id)[0] is None:
        return f"lane trial: conflict with lane {lane_id}: {paths}"
    pairs = []
    for other, other_sha in merged:
        tree, both = merge_tree(repo, other_sha, sha, f"{lane_id} and {other}")
        if tree is None:
            pairs.append(f"lane {other} ({', '.join(both) or 'git named no path'})")
    whom = (" and ".join(pairs) if pairs else
            "the merge of lane " + ", ".join(other for other, _ in merged) + f" ({paths})")
    alone = shlex.join(["lane", "trial", lane_id, *[x for c in commands for x in ("--run", c)]])
    return (f"lane trial: lane {lane_id} conflicts with {whom}, not with this lane: {lane_id} "
            f"was left out; try it with this lane alone: {alone}")


def drop_tree(repo: Repo, tree: str, tmpdir: str) -> None:
    """Unregister and remove the trial's tree, then its dir; a failure only warns, so it never
    hides how the trial ended."""
    if os.path.lexists(os.path.join(tree, ".git")):
        try:
            p = git(["worktree", "remove", "--force", "--end-of-options", tree], repo.toplevel,
                    timeout=TRIAL_GIT_WAIT)
            if p.returncode != 0:
                warn(shown(f"couldn't remove the trial's tree at {tree}: {p.stderr.strip()}"))
        except subprocess.TimeoutExpired:
            warn(f"git worktree remove took over {TRIAL_GIT_WAIT} s: the tree at {tree} is left")
    shutil.rmtree(tmpdir, ignore_errors=True)


def trial_report(commands: list[str], runs: list[tuple[int, list[str]]],
                 again: dict[int, tuple[int, list[str]]]) -> int:
    """Say how each suite did on the merge, judged against its baseline rerun (again, by suite
    index) when it failed: 0 when no failure is the merge's, else 1. A failed suite passes only
    when every id it failed on the merge also fails on the baseline, and its exit doesn't get
    worse there: non-zero on the merge but zero on the baseline, or a death by signal on the
    merge only, is the merge's (a `--run` can chain a runner whose ids it parses with a check
    that prints none). One with no ids to compare fails, to be compared by hand. Ids come from
    the suites' output, so they are masked."""
    new = 0
    for i, (cmd, (rc, ids)) in enumerate(zip(commands, runs)):
        head = f"lane trial: suite {i + 1} ({cmd}):"
        if i not in again:
            say(shown(f"{head} ok"))
            continue
        base_rc, base_ids = again[i]
        if not ids:
            new += 1
            say(shown(f"{head} failed (exit {rc}) with no test id to compare against the "
                      "baseline: compare the two runs above by hand"))
            continue
        only = [x for x in ids if x not in base_ids]
        worse = (rc != 0 and base_rc == 0) or (rc < 0 <= base_rc)
        if only or worse:
            new += 1
        if only:
            say(shown(f"{head} {len(only)} failure(s) only on the merge:"))
        elif worse:
            say(shown(f"{head} its ids fail on the baseline too, but it exits {rc} on the merge "
                      f"and {base_rc} on the baseline, so a failure is the merge's: compare "
                      "the two runs above"))
        else:
            say(shown(f"{head} every failure also fails on the baseline (exit {rc} on the merge, "
                      f"{base_rc} on the baseline), so none is the merge's:"))
        for x in only or ([] if worse else ids):
            say(shown(f"  {x}"))
    if new:
        say(f"lane trial: FAILED: {new} suite(s) fail on the merge")
    return 1 if new else 0


# ---- done: what runs in a lane, and ending it ------------------------------------------------
# `done` sorts every process whose real cwd is in the lane into these classes, and ends only
# those; anything else refuses the close before any signal. The proof is kernel facts (/proc)
# and Claude Code's own files, never lane.json (lanelib's processes section).
SESSION = "session"    # a session file's own process (pid and procStart), both cwds in the lane
OWNED = "owned"        # its parent chain reaches a SESSION: its Bash commands, hooks, MCP servers
PANE = "pane shell"    # a tmux pane's shell whose children are all SESSIONs (claude-restore's zsh)
LEFTOVER = "leftover"  # none of those, started with a lane session's CLAUDE_CODE_SESSION_ID
PROOF_MAX = 1 << 20  # bytes of a recorded proof (save_proof) load_proof reads
# secs a round waits for what it signalled to exit: twice settings.json's SessionEnd hook
# timeout (5 s), so round 2 never cuts off a hook Claude Code itself would still let run
GRACE = 10.0
OPEN_SESSIONS_WAIT = 2.0  # secs `done` waits for open-sessions/.lock (claude-restore's flock)
INSTALL_LOCK_WAIT = 30.0  # secs `done` waits for install.lock (setup.sh's flock) before the remove
LANES_LOCK_WAIT = 30.0  # secs `done` waits for the lanes lock while it holds install.lock
LEFT = ", so it was left running"  # the end of each reason `guarded` holds a signal for
SHOWN = re.compile(r"[\x00-\x1f\x7f-\x9f]")  # C0, DEL and C1: masked in what `done` prints
HANDOFF_CHECK = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "handoff",
                             "scripts", "handoff-check")


class Hit(NamedTuple):
    """A process `done` may end: its class, why it is the lane's, and a SESSION's id."""
    proc: lanelib.Proc
    kind: str
    why: str
    sid: str | None = None


def grace() -> float:
    """GRACE, or _LANE_TEST_GRACE's seconds (tests/lanes only, like _LANE_TEST_SANDBOXED)."""
    try:
        secs = float(os.environ.get("_LANE_TEST_GRACE", ""))
    except ValueError:
        return GRACE
    return secs if 0 <= secs <= GRACE else GRACE


def shown(text: str) -> str:
    """text with its control characters (SHOWN) masked, fit for a terminal."""
    return SHOWN.sub("?", text)


def described(p: lanelib.Proc, why: str) -> str:
    """`pid comm (why): program`, control chars masked. Only argv[0], cut at its first whitespace,
    then its basename: never an argument, since any can hold a secret (`curl -u user:pass`), and
    a title set with setproctitle carries them in argv[0] itself (cut first, since an argument
    can hold a '/')."""
    prog = os.path.basename((p.argv[0].split(None, 1) or [""])[0]) if p.argv else ""
    return shown(f"{p.pid} {p.comm} ({why})" + (f": {prog}" if prog else ""))


def in_lane(procs: dict[int, lanelib.Proc], path: str) -> dict[int, lanelib.Proc]:
    """The running processes whose real cwd is the lane at path or under it, this one aside."""
    me = os.getpid()
    return {pid: p for pid, p in procs.items() if pid != me and p.state not in lanelib.EXITED
            and p.cwd is not None and lanelib.inside(p.cwd, path)}


def other_jobs(pid: int, kids: dict[int, list[int]], targets) -> list[int]:
    """pid's running children that aren't in targets (pids from the same scan)."""
    return [c for c in kids.get(pid, []) if c not in targets]


def jobs_named(pids: list[int], procs: dict[int, lanelib.Proc]) -> str:
    return ", ".join(f"{c} {procs[c].comm}" if c in procs else str(c) for c in pids)


def survey(lane_id: str,
    path: str,
    procs: dict[int, lanelib.Proc],
    known: dict[tuple[int, int], Hit] | None = None,
) -> tuple[dict[int, Hit], dict[int, str]]:
    """Sort what runs in the lane (in_lane), from one scan: (hits, refused). hits {pid: Hit} is
    what `done` may end; refused {pid: line} what nothing proves the lane's, each of which
    refuses the close. A process in known {(pid, start): Hit} (an earlier round's hits) keeps its
    class: a session mid-exit may have dropped its session file, and its SessionEnd hooks are
    still its OWNED children. The rest in order: SESSION, OWNED, PANE, LEFTOVER. A PANE is a
    tmux pane's shell (its parent a tmux server) with no foreign session id. A LEFTOVER's every
    descendant, anywhere, must be a hit too: a tmux server or a `--bg` daemon started from a
    lane Bash carries the lane's session id, and its panes or sessions run elsewhere."""
    files = lanelib.session_files()
    here = in_lane(procs, path)
    kids = lanelib.children(procs)
    by_pid = {}
    for s in files:
        if type(s.get("pid")) is int:
            by_pid.setdefault(s["pid"], []).append(s)
    hits, refused, notes = {}, {}, {}
    for pid, p in here.items():
        if h := (known or {}).get((pid, p.start)):
            hits[pid] = h._replace(proc=p)
    for pid, p in here.items():
        if pid in hits:
            continue
        named = by_pid.get(pid, [])
        match = [s for s in named if lanelib.proc_start_of(s) == p.start]
        if not match:
            if named:  # a stale file: that pid ran another process when it was written
                notes[pid] = "a stale session file names its pid"
            continue
        sid = match[0].get("sessionId")
        if not (isinstance(sid, str) and lanelib.SID.fullmatch(sid)):
            refused[pid] = described(p, "its session file has no valid session id")
        elif not lanelib.cwd_inside(match[0].get("cwd"), path):
            refused[pid] = described(p, f"session {sid} is not lane {lane_id}'s")
        elif match[0].get("kind") == "bg" or "jobId" in match[0]:
            job = match[0].get("jobId")
            stop = (f"`claude stop {job}`" if isinstance(job, str) and lanelib.SID.fullmatch(job)
                    else "`claude stop` with its job id")
            refused[pid] = described(p, f"background session {sid}, which the daemon owns: "
                                        f"run {stop}")
        else:
            hits[pid] = Hit(p, SESSION, f"lane session {sid}", sid)
    # A known session still running counts, whether or not its session file is left.
    sessions = {pid for pid, h in hits.items() if h.kind == SESSION}
    for pid, p in here.items():
        if pid not in hits and pid not in refused:
            up = next((a for a in lanelib.ancestors(pid, procs) if a in sessions), None)
            if up is not None:
                hits[pid] = Hit(p, OWNED, f"under lane session {hits[up].sid}")
    proven = {}
    for pid, p in here.items():
        if pid in hits or pid in refused:
            continue
        try:
            sid = lanelib.proc_env_sid(pid)
        except OSError:
            if lanelib.proc_alive(p):
                refused[pid] = described(p, "its environment can't be read")
            continue  # else it exited since the scan
        if sid is not None and sid not in proven:
            proven[sid] = lanelib.lane_sid(sid, path, files)
        foreign = (f"session {sid} is not lane {lane_id}'s" if sid and not proven[sid]
                   else None)
        if shell_of := [c for c in kids.get(pid, []) if c in sessions]:
            # claude-restore's shape: a tmux pane's shell that ran claude. A session's parent
            # that isn't one (a foreign session's Bash `cd <lane> && claude`, a tmux server
            # whose pane command is claude) is no lane's to end.
            parent = procs.get(p.ppid)
            if len(shell_of) != len(kids[pid]):
                why = "a shell with other jobs"
            elif not (parent and parent.comm.startswith("tmux")):
                why = (f"the parent of lane session {hits[shell_of[0]].sid}, but not a tmux "
                       "pane's shell")
            elif foreign:
                why = f"the parent of lane session {hits[shell_of[0]].sid}, but {foreign}"
            else:
                hits[pid] = Hit(p, PANE, f"the shell of lane session {hits[shell_of[0]].sid}")
                continue
            refused[pid] = described(p, why)
            continue
        if sid is not None and proven[sid]:
            hits[pid] = Hit(p, LEFTOVER, f"carries lane session {sid}")
            continue
        refused[pid] = described(p, notes.get(pid) or foreign
                                 or "no session id in its environment")
    for pid, h in list(hits.items()):
        if h.kind == PANE and (jobs := other_jobs(pid, kids, hits)):
            # A known pane shell that took a new job since (its SIGHUP would reach that too)
            del hits[pid]
            refused[pid] = described(h.proc, f"{h.why}, now running {jobs_named(jobs, procs)}")
    me = os.getpid()  # self_guard names this one's own place, more plainly
    for pid, h in list(hits.items()):
        if h.kind == LEFTOVER:
            for d in lanelib.descendants(pid, kids):
                if d not in hits and d not in refused and d != me and d in procs:
                    refused[d] = described(procs[d], f"runs under {pid} {h.proc.comm} ({h.why}), "
                                                     f"outside lane {lane_id}")
    return hits, refused


def save_proof(repo: Repo, lane: dict, path: str, hits) -> None:
    """Record the pane shells among hits at repo.closing_path for a rerun's load_proof: a pane
    shell's only proof is its session, which the close itself ends (2026-10-15, lane
    two-sessions). Every other class a rerun proves afresh. Raises OSError when it can't."""
    write_json(repo.closing_path(lane["id"]), {
        "boot": lanelib.boot_id(), "lane": lane["id"], "created": lane.get("created"),
        "path": path,
        "shells": [{"pid": h.proc.pid, "start": h.proc.start, "comm": h.proc.comm, "why": h.why}
                   for h in hits if h.kind == PANE]})


def load_proof(repo: Repo,
    lane: dict,
    path: str,
    procs: dict[int, lanelib.Proc],
) -> dict[tuple[int, int], Hit]:
    """survey's known from the pane shells an earlier `done` of the lane recorded (save_proof):
    each of this boot, lane (its id and created stamp, so no later lane of that id inherits it)
    and path whose pid runs with its start and comm, while a tmux server is its parent and it
    carries no foreign session id. The rest is left to survey's own classification, and a
    malformed record counts as none."""
    try:
        rec = json.loads(lanelib.read_head(repo.closing_path(lane["id"]), PROOF_MAX) or b"null")
        boot = lanelib.boot_id()
    except (ValueError, RecursionError, OSError):
        return {}
    if not (isinstance(rec, dict) and rec.get("boot") == boot and rec.get("lane") == lane["id"]
            and rec.get("created") == lane.get("created") and rec.get("path") == path
            and isinstance(rec.get("shells"), list)):
        return {}
    files = lanelib.session_files()
    known = {}
    for e in rec["shells"]:
        if not isinstance(e, dict) or type(pid := e.get("pid")) is not int:
            continue
        p, why = procs.get(pid), e.get("why")
        parent = procs.get(p.ppid) if p else None
        if not (p and p.start == e.get("start") and p.comm == e.get("comm")
                and isinstance(why, str) and parent and parent.comm.startswith("tmux")):
            continue
        try:
            sid = lanelib.proc_env_sid(pid)
        except OSError:
            continue
        if sid is None or lanelib.lane_sid(sid, path, files):
            known[(pid, p.start)] = Hit(p, PANE, why)
    return known


def refusal(head: str, refused: dict[int, str], tail: str) -> LaneError:
    lines = "".join(f"\n  {refused[pid]}" for pid in sorted(refused))
    return LaneError(f"{head}:{lines}\n{tail}")


def self_guard(lane_id: str, path: str, procs: dict[int, lanelib.Proc], hits: dict) -> None:
    """Refuse a `done` run from inside the lane: its own cwd, or a process above it (the lane's
    session, a pane shell), is one it would end."""
    if lanelib.inside(os.getcwd(), path) or any(
            a in hits for a in lanelib.ancestors(os.getpid(), procs)):
        raise LaneError(f"this `lane done` runs inside lane {lane_id} (its cwd, or a process "
                        "above it, is one it would end): run it from the main checkout")


def removable(lane_id: str, path: str) -> None:
    """Refuse unless a plain `git worktree remove` will take the lane, so nothing is ended only
    for the remove to fail afterwards: a clean tree by git's own test, not locked, and no
    submodules (a gitlink in the index, or a modules dir in its admin dir).

    The status skips submodules: one with changes in it would run its own `git status`, whose
    config (core.fsmonitor among it) sits where the lane can write it, and GIT_COMMON_DIR never
    reaches that child. The lane's sessions still run here, so refusing submodules first would
    race a lane that adds one after the check: the submodule refusal below stays the gate."""
    p = git(["status", "--porcelain", "--ignore-submodules=all"], path)
    if p.returncode != 0:
        raise LaneError(f"git status failed in {path}: {p.stderr.strip()}")
    if dirty := [line[3:] for line in p.stdout.splitlines()]:
        more = f" and {len(dirty) - 5} more" if len(dirty) > 5 else ""
        raise LaneError(f"lane {lane_id} has uncommitted or untracked files ("
                        f"{', '.join(dirty[:5])}{more}), which `git worktree remove` refuses: "
                        f"commit or remove them, then rerun `lane done {lane_id}`")
    tree = None
    for line in git(["worktree", "list", "--porcelain"], path).stdout.splitlines():
        if line.startswith("worktree "):
            tree = os.path.realpath(line[len("worktree "):])
        elif tree == path and (line == "locked" or line.startswith("locked ")):
            raise LaneError(f"lane {lane_id}'s worktree is locked, so git won't remove it: "
                            f"`git worktree unlock {path}`, then rerun `lane done {lane_id}`")
    staged = git(["ls-files", "--stage"], path).stdout.splitlines()
    admin = git(["rev-parse", "--absolute-git-dir"], path).stdout.strip()
    if any(line.startswith("160000 ") for line in staged) or (
            admin and os.path.isdir(os.path.join(admin, "modules"))):
        raise LaneError(f"lane {lane_id}'s worktree has submodules, which a plain `git worktree "
                        "remove` refuses (and `done` never forces it)")


def closing_check(lane_id: str, path: str, abandon: bool = False) -> None:
    """`handoff-check --closing` in the lane must pass before its sessions end: the record is
    all of the lane that outlives them. With abandon, its `Keep open:` check is skipped, as
    `done --abandon` closes a kept lane anyway."""
    try:
        p = subprocess.run([sys.executable, "-I", HANDOFF_CHECK, "--closing",
                            *(["--abandon"] if abandon else []), "-C", path],
                           capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError) as e:
        raise LaneError(f"can't run handoff-check --closing ({e}), so nothing was signalled")
    if p.returncode != 0:
        raise LaneError(f"lane {lane_id}'s handoff is incomplete, so nothing was signalled: "
                        f"finish it, then rerun `lane done {lane_id}`\n"
                        f"{(p.stdout + p.stderr).strip()}")


def signal_proc(p: lanelib.Proc, sig: int) -> bool:
    """Send sig to p only while its pid still names that process: through a pidfd, whose start
    time is checked once the pidfd pins the process, so a pid reused since the scan is never
    hit. Where a seccomp filter refuses pidfds (ENOSYS, EPERM), the start time is checked just
    before a plain kill. False when p is gone or can't be signalled: whatever survives, the
    final look in end_lane refuses."""
    filtered = (errno.ENOSYS, errno.EPERM)
    try:
        fd = os.pidfd_open(p.pid)
    except ProcessLookupError:
        return False
    except OSError as e:
        if e.errno not in filtered:
            warn(shown(f"can't signal {p.pid} {p.comm}: {e.strerror}"))
            return False
        fd = None
    try:
        if fd is not None:
            if lanelib.proc_start(p.pid) != p.start:
                return False
            try:
                signal.pidfd_send_signal(fd, sig)
                return True
            except OSError as e:
                if e.errno not in filtered:
                    raise
        if lanelib.proc_start(p.pid) != p.start:
            return False
        os.kill(p.pid, sig)
        return True
    except ProcessLookupError:
        return False
    except OSError as e:
        warn(shown(f"can't signal {p.pid} {p.comm}: {e.strerror}"))
        return False
    finally:
        if fd is not None:
            os.close(fd)


def guarded(p: lanelib.Proc,
    sig: int,
    common: str,
    only: set[tuple[int, int]] | None = None,
) -> str | None:
    """Send p sig unless p or a process under it holds a file open under common (the git dir): a
    git cut off mid-write leaves its lock files, and a sandbox's pid namespace init (apply-seccomp,
    bwrap) that exits takes every process in it down by SIGKILL. With only {(pid, start)}, also
    unless a child of p is not in it (a pane shell's SIGHUP reaches each of its jobs). None
    when sent (or p is gone), else why it was held, which the final look names.

    Checked from one scan just before the signal, with nothing stopped: tmux continues a pane
    process that gets SIGSTOP at once, and a job-control shell reports a stopped job suspended
    and takes back the terminal (probe on tmux 3.7c, 2026-10-13), so no freeze can hold a tab's
    session still. A process that opens a git file between the check and the signal is the
    accepted residual (Hayden's call, 2026-10-13); git itself removes its lock files on SIGTERM."""
    procs = lanelib.scan(full=False)
    now = procs.get(p.pid)
    if now is None or now.start != p.start or now.state in lanelib.EXITED:
        return None  # gone
    tree = [now, *(procs[d] for d in lanelib.descendants(p.pid, lanelib.children(procs))
                   if d in procs)]
    if any(q.pid == os.getpid() for q in tree):
        return f"this `lane done` runs under it{LEFT}"
    if only is not None and (jobs := [q for q in tree if q.ppid == p.pid
                                      and (q.pid, q.start) not in only]):
        return f"now running {', '.join(f'{q.pid} {q.comm}' for q in jobs)}{LEFT}"
    for q in tree:
        if found := lanelib.open_under(q.pid, common):
            who = "holds" if q.pid == p.pid else f"has {q.pid} {q.comm} under it, which holds"
            return f"{who} {found} open{LEFT} (a killed git leaves lock files)"
    signal_proc(p, sig)
    return None


def forget_sessions(sids: list[str]) -> None:
    """Delete each session's open-sessions entry, as Shelve does (tmux/claude-saved), so
    claude-restore never reopens a session `done` ends; its SessionEnd then finds none to mark."""
    reg = os.path.join(lanelib.state_dir(), "open-sessions")
    for sid in sids:
        try:
            os.remove(os.path.join(reg, sid + ".json"))
        except FileNotFoundError:
            pass
        except OSError as e:
            warn(f"open-sessions entry of session {sid} kept ({e.strerror}): claude-restore may "
                 "reopen it")


def sweep_open_sessions(path: str) -> None:
    """Delete every open-sessions entry whose cwd is in the lane, under that dir's .lock (the
    flock claude-restore takes): a restore would reopen them in a removed worktree. A lock held
    past OPEN_SESSIONS_WAIT leaves them, with a warning."""
    reg = os.path.join(lanelib.state_dir(), "open-sessions")
    if not os.path.isdir(reg):
        return
    try:
        fd = os.open(os.path.join(reg, ".lock"),
                     os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_CLOEXEC, 0o644)
    except OSError as e:
        warn(f"open-sessions entries in {path} kept: can't open {reg}/.lock ({e.strerror})")
        return
    try:
        deadline = time.monotonic() + OPEN_SESSIONS_WAIT
        while not try_lock(fd):
            if time.monotonic() >= deadline:
                warn(f"open-sessions entries in {path} kept: {reg}/.lock is held (a restore "
                     "running?), and claude-restore may reopen them")
                return
            time.sleep(0.05)
        for entry in glob.glob(os.path.join(reg, "*.json")):
            try:
                rec = json.loads(lanelib.read_head(entry, 1 << 20) or b"null")
            except ValueError:
                continue
            if isinstance(rec, dict) and lanelib.cwd_inside(rec.get("cwd"), path):
                try:
                    os.remove(entry)
                except FileNotFoundError:
                    pass
                except OSError as e:
                    warn(f"open-sessions entry {entry} kept ({e.strerror}): claude-restore may "
                         "reopen it")
    finally:
        os.close(fd)


def end_lane(repo: Repo, lane: dict, path: str, hits: dict[int, Hit]) -> None:
    """End what `done` proved the lane's (hits) in two rounds, then look once more: anything
    still in the lane refuses, nothing is archived, and a rerun carries on from the pane shells
    cmd_done recorded (save_proof), which round 2 records again with its own. The lanes lock is
    never held here: a session's SessionEnd hook takes it to stamp endedAt. Each session's
    open-sessions entry goes before its SIGTERM, in either round (forget_sessions). Every signal
    but round 1's SIGTERM to a session, and the SIGCONTs that land it on a stopped one and its
    stopped tree, goes through guarded."""
    lane_id, wait = lane["id"], grace()
    known = {(h.proc.pid, h.proc.start): h for h in hits.values()}
    ended, held, forgotten = set(), {}, set()

    def settle(group: list[Hit], secs: float) -> list[Hit]:
        """Wait up to secs for group to exit, saying `ended` for each; the ones still running."""
        deadline = time.monotonic() + secs
        while True:
            left = []
            for h in group:
                key = (h.proc.pid, h.proc.start)
                if key in ended:
                    continue
                if lanelib.proc_alive(h.proc):
                    left.append(h)
                else:
                    ended.add(key)
                    say(f"ended {described(h.proc, h.why)}")
            if not left or time.monotonic() >= deadline:
                return left
            time.sleep(0.05)

    def forget(group) -> None:
        sids = [h.sid for h in group if h.kind == SESSION and h.sid not in forgotten]
        forgotten.update(sids)
        forget_sessions(sids)

    def send(h: Hit, sig: int, only: set | None = None) -> bool:
        """guarded's signal to h; a hold is kept for the final look, and dropped once a later
        signal to h goes through. True when sent (or h is gone)."""
        key = (h.proc.pid, h.proc.start)
        if why := guarded(h.proc, sig, repo.common_dir, only):
            held[key] = why
            return False
        held.pop(key, None)
        return True

    if hits:
        # Round 1: the sessions and the leftovers. A session gets a plain SIGTERM, unchecked:
        # Claude Code handles it as when its tab closes, running its SessionEnd hooks and ending
        # its own children, which are left to it. Every other signal goes through guarded.
        # Then the pane shells, which an interactive shell ignores SIGTERM for. A shell draws its
        # prompt once its session exits, and a prompt can fork as it draws (agnoster's
        # `$(build_prompt)` runs git in a -zsh child, 2026-10-15), so each shell gets its SIGHUP
        # once it runs no job of its own and guarded lets it through, within the grace; one
        # still running a job then is left to round 2.
        first = [h for h in hits.values() if h.kind in (SESSION, LEFTOVER)]
        forget(first)
        for h in first:
            if h.kind == SESSION:
                signal_proc(h.proc, signal.SIGTERM)
                # A stopped claude (Ctrl+Z) holds that SIGTERM pending, so its SessionEnd hook
                # never runs: SIGCONT delivers it. Ctrl+Z stops its whole process group, so
                # its stopped tree (MCP servers, tool children) is continued too, or the
                # signals its exit sends them would wait as well. Only this first signal,
                # unguarded by design, is continued; one that stops again on the terminal
                # (SIGTTOU) still ends by round 2's SIGTERM and SIGKILL.
                st = lanelib.proc_stat(h.proc.pid)
                if st and st[3] == h.proc.start and st[1] in lanelib.STOPPED:
                    procs = lanelib.scan(full=False)
                    for d in lanelib.descendants(h.proc.pid, lanelib.children(procs)):
                        if (q := procs.get(d)) and q.state in lanelib.STOPPED:
                            signal_proc(q, signal.SIGCONT)
                    signal_proc(h.proc, signal.SIGCONT)
            else:
                send(h, signal.SIGTERM)
        settle(first, wait)
        if shells := [h for h in hits.values() if h.kind == PANE]:
            deadline, left = time.monotonic() + wait, shells
            while True:
                procs = lanelib.scan(full=False)
                kids = lanelib.children(procs)
                targets = {pid for pid, p in procs.items() if (pid, p.start) in known}
                # Left: still running a job, or held by guarded (a job forked since this scan).
                left = [h for h in left if other_jobs(h.proc.pid, kids, targets)
                        or not send(h, signal.SIGHUP, set(known))]
                if not left or time.monotonic() >= deadline:
                    break
                time.sleep(0.05)
            settle([h for h in shells if h not in left], wait)
        # Round 2: whatever runs now, classified afresh, but a known process keeps its round-1
        # class (a pane shell whose session has gone is no less the lane's, and a session still
        # exiting keeps its hooks OWNED).
        procs = lanelib.scan()
        now, refused = survey(lane_id, path, procs, known)
        if refused:
            raise refusal(f"lane {lane_id} is closing, and nothing proves these lane {lane_id}'s",
                          refused, f"End or move them, then rerun `lane done {lane_id}`")
        for h in now.values():
            known.setdefault((h.proc.pid, h.proc.start), h)
        try:  # the pane shells still running, round 2's own included, for a rerun
            save_proof(repo, lane, path, now.values())
        except OSError as e:
            warn(f"can't record round 2's proof of lane {lane_id} ({e.strerror or e}): a rerun "
                 "keeps only round 1's")
        forget(now.values())
        running = {pid for pid, h in now.items() if h.kind == SESSION}
        for pid, h in now.items():
            if h.kind == OWNED and any(a in running for a in lanelib.ancestors(pid, procs)):
                continue  # a session's hook ends with it; the SIGKILL pass covers a survivor
            if h.kind == PANE:  # SIGHUP again: an interactive shell ignores SIGTERM
                send(h, signal.SIGHUP, set(known))
            else:
                send(h, signal.SIGTERM)
        survivors = settle(list(now.values()), wait)
        # SIGKILL, guarded too, sessions first; one held at its round-2 signal stays held, and so
        # does whatever runs under a held session (its hooks and servers got no signal of their
        # own), so nothing is killed that never got the chance to exit.
        killed = []
        for h in sorted(survivors, key=lambda h: h.kind != SESSION):
            key = (h.proc.pid, h.proc.start)
            if key in held:
                continue
            if h.kind == OWNED and (up := next((a for a in lanelib.ancestors(h.proc.pid, procs)
                                                if a in running and a in procs
                                                and (a, procs[a].start) in held), None)):
                held[key] = f"its session {up} was left running, so it was too"
                continue
            if send(h, signal.SIGKILL):
                killed.append(h)
        settle(killed, wait)
        settle(list(known.values()), 0)  # the rest that exited by themselves
    # The final look, with or without anything ended: a process that started meanwhile, or
    # survived, keeps the worktree.
    procs = lanelib.scan()
    if left := in_lane(procs, path):
        lines = {}
        for pid, p in left.items():
            h = known.get((pid, p.start))
            why = f"{h.why}; still running" if h else "started during the close"
            if h and (hold := held.get((pid, p.start))):
                why = f"{h.why}; {hold}"
            lines[pid] = described(p, why)
        raise refusal(f"lane {lane_id} is closing, and these still run in {path}", lines,
                      f"End them (or let them finish), then rerun `lane done {lane_id}`")


def install_state():
    """install-state.py at this checkout's root, loaded by path (its name holds a '-'): setup.sh's
    link rules, which `ls` and `done` share with it."""
    spec = importlib.util.spec_from_file_location("install_state", INSTALL_STATE)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def install_hold(repo: Repo, lane_id: str, path: str, so: str) -> None:
    """Refuse while installed links (or setup-tmux.sh's ~/.tmux.conf block) point into the lane:
    removing its worktree would break every session's hooks and tools. Fails closed, since a
    close that can't check would risk exactly that; so ends that message with what the caller
    has (and hasn't) done by then."""
    try:
        into = install_state().links_into(path)
    except Exception as e:
        raise LaneError(f"can't check the install for links into lane {lane_id} ({type(e).__name__}"
                        f": {e}), so {so}")
    if into:
        more = f"\n  and {len(into) - 5} more" if len(into) > 5 else ""
        raise LaneError(f"lane {lane_id} holds the install: these point into {path}, and removing "
                        "it would break them:" + "".join(f"\n  {shown(x)}" for x in into[:5])
                        + more + "\nThe lead reruns the installer each line names from the main "
                        f"checkout {repo.main}, then reruns `lane done {lane_id}`")


@contextlib.contextmanager
def install_lock():
    """Hold <state_dir>/install.lock, the flock setup.sh holds for its whole run, so no install
    relinks into a lane between `done`'s last links check and its worktree remove. Gives up
    after INSTALL_LOCK_WAIT."""
    state = lanelib.state_dir()
    os.makedirs(state, exist_ok=True)
    fd = os.open(os.path.join(state, "install.lock"),
                 os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_CLOEXEC, 0o644)
    try:
        deadline = time.monotonic() + INSTALL_LOCK_WAIT
        while not try_lock(fd):
            if time.monotonic() >= deadline:
                raise LaneError(f"{state}/install.lock is held past {INSTALL_LOCK_WAIT:g} s: by a "
                                "setup.sh run, or by anything holding it open with its lock (a "
                                "process setup.sh started inherits it). Nothing was archived or "
                                "removed: rerun `lane done` once it is released")
            time.sleep(0.1)
        yield
    finally:
        os.close(fd)


@contextlib.contextmanager
def lanes_lock(repo: Repo, then: str):
    """lock(repo), given up after LANES_LOCK_WAIT with a LaneError that ends with then: `done`
    takes it while it holds install.lock, and a sandboxed `lane claim` or `note` can hold it."""
    with contextlib.ExitStack() as stack:
        try:
            stack.enter_context(lock(repo, timeout=LANES_LOCK_WAIT))
        except lanelib.LockTimeout:
            raise LaneError(f"the lanes lock {repo.lanes_dir}/.lock is held past "
                            f"{LANES_LOCK_WAIT:g} s (a stuck `lane claim` or `note`?): {then}")
        yield


def reread(repo: Repo, loaded: dict, path: str) -> dict:
    """lane.json read again, under the lock: a second `done` may have closed the lane since this
    one loaded it, or its path or branch changed (what `done` checked would no longer be what
    it removes or deletes)."""
    lane_id = loaded["id"]
    try:
        lane = lanelib.read_record(repo, lane_id)
    except FileNotFoundError:
        raise LaneError(f"lane {lane_id} was closed meanwhile (a second `lane done`?)")
    if os.path.realpath(lane["path"]) != path or lane["branch"] != loaded["branch"]:
        raise LaneError(f"lane {lane_id}'s path or branch changed during the close: refusing")
    return lane


def work_references(repo: Repo, lane: dict) -> list[str]:
    """Symlinks in other lanes, and mentions in their records, that point into <lane>/work."""
    work = os.path.join(lane["path"], "work")
    if not os.path.isdir(work):
        return []
    hits = []
    peers, walked = repo.lanes(shared=True), set()  # a planted twin must not hide a peer
    for other in peers:
        if other["id"] == lane["id"] or not lanelib.is_live(other) or other["path"] in walked:
            continue
        if lanelib.worktree_problem(repo, other["path"], peers):
            continue  # walked sandbox-off: only a real lane worktree
        walked.add(other["path"])
        text, _ = record_text(repo, other)
        if text and work in text:
            hits.append(f"lane {other['id']} record mentions {work}")
        for root, dirs, files in os.walk(other["path"]):
            dirs[:] = [d for d in dirs if d not in (".git", "node_modules")
                       and root.count(os.sep) - other["path"].count(os.sep) < 3]
            for name in dirs + files:
                p = os.path.join(root, name)
                if os.path.islink(p) and lanelib.inside(os.path.realpath(p), work):
                    hits.append(f"{p} -> {os.path.realpath(p)}")
    return hits


def closable(repo: Repo, lane: dict, fetched: bool, branch: str) -> tuple[str | None, str, str]:
    """(label, state, why not) for closing a lane on `branch` without --abandon; label None
    means it needs --abandon. Merged means the branch has commits past its base and either a
    merged PR's head commit is the branch tip (a squash merge leaves the tip out of the base) or
    the tip is in the base; an old PR from a same-named branch at another commit proves nothing.
    A lane made by `new` with nothing past its base did no work, so it needs --abandon (state
    `empty`). An adopted lane's base is a merge-base: with nothing past it the tip is already in
    the base, so nothing can be lost. It can't tell "no work" from "fast-forwarded in before
    adoption", so it closes with state `closed`, "closed (nothing past <base>)", unless a merged
    PR names that tip. `abandoned` is kept for --abandon."""
    tip = rev(repo, f"refs/heads/{branch}")
    if tip is None:
        return None, "", f"branch {branch} does not exist"
    cfg = repo.config()
    ref, base = base_ref(cfg), cfg.get("base", "origin/main")  # git gets the full ref
    fork = lane.get("base_sha") or tip
    count = git(["rev-list", "--count", "--end-of-options", f"{fork}..{tip}"], repo.toplevel)
    no_work = count.returncode == 0 and count.stdout.strip() == "0"
    if no_work and not lane.get("adopted"):
        return None, "empty", f"no commits past its base {fork[:12]}"
    try:
        p = subprocess.run(["gh", "pr", "list", "--head", branch, "--state", "merged", "--json",
                            "number,headRefOid"], cwd=repo.toplevel, capture_output=True,
                           text=True, timeout=30)
        rows = json.loads(p.stdout or "[]") if p.returncode == 0 else []
        for row in rows:
            if row.get("headRefOid") == tip:
                return f"PR #{row.get('number')} merged", "merged", ""
    except (OSError, subprocess.SubprocessError, ValueError):
        pass
    in_base = git(["merge-base", "--is-ancestor", "--end-of-options", tip, ref],
                  repo.toplevel).returncode == 0
    if in_base and no_work:
        return f"closed (nothing past {base})", "closed", ""
    if in_base:
        return f"fully in {base}" + ("" if fetched else " (unfetched copy)"), "merged", ""
    return None, "", f"no merged PR at its tip {tip[:12]}, and the tip is not in {base}"


def done_branches(repo: Repo, lane: dict, heads: dict[str, tuple[str, str]]) -> list[str]:
    """The branches `done` judges and deletes: the one the worktree has checked out (lane_head),
    then lane.json's when it differs and still exists. A detached worktree gives lane.json's
    alone; lane_head's detached commit is judged by closable_all."""
    branch, _ = lane_head(lane, heads)
    out = [branch] if branch else []
    if lane["branch"] not in out and (not out or rev(repo, f"refs/heads/{lane['branch']}")):
        out.append(lane["branch"])
    return out


def closable_all(repo: Repo, lane: dict, heads: dict[str, tuple[str, str]], branches: list[str],
                 fetched: bool) -> tuple[str | None, str, str]:
    """closable over every branch done_branches gave: each must pass, except that a branch with
    nothing past the base loses nothing once another passed (a switch to a fresh branch). A
    detached worktree needs --abandon: its commit is on no branch for closable to judge."""
    branch, sha = lane_head(lane, heads)
    if not branch:
        return None, "", (f"lane {lane['id']}'s worktree is on a detached HEAD at {sha[:12]}, so "
                          "`done` can't tell its work is merged: check out its branch")
    results = [(b, closable(repo, lane, fetched, b)) for b in branches]
    passed = [(b, r) for b, r in results if r[0]]
    for b, (label, state, why) in results:
        if not label and not (passed and state == "empty"):
            return None, "", f"branch {b} is not merged: {why}"
    if len(results) == 1:
        return results[0][1]
    state = "merged" if any(r[1] == "merged" for _, r in passed) else "closed"
    return "; ".join(f"{b}: {r[0]}" for b, r in passed), state, ""


def lane_place(repo: Repo, root: str | None, cwd) -> str | None:
    """Where a session's cwd (its session file's, or its real one) makes it a lane's, or None:
    in a linked worktree of this repo (lanelib.linked_worktree), or under the lanes root (when
    there is one) but outside the main checkout (a root that holds main must not count the lead
    as a lane; no lane lives inside main, since worktree_problem refuses one)."""
    if wt := lanelib.linked_worktree(repo, cwd):
        return f"in linked worktree {wt}"
    if root and lanelib.cwd_inside(cwd, root) and not lanelib.cwd_inside(cwd, repo.main):
        return f"under the lanes root {root}"
    return None


def lane_above(repo: Repo, root: str | None,
               above: list[tuple[dict, lanelib.Proc]]) -> tuple[dict, lanelib.Proc, str] | None:
    """The first session in above (lanelib.sessions_above) that is a lane's by its session
    file's cwd or its real one (a lane session that cd'd to main): lane_place. That session,
    its process and where it is, or None. Every one counts, not only the nearest: a lane's
    claude may run another claude, and no lane may close lanes (lead_only) or take the lead
    (lead_claim) that way. Only trusted facts decide: the lanes root from the config, which
    sandboxed Bash can't write, and git's own worktree links. Never lane.json's paths, which it
    can: a planted "/home" made every `done` refuse the lead, and a lane could drop its own
    path."""
    for s, p in above:
        if where := lane_place(repo, root, s.get("cwd")) or lane_place(repo, root, p.cwd):
            return s, p, where
    return None


def lead_only(repo: Repo, lane_id: str, path: str) -> None:
    """Only the lead closes lanes: refuse unless this runs from the main checkout, and when a
    Claude session above it (a session file's own process, by pid and procStart) is a lane's:
    lane_above. Sandboxed, the processes above it can't be seen, so that refuses too."""
    lead = (f"only the lead (the main checkout) closes lanes: run `lane done {lane_id}` from "
            f"{repo.main}")
    if not repo.is_main:
        raise LaneError(f"refusing: {lead}")
    if not lanelib.pids_visible():
        raise LaneError("sandboxed: this command can't see other processes, so it can't tell "
                        f"whether a session still runs in {path}, or runs this one. Run it as a "
                        f"bare `lane done {lane_id}` (excludedCommands runs that outside the "
                        "sandbox)")
    root = repo.config().get("root")
    if not (isinstance(root, str) and os.path.isabs(root)):
        raise LaneError(f"the lanes config {repo.config_path} has no absolute root: rerun "
                        "`lane init --root DIR`")
    if hit := lane_above(repo, os.path.realpath(root), lanelib.sessions_above()):
        s, p, where = hit
        raise LaneError(shown(f"refusing: {lead}. This `lane done` runs under session "
                              f"{sid_of(s)} ({p.pid} {p.comm}), {where}"))


def sid_of(session: dict) -> str:
    """A session file's sessionId when it is one (lanelib.SID), else "?"."""
    sid = session.get("sessionId")
    return sid if isinstance(sid, str) and lanelib.SID.fullmatch(sid) else "?"


LEAD_ACTS = ("init", "new", "adopt", "open", "done")  # each, when it succeeds, takes the lead
LEAD_HINT = ("No lead picked: the lead takes it with a bare `lane lead` (Hayden: `! lane lead` at "
             "the lead's prompt), or any bare lane new, open, adopt or done it runs. After a tmux "
             "restart, a restored tab that resumes the lead's session keeps the lead; otherwise "
             "the lead must act again")
SANDBOXED_LEAD = ("sandboxed: the Claude session above this command is out of sight, and the "
                  "state dir is read-only. Run it as a bare `lane lead` (excludedCommands runs "
                  "that outside the sandbox)")


def lead_claim(repo: Repo) -> tuple[dict, dict]:
    """(session file, record) that make the session running this command the lead, or a
    LaneError saying why it can't be. The nearest Claude session above
    (lanelib.sessions_above) must be interactive, have a session id and a messaging socket (or
    no lane could reach it), and have launched in the main checkout, outside lane_place: inside
    main that means outside any linked worktree, so a session in an agent worktree never leads,
    nor does a lane's session cd'd to main. Its session file's cwd decides that, as it does for
    `addr`; a Bash cd doesn't move it, so a lead cd'd into a lane still leads. Then no session
    farther up may be a lane's, by lead_only's rule (lane_above, real cwd included): else a
    lane's session could run an interactive claude in main and make it the lead. The
    lane-identity hook runs `lane lead` on a proven continuation (lanelib.lead_relink), so
    these checks bind it too."""
    if not lanelib.pids_visible():
        raise LaneError(SANDBOXED_LEAD)
    above = lanelib.sessions_above()
    if not above:
        raise LaneError("no Claude session runs this command (no process above it has a session "
                        "file): run it from the lead, as `! lane lead` at its prompt")
    s, p = above[0]
    sid, kind = sid_of(s), s.get("kind")
    if kind == "bg":
        raise LaneError(f"session {sid} is a background session, and the lead is one Hayden "
                        "talks to: run `! lane lead` at the lead's prompt")
    if kind != "interactive":
        raise LaneError(shown(f"session {sid} is a {kind or 'kindless'} session, not an "
                              "interactive one (a `claude -p` can't lead)"))
    if sid == "?":
        raise LaneError(f"the session above ({p.pid} {shown(p.comm)}) has no session id")
    if not lanelib.socket_of(s):
        raise LaneError(f"session {sid} has no messaging socket, so no lane could reach it")
    cwd = s.get("cwd")
    if not lanelib.cwd_inside(cwd, repo.main):
        raise LaneError(shown(f"session {sid} launched in {cwd}, outside the main checkout "
                              f"{repo.main}: only a session there leads"))
    # lane_place for a cwd inside main: its lanes-root clause never holds there.
    if where := lanelib.linked_worktree(repo, cwd):
        raise LaneError(shown(f"session {sid} is a lane's or an agent's, in linked worktree "
                              f"{where}: only a session in the main checkout leads"))
    # With no absolute root in the config (lead_only refuses there), linked worktrees alone.
    root = repo.config().get("root")
    root = os.path.realpath(root) if isinstance(root, str) and os.path.isabs(root) else None
    # The nearest passed by its launch dir above; by pid, not position, in case two session
    # files name its process.
    if hit := lane_above(repo, root, [x for x in above if x[1].pid != p.pid]):
        lane_s, lane_p, where = hit
        raise LaneError(shown(f"this runs under session {sid_of(lane_s)} ({lane_p.pid} "
                              f"{lane_p.comm}), {where}: a lane's session never leads, nor any "
                              "session it runs"))
    return s, lanelib.lead_record(s, lanelib.proc_tmux(p.pid))


def take_lead() -> None:
    """After a lead act (LEAD_ACTS) succeeds: record its session as the lead, or do nothing.
    The act is done either way, so nothing here fails it: from a lane, sandboxed, with no
    session above, or on any error, the lead stays where it was."""
    try:
        repo = lanelib.resolve(os.getcwd())
        if repo is not None and repo.has_lanes:
            lanelib.write_lead(repo, lead_claim(repo)[1])
    # Every Exception, not only LaneError and OSError: the act already succeeded and printed,
    # and the record is a best effort, so a crash here (a RecursionError from a session file
    # nested past json's limit, say) must not turn its exit code into a traceback's.
    except Exception:
        pass


def cmd_lead(args) -> None:
    """Hand the lead to the session that runs this, for `addr lead`, the board's footer and the
    tab bar to name."""
    if not lanelib.pids_visible():
        raise LaneError(SANDBOXED_LEAD)
    repo = lanes_repo()
    session, rec = lead_claim(repo)
    if args.expect_sid is not None and rec["sessionId"] != args.expect_sid:
        raise LaneError(shown(f"session {rec['sessionId']} runs this, not {args.expect_sid}: "
                              "the lead stays where it was"))
    try:
        lanelib.write_lead(repo, rec)
    except OSError as e:
        raise LaneError(f"can't write {repo.lead_path} ({e.strerror})")
    say(shown(f"lead of {repo.main}: session {rec['sessionId']} in {window_label(session)}"))


def close_record(repo: Repo,
    lane: dict,
    path: str,
    data_dir: str,
    state: str,
    how: str,
    present: bool,
    judged: tuple[str, str] | None = None,
) -> str:
    """Archive the lane's record and remove its worktree, all under install.lock: (a) under the
    lanes lock, re-read lane.json (a SessionEnd hook may have stamped endedAt, which the archive
    keeps) and build the archive under a .tmp name; (b) without it, check the install once more,
    and that the worktree still has `judged` (its branch and HEAD when `done` judged it) checked
    out, then `git worktree remove`, which can take seconds while every lane's hooks give up on
    that lock after 2 s; (c) under it again, re-read (refused if the record vanished or its path
    or branch changed), rename the archive into place and remove the data dir. A failure
    anywhere removes the .tmp, so no partial archive is left. Returns the archive's path."""
    lane_id = lane["id"]
    stamp = datetime.date.today().isoformat()
    closed = os.path.join(repo.lanes_dir, lanelib.CLOSED)
    rerun = f"rerun `lane done {lane_id}`"
    # install.lock first, then the lanes lock: setup.sh never takes the lanes lock, and the lanes
    # lock must not sit idle for the install wait. Held from the build to the rename, so no
    # install relinks into the lane after the check in (b), and, with no worktree left too, no
    # second `done` of the lane builds on the same .tmp name meanwhile.
    with install_lock():
        with lanes_lock(repo, f"nothing was archived or removed: {rerun}"):
            loaded = reread(repo, lane, path)
            archive = os.path.join(closed, f"{lane_id}-{stamp}")
            n = 2
            while os.path.exists(archive):
                archive = os.path.join(closed, f"{lane_id}-{stamp}-{n}")
                n += 1
            tmp = archive + ".tmp"
            source = lanelib.record_dir(loaded)
            if lanelib.record_is_link(loaded):
                warn(f"{source} is a symlink: its target is not archived (the last mirror is, if "
                     "any)")
                source = lanelib.mirror_dir(repo, lane_id, restore=True)
            elif not os.path.isdir(source):
                source = lanelib.mirror_dir(repo, lane_id, restore=True)  # under the lock
            try:
                shutil.rmtree(tmp, ignore_errors=True)
                os.makedirs(tmp)
                if source and os.path.isdir(source):
                    lanelib.copy_record(source, os.path.join(tmp, lanelib.RECORD_DIR))
                write_json(os.path.join(tmp, "lane.json"),
                           dict(loaded, state=state, closed=now_iso(), outcome=how))
            except OSError as e:
                shutil.rmtree(tmp, ignore_errors=True)
                raise LaneError(f"could not archive lane {lane_id} ({e}); nothing was removed")
            except BaseException:  # a record nested past the recursion limit, an interrupt
                shutil.rmtree(tmp, ignore_errors=True)
                raise
        try:
            if not present and os.path.lexists(path):
                # Gone at the gates, so nothing checked it (worktreeConfig among the rest), and
                # `git worktree remove` would run git in it sandbox-off.
                raise LaneError(f"{path} reappeared during the close of lane {lane_id}, so nothing "
                                f"checked it: {rerun}")
            if path in (heads := worktree_heads(repo)):
                # A switch since `done` judged the branches would remove a worktree on one it
                # never judged (and keep that branch, unjudged, from `branch -d`).
                if judged is not None and heads[path] != judged:
                    now, sha = heads[path]
                    moved = (f"got commit {sha[:12]} on {now}" if now == judged[0] else
                             f"moved to {now or f'a detached HEAD at {sha[:12]}'}")
                    raise LaneError(f"lane {lane_id}'s worktree {moved} during the close, so it "
                                    f"was not removed: {rerun}")
                # An install run since the first links check (setup.sh from the lane, mid-close)
                # would point every hook into the worktree this removes: check again, under its
                # lock.
                install_hold(repo, lane_id, path, "its worktree was not removed")
                # And for a process once more: the final look was up to a minute of lock waits
                # ago, and with nothing ended the lane was never `closing`, so `open` could
                # start a session meanwhile.
                if left := in_lane(lanelib.scan(), path):
                    raise refusal(f"these started in {path} during the close, so lane {lane_id}'s "
                                  "worktree was not removed",
                                  {pid: described(p, "started during the close")
                                   for pid, p in left.items()},
                                  f"End them, then rerun `lane done {lane_id}`")
                p = git(["worktree", "remove", path], repo.toplevel)
                if p.returncode != 0:
                    raise LaneError(f"git worktree remove refused: {p.stderr.strip()}")
            with lanes_lock(repo, f"lane {lane_id}'s record is not archived, and its worktree is "
                                  f"gone: {rerun}"):
                reread(repo, loaded, path)
                os.rename(tmp, archive)
                shutil.rmtree(data_dir)
        except BaseException:
            shutil.rmtree(tmp, ignore_errors=True)
            raise
    return archive


def cmd_done(args) -> None:
    repo = lanes_repo()
    data_dir = lane_data_dir(repo, args.id)
    lane = load_lane(repo, args.id)
    path = os.path.realpath(lane["path"])
    if path == repo.main:
        raise LaneError(f"refusing: lane {args.id}'s path is the main checkout")
    lead_only(repo, args.id, path)
    # Every git `done` runs in the lane (status, handoff-check's, the one `git worktree remove`
    # starts) takes its config from this repo's common dir, never the lane-writable commondir
    # file that worktree_problem checks: a lane could repoint it after the check to a config
    # whose core.fsmonitor runs a command sandbox-off.
    os.environ["GIT_COMMON_DIR"] = repo.common_dir
    # And none of them writes the lane's index: a status that refreshes it fires the
    # post-index-change hook, which a relative core.hooksPath runs from the lane's worktree.
    os.environ["GIT_OPTIONAL_LOCKS"] = "0"
    # Not even then, where the repo turns on per-worktree config: git would read the lane's
    # <admin>/config.worktree too, which its sandbox can write and no variable overrides.
    present = os.path.isdir(path)
    wtc = git(["config", "--file", os.path.join(repo.common_dir, "config"), "--type=bool",
               "--get", "extensions.worktreeConfig"], repo.main) if present else None
    if wtc and wtc.stdout.strip() == "true":
        raise LaneError(f"this repo sets extensions.worktreeConfig, so git in lane {args.id} reads "
                        "its config.worktree, which the lane's sandbox can write: `done` won't run "
                        "git there sandbox-off. Close the lane by hand, or turn the extension off "
                        "if nothing needs it (`git sparse-checkout` turns it on)")
    if present:  # its record is archived and its worktree removed, sandbox-off
        usable_path(repo, lane)
    heads = worktree_heads(repo)  # judged once: close_record refuses if it moves meanwhile
    branches = done_branches(repo, lane, heads)
    fetched = fetch(repo)
    how, state, why = closable_all(repo, lane, heads, branches, fetched)
    if not how and not args.abandon:
        raise LaneError(f"{why}. Pass --abandon to close it anyway")
    how, state = (how, state) if how else ("abandoned", "abandoned")
    # Read here, live session or not: `handoff-check --closing` (which fails on it too) runs only
    # when there is something to end.
    if present and not args.abandon and (kept := lanelib.kept_open(lanelib.next_block(
            record_text(repo, lane)[0] or ""))):
        raise LaneError(f"lane {args.id}'s Next says {shown(kept.splitlines()[0].strip())!r}: it "
                        "stays open for more PRs. Its session drops that line at its last merge; "
                        "pass --abandon to close it anyway")
    install_hold(repo, args.id, path, "nothing was signalled")
    hits = {}
    if present:  # every gate before any signal (lead_only refused a sandboxed run)
        removable(args.id, path)
        procs = lanelib.scan()
        # A rerun keeps what an earlier run proved: its signals may have ended the proof itself.
        hits, refused = survey(args.id, path, procs, load_proof(repo, lane, path, procs))
        self_guard(args.id, path, procs, hits)
        if refused:
            raise refusal(f"nothing proves these processes in {path} are lane {args.id}'s, so "
                          "nothing was signalled", refused,
                          f"End or move them, then rerun `lane done {args.id}`")
        if hits:
            closing_check(args.id, path, args.abandon)
    for hit in work_references(repo, lane) if present else []:
        warn(shown(f"reference into {lane['id']}/work: {hit}"))  # a path from another lane
    if hits:
        # Closing from here on: `open` refuses the lane, so no new session starts mid-close,
        # and a refusal below leaves it closing for a rerun to finish. With nothing to end, a
        # refusal leaves the lane as it was. Then, before any signal, the proof is recorded:
        # without it, a refusal after a session ended would leave its pane shell nothing a rerun
        # can prove it by. Only a closing lane gets one, so none outlives a run that stopped
        # short of its signals.
        with lanes_lock(repo, f"nothing was signalled: rerun `lane done {args.id}`"):
            reread(repo, lane, path)
            lanelib.update_lane(repo, args.id, lambda x: x.update(state="closing"))
        try:
            save_proof(repo, lane, path, hits.values())
        except OSError as e:
            raise LaneError(f"can't record what lane {args.id}'s close proved at "
                            f"{repo.closing_path(args.id)} ({e.strerror or e}), so nothing was "
                            f"signalled and the lane is left closing: rerun `lane done {args.id}` "
                            "once it can be written")
        try:
            end_lane(repo, lane, path, hits)
        finally:  # a close refused partway has ended sessions all the same
            sweep_open_sessions(path)
    else:
        if present:
            end_lane(repo, lane, path, hits)  # its final look only
        sweep_open_sessions(path)
    archive = close_record(repo, lane, path, data_dir, state, how, present, heads.get(path))
    try:
        os.remove(repo.closing_path(args.id))
    except FileNotFoundError:
        pass
    except OSError as e:
        warn(f"the record of lane {args.id}'s close is kept at {repo.closing_path(args.id)} "
             f"({e.strerror}): remove it by hand (no later lane {args.id} takes it, since it "
             "names this one's created stamp)")
    say(f"lane {args.id} closed ({how}); archived to {archive}")
    delete_branches(repo, branches)
    orphaned_rules(args.id, path)


def delete_branches(repo: Repo, branches: list[str]) -> None:
    """`git branch -d` each branch `done` judged, never the base's own local branch (a lane can
    check it out) and never one another worktree has checked out (Hayden testing it, say)."""
    cfg = repo.config()
    try:
        base_branch = base_parts(repo, cfg)[1]
    except LaneError:  # a base no remote matches: keep any branch named like its tail
        base_branch = base_ref(cfg).rsplit("/", 1)[-1]
    try:
        elsewhere = {b for b, _ in worktree_heads(repo).values() if b}
    except (OSError, subprocess.SubprocessError):
        elsewhere = set(branches)  # can't tell: keep them all
    for branch in branches:
        if branch == base_branch:
            continue
        if branch in elsewhere:
            warn(f"branch {branch} kept: another worktree has it checked out")
            continue
        # With no upstream, -d judges against the main checkout's HEAD, which may not have
        # pulled the merge yet; the base as upstream makes it judge against what was merged.
        # A branch -d keeps gets its config section back as it was (an upstream naming a
        # pruned remote ref, a rebase setting, a key with several values).
        before = branch_config(repo, branch)
        git(["branch", f"--set-upstream-to={base_ref(cfg)}", "--end-of-options", branch],
            repo.toplevel)
        p = git(["branch", "-d", "--end-of-options", branch], repo.toplevel)
        if p.returncode != 0:
            git(["config", "--remove-section", f"branch.{branch}"], repo.toplevel)
            for key, value in before:
                git(["config", "--add", key, value], repo.toplevel)
            warn(f"branch {branch} kept: {p.stderr.strip()} (a squash merge leaves it "
                 "unmerged to git; check, then delete it yourself)")


def branch_config(repo: Repo, branch: str) -> list[tuple[str, str]]:
    """Every (key, value) in the branch's config section, in order. A branch name can hold dots,
    so a key is the branch's when its tail past `branch.<name>.` is one bare name."""
    p = git(["config", "-z", "--get-regexp", r"^branch\."], repo.toplevel)
    out = []
    for record in p.stdout.split("\0") if p.returncode == 0 else []:
        key, _, value = record.partition("\n")
        var = key.removeprefix(f"branch.{branch}.")
        if var != key and var and "." not in var:
            out.append((key, value))
    return out


def parser() -> argparse.ArgumentParser:
    # No abbreviated flags: the asks on --setup, --root and --abandon must see the full spelling.
    strict = functools.partial(argparse.ArgumentParser, allow_abbrev=False)
    ap = strict(prog="lane", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True, parser_class=strict)
    p = sub.add_parser("init", help="write the lanes config (in the state dir)")
    p.add_argument("--root", help="dir that holds the lane worktrees (default <repo>-lanes beside it)")
    p.add_argument("--setup", help="shell command run in each new lane (LANE_ID, LANE_PORT set)")
    p.add_argument("--ports", help="port range A-B handed out one per lane")
    p.add_argument("--cap", type=int, help=f"live-lane cap (default {DEFAULT_CAP})")
    p.add_argument("--locks", help="comma-separated names `lane lock` accepts, e.g. gate,e2e")
    p.add_argument("--autopass", action=argparse.BooleanOptionalAction, default=None,
                   help="auto-pass in the lanes and the main checkout (on when never set)")
    p.add_argument("--model", help="claude --model for each `lane open` ('' for the user's default)")
    p.add_argument("--effort", help="claude --effort for each `lane open` ('' for the user's "
                                    "default)")
    p = sub.add_parser("new", help="make a lane: worktree, branch, record, port, setup")
    p.add_argument("id")
    p.add_argument("--branch", help="branch name (default: the id)")
    p.add_argument("--claim", action="append", default=[], metavar="REQ")
    p.add_argument("--goal")
    p.add_argument("--files", help="files the lane expects to touch")
    p.add_argument("--overlaps", help="lanes (by id) whose files overlap")
    p.add_argument("--done-when", dest="done_when", help="done criteria")
    p.add_argument("--constraints")
    p = sub.add_parser("adopt", help="register an existing worktree as a lane, or finish one "
                                     "`new` left setup-failed")
    p.add_argument("path")
    p.add_argument("--id", help="lane id when the dir name is no slug (default: the dir name)")
    p = sub.add_parser("ls", help="the board (derived live)")
    p.add_argument("--json", action="store_true")
    p.add_argument("--requests", action="store_true", help="request -> lane, from claims only")
    p = sub.add_parser("open", help="start a lane's session in a new tmux window, in plan mode")
    p.add_argument("id")
    p.add_argument("--focus", action="store_true",
                   help="switch to the window (a new one, or the live session's)")
    p.add_argument("--print", action="store_true", help="print the tmux command, run nothing")
    p.add_argument("--model", help="claude --model for this launch (default: init's; '' for none)")
    p.add_argument("--effort", help="claude --effort for this launch (default: init's; '' for "
                                    "none)")
    p.add_argument("prompt", nargs="?", help="first prompt (default: read the record, plan the brief)")
    p = sub.add_parser("addr", help="the messaging address (uds:<socket>) of a lane's live "
                                    "session, or the lead's; resolve it before each send")
    p.add_argument("id", help="a lane id, or `lead`")
    p = sub.add_parser("lead", help="make the session that runs this the lead, the one `lane addr "
                                    "lead` names (a bare init, new, adopt, open or done does too)")
    p.add_argument("--expect-sid", metavar="SID",
                   help="refuse unless that session holds this id (the lane-identity hook's "
                        "relink passes the id it proved)")
    p = sub.add_parser("lock", help="run a command under a named lock (`lane lock <name> -- <cmd>`)",
                       usage="lane lock <name> [--wait SECS] -- <cmd...>")
    p.add_argument("name")
    p.add_argument("--wait", type=float, metavar="SECS",
                   help=f"give up after SECS, exit {LOCK_BUSY} (default: wait as long as it "
                        f"takes); the command's own {LOCK_BUSY} looks the same, but only a "
                        "timeout prints \"gave up on lock\" on stderr")
    p = sub.add_parser("trial", help="run the suites on a merge of this lane with every other "
                                     "live lane, in a scratch tree, under the suite lock",
                       usage="lane trial [<id> ...] [--wait SECS] [--keep] "
                             "--run CMD [--run CMD ...]")
    p.add_argument("ids", nargs="*", metavar="id",
                   help="merge only these lanes (default: every other live lane)")
    p.add_argument("--run", action="append", required=True, metavar="CMD",
                   help="a suite, run as `sh -c CMD` in the tree and judged on its own; repeat "
                        "it per suite (a chained `a && b` stops at the first failure)")
    p.add_argument("--wait", type=float, metavar="SECS",
                   help=f"give up on the lock after SECS, exit {LOCK_BUSY} (default: wait)")
    p.add_argument("--keep", action="store_true",
                   help="keep the scratch tree (it says where, and how to remove it)")
    p = sub.add_parser("whoami", help="this checkout's lane id, main, or plain")
    p.add_argument("--json", action="store_true")
    for name in ("claim", "release"):
        p = sub.add_parser(name, help=f"{name} requests for this lane")
        p.add_argument("req", nargs="+")
    p = sub.add_parser("who", help="which lane claims a request")
    p.add_argument("req")
    p = sub.add_parser("note", help="append a timestamped line to this lane's State")
    p.add_argument("text", nargs="+")
    sub.add_parser("asks", help="every lane's open asks for Hayden")
    p = sub.add_parser("done", help="close a merged (or abandoned) lane, ending its sessions",
                       description="Close a merged lane (an unmerged one with --abandon), from "
                       "the main checkout only: end the processes that provably belong to it, "
                       "archive its record, remove its worktree. Its sessions get SIGTERM (a "
                       "stopped one SIGCONT too), their pane shells SIGHUP, survivors SIGKILL. "
                       "Anything else with its cwd in the lane refuses the close by name before "
                       "any signal, as do installed links into the lane, a dirty, locked "
                       "or submodule worktree, a repo with extensions.worktreeConfig, a record "
                       "whose Next says `Keep open:` (unless --abandon) and, when there is "
                       "something to end, a failing `handoff-check --closing`. A close refused "
                       "after a signal, or one that couldn't record its proof (nothing "
                       "signalled), leaves the lane closing: rerun `lane done <id>`, which keeps "
                       "the pane shells the first run proved.")
    p.add_argument("id")
    p.add_argument("--abandon", action="store_true",
                   help="close an unmerged lane, or one whose Next says `Keep open:`")
    return ap


def main(argv=None) -> int:
    argv = sys.argv[1:] if argv is None else list(argv)
    # `lock`'s command is everything after the first `--`, split off before argparse sees it:
    # a REMAINDER positional would swallow `--wait` and keep the `--`.
    command = None
    if argv[:1] == ["lock"] and "--" in argv:
        cut = argv.index("--")
        argv, command = argv[:cut], argv[cut + 1:]
    ap = parser()
    args, extra = ap.parse_known_args(argv)
    # argparse fills `open`'s optional prompt (empty) together with the id, so a prompt after a
    # flag (`lane open x --focus "..."`) comes back unrecognized: it is the prompt.
    if args.cmd == "open" and args.prompt is None and len(extra) == 1 \
            and not extra[0].startswith("-"):
        args.prompt, extra = extra[0], []
    if extra:
        ap.error("unrecognized arguments: " + " ".join(extra))
    if args.cmd == "lock":
        if not command:
            ap.error("lane lock <name> [--wait SECS] -- <cmd...>: no command after --")
        args.command = command
    try:
        rc = globals()["cmd_" + args.cmd](args)
    except (LaneError, lanelib.Untrusted) as e:
        warn(str(e))
        return 1
    except subprocess.CalledProcessError as e:
        warn(f"{' '.join(e.cmd)} failed: {(e.stderr or '').strip()}")
        return 1
    except OSError as e:  # shutil.Error included: a clean message, never a traceback
        warn(f"{type(e).__name__}: {e}")
        return 1
    # The one place a lead act takes the lead: only once it succeeded, so a refused or failed
    # act never moves it. `open --print` only prints.
    if args.cmd in LEAD_ACTS and not getattr(args, "print", False):
        take_lead()
    if rc and rc < 0:  # a command died of signal -rc, or a Ctrl-C hit `lane` itself
        return die_of(-rc)  # only now: the lock's holder line is cleared and the lock let go
    return rc or 0  # only `lock` (its command's) and `trial` return a code


if __name__ == "__main__":
    sys.exit(main())
