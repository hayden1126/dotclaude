#!/usr/bin/env python3
"""subagent-policy: PreToolUse policy for delegated agents (subagents and in-process teammates).

It applies only to calls made inside a subagent. Hook input carries `agent_id` there and never
on the main thread, not even in an `--agent` session (code.claude.com/docs/en/hooks). The
settings entry filters on that before starting Python: a main-thread call starts it only when its
payload happens to contain the text "agent_id", and then exits at once.

Where it sits:
- The sandbox (session-wide, OS-enforced, Bash only) binds a command whatever form it takes:
  an alias, a script, `eval`.
- This hook:
  - denies leaving the sandbox;
  - polices the file and MCP tools, which the sandbox never sees;
  - applies each role's rules (policy.toml), and says why.

  It catches the obvious forms; the sandbox catches the rest.

Contract:
- stdin is the PreToolUse hook JSON.
- An allowed call prints nothing and exits 0. There is no "allow" decision, so normal permission
  handling still applies.
- A denial prints a PreToolUse deny whose reason names a rule and an intent, and appends a
  `policy` row to the ledger.
- Past the role's stop budget for this activation (policy.toml [deadline]), every tool except
  the `allow` list is denied, policed or not. delegation-ledger's PostToolUse hook nudged the
  agent before that.

Fails closed for the tools it polices (shell, file, MCP): an exception, a malformed policy.toml,
or the 5-second alarm becomes a deny. That alarm fires before Claude Code's own hook timeout,
which would let the call through. Other tools (SubagentHandback, SendMessage, ...) are allowed
on error, so a policy bug can't swallow a report. The deadline check alone fails open: with no
readable liveness index there is no clock, so there is no deadline.

Command parsing uses Parable (vendor/parable.py, MIT, vendored verbatim). The rule set and the
intent vocabulary follow cc-safety-net (github.com/kenryu42/cc-safety-net, MIT), reimplemented.
"""
import fnmatch
import json
import os
import re
import shutil
import signal
import sys
import time
import tomllib

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
sys.path.insert(0, os.path.join(HERE, "vendor"))
import delegation_common as dc  # noqa: E402

SHELL_TOOLS = {"Bash", "Monitor", "PowerShell"}
WRITE_TOOLS = {"Edit", "Write", "NotebookEdit", "MultiEdit"}
READ_TOOLS = {"Read", "Grep", "Glob", "LS", "NotebookRead"}
ALARM_SECONDS = 5
INTENTS = ("hard_stop", "use_alternative", "scope_down", "manual_only", "stop_and_explain")


class Deny(Exception):
    """A denial. `footer` replaces the intent's footer from [intents] when the rule's own
    message already says what to do next (the deadline)."""

    def __init__(self, rule, intent, message, footer=None):
        super().__init__(message)
        self.rule, self.intent, self.message, self.footer = rule, intent, message, footer


def policed(tool):
    return (tool in SHELL_TOOLS or tool in WRITE_TOOLS or tool in READ_TOOLS
            or str(tool).startswith("mcp__"))


# ---------------------------------------------------------------- policy and settings

def load_policy(path=None):
    with open(path or dc.policy_path(), "rb") as f:
        p = tomllib.load(f)
    for table in ("intents", "roles", "deadline", "shell", "git", "curl", "wget", "rm",
                  "protect", "researcher", "mcp"):
        if not isinstance(p.get(table), dict):
            raise ValueError(f"policy.toml: missing table [{table}]")
    missing = [i for i in INTENTS if not p["intents"].get(i)]
    if missing:
        raise ValueError(f"policy.toml: [intents] lacks {missing}")
    for intent in p["git"]["denied"].values():
        if intent not in INTENTS:
            raise ValueError(f"policy.toml: unknown intent {intent!r} in [git].denied")
    dc.check_deadline(p["deadline"])
    return p


def settings_tiers(project, home):
    """Settings files by tier, lowest precedence first, following
    code.claude.com/docs/en/settings#settings-precedence. A `--settings` payload is invisible
    to a hook, so whoever launches Claude with one (the live harness) also names it in
    DELEGATION_SETTINGS_EXTRA. That is the launcher's environment, which no agent can set.
    A file that exists but doesn't read as an object raises (dc.read_settings): main denies."""
    tiers = [
        ("user", dc.read_settings(os.path.join(dc.config_dir(home), "settings.json"))),
        ("user", dc.read_settings(os.path.join(dc.config_dir(home), "settings.local.json"))),
        ("project", dc.read_settings(os.path.join(project, ".claude", "settings.json"))),
        ("local", dc.read_settings(os.path.join(project, ".claude", "settings.local.json"))),
    ]
    extra = os.environ.get("DELEGATION_SETTINGS_EXTRA")
    if extra:
        tiers.append(("user", dc.read_settings(extra)))  # --settings ranks as a trusted tier
    tiers.append(("managed", dc.read_settings("/etc/claude-code/managed-settings.json")))
    return tiers


def sandbox_view(tiers):
    """The effective sandbox posture: scalars from the highest tier that sets them, lists
    unioned, excludedCommands from trusted tiers only (2.1.285 ignores project entries)."""
    view = {"enabled": None, "failIfUnavailable": None, "excludedCommands": [],
            "denyRead": [], "denyWrite": [], "allowWrite": []}
    for tier, s in tiers:
        sb = (s or {}).get("sandbox") or {}
        for key in ("enabled", "failIfUnavailable"):
            if key in sb:
                view[key] = sb[key]
        if tier in ("user", "managed"):
            view["excludedCommands"] += list(sb.get("excludedCommands") or [])
        fs = sb.get("filesystem") or {}
        for key in ("denyRead", "denyWrite", "allowWrite"):
            view[key] += list(fs.get(key) or [])
    return view


# ---------------------------------------------------------------- paths

def expand(p, home, tilde=True):
    p = str(p).replace("{uid}", str(os.getuid())).replace("{state_dir}", dc.state_dir(home))
    if tilde and (p == "~" or p.startswith("~/")):
        p = home + p[1:]
    return os.path.normpath(p)


def resolve(p, base):
    """Absolute, with symlinks resolved on the longest existing prefix, so a link through
    /tmp or the worktree into a protected directory still counts."""
    p = p if os.path.isabs(p) else os.path.join(base, p)
    p = os.path.normpath(p)
    head, tail = p, []
    while head and not os.path.exists(head) and head != os.path.dirname(head):
        head, t = os.path.dirname(head), os.path.basename(head)
        tail.insert(0, t)
    return os.path.normpath(os.path.join(os.path.realpath(head), *tail))


def under(p, root):
    return p == root or p.startswith(root.rstrip("/") + "/")


# ---------------------------------------------------------------- words

class Lit:
    """A shell word reduced to its static text. dynamic: it depends on an expansion the
    policy can't evaluate ($VAR, $(...), `...`). glob: unquoted *, ? or [ or a brace list.
    split: the word can become more than one argument or expand to an option at runtime (an
    unquoted expansion, which word-splits, or a glob/brace), so it is not one fixed argument;
    a quoted expansion ("$X") is dynamic but not split (always exactly one word)."""
    __slots__ = ("text", "dynamic", "glob", "split", "raw")

    def __init__(self, text, dynamic=False, glob=False, split=False, raw=None):
        self.text, self.dynamic, self.glob, self.split = text, dynamic, glob, split
        self.raw = text if raw is None else raw  # the word as written, quotes and all

    @property
    def static(self):
        return None if self.dynamic else self.text


def scan_word(value, home):
    """home None: the command sets HOME somewhere, so ~ and $HOME are unknown (dynamic)."""
    out, i, q, dyn, glob, split = [], 0, None, False, False, False
    n = len(value)
    prefix = value[1:].split("/", 1)[0] if value.startswith("~") else None
    if prefix == "":
        out.append(home if home is not None else "~")
        dyn = home is None
        i = 1
    elif prefix is not None and not re.search(r"[\"'\\$`]", prefix):
        # ~user, ~+, ~-, ~N: zsh reads ~name from a variable holding a path before it looks up
        # the user, and +, -, N are PWD, OLDPWD and the directory stack, so none is known.
        dyn = True
    while i < n:
        c = value[i]
        if q == "'":
            if c == "'":
                q = None
            else:
                out.append(c)
        else:
            if c == "\\" and i + 1 < n:
                out.append(value[i + 1])
                i += 2
                continue
            if q is None and c == "'":
                q = "'"
            elif c == '"':
                q = None if q == '"' else '"'
            elif c == "`":
                dyn = True
                if q is None:  # an unquoted `...` word-splits; inside "..." it does not
                    split = True
            elif c == "$":
                rest = value[i:]
                m = re.match(r"\$(\{HOME\}|HOME)(?![A-Za-z0-9_:\[])", rest)  # not $HOME:h
                if m and home is not None:
                    out.append(home)
                    i += len(m.group(0))
                    continue
                dyn = True
                if q is None:  # an unquoted $VAR/$(...) word-splits; inside "..." it does not
                    split = True
            elif q is None and c in "*?[{":
                glob = True
                split = True
                out.append(c)
            else:
                out.append(c)
        i += 1
    return Lit("".join(out), dyn, glob, split, value)


# ---------------------------------------------------------------- zsh expansions

# What zsh runs and Parable, a bash parser, can't see: parameter flags such as ${(e)x}, $~
# (GLOB_SUBST, which lets a value's glob qualifiers run code), and =(...) process substitution.
ZSH_FLAGS = re.compile(r"\$\{\(|\$~")
ZSH_PROCSUB = re.compile(r"=\(")


def unexpanded_spans(cmd):
    """The text of cmd that zsh (and bash) take literally, and the heredocs read on the way.

    Spans are (start, end, kind): "single" for a single-quoted string, "double" for a
    double-quoted one (where ${(..)} and $~ still expand but =(...) doesn't), "heredoc" for a
    quoted heredoc's body, "midword" for an = inside a word (zsh reads =(...) as process
    substitution only where the = opens a word, so an array assignment's x=( is literal). Heredocs are (delimiter, quoted, strip_tabs, content) as Parable
    reads them, so the caller can check that both parsers agree.

    The scan reads left to right and stops at anything it doesn't model: $'..', $"..", $(, ${,
    $[, a backtick, <(, >(, ((, an unclosed quote or heredoc, a continued line in an unquoted
    heredoc body, a delimiter that isn't plain text, a # right after an operator. Nothing after
    a stop counts as literal, and that is what makes the scan safe. Each quote character
    permutes the three quote states, so the scan can drift from zsh only through a construct it
    reads differently; an escaped quote (\\') can then bring the two back in step with a live
    stretch marked literal in between. So every construct is read exactly or stops the scan,
    and a # opens a comment only at a word start, as in both shells."""
    spans, heredocs, pending = [], [], []
    n, i = len(cmd), 0
    word_start = True  # False mid-word; None after an operator, where a # can't be placed
    while i < n:
        c, nxt = cmd[i], cmd[i + 1:i + 2]
        if c == "\\":
            if not nxt:
                break
            if nxt != "\n":  # a backslash-newline joins two lines and leaves word_start be
                word_start = False
            i += 2
        elif c == "'":
            j = cmd.find("'", i + 1)
            if j < 0:
                break
            spans.append((i + 1, j, "single"))
            i, word_start = j + 1, False
        elif c == '"':
            j = i + 1
            while j < n and cmd[j] != '"':
                if cmd[j] == "`" or (cmd[j] == "$" and cmd[j + 1:j + 2] in ("(", "{", "[")):
                    return spans, heredocs
                j += 2 if cmd[j] == "\\" else 1
            if j >= n:
                break
            spans.append((i + 1, j, "double"))
            i, word_start = j + 1, False
        elif (c == "`" or (c == "$" and nxt in ("'", '"', "(", "{", "["))
              or (c in "<>(" and nxt == "(")):
            break
        elif c == "#" and word_start is not False:
            if word_start is None:
                break
            j = cmd.find("\n", i)
            i = n if j < 0 else j  # the newline ends the comment and is read as one
        elif cmd.startswith("<<<", i):
            i, word_start = i + 3, None
        elif cmd.startswith("<<", i):
            op = _heredoc_operator(cmd, i)
            if op is None:
                break
            i, delim, quoted, strip = op
            pending.append((delim, quoted, strip))
            word_start = False
        elif c == "\n" and pending:
            i, word_start = i + 1, True
            for delim, quoted, strip in pending:
                body = _heredoc_body(cmd, i, delim, quoted, strip)
                if body is None:
                    return spans, heredocs
                end, content, after = body
                if quoted:
                    spans.append((i, end, "heredoc"))
                heredocs.append((delim, quoted, strip, content))
                i = after
            pending = []
        else:
            if c == "=" and nxt == "(" and word_start is False:
                spans.append((i, i + 1, "midword"))
            if c in " \t\n":
                word_start = True
            elif c in ";&|(){}<>":
                word_start = None
            else:
                word_start = False
            i += 1
    return spans, heredocs


def _heredoc_operator(cmd, i):
    """The heredoc operator at i (<< or <<-, then its delimiter word): (where the word ends, the
    delimiter with its quotes removed, whether any of it was quoted, whether tabs are stripped),
    or None for a delimiter the scan doesn't read: empty, or holding $, a backtick, a backslash
    or a newline once its quotes are gone."""
    n, j = len(cmd), i + 2
    strip = cmd.startswith("-", j)
    if strip:
        j += 1
    while j < n and cmd[j] in " \t":
        j += 1
    word, quoted = [], False
    while j < n and cmd[j] not in " \t\n;&|<>()":
        c = cmd[j]
        if c in "'\"":
            k = cmd.find(c, j + 1)
            if k < 0:
                return None
            word.append(cmd[j + 1:k])
            quoted, j = True, k + 1
        elif c == "\\" and j + 1 < n:
            word.append(cmd[j + 1])
            quoted, j = True, j + 2
        else:
            word.append(c)
            j += 1
    delim = "".join(word)
    if not delim or any(c in delim for c in "$`\\\n"):
        return None
    return j, delim, quoted, strip


def _heredoc_body(cmd, i, delim, quoted, strip):
    """The heredoc body starting at i: (where it ends, its content, where the line after its
    delimiter line starts), or None when no line matches the delimiter or an unquoted body
    continues a line with a backslash."""
    lines = []
    while i < len(cmd):
        k = cmd.find("\n", i)
        end = len(cmd) if k < 0 else k
        line = cmd[i:end]
        text = line.lstrip("\t") if strip else line
        if text == delim:
            return i, "".join(x + "\n" for x in lines), end + 1
        if not quoted and (len(line) - len(line.rstrip("\\"))) % 2:
            return None
        lines.append(text)
        i = end + 1
    return None


# ---------------------------------------------------------------- flags

def flag_hit(a, denied):
    """The flag in denied that the word a names, or None. A short flag (or a one-dash long one,
    like find's -exec) must match exactly; a long one matches exactly, with =value, or by any
    prefix, since getopt_long and git's parse-options take a unique prefix (`--no-veri` is
    --no-verify). A prefix that is ambiguous makes the program refuse it, so matching it anyway
    only denies a call that would fail. Use it for deny-lists only: an allow-list stays exact, so
    a prefix can add denials and never an allow."""
    if not a:
        return None
    if a in denied:
        return a
    name = a[2:].partition("=")[0] if a.startswith("--") else ""
    if not name:
        return None
    return next((f for f in denied if f.startswith("--") and f[2:].startswith(name)), None)


def any_flag(flags, denied):
    return any(flag_hit(a, denied) for a in flags)


# ---------------------------------------------------------------- substitutions

# Node fields that hold shell text Parable doesn't (always) expand into nodes, read by
# substitutions() in the mode named. Any other string field holding $, a backtick or <( is
# refused (unchecked-text), so a field Parable adds later can't pass unread.
TEXT_FIELDS = {"word": (("value", "word"),), "pattern": (("pattern", "word"),),
               "arith-cmd": (("raw_content", "inner"),),
               "for-arith": (("init", "inner"), ("cond", "inner"), ("incr", "inner"))}
LIVE_TEXT = re.compile(r"[$`]|[<>]\(")
# Assignments inside text: ${NAME=v} / ${NAME:=v}, and NAME = v, NAME += v, NAME++ ... in
# arithmetic (the name, whatever the operator; == and != compare).
PARAM_ASSIGN = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*)(?:\[[^]]*\])?:{0,2}=")  # zsh: ::=
PARAM_INDIRECT_ASSIGN = re.compile(r"\$\{![A-Za-z_][A-Za-z0-9_]*(?:\[[^]]*\])?:{0,2}=")
ARITH_ASSIGN = re.compile(r"([A-Za-z_][A-Za-z0-9_]*)\s*(?:(?:[-+*/%&|^]|<<|>>|\*\*)?=(?!=)|\+\+|--)"
                          r"|(?:\+\+|--)\s*([A-Za-z_][A-Za-z0-9_]*)")


def substitutions(text, mode="word"):
    """The body of every command substitution in text that the shell would run: $(...), `...`,
    <(...) and >(...), with those inside ${...}, $((...)) and $[...] found by scanning that text
    too. The caller also checks the substitutions Parable parsed; this reading covers the text
    Parable keeps unparsed. Each one ends where Parable's matching helpers end it, or later
    where the shell reads further.

    mode: "word" (quotes quote, as in a word), "heredoc" (an unquoted heredoc body: quotes are
    text, and <( is text) or "inner" (the inside of ${...} or arithmetic, read with quotes as
    text, so a quoted $( counts as live: it checks more, never less). A backslash escapes the
    next character in every mode. Raises ValueError for an opener with no close."""
    from parable import (_find_braced_param_end, _find_cmdsub_end, _is_valid_arithmetic_start,
                         _skip_backtick, _skip_single_quoted)
    quotes = mode == "word"
    # In inner mode the text is already bounded (the inside of a ${...} or arithmetic), so an
    # opener with no close is a quoted or partial fragment, not a live substitution: skip it
    # rather than refuse. Only top-level text (word, heredoc) refuses an unclosed opener.
    strict = mode != "inner"
    out, i, n, dq = [], 0, len(text), False

    def closed(j, close):
        if j <= n and text[:j].endswith(close):
            return j
        if strict:
            raise ValueError(text[i:])
        return None
    while i < n:
        c, nxt = text[i], text[i + 1:i + 2]
        if c == "\\" or (c == "$" and nxt == "$"):
            i += 2  # an escape, or $$ (the pid), which a ' after it can't join
        elif quotes and c == "$" and nxt == "'" and not dq:
            i = closed(_ansi_c_end(text, i + 2), "'")  # $'...' honours backslash escapes
        elif quotes and c == "'" and not dq:
            start, i = i, _skip_single_quoted(text, i + 1)
            if i > n or i - 1 <= start or text[i - 1] != "'":
                raise ValueError(text)
        elif quotes and c == '"':
            dq, i = not dq, i + 1
        elif c == "`":
            j = closed(_skip_backtick(text, i), "`")
            if j is None or j - 1 <= i:
                if strict and j is not None:
                    raise ValueError(text[i:])
                i += 1
                continue
            # inside "...", the shell also drops the backslash before a "
            out.append(re.sub(r'\\([$`\\"])' if dq else r"\\([$`\\])", r"\1", text[i + 1:j - 1]))
            i = j
        elif c == "$" and text.startswith("$((", i) and _is_valid_arithmetic_start(text, i):
            j = closed(_find_cmdsub_end(text, i + 2), "))")
            if j is None:
                i += 1
                continue
            out += substitutions(text[i + 3:j - 2], "inner")
            i = j
        elif nxt == "(" and (c == "$" or (c in "<>" and not dq and mode != "heredoc")):
            j = closed(_find_cmdsub_end(text, i + 2), ")")
            if j is None:
                i += 1
                continue
            out.append(text[i + 2:j - 1])
            i = j
        elif c == "$" and nxt == "{":
            # The shell may honour '...' inside and end later than Parable's helper; reading on
            # to the later end only checks more.
            e1, e2 = closed(_find_braced_param_end(text, i + 2), "}"), \
                closed(_param_end(text, i + 2), "}")
            j = max(e1 or 0, e2 or 0)
            if not j:
                i += 1
                continue
            out += substitutions(text[i + 2:j - 1], "inner")
            i = j
        elif c == "$" and nxt == "[":
            out += substitutions(text[i + 2:], "inner")  # rare and deprecated: the rest
            break
        else:
            i += 1
    return out


def _ansi_c_end(text, i):
    """Past the ' closing a $'...' whose body starts at i; len+1 when there is none."""
    while i < len(text):
        if text[i] == "\\":
            i += 2
        elif text[i] == "'":
            return i + 1
        else:
            i += 1
    return len(text) + 1


def _param_end(text, i):
    """Past the } closing a ${ whose body starts at i, reading '...' as quoted throughout (as
    the shell does in an unquoted ${X:-word}); len+1 when there is none."""
    from parable import _find_cmdsub_end, _skip_backtick, _skip_double_quoted
    depth = 1
    while i < len(text):
        c = text[i]
        if c == "\\" or text.startswith("$$", i):
            i += 2
        elif text.startswith("$'", i):
            i = _ansi_c_end(text, i + 2)
        elif c == "'":
            j = text.find("'", i + 1)
            if j < 0:
                return len(text) + 1
            i = j + 1
        elif c == '"':
            i = _skip_double_quoted(text, i + 1)
        elif c == "`":
            i = _skip_backtick(text, i)
        elif text.startswith("$(", i):
            i = _find_cmdsub_end(text, i + 2)
        elif text.startswith("${", i):
            i = _param_end(text, i + 2)
        else:
            depth += (c == "{") - (c == "}")
            i += 1
            if depth == 0:
                return i
    return len(text) + 1


# ---------------------------------------------------------------- sed

class SedError(Exception):
    """A sed call or script GNU sed would refuse, or one whose script the policy can't see."""


# GNU sed 4.9's options (sed/sed.c: SHORTOPTS and longopts). A short option takes no value (0),
# one (1: the rest of its cluster, else the next word) or an optional one (2: the rest of its
# cluster). A long option names the short option it stands for ("" for one with neither a short
# form nor a value), and getopt_long takes any unique prefix of its name.
SED_SHORT = {**dict.fromkeys("bsnrzuE", 0), **dict.fromkeys("eflV", 1), "i": 2}
SED_LONG = {"binary": "b", "regexp-extended": "r", "debug": "", "expression": "e", "file": "f",
            "in-place": "i", "line-length": "l", "null-data": "z", "zero-terminated": "z",
            "quiet": "n", "posix": "", "silent": "n", "sandbox": "sandbox", "separate": "s",
            "unbuffered": "u", "version": "", "help": "", "follow-symlinks": "F"}


class SedCall:
    """A sed command line read as GNU getopt_long reads it, permuting, so an option may follow an
    operand. scripts: each -e script, else the first operand. candidates: also the first operand
    when an -e follows it, since with POSIXLY_CORRECT set getopt stops there and sed takes it as the
    script. files: the input files. in_place: the -i suffix ("" for none), or None without -i.
    follow: --follow-symlinks. sandbox: --sandbox is present (sed then refuses every e, r and w).
    has_dynamic / has_glob: a $var (None) or an unquoted glob/brace is among the arguments.
    bad_dynamic: a word sits before -- where sed could read it as an option (even a bare -i, which
    --sandbox does not disable) or as a script: a dynamic or glob free-standing operand (its value
    could be -i, or a glob/brace could expand to one), or a split -e value (an unquoted or glob
    value word-splits, so its tail becomes a separate option). A quoted single-word -e value, and
    anything after --, are safe. splits: per word, whether it can word-split or expand (Lit.split);
    without it, every dynamic or glob word is treated as split (fail-closed)."""

    def __init__(self, args, globs=None, splits=None):
        globs = globs if globs is not None else [False] * len(args)
        splits = splits if splits is not None else [a is None or g for a, g in zip(args, globs)]
        self.scripts, self.candidates, self.in_place, self.follow = [], [], None, False
        self.sandbox = False
        self.has_dynamic = any(a is None for a in args[1:])
        self.has_glob = any(bool(g) for g in globs[1:])
        self.bad_dynamic = False
        operands, e_after_operand = [], False
        words = list(zip(args[1:], globs[1:], splits[1:]))
        while words:
            a, g, _ = words.pop(0)
            if a == "--":
                operands += [w for w, _, _ in words]  # after -- every word is a file, even -i
                break
            if a is None or a == "-" or not a.startswith("-"):
                if a is None or g:
                    self.bad_dynamic = True  # a dynamic/glob operand before --: could be -i
                operands.append(a)
                continue
            for opt, value, vsplit in self._options(a, words):
                if vsplit:
                    # a split separate-word option value (an unquoted expansion or a glob) word-
                    # splits at runtime, so its tail becomes a separate option like -i, which
                    # --sandbox does not disable; this covers -e, -l and every value-taking option
                    self.bad_dynamic = True
                if opt == "f":
                    raise SedError("sed -f runs a script file the policy can't read; pass the "
                                   "script with -e")
                if opt == "e":
                    self.scripts.append(value)  # a None value here is a dynamic -e script
                    e_after_operand = e_after_operand or bool(operands)
                elif opt == "i":
                    self.in_place = value or ""
                elif opt == "F":
                    self.follow = True
                elif opt == "sandbox":
                    self.sandbox = True
        if self.scripts:
            if e_after_operand and operands and operands[0] is not None:
                self.candidates.append(operands[0])
            self.files = operands
        else:
            self.scripts, self.files = operands[:1], operands[1:]

    @staticmethod
    def _options(a, words):
        """The (option, value, value_split) triples in the option word a, taking a value from
        words if one is due. value_split is True when a value taken from a separate word can
        word-split or expand (a value attached in a has already been read as one word)."""
        if a.startswith("--"):
            name, eq, value = a[2:].partition("=")
            hits = [name] if name in SED_LONG else [k for k in SED_LONG if k.startswith(name)]
            if len(hits) != 1:
                raise SedError(f"sed would refuse {a} (an unknown or ambiguous option)")
            opt = SED_LONG[hits[0]]
            takes = SED_SHORT.get(opt, 0)
            if eq and not takes:
                raise SedError(f"sed would refuse {a} (the option takes no value)")
            vsplit = False
            if takes == 1 and not eq:
                if not words:
                    raise SedError(f"sed would refuse {a} (it needs a value)")
                value, _, vsplit = words.pop(0)
            return [(opt, value, vsplit)]
        out = []
        for k, c in enumerate(a[1:], 2):
            takes = SED_SHORT.get(c)
            if takes is None:
                raise SedError(f"sed would refuse -{c} (an unknown option)")
            if not takes:
                out.append((c, None, False))
                continue
            value, vsplit = a[k:], False
            if takes == 1 and not value:
                if not words:
                    raise SedError(f"sed would refuse -{c} (it needs a value)")
                value, _, vsplit = words.pop(0)
            out.append((c, value, vsplit))
            break
        return out


def sed_backups(files, suffix, cwd, follow):
    """Where sed -i<suffix> moves each file (execute.c, get_backup_file_name): the suffix with
    every * replaced by the file's name as given, or the name plus the suffix when it has no *.
    With --follow-symlinks sed backs up the link's target."""
    if suffix in ("", "*"):
        return []
    ext = suffix if "*" in suffix else "*" + suffix
    out = []
    for f in files:
        if f is not None:
            names = [f, os.path.realpath(os.path.join(cwd, f))] if follow else [f]
            out += [ext.replace("*", name) for name in names]
    return out


def sed_ops(*scripts):
    """The e, r and w uses in a sed script given as its -e parts in order, read the way GNU sed
    4.9 compiles them: a list of (op, arg). op is "e" for the e command or the s///e flag, "r"
    for r and R, "w" for w, W and the s///w flag, whose arg is the file name (the rest of the
    line, as sed reads it). sed compiles each part on its own, except that an a, i or c text
    ending in a backslash runs on into the next part. A None part (dynamic) is skipped, and the
    part after it read from a command start, where the most is a command. Raises SedError where
    sed refuses the script's shape."""
    ops, pending = [], False
    for script in scripts:
        if script is None:
            pending = False
            continue
        part = _SedScript(script)
        ops += part.compile(pending)
        pending = part.pending
    return ops


class _SedScript:
    """GNU sed 4.9's sed/compile.c over one script, function by function under the same names:
    where it reads a pattern, a replacement, a text, a label or a file name, and where the next
    command starts. Its error checks that don't move those boundaries are left out: a script
    sed refuses runs none of its commands (except that it opens a w file as it compiles the
    command, before a later error)."""

    def __init__(self, text):
        self.s, self.i, self.ops, self.pending = text, 0, [], False

    def inchar(self):
        if self.i >= len(self.s):
            return None  # EOF
        self.i += 1
        return self.s[self.i - 1]

    def savchar(self, ch):
        if ch is not None:
            self.i -= 1

    def in_nonblank(self):
        ch = self.inchar()
        while ch in (" ", "\t"):
            ch = self.inchar()
        return ch

    @staticmethod
    def is_digit(ch):
        return ch is not None and ch in "0123456789"

    def in_integer(self, ch):
        num = 0
        while self.is_digit(ch):
            num = num * 10 + int(ch)
            ch = self.inchar()
        self.savchar(ch)
        return num

    def read_end_of_cmd(self):
        ch = self.in_nonblank()
        if ch in ("}", "#"):
            self.savchar(ch)
        elif ch not in (None, "\n", ";"):
            raise SedError("extra characters after command")

    def read_filename(self):
        ch, name = self.in_nonblank(), []
        while ch not in (None, "\n"):
            name.append(ch)
            ch = self.inchar()
        if not name:
            raise SedError("missing filename for r/R/w/W commands")
        return "".join(name)

    def read_label(self):
        ch, label = self.in_nonblank(), []
        while ch not in (None, "\n", " ", "\t", ";", "}", "#"):
            label.append(ch)
            ch = self.inchar()
        self.savchar(ch)
        return "".join(label)

    def read_text(self, ch):
        """read_text_to_slash and read_text: past the text of a, i, c or e, whose first
        non-blank character is ch, to the first newline no backslash escapes."""
        if ch is None:
            raise SedError("expected \\ after a, c or i")
        if ch == "\\":
            if self.inchar() is None:
                self.pending = True
                return
        else:
            self.savchar(ch)
        self.read_text_rest()

    def read_text_rest(self):
        """The rest of a text, to the first newline no backslash escapes. A backslash at the
        end leaves it pending: the next -e part goes on with it."""
        while True:
            ch = self.inchar()
            if ch in (None, "\n"):
                return
            if ch == "\\" and self.inchar() is None:
                self.pending = True
                return

    def snarf_char_class(self):
        """Past a bracket expression, from just after its [: the ] that closes it, or the
        newline or EOF that stops it."""
        ch = self.inchar()
        if ch == "^":
            ch = self.inchar()
        if ch == "]":
            ch = self.inchar()
        state, delim = 0, None  # 1 after a [, 2 inside [. [: or [=, 3 after its closing . : =
        while ch not in (None, "\n"):
            if ch in ".:=" and (state == 1 or (state == 2 and ch == delim)):
                if state == 1:
                    delim = ch
                state += 1
            elif ch == "[":
                state = state or 1
            elif ch == "]" and state < 2:
                return ch
            else:
                if ch == "]" and state == 3:
                    state = 0
                state &= ~1
            ch = self.inchar()
        return ch

    def match_slash(self, slash, regex):
        """Past one part of an s or y command or of an address, up to slash: False when a
        newline or the end comes first. Only a regex part reads bracket expressions."""
        while True:
            ch = self.inchar()
            if ch in (None, "\n"):
                return False
            if ch == slash:
                return True
            if ch == "\\":
                if self.inchar() is None:
                    return False
            elif ch == "[" and regex and self.snarf_char_class() != "]":
                return False

    def delimiter(self):
        """An s, y or \\c address delimiter. sed reads a multibyte one by locale; refused."""
        slash = self.inchar()
        if slash is not None and not slash.isascii():
            raise SedError("a delimiter outside ASCII")
        return slash

    def mark_subst_opts(self):
        seen = set()
        while True:
            ch = self.in_nonblank()
            if ch is not None and ch in "iImMe":
                if ch == "e":
                    self.ops.append(("e", None))
            elif ch in ("p", "g"):
                if ch in seen:
                    raise SedError(f"multiple `{ch}' options to `s' command")
                seen.add(ch)
            elif ch == "w":
                self.ops.append(("w", self.read_filename()))
                return
            elif self.is_digit(ch):
                if "n" in seen or not self.in_integer(ch):
                    raise SedError("a bad number option to `s' command")
                seen.add("n")
            elif ch in ("}", "#"):
                self.savchar(ch)
                return
            elif ch in (None, "\n", ";") or (ch == "\r" and self.inchar() == "\n"):
                return
            else:
                raise SedError("unknown option to `s'")

    def compile_address(self, ch):
        """The address starting at ch, as (kind, line number), or None, having read nothing,
        when ch starts none."""
        if ch in ("/", "\\"):
            if ch == "\\":
                ch = self.delimiter()
            if not self.match_slash(ch, True):
                raise SedError("unterminated address regex")
            ch = self.in_nonblank()
            while ch in ("I", "M"):
                ch = self.in_nonblank()
            self.savchar(ch)
            return "regex", None
        if self.is_digit(ch):
            num = self.in_integer(ch)
            ch = self.in_nonblank()
            if ch != "~":
                self.savchar(ch)
                return "num", num
            return ("num_mod" if self.in_integer(self.in_nonblank()) else "num"), num
        if ch in ("+", "~"):
            return ("step" if self.in_integer(self.in_nonblank()) else "null"), None
        if ch == "$":
            return "last", None
        return None

    def compile(self, pending=False):
        """compile_program: every command, then the e, r and w uses found. pending: this part
        starts inside the text the part before it left pending."""
        if pending:
            self.read_text_rest()
        while True:
            ch = self.inchar()
            while ch == ";" or (ch is not None and ch in " \t\n\v\f\r"):
                ch = self.inchar()
            if ch is None:
                break
            a1, a2 = self.compile_address(ch), None
            if a1:
                if a1[0] == "step":
                    raise SedError("invalid usage of +N or ~N as first address")
                ch = self.in_nonblank()
                if ch == ",":
                    a2 = self.compile_address(self.in_nonblank())
                    if not a2:
                        raise SedError("unexpected `,'")
                    ch = self.in_nonblank()
                if a1 == ("num", 0) and (a2[0] != "regex" if a2 else ch != "r"):
                    raise SedError("invalid usage of line address 0")
            if ch == "!":
                ch = self.in_nonblank()
                if ch == "!":
                    raise SedError("multiple `!'s")
            if ch is None:
                raise SedError("missing command")
            if ch == "#":
                if a1:
                    raise SedError("comments don't accept any addresses")
                while ch not in (None, "\n"):
                    ch = self.inchar()
            elif ch == "v":
                self.read_label()
            elif ch == "{":
                pass
            elif ch == "}":
                if a1:
                    raise SedError("unexpected `}'")
                self.read_end_of_cmd()
            elif ch == "e":
                self.ops.append(("e", None))
                ch = self.in_nonblank()
                if ch not in (None, "\n"):
                    self.read_text(ch)
            elif ch in "aic":
                self.read_text(self.in_nonblank())
            elif ch == ":":
                if a1 or not self.read_label():
                    raise SedError("a `:' label with an address or no name")
            elif ch in "Tbt":
                self.read_label()
            elif ch in "QqLl":
                if ch in "Qq" and a2:
                    raise SedError("command only uses one address")
                ch = self.in_nonblank()
                if self.is_digit(ch):
                    self.in_integer(ch)
                else:
                    self.savchar(ch)
                self.read_end_of_cmd()
            elif ch in "=dDFgGhHnNpPzx":
                self.read_end_of_cmd()
            elif ch in "rRwW":
                self.ops.append(("r" if ch in "rR" else "w", self.read_filename()))
            elif ch == "s":
                slash = self.delimiter()
                if not (self.match_slash(slash, True) and self.match_slash(slash, False)):
                    raise SedError("unterminated `s' command")
                self.mark_subst_opts()
            elif ch == "y":
                slash = self.delimiter()
                if not (self.match_slash(slash, False) and self.match_slash(slash, False)):
                    raise SedError("unterminated `y' command")
                self.read_end_of_cmd()
            else:
                raise SedError(f"unknown command: `{ch}'")
        return self.ops


# ---------------------------------------------------------------- the analyzer

class Analyzer:
    def __init__(self, data, policy, home=None):
        self.data = data
        self.p = policy
        self.home = home or os.path.expanduser("~")
        self.meta = dc.agent_meta(data, strict=True)
        self.agent_type = dc.agent_role(data, self.meta)
        self.cwd = os.path.realpath(data.get("cwd") or os.getcwd())
        self.worktree = self._worktree()
        # The outermost checkout, not the innermost: with nested worktrees it holds both the
        # lead's worktree and the real main checkout, and it is the area escapes are denied in
        # (with a lane-rooted parent's own checkout: protected_roots).
        self.main_root = (self.worktree.split("/.claude/worktrees/", 1)[0]
                          if self.worktree else None)
        self.project = self.main_root or self._project_dir()
        self.root = self.worktree or self.project
        self.sandbox = sandbox_view(settings_tiers(self.project, self.home))
        self.temp_roots = [expand(t, self.home) for t in self.p["rm"]["temp_roots"]]
        self.allow_write = [expand(a, self.home) for a in self.sandbox["allowWrite"]]
        self.is_researcher = self.agent_type in self.p["roles"]["allowlisted_shell"]
        self.is_writer = self.agent_type in self.p["roles"]["worktree_root"]
        # Any isolated agent (a writer, or any type spawned with isolation "worktree") is held
        # to its worktree; a writer without one is refused outright (decide()).
        self.confined = self.worktree is not None
        self.home_assigned = False  # the command sets HOME (check_env_name)
        self.word_home = self.home  # what ~ and $HOME read as in words; None once HOME is set
        self._parent_root = False  # looked up on first need (protected_roots)
        self.path_dirs = self._path_dirs()

    # ------------------------------------------------ context

    def _worktree(self):
        """The worktree root of an isolated agent: meta.json's worktreePath, else a cwd
        under .claude/worktrees/. A writer with neither is refused (it would otherwise be
        policed as if the whole checkout were its root)."""
        wt = self.meta.get("worktreePath")
        if wt:
            return os.path.realpath(wt)
        if "/.claude/worktrees/" in self.cwd + "/":
            # The innermost one: a lead session in a worktree nests its agents' worktrees.
            head, tail = self.cwd.rsplit("/.claude/worktrees/", 1)
            return head + "/.claude/worktrees/" + tail.split("/")[0]
        return None

    def _project_dir(self):
        """The session's project directory. The hook's cwd follows the agent's `cd`, so it
        can be a subdirectory; the transcript lives under <config dir>/projects/<slug>/, where
        the slug is the project path with every non-alphanumeric character turned into `-`.
        The nearest ancestor of cwd with that slug is the project; failing that, cwd."""
        tp = self.data.get("transcript_path") or ""
        slug = os.path.basename(os.path.dirname(tp)) if tp else ""
        d = self.cwd
        while slug:
            if re.sub(r"[^A-Za-z0-9]", "-", d) == slug:
                return d
            if d == os.path.dirname(d):
                break
            d = os.path.dirname(d)
        return self.cwd

    def _path_dirs(self):
        dirs = os.environ.get("PATH", "").split(":")
        snap_dir = os.path.join(dc.config_dir(self.home), "shell-snapshots")
        snaps = sorted((os.path.join(snap_dir, f) for f in os.listdir(snap_dir)),
                       key=os.path.getmtime) if os.path.isdir(snap_dir) else []
        if snaps:
            try:
                with open(snaps[-1], errors="replace") as f:
                    for line in f:
                        m = re.match(r"^export PATH='([^']*)'", line)
                        if m:
                            dirs += m.group(1).split(":")
            except OSError:
                pass
        return [d for d in dict.fromkeys(dirs) if d]

    def deny(self, rule, intent, message, footer=None):
        raise Deny(rule, intent, message, footer)

    # ------------------------------------------------ entry

    def decide(self):
        tool = self.data.get("tool_name") or ""
        self.deadline(tool)
        ti = self.data.get("tool_input")
        if not isinstance(ti, dict):
            if policed(tool):
                self.deny("malformed-input", "stop_and_explain", "hook input has no tool_input")
            return
        if self.is_writer and not self.worktree and policed(tool):  # never a handback
            self.deny("worktree-root", "stop_and_explain",
                      "this writer has no worktree (no worktreePath in its meta.json and its cwd "
                      "is not under .claude/worktrees/), so its root can't be enforced")
        if tool in SHELL_TOOLS:
            self.shell_tool(ti)
        elif tool in WRITE_TOOLS:
            path = ti.get("file_path") or ti.get("notebook_path")
            if not path:
                self.deny("malformed-input", "stop_and_explain", f"{tool} call with no path")
            self.file_write(str(path))
        elif tool in READ_TOOLS:
            self.file_read(tool, ti)
        elif tool.startswith("mcp__"):
            if not any(fnmatch.fnmatchcase(tool, g) for g in self.p["mcp"]["read_tools"]):
                self.deny("mcp-write", "manual_only",
                          f"{tool} is not on the read-only MCP list (policy.toml [mcp])")

    def deadline(self, tool):
        """Past the role's stop budget for this activation, deny every tool but [deadline]
        allow, policed or not: a web-looping agent must stop too. Fails open: an unreadable
        index, or any error here but the alarm's (PolicyTimeout), means no deadline rather than
        a policy-error."""
        allow = self.p["deadline"]["allow"]
        if tool in allow:
            return
        try:
            age = dc.activation_age(dc.read_agent_state(dc.norm_id(self.data.get("agent_id"))),
                                    time.time())
            _, stop_s = dc.deadline_for(self.p, self.agent_type)
        except PolicyTimeout:
            raise
        except Exception:  # noqa: BLE001  no clock, no deadline
            return
        if age is not None and age >= stop_s:
            self.deny("deadline", "stop_and_explain",
                      f"this activation has run {dc.minutes_text(age)} min, past the "
                      f"{dc.minutes_text(stop_s)} min stop for {self.agent_type}",
                      footer=f"Only {dc.tool_list(allow)} are allowed now. Hand back a `partial` "
                             "report naming what is done and what is left. If the lead resumes "
                             "you, the budget starts over and every tool works again.")

    # ------------------------------------------------ file tools

    def read_denied(self):
        return [expand(x, self.home) for x in
                self.p["protect"]["read_denied"] + self.sandbox["denyRead"]]

    def check_read_path(self, path):
        p = resolve(expand(path, self.home), self.cwd)
        for d in self.read_denied():
            if under(p, d) or under(p, resolve(d, "/")):
                self.deny("credential-read", "hard_stop",
                          f"{path} is a credential path; delegated agents never read it")

    def check_search_root(self, path):
        """Grep reads every file below its root, hidden ones included, so a root above an
        existing credential path would read it. Glob only lists names, so it is not checked."""
        p = resolve(expand(path, self.home), self.cwd)
        for d in self.read_denied():
            for c in (d, resolve(d, "/")):
                if under(c, p) and os.path.lexists(c):
                    self.deny("credential-search", "scope_down",
                              f"Grep over {path} would read {c}, a credential path; "
                              "search a narrower directory")

    def file_read(self, tool, ti):
        for key in ("file_path", "path", "notebook_path"):
            if ti.get(key):
                self.check_read_path(str(ti[key]))
        pat = ti.get("pattern")
        if isinstance(pat, str) and (pat.startswith("/") or pat.startswith("~")):
            prefix = re.split(r"[*?\[{]", pat, 1)[0]
            self.check_read_path(prefix or "/")
        if tool == "Grep":
            self.check_search_root(str(ti.get("path") or self.cwd))

    def protected(self, p):
        for x in self.p["protect"]["write_denied"] + self.sandbox["denyWrite"]:
            d = expand(x, self.home)
            if under(p, d) or under(p, resolve(d, "/")):
                return x
        for x in self.p["protect"]["root_write_denied"]:
            d = os.path.join(self.root, x)
            if under(p, d) and not any(under(p, os.path.join(self.root, y))
                                       for y in self.p["protect"]["root_write_allowed"]):
                return x
        return None

    def in_temp(self, p):
        return any(under(p, t) for t in self.temp_roots)

    def protected_roots(self):
        """(root, name) of the checkouts a confined agent's Bash writes are held out of: the
        main checkout, and the parent session's own checkout when it lies outside that. A
        lane-rooted session is the case: its writers' worktrees land under the main checkout,
        while the sandbox's write root is the lane. Finding the lane costs a git call, so it is
        looked up once, and only for a target outside the worktree and temp. When the lookup
        misses, only the main checkout is held."""
        if self._parent_root is False:
            top = dc.session_toplevel(self.data.get("session_id"), self.home)
            self._parent_root = (top if top and not under(top, self.root)
                                 and not under(top, self.main_root) else None)
        roots = [(self.main_root, "the main checkout")]
        if self._parent_root:
            roots.append((self._parent_root, "the parent session's checkout"))
        return roots

    def check_write_path(self, path, base, strict_root=False, tilde=True):
        """A literal write target. strict_root: the file tools, where a writer may only
        touch its worktree and temp; Bash targets are held to the worktree only inside the
        main checkout and the parent session's checkout (the sandbox already stops the rest).
        tilde=False for sed's own write targets: sed reads a ~ in a w name or -i suffix
        literally, where the shell would have expanded one it meant as $HOME."""
        p = resolve(expand(path, self.home, tilde=tilde), base)
        hit = self.protected(p)
        if hit:
            self.deny("protected-path", "hard_stop",
                      f"{path} is protected ({hit}): delegated agents never write Claude Code, "
                      "shell, git or enforcement config")
        if not self.confined or under(p, self.root) or self.in_temp(p):
            return
        if strict_root:
            self.deny("worktree-root", "scope_down",
                      f"{path} is outside your worktree ({self.root}); write only inside it")
        for root, name in self.protected_roots():
            if under(p, root):
                self.deny("worktree-root", "scope_down",
                          f"{path} is in {name} ({root}), outside your worktree ({self.root}); "
                          "write only inside it")

    def file_write(self, path):
        self.check_write_path(path, self.cwd, strict_root=True)

    # ------------------------------------------------ shell tools

    def shell_tool(self, ti):
        for k, v in ti.items():
            if re.search("sandbox", str(k), re.I) and v:
                self.deny("sandbox-escape", "hard_stop",
                          f"{k} is set; delegated agents never run outside the sandbox")
        sb = self.sandbox
        if not (sb["enabled"] is True and sb["failIfUnavailable"] is True):
            self.deny("sandbox-off", "stop_and_explain",
                      "the sandbox is not enforced for this session (sandbox.enabled and "
                      "sandbox.failIfUnavailable must both be true), so delegated agents get no "
                      "shell here")
        cmd = ti.get("command")
        if not isinstance(cmd, str):
            self.deny("malformed-input", "stop_and_explain", "shell call with no command")
        self.analyze_string(cmd, self.cwd, 0)
        if self.home_assigned and self.word_home is not None:
            # HOME is set somewhere in this command, so ~ and $HOME may not be the real home
            # anywhere in it (a loop can set it before an earlier line runs again): check the
            # whole command again with both unknown.
            self.word_home = None
            self.analyze_string(cmd, self.cwd, 0)

    def analyze_string(self, cmd, cwd, depth):
        from parable import parse, ParseError
        if len(cmd.encode()) > self.p["shell"]["max_command_bytes"]:
            self.deny("too-long", "stop_and_explain", "command too long to check")
        if depth > self.p["shell"]["max_depth"]:
            self.deny("too-deep", "stop_and_explain", "commands nested too deeply to check")
        banned = [x for x in self.p["shell"]["banned_env_names"] if x in cmd]  # even mid-word
        if banned:
            self.deny("env-banned", "use_alternative",
                      f"{banned[0]} is a variable delegated agents never use, in any form; "
                      "run the command without it")
        try:
            nodes, error = parse(cmd), None
        except ParseError as e:
            nodes, error = None, e
        if self.zsh_expansion(cmd, nodes):
            self.deny("zsh-expansion", "stop_and_explain",
                      "zsh expansion flags or =(...) can run code the policy can't see; text "
                      "meant literally goes in single quotes or a quoted heredoc (<<'EOF')")
        if error is not None:
            self.deny("parse-error", "stop_and_explain",
                      f"the command doesn't parse as bash ({error.message}); zsh-only syntax "
                      "such as glob qualifiers is not allowed")
        for n in nodes:
            cwd = self.node(n, cwd, depth)

    def zsh_expansion(self, cmd, nodes):
        """Whether cmd holds a zsh expansion Parable can't see (ZSH_FLAGS, ZSH_PROCSUB) outside
        the text zsh takes literally. That text (unexpanded_spans) counts only when Parable
        parsed cmd and read the scan's heredocs the same way: two readings must agree before
        this deny rule lets anything through."""
        joined = cmd.replace("\\\n", "")
        if not (ZSH_FLAGS.search(joined) or ZSH_PROCSUB.search(joined)):
            return False
        spans, heredocs = unexpanded_spans(cmd) if nodes is not None else ([], [])
        parsed = [(h.delimiter, h.quoted, h.strip_tabs, h.content) for h in self.heredocs(nodes)]
        if parsed[:len(heredocs)] != heredocs:
            spans = []

        def live(kinds):
            text = list(cmd)
            for a, b, kind in spans:
                if kind in kinds:
                    text[a:b] = " " * (b - a)
            # zsh joins a backslash-newline anywhere outside single quotes, even inside $~;
            # joining only ever adds a match
            return "".join(text).replace("\\\n", "")
        return bool(ZSH_FLAGS.search(live(("single", "heredoc")))
                    or ZSH_PROCSUB.search(live(("single", "double", "heredoc", "midword"))))

    def heredocs(self, nodes):
        """Every heredoc in Parable's tree, in source order."""
        out, todo = [], list(nodes or [])
        while todo:
            n = todo.pop()
            if getattr(n, "kind", "") == "heredoc":
                out.append(n)
            todo.extend(self.children(n))
        return sorted(out, key=lambda h: h._start_pos)

    def children(self, n):
        for v in vars(n).values():
            if isinstance(v, list):
                for x in v:
                    if hasattr(x, "kind"):
                        yield x
            elif hasattr(v, "kind"):
                yield v

    def node(self, n, cwd, depth):
        kind = getattr(n, "kind", "")
        if kind == "command":
            return self.command(n, cwd, depth)
        if kind == "list":
            for part in n.parts:
                if getattr(part, "kind", "") != "operator":
                    cwd = self.node(part, cwd, depth)
            return cwd
        if kind in ("cmdsub", "procsub"):
            if depth > self.p["shell"]["max_depth"]:
                self.deny("too-deep", "stop_and_explain", "commands nested too deeply to check")
            inner = getattr(n, "command", None)
            if inner is not None:
                self.node(inner, cwd, depth + 1)
            return cwd
        if kind == "heredoc":
            if not n.quoted:  # an unquoted body expands $(...) and `...`; quotes are literal
                self.shell_text(n.content, "heredoc", cwd, depth)
            return cwd
        if kind == "redirect":
            self.redirect(n, cwd)  # then on to its target word
        if kind in ("for", "select"):
            self.check_env_name(n.var)
        if kind in ("arith-cmd", "for-arith"):
            for v in vars(n).values():
                if isinstance(v, str):
                    for m in ARITH_ASSIGN.finditer(v):
                        self.check_env_name(m.group(1) or m.group(2))
        fields = dict(TEXT_FIELDS.get(kind, ()))
        for f, v in vars(n).items():
            if f in fields:
                self.shell_text(v or "", fields[f], cwd, depth)
            elif isinstance(v, str) and f != "kind" and LIVE_TEXT.search(v):
                self.deny("unchecked-text", "stop_and_explain",
                          f"the parser left shell text in a {kind} that the policy can't check; "
                          "write the command more plainly")
        if kind in ("word", "arith-cmd"):
            # Also check every substitution Parable parsed beneath it. A body that either reading
            # finds is checked, so the two must both miss one. The rest beneath is the same text
            # shell_text just read.
            for sub in self.parsed_substitutions(n):
                self.node(sub, cwd, depth + 1)
            return cwd
        start = cwd
        for c in self.children(n):
            cwd = self.node(c, cwd, depth)
        return start if kind in ("subshell", "pipeline") else cwd

    def redirect(self, r, cwd):
        op = getattr(r, "op", "") or ""
        target = getattr(r, "target", None)
        if ">" not in op or target is None or not hasattr(target, "value"):
            return
        lit = scan_word(target.value, self.word_home)
        if re.fullmatch(r"&(\d+|-)", target.value.strip()):
            return  # 2>&1, >&2, >&-: Parable keeps a duplication's target as "&N"
        # Everything else writes its target, `>& file` and `&>` included (zsh sends both
        # streams there), and so does an all-digit name (`1> 123` writes a file named 123).
        allowed = self.p["researcher"]["allowed_redirect_targets"]
        if self.is_researcher and (lit.dynamic or lit.text not in allowed):
            self.deny("researcher-write", "scope_down",
                      f"researcher output goes to stdout; a redirect to {target.value} writes a file")
        if lit.static is not None and lit.text not in allowed:
            self.check_write_path(lit.text, cwd)

    def parsed_substitutions(self, n):
        for c in self.children(n):
            if c.kind in ("cmdsub", "procsub"):
                yield c
            else:
                yield from self.parsed_substitutions(c)

    def shell_text(self, text, mode, cwd, depth):
        """Check each command substitution in text, whether or not Parable made it a node, and
        each ${NAME:=value} default, which sets NAME."""
        for name in PARAM_ASSIGN.findall(text):
            self.check_env_name(name)
        if PARAM_INDIRECT_ASSIGN.search(text):
            self.deny("dynamic-assignment", "stop_and_explain",
                      "${!name:=value} sets the variable another one names; name it plainly")
        try:
            bodies = substitutions(text, mode)
        except ValueError:
            self.deny("parse-error", "stop_and_explain",
                      "a command substitution has no end the policy can find")
        for body in bodies:
            self.analyze_string(body, cwd, depth + 1)

    def command(self, n, cwd, depth):
        for x in list(n.words) + list(n.redirects or []):
            self.node(x, cwd, depth)
        lits = [scan_word(w.value, self.word_home) for w in n.words]
        return self.argv(lits, cwd, depth)

    # ------------------------------------------------ one simple command

    def assignment(self, lit):
        m = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)=(.*)$", lit.text or "", re.S)
        return m.groups() if m else None

    def check_env(self, name, value):
        sh = self.p["shell"]
        if f"{name}={value}" in sh["allowed_env"]:
            return
        if self.is_researcher and name not in self.p["researcher"]["allowed_env"]:
            self.deny("env-assignment", "scope_down", f"researcher may not set {name}")
        self.check_env_name(name)

    def check_env_assignment(self, lit):
        """A NAME=value word, where the value (but not the name) may be dynamic. The allowlist
        exemption (PAGER=cat) applies only to a fully static word; otherwise the name is checked
        on its own, and a computed name is refused."""
        m = re.match(r"""["']?([A-Za-z_][A-Za-z0-9_]*)(\[[^]]*\])?\+?=(.*)""", lit.raw, re.S)
        name = m.group(1)
        if "$" in m.group(1) + (m.group(2) or "") or "`" in (m.group(2) or ""):
            self.deny("dynamic-assignment", "stop_and_explain",
                      f"the variable name in {lit.raw!r} comes from an expansion; name it plainly")
        if not lit.dynamic:
            self.check_env(name, self.assignment(lit)[1])
        else:
            if self.is_researcher and name not in self.p["researcher"]["allowed_env"]:
                self.deny("env-assignment", "scope_down", f"researcher may not set {name}")
            self.check_env_name(name)

    def check_env_name(self, name):
        sh = self.p["shell"]
        if name == "HOME":
            self.home_assigned = True
        if name in sh["denied_env_names"] or name in sh["banned_env_names"] or any(
                name.startswith(x) for x in sh["denied_env_prefixes"]):
            self.deny("env-assignment", "use_alternative",
                      f"setting {name} changes what a command executes or reads; run it "
                      "without that")

    # Builtins that set variables from their arguments: NAME=value or a bare NAME (export and
    # the typeset family), or a NAME they read into. A VAR=x word before a command is not the
    # only way to set one, so each name goes through the same check.
    TYPESET = {"export", "declare", "typeset", "local", "readonly", "integer", "float"}
    READ_INTO = {"read", "getopts", "mapfile", "readarray", "vared"}
    # NAME, NAME[sub], NAME=..., NAME+=..., optionally inside a leading quote ("x=$1"); the name
    # and subscript hold no expansion.
    ASSIGN_NAME = re.compile(r"""["']?([A-Za-z_][A-Za-z0-9_]*)(\[[^]$`]*\])?(\+?=|["']?$)""")
    READ_VALUE_OPTS = "dinNptu"  # read's options whose value is the next word (-a's is a name)

    def assigning_builtin(self, base, lits):
        def name_of(lit):
            m = self.ASSIGN_NAME.match(lit.raw)
            if not m:
                self.deny("dynamic-assignment", "stop_and_explain",
                          f"{base} sets a variable whose name the policy can't read "
                          f"({lit.raw!r}); name it plainly")
            return m
        rest = lits[1:]
        if base in self.TYPESET or base in self.READ_INTO:
            skip = False
            for lit in rest:
                if skip:
                    skip = False
                    continue
                if lit.raw.startswith(("-", "+")) and not lit.dynamic:
                    if base in ("declare", "typeset", "local") and "n" in lit.text[1:]:
                        self.deny("dynamic-assignment", "stop_and_explain",
                                  f"{base} -n makes a name that sets another variable; set the "
                                  "variable itself")
                    if base == "read":  # the next word is a value only if nothing is attached to
                        for j, ch in enumerate(lit.text[1:]):  # the first value-taking letter
                            if ch in self.READ_VALUE_OPTS:
                                skip = j == len(lit.text) - 2
                                break
                    continue
                if base in self.READ_INTO and not lit.dynamic:
                    # zsh: read 'NAME?prompt'; a subscript sets part of NAME
                    self.check_env_name(re.split(r"[?\[]", lit.text, maxsplit=1)[0])
                    continue
                m = name_of(lit)
                if lit.dynamic or lit.text not in self.p["shell"]["allowed_env"]:
                    self.check_env_name(m.group(1))
        elif base == "let":
            for lit in rest:
                for m in ARITH_ASSIGN.finditer(lit.text):
                    self.check_env_name(m.group(1) or m.group(2))
        elif base in ("printf", "print"):
            k = 0
            while k < len(rest):
                t = rest[k].text
                if t == "-v":  # quoted or bare; an attached expansion left text as "-v" too
                    if rest[k].dynamic:
                        self.deny("dynamic-assignment", "stop_and_explain",
                                  f"{base} -v with a computed variable name; name it plainly")
                    if k + 1 < len(rest):
                        self.check_env_name(re.split(r"\[", name_of(rest[k + 1]).group(1), 1)[0])
                    k += 2
                elif t.startswith("-v"):  # -vNAME attached
                    if rest[k].dynamic:
                        self.deny("dynamic-assignment", "stop_and_explain",
                                  f"{base} -v with a computed variable name; name it plainly")
                    self.check_env_name(t[2:].split("[", 1)[0])
                    k += 1
                elif t.startswith("-"):
                    k += 1
                else:
                    break  # the format: options end here

    def trap(self, lits, cwd, depth):
        """trap's handler runs later in this shell, so it is checked like eval's text. Resetting
        (`trap - SIG`), ignoring (`trap '' SIG`) and the listing forms run nothing."""
        rest = lits[1:]
        # trap's only options are -l, -p and --; anything else starting with - is the handler
        # (a reset like `trap '-; cmd' EXIT`), so it is not skipped.
        while rest and not rest[0].dynamic and rest[0].text in ("-l", "-p", "--"):
            end, rest = rest[0].text == "--", rest[1:]
            if end:
                break
        if not rest:
            return
        handler = rest[0]
        if handler.dynamic or handler.glob:
            self.deny("dynamic-eval", "stop_and_explain", "trap with a dynamic handler")
        if handler.text in ("", "-") or (len(rest) == 1 and
                                         re.fullmatch(r"(SIG)?[A-Z0-9]+", handler.text)):
            return
        self.analyze_string(handler.text, cwd, depth + 1)

    def resolves(self, word):
        if word in self.p["shell"]["builtins"]:
            return True
        if "/" in word:
            return os.access(resolve(word, self.cwd), os.X_OK)
        return shutil.which(word, path=":".join(self.path_dirs)) is not None

    def unresolved(self, word):
        """Why `word` doesn't resolve, worded so the agent can fix it. The hook checks the whole
        line before any of it runs, so a path the same line creates doesn't exist yet."""
        if "/" not in word:
            return (f"{word!r} is not a program on PATH (an alias or a shell function?); "
                    "use the full command it stands for")
        if os.path.exists(resolve(word, self.cwd)):
            return f"{word!r} isn't executable"
        return (f"{word!r} doesn't exist yet. If this command line creates it (a venv, a "
                "build), run the creating step as its own Bash call first, then this one")

    def argv(self, lits, cwd, depth):
        sh = self.p["shell"]
        shell_cwd, self.peel_moved = cwd, False
        for _ in range(20):
            while lits and not lits[0].dynamic and self.assignment(lits[0]):
                self.check_env(*self.assignment(lits[0]))
                lits = lits[1:]
            if not lits:
                return cwd
            head = lits[0]
            if head.dynamic:
                self.deny("dynamic-executable", "manual_only",
                          f"the command name {head.text!r} comes from an expansion")
            word = head.text
            base = os.path.basename(word)
            if not self.resolves(word):
                self.deny("unknown-command", "stop_and_explain", self.unresolved(word))
            self.check_excluded([l.text if not l.dynamic else None for l in lits])
            if base == "sudo":
                self.deny("sudo", "manual_only", "delegated agents never use sudo")
            if base in sh["shells"]:
                return self.shell_wrapper(lits, cwd, depth)
            if base == "eval":
                if any(l.dynamic or l.glob for l in lits[1:]):
                    self.deny("dynamic-eval", "stop_and_explain", "eval of a dynamic string")
                self.analyze_string(" ".join(l.text for l in lits[1:]), cwd, depth + 1)
                return cwd
            if base == "trap":
                self.trap(lits, cwd, depth)
                return cwd
            if base in ("source", "."):
                target = lits[1].text if len(lits) > 1 and not lits[1].dynamic else ""
                if any(target.endswith(s) for s in sh["source_allowed_suffixes"]):
                    return cwd
                self.deny("source", "stop_and_explain",
                          "source runs a file the policy can't see (only */bin/activate is allowed)")
            if base in sh["wrappers"] and base != "sudo":
                inner = self.peel_wrapper(base, lits, cwd, depth)
                cwd = self.peel_cwd
                if inner is None:
                    return cwd  # the wrapper alone (e.g. bare `env`) just prints
                lits = inner
                continue
            break
        else:
            self.deny("too-deep", "stop_and_explain", "too many nested wrappers")
        self.assigning_builtin(base, lits)
        if base == "unset" and any(l.text == "HOME" for l in lits[1:]):
            self.home_assigned = True  # $HOME is now empty: check the command again
        args = [l.text if not l.dynamic else None for l in lits]
        globs = [l.glob for l in lits]
        splits = [l.split for l in lits]
        moved = self.peel_moved
        cwd = self.program(base, args, globs, splits, cwd, depth)
        return shell_cwd if moved else cwd  # env -C moved only the command it ran

    def env_chdir(self, lit):
        """env -C DIR runs the command in DIR: hold it to cd's rules and move the cwd the rest
        of the checks resolve against."""
        if lit is None or lit.dynamic or lit.glob:
            self.deny("dynamic-wrapper-arg", "stop_and_explain", "env -C with a computed directory")
        self.peel_cwd = self.cd(["cd", lit.text], self.peel_start)  # the last -C wins
        self.peel_moved = True

    def peel_wrapper(self, base, lits, cwd, depth):
        """Return the wrapped command's words, or None when there is none. A wrapper that runs
        the command elsewhere (env -C) leaves the new cwd in self.peel_cwd."""
        self.peel_cwd = self.peel_start = cwd
        rest = lits[1:]
        if base == "env":
            i = 0
            while i < len(rest):
                t = rest[i].text
                split = None
                if t == "--":
                    i += 1
                    break
                if t in ("--split-string",) and i + 1 < len(rest):
                    split, after = rest[i + 1], i + 2
                elif t.startswith("--split-string="):
                    split, after = Lit(t.split("=", 1)[1], rest[i].dynamic), i + 1
                elif t in ("--ignore-environment", "--null", "--debug"):
                    self.home_assigned |= t == "--ignore-environment"
                    i += 1
                    continue
                elif t == "--unset":
                    self.home_assigned |= i + 1 < len(rest) and rest[i + 1].text == "HOME"
                    i += 2
                    continue
                elif t == "--chdir":
                    self.env_chdir(rest[i + 1] if i + 1 < len(rest) else None)
                    i += 2
                    continue
                elif t.startswith("--chdir="):
                    self.env_chdir(Lit(t.split("=", 1)[1], rest[i].dynamic, rest[i].glob))
                    i += 1
                    continue
                elif t.startswith("--unset="):
                    self.home_assigned |= t == "--unset=HOME"
                    i += 1
                    continue
                elif t.startswith("--"):
                    self.deny("unknown-option", "stop_and_explain",
                              f"env {t} is an option the policy doesn't know; use plain env")
                elif t.startswith("-") and len(t) > 1:
                    # A short cluster, parsed as env does: flags, then a value-taking letter
                    # whose value is the rest of the cluster or the next word. -S (split
                    # string) runs its value as a command, attached or not (`-iS'git ...'`).
                    after = i + 1
                    for k, ch in enumerate(t[1:], 1):
                        if ch in "i0v":
                            self.home_assigned |= ch == "i"
                            continue
                        value = t[k + 1:]
                        if ch in "uC":
                            if not value:
                                after = i + 2
                            if ch == "u":
                                self.home_assigned |= (value or (rest[i + 1].text if i + 1 < len(
                                    rest) else "")) == "HOME"
                            if ch == "C":
                                self.env_chdir(Lit(value, rest[i].dynamic, rest[i].glob) if value
                                               else rest[i + 1] if i + 1 < len(rest) else None)
                            break
                        if ch == "S":
                            if value:
                                split = Lit(value, rest[i].dynamic)
                            elif i + 1 < len(rest):
                                split, after = rest[i + 1], i + 2
                            else:
                                split = Lit("")
                            break
                        self.deny("unknown-option", "stop_and_explain",
                                  f"env -{ch} is an option the policy doesn't know; use plain env")
                    if split is None:
                        i = after
                        continue
                if split is not None:
                    if split.dynamic:
                        self.deny("dynamic-shell", "stop_and_explain", "env -S with a dynamic string")
                    return [Lit(s) for s in split.text.split()] + rest[after:]
                elif re.match(r"""["']?[A-Za-z_][A-Za-z0-9_]*(\[[^]]*\])?\+?=""", rest[i].raw):
                    self.check_env_assignment(rest[i])
                    i += 1
                elif rest[i].dynamic and "=" in (rest[i].text or ""):
                    self.deny("dynamic-assignment", "stop_and_explain",
                              "env with a computed variable name; name it plainly")
                else:
                    break
            rest = rest[i:]
            return rest or None
        if base in ("noglob", "nocorrect"):
            return rest or None  # zsh precommand modifiers: the next word is the command
        rest, opts = self.wrapper_options(base, rest)
        repl = opts.pop("replace", None)
        if base == "command" and ("-v" in opts or "-V" in opts):
            return None  # it prints how a name resolves
        if base in ("timeout", "flock") and rest:
            if rest[0].dynamic or rest[0].glob:
                self.deny("dynamic-wrapper-arg", "stop_and_explain",
                          f"{base} with a computed {'duration' if base == 'timeout' else 'lock file'}")
            if base == "flock":
                if self.is_researcher:
                    self.deny("researcher-flag", "scope_down",
                              "flock creates its lock file; researcher only reads")
                self.check_write_path(rest[0].text, cwd)
            rest = rest[1:]
            if base == "flock" and rest and rest[0].text in ("-c", "--command"):
                return self.wrapper_shell_string(base, rest[1:2], cwd, depth)
        if base == "watch" and not ({"-x", "--exec"} & set(opts)):
            return self.wrapper_shell_string(base, rest, cwd, depth)  # watch runs it with sh -c
        if base == "xargs":
            if not rest:
                return None
            if repl is not None:
                repl = "{}" if repl is True else repl
                rest = [Lit(l.text, dynamic=True) if repl in (l.text or "") else l for l in rest]
            return rest + [Lit("", dynamic=True)]  # the arguments come from stdin
        return rest or None

    # Each wrapper's options as its own parser reads them. A value letter takes the rest of its
    # cluster, else the next word; an optional one ("opt") only the rest of the cluster, and an
    # optional long one only an attached =. Long names match exactly. Any other option is
    # refused: one skipped without its value moves the word the policy takes for the command
    # (`exec -a ls sort -o out f` runs sort), and GNU time's -o writes a file, so time keeps only
    # the shell keyword's -p.
    WRAPPER_OPTS = {
        "command": {"bool": "pvV"},
        "builtin": {},
        "exec": {"bool": "cl", "value": "a"},
        "time": {"bool": "p"},
        "nohup": {},
        "nice": {"value": "n", "lvalue": ("adjustment",)},
        "timeout": {"bool": "v", "value": "sk", "lbool": ("preserve-status", "foreground",
                                                          "verbose"),
                    "lvalue": ("signal", "kill-after")},
        "stdbuf": {"value": "ioe", "lvalue": ("input", "output", "error")},
        "ionice": {"bool": "t", "value": "cnpPu", "lbool": ("ignore",),
                   "lvalue": ("class", "classdata", "pid", "pgid", "uid")},
        "xargs": {"bool": "0prtxo", "value": "aEILnPsd", "opt": "eil",
                  "lbool": ("null", "no-run-if-empty", "verbose", "interactive", "exit",
                            "open-tty", "show-limits"),
                  "lvalue": ("arg-file", "delimiter", "max-args", "max-procs", "max-chars",
                             "process-slot-var"),
                  "lopt": ("max-lines", "replace", "eof")},
        "watch": {"bool": "bcCegprtwx", "value": "nq", "opt": "d",
                  "lbool": ("beep", "color", "no-color", "errexit", "chgexit", "precise",
                            "no-rerun", "no-title", "no-wrap", "exec"),
                  "lvalue": ("interval", "equexit"), "lopt": ("differences",)},
        "flock": {"bool": "sxunoF", "value": "wE",
                  "lbool": ("shared", "exclusive", "unlock", "nonblock", "close", "no-fork",
                            "verbose"),
                  "lvalue": ("timeout", "wait", "conflict-exit-code")},
    }

    def wrapper_options(self, base, rest):
        """Read a wrapper's leading options by WRAPPER_OPTS: the words after them, and the
        options seen ({"-I": "{}", "--null": True, ...}). A computed word where an option could
        be is refused, since it could expand to one."""
        spec = self.WRAPPER_OPTS[base]
        opts, rest = {}, list(rest)
        while rest:
            lit = rest[0]
            t = lit.text or ""
            if lit.glob and not lit.dynamic and not re.search(r"[*?\[]|\{(?!\})", t):
                lit = Lit(t)  # only a bare {} (xargs -I{}), which neither shell expands
            if not lit.dynamic and not lit.glob and (t == "-" or not t.startswith("-")):
                break
            if lit.dynamic or lit.glob:
                if not t.startswith("-") and not lit.split:
                    break  # a quoted expansion in command position: argv refuses it there
                self.deny("dynamic-wrapper-arg", "stop_and_explain",
                          f"{base} with a computed word where an option could be")
            rest = rest[1:]
            if t == "--":
                break
            if t.startswith("--"):
                name, eq, value = t[2:].partition("=")
                if name in spec.get("lbool", ()) and not eq:
                    opts["--" + name] = True
                elif name in spec.get("lopt", ()):
                    opts["--" + name] = value if eq else True
                    if name == "replace":
                        opts["replace"] = opts["--replace"]  # xargs: the last one given wins
                elif name in spec.get("lvalue", ()):
                    if not eq:
                        value = self.wrapper_value(base, rest)
                    opts["--" + name] = value
                else:
                    self.deny("unknown-option", "stop_and_explain",
                              f"{base} {t} is an option the policy doesn't know; leave it out")
                continue
            for k, ch in enumerate(t[1:], 2):
                if ch in spec.get("bool", ""):
                    opts["-" + ch] = True
                    continue
                elif ch in spec.get("opt", ""):
                    opts["-" + ch] = t[k:] or True
                    if base == "xargs" and ch == "i":
                        opts["replace"] = opts["-i"]
                    break
                elif ch in spec.get("value", ""):
                    opts["-" + ch] = t[k:] or self.wrapper_value(base, rest)
                    if base == "xargs" and ch == "I":
                        opts["replace"] = opts["-I"]
                    break
                else:
                    self.deny("unknown-option", "stop_and_explain",
                              f"{base} -{ch} is an option the policy doesn't know; leave it out")
        return rest, opts

    def wrapper_value(self, base, rest):
        """Pop an option's value from the next word. It must be one literal word: a brace, glob
        or expansion there could become several and move the command (`nice -n {5,echo,x} true`)."""
        if not rest:
            return ""
        lit = rest.pop(0)
        if lit.dynamic or (lit.glob and re.search(r"[*?\[]|\{(?!\})", lit.text or "")):
            self.deny("dynamic-wrapper-arg", "stop_and_explain",
                      f"{base} with a computed option value")
        return lit.text

    def wrapper_shell_string(self, base, words, cwd, depth):
        """watch (without -x) and flock -c run their words through sh -c: check that text."""
        if any(l.dynamic or l.glob for l in words):
            self.deny("dynamic-eval", "stop_and_explain", f"{base} runs a dynamic string")
        self.analyze_string(" ".join(l.text for l in words), cwd, depth + 1)
        return None

    # Shell options that take the next word (-o NAME, +O NAME), and the long ones that take
    # none. Any other long option is refused (--rcfile and --init-file read a file).
    SHELL_VALUE = {"zsh": "o"}  # every other shell: "oO", the value always the next word
    SHELL_LONG = {"--norc", "--noprofile", "--login", "--posix", "--no-rcs", "--noediting",
                  "--verbose", "--restricted"}

    def shell_wrapper(self, lits, cwd, depth):
        """A shell's options, read as bash and zsh read them: -c makes the first word after the
        options the script, wherever -c stands among them, and -o/-O take the next word."""
        rest, script, has_c, has_s = lits[1:], None, False, False
        shell = os.path.basename(lits[0].text)
        i = 0
        while i < len(rest):
            lit = rest[i]
            t = lit.text or ""
            if lit.dynamic or lit.glob:
                if t.startswith(("-", "+")) or lit.split:
                    self.deny("dynamic-shell", "stop_and_explain",
                              "a shell with a computed word where an option could be")
                break
            if t in ("-", "--"):
                i += 1
                break
            if t.startswith("--"):
                if t not in self.SHELL_LONG:
                    self.deny("unknown-option", "stop_and_explain",
                              f"{t} is a shell option the policy doesn't know; leave it out")
                i += 1
                continue
            if t.startswith(("-", "+")) and len(t) > 1:
                i += 1
                for k, ch in enumerate(t[1:], 2):
                    if ch == "c":
                        has_c = True
                    elif ch == "s":
                        has_s = True
                    elif ch in self.SHELL_VALUE.get(shell, "oO"):
                        if shell == "zsh" and t[k:]:
                            break  # zsh: -oNAME, the rest of the word is the value
                        if i < len(rest) and (rest[i].dynamic or rest[i].glob):
                            self.deny("dynamic-shell", "stop_and_explain",
                                      "a shell option with a computed value")
                        i += 1  # its value
                continue
            break
        if has_s and not has_c:
            self.deny("shell-stdin", "stop_and_explain",
                      "a shell with -s reads its commands from stdin, which can't be checked")
        if has_c:
            script = rest[i] if i < len(rest) else None
            if script is None or script.dynamic or script.glob:
                self.deny("dynamic-shell", "stop_and_explain", "a shell -c with a dynamic script")
            self.analyze_string(script.text, cwd, depth + 1)
            return cwd
        if i < len(rest) and not rest[i].text.startswith("-"):
            if self.is_researcher:
                self.deny("researcher-program", "scope_down",
                          "researcher runs only allowlisted read commands, not scripts")
            return cwd  # a script file: its body is the sandbox's to bound
        self.deny("shell-stdin", "stop_and_explain",
                  "a shell reading commands from stdin (e.g. `... | sh`) can't be checked")

    def check_excluded(self, args):
        """excludedCommands run outside the sandbox, so a delegated agent may not run one.
        Matched per simple command (stricter than Claude Code's whole-command match)."""
        words = [a for a in args]
        if not words or words[0] is None:
            return
        words = [os.path.basename(words[0])] + words[1:]
        for pat in self.sandbox["excludedCommands"]:
            p = pat.strip()
            wild = p.endswith(" *") or p.endswith(":*")
            toks = (p[:-2] if wild else p).split()
            if not toks:
                continue
            if (words[:len(toks)] == toks and (wild or len(words) == len(toks))):
                self.deny("excluded-command", "manual_only",
                          f"{' '.join(toks)} runs outside the sandbox (excludedCommands), so "
                          "delegated agents may not run it")

    # ------------------------------------------------ programs

    def program(self, base, args, globs, splits, cwd, depth):
        if self.is_researcher:
            return self.researcher_program(base, args, globs, splits, cwd, depth)
        if base == "git":
            return self.git(args, cwd)
        if base in ("cd", "pushd"):
            return self.cd(args, cwd)
        if base == "rm":
            self.rm(args, globs, cwd)
        elif base == "find":
            self.find(args, cwd, depth)
        elif base == "curl":
            self.curl(args)
        elif base == "wget":
            self.wget(args)
        self.write_targets(base, args, globs, splits, cwd)
        return cwd

    def cd(self, args, cwd):
        target = next((a for a in args[1:] if a is None or not a.startswith("-")), self.home)
        if target is None:
            return cwd
        new = resolve(expand(target, self.home), cwd)
        if self.confined and not (under(new, self.root) or self.in_temp(new)):
            self.deny("worktree-root", "scope_down",
                      f"cd {target} leaves your worktree ({self.root}); stay inside it")
        return new

    def write_targets(self, base, args, globs, splits, cwd):
        pos = [a for a in args[1:] if a is None or not a.startswith("-")]
        targets = []
        tdir = None
        for i, a in enumerate(args[1:], 1):
            if a in ("-t", "--target-directory") and i + 1 < len(args):
                tdir = args[i + 1]
            elif a and a.startswith("--target-directory="):
                tdir = a.split("=", 1)[1]
        if base in ("cp", "install", "rsync", "ln"):
            targets = [tdir] if tdir else pos[-1:] if len(pos) >= 2 else []
        elif base == "mv":
            targets = pos + ([tdir] if tdir else [])
        elif base in ("tee", "touch", "mkdir", "rmdir", "truncate", "rm", "shred", "unlink"):
            targets = pos
        elif base in ("chmod", "chown", "chgrp"):
            targets = pos[1:]
        elif base == "dd":
            targets = [a.split("=", 1)[1] for a in args[1:] if a and a.startswith("of=")]
        elif base == "sed":
            for t in self.sed_writes(args, globs, splits, cwd):
                if t is not None:
                    self.check_write_path(t, cwd, tilde=False)
            return
        for t in targets:
            if t is not None:
                self.check_write_path(t, cwd)

    def sed(self, args, globs, splits):
        """A sed call (SedCall) and the e, r and w uses the policy can see in its scripts (sed_ops).
        When a $var or glob is among the arguments the policy can't see the script or be sure a word
        isn't an option, so it requires sed's own --sandbox (sed then refuses every e, r and w) and
        that each dynamic word sit only where it can't be an option: as a quoted (single-word) -e
        value (a script --sandbox covers), or after -- (a file). A word that word-splits or expands
        (an unquoted expansion, or a glob/brace) could still become a bare -i, which --sandbox does
        not disable, so it is refused anywhere before --. Then it returns no script ops (only a
        literal -i, handled by the caller, is left). A fully literal call is parsed in full."""
        try:
            call = SedCall(args, globs, splits)
        except SedError as e:
            self.deny("sed-unchecked", "stop_and_explain", str(e))
        if call.has_dynamic or call.has_glob:
            if not call.sandbox or call.bad_dynamic:
                self.deny("sed-unchecked", "use_alternative",
                          "a sed call with a $var or glob can hide an e, w or exec, or expand to an "
                          "option like -i (which --sandbox does not disable): pass --sandbox so sed "
                          "refuses e/r/w, give any dynamic script as a quoted `-e \"<script>\"`, and "
                          "put glob or other dynamic words after -- so sed reads them as files")
            return call, []
        try:
            ops = sed_ops(*call.scripts)
        except SedError as e:
            self.deny("sed-unchecked", "stop_and_explain",
                      f"the sed script doesn't parse as GNU sed reads it ({e}), so the policy "
                      "can't check it for e and w commands")
        for script in call.candidates:
            try:
                ops += sed_ops(script)
            except SedError:
                pass
        return call, ops

    def sed_writes(self, args, globs, splits, cwd):
        """The files a sed call writes: each w/W command's and s///w flag's file, and with -i
        each input file and its backup. An e command runs a shell command the policy can't see,
        so it is refused outright."""
        call, ops = self.sed(args, globs, splits)
        if any(op == "e" for op, _ in ops):
            self.deny("sed-exec", "stop_and_explain",
                      "a sed e command runs a shell command the policy can't see")
        out = [arg for op, arg in ops if op == "w"]
        if call.in_place is not None:
            out += call.files + sed_backups(call.files, call.in_place, cwd, call.follow)
        return out

    def rm(self, args, globs, cwd):
        recursive = False
        targets = []
        end_opts = False
        for a, g in zip(args[1:], globs[1:]):
            if not end_opts and a == "--":
                end_opts = True
            elif not end_opts and a and a.startswith("--"):
                recursive |= a in ("--recursive",)
            elif not end_opts and a and a.startswith("-") and len(a) > 1:
                recursive |= ("r" in a[1:] or "R" in a[1:])
            else:
                targets.append((a, g))
        roots = [self.root] + self.allow_write + self.temp_roots
        for t, g in targets:
            if t is None or g:
                if recursive:
                    self.deny("rm-dynamic", "scope_down",
                              "rm -r with a computed or glob target; name literal paths inside "
                              "your root")
                continue
            p = resolve(expand(t, self.home), cwd)
            if p in ("/", self.home) or under(self.home, p):
                self.deny("rm-root-or-home", "hard_stop", f"rm of {t} would remove / or home")
            if ".git" in p.split("/"):
                self.deny("rm-git-metadata", "hard_stop", f"rm of git metadata ({t})")
            if recursive and not any(under(p, r) for r in roots):
                self.deny("rm-outside-root", "scope_down",
                          f"rm -r of {t} is outside your root ({self.root}) and temp")

    def find(self, args, cwd, depth):
        starts = []
        for a in args[1:]:
            if a is None or a.startswith("-") or a in ("(", "!", ")"):
                break
            starts.append(a)
        starts = starts or ["."]
        if "-delete" in args:
            self.rm(["rm", "-r"] + starts, [False] * (len(starts) + 2), cwd)
        for flag in ("-exec", "-execdir", "-ok", "-okdir"):
            for i, a in enumerate(args):
                if a == flag:
                    inner = []
                    for b in args[i + 1:]:
                        if b in (";", "+", "\\;"):
                            break
                        inner.append(b)
                    lits = [Lit("", dynamic=True) if b is None or "{}" in b else Lit(b)
                            for b in inner]
                    if lits:
                        self.argv(lits, cwd, depth + 1)
        for i, a in enumerate(args):
            if a in ("-fprint", "-fprint0", "-fprintf", "-fls") and i + 1 < len(args) and args[i + 1]:
                self.check_write_path(args[i + 1], cwd)

    def short_cluster(self, a):
        return a.startswith("-") and not a.startswith("--") and len(a) > 1

    # Short options that take a value, per program, so a cluster's tail isn't read as more
    # options (`sort -ko,2`: the k takes "o,2"). Used by cluster_opts for the deny checks below.
    # Only options that actually take a value; a boolean short flag must stay out, or a denied
    # letter after it (sort -bo, fd -px) would be read as its value and missed. tree has none:
    # each of its value letters takes the next word and the cluster goes on (`tree -Lo 1 f` is
    # -L 1 -o f). grep's letters cover GNU grep and ugrep, which grep runs here. xxd doesn't
    # cluster at all; xxd_writes reads it.
    SHORT_VALUE = {"sort": "oktSTy", "tree": "", "date": "dIrfs", "file": "mefFP", "yq": "opIsf",
                   "fd": "xXtedjScEo", "fdfind": "xXtedjScEo", "grep": "efmABCDdgJKMNOt",
                   "egrep": "efmABCDdgJKMNOt", "fgrep": "efmABCDdgJKMNOt",
                   "ugrep": "efmABCDdgJKMNOt"}

    def cluster_opts(self, token, value_letters):
        """The option letters in a short cluster (-qD -> {q, D}), stopping once a value-taking
        letter is reached: that letter is included, and the rest of the token is its value."""
        out = set()
        for ch in token[1:]:
            out.add(ch)
            if ch in value_letters:
                break
        return out

    # xxd reads each option by its first letter after one or two dashes (-revert, --r and -r are
    # all -r; -pr is -p), and stops at its first file operand. A value letter takes the next word
    # when nothing follows it or what follows starts its long name (-c 8, -cols 8), else the rest
    # of the word (-c8). R has no long name the policy relies on.
    XXD_VALUE = {"c": "ols", "g": "roupsize", "l": "en", "s": "eek", "n": "ame", "o": "ffset",
                 "R": ""}

    def xxd_writes(self, words):
        """True when xxd would write a file: -r in any spelling, or a second operand (the output
        file). A word the policy can't read counts as an operand, so doubt means a refusal."""
        words, operands = list(words), 0
        while words:
            a = words.pop(0)
            if a in ("--", "---"):  # xxd drops one dash from a word that starts --, so --- is --
                operands += len(words)
                break
            if a is None or a == "-" or not a.startswith("-"):
                operands += 1 + len(words)  # options end here; every later word is an operand
                break
            body = a[2:] if a.startswith("--") else a[1:]
            if body[:1] == "r":
                return True
            long = self.XXD_VALUE.get(body[:1])
            if long is not None and (len(body) == 1 or (long and body[1:].startswith(long))):
                if words:
                    words.pop(0)
        return operands > 1

    def curl(self, args, researcher=False):
        c = self.p["curl"]
        send_long = [f for f in c["send_flags"] if f.startswith("--")]
        send_short = {f[1] for f in c["send_flags"] if not f.startswith("--")}
        out_long = [f for f in c["output_flags"] if f.startswith("--")]
        out_short = {f[1] for f in c["output_flags"] if not f.startswith("--")}
        i = 1
        while i < len(args):
            a = args[i] or ""
            method = None
            # curl takes a unique prefix of a long option (--data-bin is --data-binary), so every
            # long name here matches by prefix (flag_hit), as git's and wget's do.
            if a == "-X" or (a.startswith("--") and "=" not in a and flag_hit(a, ("--request",))):
                method = args[i + 1] if i + 1 < len(args) else None
                i += 1
            elif a.startswith("--") and "=" in a and flag_hit(a, ("--request",)):
                method = a.split("=", 1)[1]
            elif self.short_cluster(a) and "X" in a[1:]:
                rest = a[a.index("X", 1) + 1:]
                method = rest or (args[i + 1] if i + 1 < len(args) else None)
            if method is not None or a == "-X" or flag_hit(a, ("--request",)):
                if (method or "").upper() not in c["allowed_methods"]:
                    self.deny("http-write", "manual_only",
                              f"curl with method {method!r}; delegated agents only GET or HEAD")
            if a.startswith("--") and flag_hit(a, send_long):
                self.deny("http-write", "manual_only", f"curl {a} sends data")
            if self.short_cluster(a):
                for ch in a[1:]:
                    if ch == "X":
                        break
                    if ch in send_short:
                        self.deny("http-write", "manual_only", f"curl -{ch} sends data")
                    if researcher and ch in out_short:
                        self.deny("researcher-write", "scope_down",
                                  f"curl -{ch} writes a local file; researcher reads to stdout")
            if researcher and a.startswith("--") and flag_hit(a, out_long):
                self.deny("researcher-write", "scope_down",
                          f"curl {a} writes a local file; researcher reads to stdout")
            if researcher:
                fmt = None  # -w/--write-out: %output{FILE} writes FILE, and @FILE reads a format
                if a.startswith("--") and flag_hit(a, ("--write-out",)):
                    nxt = args[i + 1] if i + 1 < len(args) else ""
                    fmt = a.split("=", 1)[1] if "=" in a else nxt
                elif self.short_cluster(a) and "w" in a[1:]:
                    fmt = a[a.index("w", 1) + 1:] or (args[i + 1] if i + 1 < len(args) else "")
                if fmt is not None and ("%output" in (fmt or "") or (fmt or "").startswith("@")):
                    self.deny("researcher-write", "scope_down",
                              "curl -w with %output{} writes a file, and @FILE reads its format "
                              "from one; researcher reads to stdout")
            i += 1

    # wget 1.21's short options that take a value (its --help gives each a =VALUE; -n takes the
    # letters of -nv, -nc, -nd, -nH, -np): the rest of the cluster, else the next word.
    WGET_VALUE_SHORT = frozenset("aABDeiIlnoOPQRtTUwXY")
    # wget 1.21's long options that take a value: its --help gives each a =VALUE, except
    # max-redirect, hsts-file and use-askpass, which take one too. Written without =, the value
    # is the next word. backups is the other way round: its value is attached or absent.
    WGET_LONG_VALUE = frozenset("""
        accept accept-regex append-output base bind-address body-data body-file
        ca-certificate ca-directory certificate certificate-type ciphers compression config
        connect-timeout crl-file cut-dirs default-page directory-prefix dns-timeout domains
        exclude-directories exclude-domains execute follow-tags ftp-password ftp-user header
        hsts-file http-password http-user ignore-tags include-directories input-file level
        limit-rate load-cookies local-encoding max-redirect method output-document output-file
        password pinnedpubkey post-data post-file prefer-family private-key private-key-type
        progress proxy-password proxy-user quota random-file read-timeout referer regex-type
        reject reject-regex rejected-log remote-encoding report-speed restrict-file-names
        retry-on-http-error save-cookies secure-protocol start-pos timeout tries use-askpass user
        user-agent wait waitretry warc-dedup warc-file warc-header warc-max-size
        warc-tempdir""".split())
    # The boolean ones, hsts and backups included: --help shows only --no-hsts, and --backups=N.
    WGET_LONG_FLAG = frozenset("""
        adjust-extension ask-password auth-no-challenge background backup-converted backups
        content-disposition content-on-error continue convert-file-only convert-links debug
        delete-after follow-ftp force-directories force-html ftps-clear-data-connection
        ftps-fallback-to-ftp ftps-implicit ftps-resume-ssl help hsts https-only ignore-case
        ignore-length inet4-only inet6-only keep-session-cookies mirror no-cache
        no-check-certificate no-clobber no-config no-cookies no-directories no-dns-cache no-glob
        no-host-directories no-hsts no-http-keep-alive no-if-modified-since no-iri no-netrc
        no-parent no-passive-ftp no-proxy no-remove-listing no-use-server-timestamps no-verbose
        no-warc-compression no-warc-digests no-warc-keep-log page-requisites
        preserve-permissions protocol-directories quiet random-wait recursive relative
        retr-symlinks retry-connrefused retry-on-host-error save-headers server-response
        show-progress span-hosts spider strict-comments timestamping trust-server-names unlink
        verbose version warc-cdx xattr""".split())

    def wget_long(self, name):
        """The wget long option name stands for: itself, else the one option it is a prefix of;
        None when unknown or ambiguous (wget then refuses the call)."""
        known = self.WGET_LONG_VALUE | self.WGET_LONG_FLAG
        if name in known:
            return name
        hits = [o for o in known if o.startswith(name)]
        return hits[0] if len(hits) == 1 else None

    def wget(self, args, researcher=False):
        w = self.p["wget"]
        send, writes = w["send_flags"], w["researcher_write_flags"]
        out_doc, words = None, list(args[1:])
        while words:
            a = words.pop(0)
            if a == "--":
                break  # the rest are URLs
            if not a or a == "-" or not a.startswith("-"):
                continue
            if a.startswith("--"):
                name, eq, value = a[2:].partition("=")
                opt = self.wget_long(name)
                if opt is None:
                    if researcher:  # it may take the next word, -O- included, as its value
                        self.deny("researcher-write", "scope_down",
                                  f"wget {a} is not an option the policy knows")
                    found, exact = [a], False  # unknown: match the lists by prefix
                else:
                    found, exact = ["--" + opt], True
                    if opt in self.WGET_LONG_VALUE and not eq:
                        value = words.pop(0) if words else None
                    if opt == "output-document":
                        out_doc = value
            else:
                found, exact = [], True
                for k, c in enumerate(a[1:], 2):
                    found.append("-" + c)
                    if c in self.WGET_VALUE_SHORT:
                        value = a[k:] or (words.pop(0) if words else None)
                        if c == "O":
                            out_doc = value
                        break
            for f in found:
                if (f in send) if exact else flag_hit(f, send):
                    self.deny("http-write", "manual_only",
                              f"wget {a} sends data or runs a wgetrc command that can")
                if researcher and ((f in writes) if exact else flag_hit(f, writes)):
                    self.deny("researcher-write", "scope_down",
                              f"wget {a} writes a local file; researcher reads to stdout")
        if researcher and out_doc != "-":
            self.deny("researcher-write", "scope_down",
                      "researcher runs wget only with -O- (output to stdout)")

    # ------------------------------------------------ git

    GIT_BRANCH_MUTATE = {"-d", "-D", "--delete", "-m", "-M", "--move", "-c", "-C", "--copy",
                         "-f", "--force", "-u", "--set-upstream-to", "--unset-upstream",
                         "--edit-description"}
    GIT_TAG_MUTATE = {"-d", "--delete", "-f", "--force"}
    GIT_REMOTE_READ = {None, "-v", "--verbose", "show", "get-url"}

    # git's main-level options that take a value (attached with = or the next word). Reading
    # the value is what stops it being mistaken for the subcommand (`git --namespace x push`).
    GIT_GLOBAL_VALUE = {"-C", "-c", "--git-dir", "--work-tree", "--namespace", "--super-prefix",
                        "--config-env", "--attr-source", "--shallow-file"}
    # The ones that take no next word (--exec-path and --list-cmds take theirs attached). git
    # matches its main-level options exactly, so any other is refused rather than guessed at: a
    # value option this list lacks would make its value read as the subcommand.
    GIT_GLOBAL_FLAG = {"-p", "--paginate", "-P", "--no-pager", "--no-replace-objects", "--bare",
                       "--literal-pathspecs", "--no-literal-pathspecs", "--glob-pathspecs",
                       "--noglob-pathspecs", "--icase-pathspecs", "--no-optional-locks",
                       "--no-advice", "--no-lazy-fetch", "--exec-path", "--html-path",
                       "--man-path", "--info-path", "--list-cmds", "-v", "--version", "-h",
                       "--help"}

    def git(self, args, cwd, researcher=False):
        g = self.p["git"]
        i = 1
        gcwd = cwd
        while i < len(args) and args[i] and args[i].startswith("-") and args[i] != "-":
            a = args[i]
            name, eq, attached = a.partition("=")
            if name in ("-c", "--config-env"):
                self.deny("git-config-override", "use_alternative",
                          "git -c can set a pager, diff driver or fsmonitor that runs a command; "
                          "run git without it")
            if name == "--exec-path":
                self.deny("git-exec-path", "manual_only", "git --exec-path runs other programs")
            if name not in self.GIT_GLOBAL_VALUE | self.GIT_GLOBAL_FLAG:
                self.deny("git-global-option", "stop_and_explain",
                          f"git {name} is not a main-level git option the policy knows; run git "
                          "without it")
            value = attached if eq else None
            if name in self.GIT_GLOBAL_VALUE and not eq:
                if i + 1 >= len(args):
                    break
                value, i = args[i + 1], i + 1
            if name in ("-C", "--git-dir", "--work-tree"):
                if value is None:
                    self.deny("git-dynamic-dir", "stop_and_explain",
                              f"git {name} with a computed path")
                gcwd = resolve(expand(value, self.home), gcwd)
            i += 1
        if self.confined and not (under(gcwd, self.root) or self.in_temp(gcwd)):
            self.deny("worktree-root", "scope_down",
                      f"git outside your worktree ({gcwd}); run it inside {self.root}")
        if i >= len(args):
            return cwd
        sub = args[i]
        rest = [a for a in args[i + 1:]]
        if sub is None:
            self.deny("dynamic-executable", "manual_only", "git subcommand from an expansion")
        if sub not in g["known"]:
            self.deny("git-unknown", "stop_and_explain",
                      f"git {sub} is not a known git subcommand (an alias?); use the subcommand "
                      "it stands for")
        for a in rest:
            if flag_hit(a, g["denied_flags"]):
                self.deny("git-flag", "use_alternative", f"git {sub} {a} is not allowed")
            if sub == "grep" and a and (
                    (self.short_cluster(a) and "O" in self.cluster_opts(a, self.GIT_GREP_VALUE))
                    or flag_hit(a, ("--open-files-in-pager",))):
                self.deny("git-flag", "use_alternative", "git grep -O runs a pager command")
            if sub == "clone" and self.clone_flag(a):
                self.deny("git-flag", "use_alternative", f"git clone {a} is not allowed")
            if sub == "clone" and a and re.match(r"^(ext|fd)::", a):
                self.deny("git-transport", "hard_stop", f"git clone {a} runs a command")
        if sub in g["denied"]:
            self.deny(f"git-{sub}", g["denied"][sub],
                      f"git {sub} is not something delegated agents do"
                      + (" (it needs the GitHub credential, which subagents never get)"
                         if sub in ("push", "fetch", "pull", "ls-remote", "send-pack") else ""))
        pos = [a for a in rest if a is not None and not a.startswith("-")]
        flags = self.git_flags(sub, rest)
        first = pos[0] if pos else None
        if researcher:
            self.git_read_only(sub, rest, pos, flags, first, cwd)
            return cwd
        if sub == "checkout" and not (rest and rest[0] == "-b") or (
                sub == "checkout" and any_flag(flags, ("-B", "-f", "--force"))):
            self.deny("git-checkout", "use_alternative",
                      "only `git checkout -b <new>` is allowed; use `git switch -c <new>` to "
                      "create a branch")
        if sub == "switch" and not (flags & {"-c", "--create"}) or (
                sub == "switch" and any_flag(flags, ("-C", "--force-create", "-f", "--force",
                                                     "--discard-changes"))):
            self.deny("git-switch", "use_alternative", "only `git switch -c <new>` is allowed")
        if sub == "restore" and (not flags & {"--staged", "-S"}
                                 or any_flag(flags, ("--worktree", "-W"))):
            self.deny("git-restore", "use_alternative",
                      "git restore that discards work is not allowed; `git restore --staged "
                      "<path>` unstages")
        if sub == "commit" and "-n" in flags:
            self.deny("git-flag", "use_alternative",
                      "git commit -n is --no-verify; it skips the hooks")
        if sub == "branch" and any_flag(flags, self.GIT_BRANCH_MUTATE):
            self.deny("git-branch", "use_alternative",
                      "deleting, moving or force-resetting a branch is not allowed")
        if sub == "stash" and first in ("drop", "clear", "pop"):
            self.deny("git-stash", "use_alternative",
                      f"git stash {first} discards a stash entry; `git stash apply` keeps it")
        if sub == "worktree" and first not in (None, "list"):
            self.deny("git-worktree", "manual_only", "only `git worktree list` is allowed")
        if sub == "tag" and any_flag(flags, self.GIT_TAG_MUTATE):
            self.deny("git-tag", "manual_only", "deleting or moving a tag is not allowed")
        if sub == "remote" and first not in self.GIT_REMOTE_READ:
            self.deny("git-remote", "manual_only", f"git remote {first} changes remotes")
        if sub == "config" and not self.git_config_read(rest, pos, flags):
            self.deny("git-config", "manual_only", "git config writes are not allowed")
        if sub == "reflog" and first in ("expire", "delete"):
            self.deny("git-reflog", "manual_only", f"git reflog {first} discards history")
        if sub == "gc" and any_flag(flags, ("--prune",)):
            self.deny("git-gc", "manual_only", "git gc --prune discards objects")
        if sub in ("merge", "cherry-pick", "am") and any_flag(flags, ("--abort",)):
            self.deny("git-abort", "use_alternative", f"git {sub} --abort discards work in progress")
        if sub == "rm" and (any_flag(flags, ("-f", "--force")) or any(
                a and re.fullmatch(r"-[a-zA-Z]*f[a-zA-Z]*", a) for a in rest)):
            self.deny("git-rm-force", "use_alternative", "git rm -f discards changes")
        if sub == "submodule" and first not in ("status", "summary", None):
            self.deny("git-submodule", "manual_only", f"git submodule {first} is not allowed")
        if sub in ("difftool", "mergetool"):
            self.deny("git-tool", "manual_only", f"git {sub} launches an external program")
        cpos = self.clone_positionals(rest) if sub == "clone" else []
        if sub == "clone" and self.confined and len(cpos) >= 2 and cpos[-1] is not None:
            self.check_write_path(cpos[-1], cwd)
        return cwd

    # Per-subcommand short options that take a value, so the rest of a cluster is that value and
    # not more flags (`git tag -mDeploy`: the m takes "Deploy", not -D -e ...). Only subcommands
    # whose mutate checks read short letters need an entry.
    # An optional value (branch -t, commit -S and -u) is the rest of the cluster too.
    GIT_SHORT_VALUE = {"branch": "ut", "tag": "mFun", "switch": "cCt", "restore": "s",
                       "commit": "mFcCtSu", "checkout": "bB"}
    # git grep's own (-O's optional value is attached), not grep's or ugrep's.
    GIT_GREP_VALUE = "efmABCO"

    def git_flags(self, sub, rest):
        """The option flags in rest as a set: each long option whole (minus any =value), and each
        short cluster split into its letters (-qD -> -q, -D), stopping at a value-taking letter so
        an attached value is never read as flags."""
        value = self.GIT_SHORT_VALUE.get(sub, "")
        out = set()
        for a in rest:
            if not a or not a.startswith("-") or a == "-":
                continue
            if a.startswith("--"):
                out.add(a.split("=", 1)[0])
                continue
            for ch in a[1:]:
                out.add("-" + ch)
                if ch in value:
                    break
        return out

    def clone_flag(self, a):
        """git clone's --upload-pack (-u), --config (-c) and --template: long by prefix, short
        anywhere in a cluster (`-qc`) before a value-taking letter (-b, -j, -o) starts a value."""
        if flag_hit(a, ("--upload-pack", "--template", "--config", "--separate-git-dir")):
            return True  # --separate-git-dir puts .git anywhere, outside the clone dest
        if self.short_cluster(a or ""):
            for ch in a[1:]:
                if ch in "uc":
                    return True
                if ch in "bjo":
                    break
        return False

    CLONE_VALUE_FLAGS = {"--depth", "-b", "--branch", "-o", "--origin", "--reference",
                         "--reference-if-able", "-j", "--jobs", "--shallow-since",
                         "--shallow-exclude", "--separate-git-dir", "--filter",
                         "--server-option", "--bundle-uri", "--revision"}

    def clone_positionals(self, rest):
        out, skip = [], False
        for a in rest:
            if skip:
                skip = False
            elif a is not None and a.startswith("--") and "=" not in a and flag_hit(
                    a, self.CLONE_VALUE_FLAGS):
                skip = True  # a long value option by prefix (--sep -> --separate-git-dir)
            elif a is not None and a in self.CLONE_VALUE_FLAGS:
                skip = True
            elif a is None or not a.startswith("-"):
                out.append(a)
        return out

    def git_config_read(self, rest, pos, flags):
        # --global/--system only pick the scope; a write still needs an action flag or a
        # name+value pair (caught by the positional count below), so a read with --global passes.
        write_flags = {"--unset", "--unset-all", "--add", "--replace-all", "--edit", "-e",
                       "--rename-section", "--remove-section"}
        if any_flag(flags, write_flags):
            return False
        if flags & {"--get", "--get-all", "--get-regexp", "--list", "-l", "--get-urlmatch",
                    "--show-origin", "--show-scope", "--name-only"}:
            return True
        return len(pos) <= 1

    def git_read_only(self, sub, rest, pos, flags, first, cwd):
        g = self.p["git"]
        if sub not in g["read_only"]:
            self.deny("researcher-git", "scope_down",
                      f"researcher runs read-only git; git {sub} changes something")
        ok = True
        if sub == "branch":
            ok = not any_flag(flags, self.GIT_BRANCH_MUTATE | {"-t", "--track", "--no-track",
                                                               "--create-reflog"})
            ok = ok and (not pos or flags & {"--list", "-l", "--contains", "--merged",
                                             "--no-merged", "--points-at", "--no-contains"})
        elif sub == "tag":
            ok = not any_flag(flags, self.GIT_TAG_MUTATE | {"-a", "-s", "-m", "-F", "-u",
                                                            "--annotate", "--sign"})
            ok = ok and (not pos or flags & {"-l", "--list", "--contains", "--points-at",
                                             "--merged", "--no-merged"})
        elif sub == "remote":
            ok = first in self.GIT_REMOTE_READ
        elif sub == "stash":
            ok = bool(rest) and rest[0] in ("list", "show")  # an option first means stash push
        elif sub == "worktree":
            ok = first == "list"
        elif sub == "config":
            ok = self.git_config_read(rest, pos, flags)
        elif sub == "reflog":
            ok = first in (None, "show")
        elif sub == "clone":
            cpos = self.clone_positionals(rest)
            url = cpos[0] if cpos else ""
            dest = cpos[1] if len(cpos) > 1 else None
            ok = url.startswith("https://") and dest is not None and self.in_temp(
                resolve(expand(dest, self.home), cwd))
            if not ok:
                self.deny("researcher-clone", "scope_down",
                          "researcher clones only an https URL into an explicit temp dir "
                          f"({self.temp_roots[0]}/...)")
        if not ok:
            self.deny("researcher-git", "scope_down",
                      f"researcher runs only the read-only forms of git {sub}")

    # ------------------------------------------------ researcher

    def uniq_operands(self, words):
        """uniq's file operands: words that aren't options, - (stdin) included, and every word
        after --. A second one is the output file."""
        n = 0
        for k, a in enumerate(words):
            if a == "--":
                return n + len(words) - k - 1
            if a is None or a == "-" or not a.startswith("-"):
                n += 1
        return n

    # Researcher programs with write or run rules in code rather than in denied_flags.
    RESEARCHER_WRITERS = {"xxd", "uniq", "curl", "wget", "git"}

    def researcher_program(self, base, args, globs, splits, cwd, depth):
        r = self.p["researcher"]
        if len(args) == 2 and args[1] in ("--version", "--help", "-h", "-V") and \
                "/" not in (args[0] or ""):
            return cwd
        if base not in r["programs"]:
            self.deny("researcher-program", "scope_down",
                      f"researcher runs only allowlisted read commands; {base} is not one")
        if "/" in (args[0] or "") and base != "gh-public":
            self.deny("researcher-program", "scope_down",
                      "researcher runs programs by name from PATH, not by path")
        for a in args[1:]:
            if a is None:
                continue
            cluster = (self.cluster_opts(a, self.SHORT_VALUE.get(base, ""))
                       if self.short_cluster(a) else set())
            for f in r["denied_flags"].get(base, []):
                hit = flag_hit(a, (f,)) or a.startswith(f + "=")
                if not f.startswith("--") and len(f) == 2:
                    hit = hit or f[1] in cluster  # a denied letter anywhere in the cluster
                if hit:
                    self.deny("researcher-flag", "scope_down",
                              f"{base} {f} writes or runs something; researcher only reads")
        if base == "sed" and any(globs[1:]):
            # A glob or brace could expand to an option the policy can't see, even -i, which
            # --sandbox does not disable; a researcher write has no sandbox backstop, so refuse.
            self.deny("sed-unchecked", "use_alternative",
                      "sed with a glob or brace argument could expand to an option (even -i, "
                      "which --sandbox won't stop) or a script the policy can't check; name the "
                      "files or pipe them in")
        # A program with a write or run rule sees every word literally: a glob, brace, variable
        # or substitution (or a word xargs adds) can expand to an option or an output operand
        # the rules never read (`sort "$(echo -oout)" in`), so none is allowed, even after --.
        # sed keeps its own reader, which already refuses each one outside a --sandbox -e value.
        if base != "sed" and (base in r["denied_flags"] or base in self.RESEARCHER_WRITERS) and (
                any(globs[1:]) or any(splits[1:]) or None in args[1:]):
            self.deny("researcher-dynamic", "use_alternative",
                      f"{base} with a glob, brace, variable or substitution could expand to an "
                      "option or output file the policy can't check; name each file and value "
                      "literally")
        if base == "git":
            return self.git(args, cwd, researcher=True)
        if base == "cd":
            return self.cd(args, cwd)
        if base == "sed":
            call, ops = self.sed(args, globs, splits)
            if call.in_place is not None or any(op in ("e", "w") for op, _ in ops):
                self.deny("researcher-flag", "scope_down",
                          "sed -i or a sed w/W/e command writes a file or runs one")
        if base in ("grep", "egrep", "fgrep", "ugrep") and any(
                a and a.startswith("---") for a in args[1:]):
            self.deny("researcher-flag", "scope_down",
                      f"{base} ---FILE loads a config file that can set a filter or pager command")
        if base == "uniq" and self.uniq_operands(args[1:]) > 1:
            self.deny("researcher-flag", "scope_down", "uniq with an output file writes it")
        if base == "date" and any(a and not a.startswith(("-", "+")) for a in args[1:]):
            self.deny("researcher-flag", "scope_down",
                      "date with an operand other than +FORMAT sets the clock")
        if base == "xxd" and self.xxd_writes(args[1:]):
            self.deny("researcher-flag", "scope_down", "xxd -r or an xxd output file writes it")
        if base == "curl":
            self.curl(args, researcher=True)
        if base == "wget":
            self.wget(args, researcher=True)
        return cwd


# ---------------------------------------------------------------- main

def deny_output(d, policy):
    footer = d.footer if d.footer is not None else \
        (policy or {}).get("intents", {}).get(d.intent, "")
    return json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": f"[subagent-policy] {d.rule} ({d.intent}): {d.message}. "
                                    f"{footer}".strip(),
    }})


def log_deny(data, d):
    try:
        dc.append_row({"ts": dc.now_iso(), "runner": "claude", "event": "policy",
                       "id": dc.norm_id(data.get("agent_id")),
                       "agent_type": dc.agent_role(data), "session_id": data.get("session_id"),
                       "tool": data.get("tool_name"), "rule": d.rule, "intent": d.intent})
    except Exception:
        pass


def heartbeat():
    try:
        os.makedirs(dc.state_dir(), exist_ok=True)
        path = os.path.join(dc.state_dir(), "subagent-policy.heartbeat")
        with open(path, "a"):
            pass
        os.utime(path, None)
    except PolicyTimeout:
        raise
    except Exception:
        pass


class PolicyTimeout(Exception):
    """The alarm's: not TimeoutError, an OSError that a read catching OSError (dc.read_session)
    would swallow, leaving the hook to run on with no alarm. main turns it into a deny."""


def _alarm(_sig, _frm):
    raise PolicyTimeout(f"policy check took over {ALARM_SECONDS}s")


def evaluate(data, policy=None, home=None):
    """None to allow, or a Deny. Raises on internal errors (main() decides what that means)."""
    policy = policy or load_policy()
    try:
        Analyzer(data, policy, home=home).decide()
    except Deny as d:
        return d
    return None


def main():
    signal.signal(signal.SIGALRM, _alarm)
    signal.alarm(ALARM_SECONDS)
    data, policy = None, None
    try:
        data = json.loads(sys.stdin.read() or "null")
        if not isinstance(data, dict):
            raise ValueError("hook input is not a JSON object")
        if not data.get("agent_id"):
            return 0  # the main thread: not ours to police
        heartbeat()
        policy = load_policy()
        d = evaluate(data, policy)
    except Exception as e:  # noqa: BLE001  fail closed for policed tools only
        tool = (data or {}).get("tool_name") if isinstance(data, dict) else None
        if data is not None and isinstance(data, dict) and not data.get("agent_id"):
            return 0
        if tool is not None and not policed(tool):
            return 0
        d = Deny("policy-error", "stop_and_explain",
                 f"the policy check failed ({type(e).__name__}: {e}), so this call is refused")
    finally:
        signal.alarm(0)
    if d:
        if isinstance(data, dict):
            log_deny(data, d)
        print(deny_output(d, policy))
    return 0


if __name__ == "__main__":
    sys.exit(main())
