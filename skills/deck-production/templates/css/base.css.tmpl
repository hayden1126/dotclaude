/* Base: font faces, reveal overrides, house styles.
   Layout scaffolds live in archetypes.css; per-slide rules live scoped inside
   each fragment. Nothing here knows a slide's name.

   The @font-face block below is generated by `deckkit new` from the theme's
   font roles. Re-run the scaffolder, or edit by hand, if you change faces. */

{{FONT_FACES}}

/* reveal resets: kill the theme defaults, we own everything */
.reveal { font-family: var(--font-sans); font-size: var(--fs-body); color: var(--ink); }
.reveal .slides section { text-align: left; padding: 0; height: {{CANVAS_HEIGHT}}px; box-sizing: border-box; }
.reveal h1, .reveal h2, .reveal h3 { font-family: var(--font-display); font-weight: 700; margin: 0; letter-spacing: 0.005em; }
.reveal h1 { font-size: var(--fs-h1); line-height: 1.05; }
.reveal h2 { font-size: var(--fs-h2); line-height: 1.1; }
.reveal h3 { font-size: var(--fs-h3); line-height: 1.15; }
.reveal p { margin: 0; line-height: 1.45; }
.reveal img, .reveal video { max-width: none; margin: 0; border: none; box-shadow: none; }

/* CJK glyphs pick up the CJK face from the lang attribute, never from a class */
:lang(zh-Hans), :lang(zh-Hant), :lang(ja), :lang(ko) { font-family: var(--font-cjk); }

/* grounds: every slide declares one, and the ground decides text colour */
.ground-dark { background: var(--ground-dark); color: var(--paper); }
.ground-dark .muted { color: var(--paper-dim); }
.ground-light { background: var(--ground-light); color: var(--ink); }
.ground-light .muted { color: var(--muted); }

/* house stat style: one giant numeral, one tiny caption beneath.
   Never two competing numerals in one panel. A delta belongs in the caption. */
.stat { font-family: var(--font-display); }
.stat .stat-num { font-size: var(--fs-stat); font-weight: 700; line-height: 1; letter-spacing: -0.01em; }
.stat.hero .stat-num { font-size: var(--fs-hero); }
.stat .stat-unit { font-size: 0.4em; font-weight: 400; margin-left: 0.08em; }
.stat .stat-caption { display: block; font-family: var(--font-sans); font-size: var(--fs-caption); margin-top: var(--sp-2); }
.ground-dark .stat .stat-num { color: var(--accent-bright); }
.ground-light .stat .stat-num { color: var(--ground-dark); }

/* kicker: the small-caps lead-in line above a headline */
.kicker { font-family: var(--font-sans); font-size: var(--fs-caption); text-transform: uppercase; letter-spacing: 0.22em; color: var(--accent); }

/* public sourcing footnote: bottom strip, mandatory on every data slide.
   Source names and dates only. Registry ids never render. */
footer.src { position: absolute; left: var(--margin-slide); right: var(--margin-slide); bottom: 40px; font-family: var(--font-sans); font-size: var(--fs-footnote); line-height: 1.4; }
.ground-dark footer.src { color: rgba(247, 245, 241, 0.55); }
.ground-light footer.src { color: rgba(75, 78, 104, 0.75); }

/* hairline dividers */
.rule { border: none; border-top: var(--hairline); margin: var(--sp-4) 0; }
.ground-light .rule { border-top: var(--hairline-dark); }

/* X -> Y house notation for every target */
.arrow-to { color: var(--accent); padding: 0 0.25em; }

/* chart defaults, so a figure inherits the system instead of restating it */
.chart text { dominant-baseline: central; font-variant-numeric: tabular-nums; }
.chart .axis { stroke: rgba(75, 78, 104, 0.22); stroke-width: 1; }
