<!doctype html>
<html lang="{{LANG}}">
<head>
  <meta charset="utf-8">
  <title>{{TITLE}}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="vendor/reveal/reveal.css">
  <link rel="stylesheet" href="css/tokens.css">
  <link rel="stylesheet" href="css/base.css">
  <link rel="stylesheet" href="css/archetypes.css">
{{LOCAL_ARCHETYPES_LINK}}
</head>
<body>
  <div class="reveal">
    <div class="slides">
      <!-- BUILD:SLIDES:BEGIN (generated by deckkit build from {{FRAGMENT_DIR}}/*.html in storyboard order — edit the fragments, not this block) -->
    <!-- BUILD:SLIDES:END -->
    </div>
  </div>
  <script src="vendor/reveal/reveal.js"></script>
  <script src="vendor/reveal/plugin/notes/notes.js"></script>
  <script>
    // ?export -> capture mode: no transitions, videos frozen on poster frames,
    // no presenter chrome. decktape and the PDF path always use this.
    const EXPORT_MODE = new URLSearchParams(location.search).has('export');
    Reveal.initialize({
      width: {{CANVAS_WIDTH}}, height: {{CANVAS_HEIGHT}}, margin: 0,
      hash: true, controls: false, progress: false,
      transition: EXPORT_MODE ? 'none' : 'fade',
      backgroundTransition: 'none',
      plugins: [RevealNotes],   // speaker view on S; notes live in aside.notes
    });
    if (EXPORT_MODE) {
      document.documentElement.classList.add('export');
      document.querySelectorAll('video').forEach(v => {
        v.removeAttribute('autoplay'); v.pause(); v.preload = 'none';
      });
    } else {
      Reveal.on('slidechanged', e => {
        document.querySelectorAll('video').forEach(v => v.pause());
        const v = e.currentSlide.querySelector('video[data-autoplay-on-view]');
        if (v) { v.currentTime = 0; v.play().catch(() => {}); }
      });
      // Films start muted, which is what browser autoplay policy requires. The
      // presenter clicks the film to toggle sound; the slide's .unmute-hint
      // chip fades once sound is on.
      document.addEventListener('click', ev => {
        const v = ev.target.closest('video[data-autoplay-on-view]');
        if (!v) return;
        v.muted = !v.muted;
        if (!v.muted && v.paused) v.play().catch(() => {});
        v.closest('section').classList.toggle('sound-on', !v.muted);
      });
    }
  </script>
</body>
</html>
