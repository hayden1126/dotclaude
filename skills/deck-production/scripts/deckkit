#!/usr/bin/env python3
"""deckkit: the single entry point for the deck-production tools. Stdlib only.

Its most important job is choosing the interpreter. Font work needs fontTools,
which usually lives in the system python and not in a project .venv; pptx work
needs python-pptx, which usually lives in the .venv and not in the system
python. Getting this wrong was a recurring cost, so it is automated here
instead of documented and forgotten.

    deckkit new <dir> --title T [--theme ID] [--facts repo|deck|none]
    deckkit doctor [<deck>]
    deckkit build <deck> [--check] [--urls] [--json]
    deckkit lint <deck> [--baseline FILE]
    deckkit fonts <deck> [--check]
    deckkit package <deck> [--check]
    deckkit serve <deck> [--port N]
    deckkit geometry <deck> [--rules FILE] [--slides SPEC]
    deckkit fingerprint <deck> [--baseline FILE]
    deckkit pdf <deck> [--background]
    deckkit pptx <deck> [--picture-only|--editable-only]
    deckkit theme extract [--pptx F] [--pdf F] [--logo F] [--site URL] --out DIR
    deckkit ingest <stage> ...
    deckkit regress --ref-deck PATH [--facts PATH]

Exit codes: 0 ok · 1 check failed · 2 usage/config error · 3 environment missing
"""
from __future__ import annotations

import os
import pathlib
import sys

HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))

import deckcfg  # noqa: E402  (path must be set first)

# subcommand -> (script, interpreter kind, takes a deck dir as first positional)
COMMANDS: dict[str, tuple[str, str, bool]] = {
    "new":         ("new_deck.py",     "self",      False),
    "doctor":      ("doctor.py",       "self",      True),
    "build":       ("build.py",        "self",      True),
    "lint":        ("lint.py",         "fonttools", True),
    "fonts":       ("subset_fonts.py", "fonttools", True),
    "package":     ("package.py",      "self",      True),
    "serve":       ("serve.py",        "self",      True),
    "geometry":    ("geometry.py",     "self",      True),
    "fingerprint": ("fingerprint.py",  "self",      True),
    "pdf":         ("pdf.py",          "self",      True),
    "pptx":        ("export_pptx.py",  "pptx",      True),
    "theme":       ("theme_extract.py", "pptx",     False),
    "ingest":      ("ingest.py",       "pptx",      False),
    "regress":     ("parity_check.py", "self",      False),
}

USAGE = __doc__.split("Exit codes:")[0].strip()


def resolve_interpreter(kind: str, deck_arg: str | None) -> str:
    if kind == "self":
        return sys.executable
    try:
        cfg = deckcfg.load(deck_arg) if deck_arg else deckcfg.load()
    except deckcfg.ConfigError:
        # No deck yet, or an unreadable one: fall back to the documented defaults.
        cfg = deckcfg.DeckConfig(pathlib.Path.cwd(), {}, "<defaults>")
    return cfg.interpreter(kind)


def main(argv: list[str]) -> int:
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print(USAGE)
        return deckcfg.EXIT_OK
    if argv[1] in ("-V", "--version"):
        print("deckkit (deck-production skill)")
        return deckcfg.EXIT_OK

    name = argv[1]
    if name not in COMMANDS:
        print(f"error: unknown command {name!r}", file=sys.stderr)
        print(f"       commands: {', '.join(sorted(COMMANDS))}", file=sys.stderr)
        return deckcfg.EXIT_USAGE

    script_name, kind, takes_deck = COMMANDS[name]
    script = HERE / script_name
    if not script.exists():
        print(f"error: {name} is not implemented yet ({script} missing)", file=sys.stderr)
        return deckcfg.EXIT_USAGE

    rest = argv[2:]
    deck_arg = None
    if takes_deck and rest and not rest[0].startswith("-"):
        deck_arg = rest[0]

    interpreter = resolve_interpreter(kind, deck_arg)
    if not pathlib.Path(interpreter).exists() and interpreter != sys.executable:
        print(f"environment: {interpreter} does not exist", file=sys.stderr)
        print(f"  {name} needs the '{kind}' interpreter; set [env] in deck.toml "
              f"or run `deckkit doctor`", file=sys.stderr)
        return deckcfg.EXIT_ENV

    os.execv(interpreter, [interpreter, str(script), *rest])
    return deckcfg.EXIT_OK  # unreachable


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except deckcfg.ConfigError as exc:
        sys.exit(deckcfg.bail(str(exc)))
